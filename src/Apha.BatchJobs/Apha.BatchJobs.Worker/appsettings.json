{
  "ConnectionStrings": {
    "FPSConnectionString": "<set via environment variable or appsettings.Local.json>"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "LogsPath": "Logs",
  "ExceptionTypes": {
    "General": "FPSBatchJobs.GENERAL_EXCEPTION",
    "Sql": "FPSBatchJobs.SQL_EXCEPTION",
    "Validation": "FPSBatchJobs.VALIDATION_EXCEPTION",
    "Concurrency": "FPSBatchJobs.CONCURRENCY_EXCEPTION"
  },
  "Logging": {
    "LogStreamPrefix": "apha-batch",
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Build": {
    "LastEcrPushMarker": "2026-07-17T2"
  },
  "BatchJobs": {
    "MaxConcurrentJobs": 5,
    "JobTimeout": 0,
    "RetryAttempts": 3,
    "RetryDelaySeconds": 60,
    "MaxRetryDurationSeconds": 0,
    "LockTimeoutSeconds": 0,
    "HeartbeatIntervalSeconds": 30,
    "GracefulShutdownWindowSeconds": 25,
    "WorkerOverallTimeoutSeconds": 3600
  },
  "MabArchive": {
    "LockTimeoutSeconds": 0
  },
  "BatchAlerting": {
    "EnableEmailNotifications": true,
    "AdminNotificationEmail": "batch-admin@defra.gov.uk"
  },
  "AwsLogging": {
    "LogGroupName": "/aws/ecs/batch-jobs"
  }
}

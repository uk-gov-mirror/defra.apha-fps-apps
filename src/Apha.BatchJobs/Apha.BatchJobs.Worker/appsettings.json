{
  "ConnectionStrings": {
    "FPSConnectionString": "<set via environment variable or appsettings.Local.json>"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "ExceptionTypes": {
    "General": "FPSBatchJobs.GENERAL_EXCEPTION",
    "Sql": "FPSBatchJobs.SQL_EXCEPTION",
    "Validation": "FPSBatchJobs.VALIDATION_EXCEPTION",
    "Configuration": "FPSBatchJobs.CONFIGURATION_EXCEPTION",
    "Concurrency": "FPSBatchJobs.CONCURRENCY_EXCEPTION",
    "Email": "FPSBatchJobs.EMAIL_EXCEPTION"
  },
  "Logging": {
    "LogStreamPrefix": "apha-batch",
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Build": {
    "LastEcrPushMarker": "2026-07-17"
  },
  "BatchJobs": {
    "MaxConcurrentJobs": 5,
    "JobTimeout": 0,
    "RetryAttempts": 3,
    "RetryDelaySeconds": 60,
    "MaxRetryDurationSeconds": 0,
    "LockTimeoutSeconds": 0,
    "HeartbeatIntervalSeconds": 30
  },
  "MabArchive": {
    "LockTimeoutSeconds": 0,
    "TransactionTimeoutSeconds": 0,
    "AdminNotificationEmail": "batch-admin@defra.gov.uk",
    "NotificationFromEmail": "batch-jobs@defra.gov.uk",
    "SmtpHost": "smtp.example.com",
    "SmtpPort": 587,
    "EnableEmailNotifications": true,
    "CloudWatchLogGroup": "/aws/ecs/batch-jobs"
  }
}

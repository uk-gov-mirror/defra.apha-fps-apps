<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<ItemGroup>
		<Folder Include="Contracts\Costbook\" />
	</ItemGroup>

	<ItemGroup>
		<!-- Exclude the separate UnitTests sub-project; its obj/ folder contains auto-generated
		     AssemblyInfo.cs files that clash with this project's own generated attributes. -->
		<Compile Remove="Apha.Common.UnitTests\**\*" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="AWSSDK.EventBridge" Version="4.0.6.10" />
		<PackageReference Include="AWSSDK.SSO" Version="4.0.6.10" />
		<PackageReference Include="AWSSDK.SSOOIDC" Version="4.0.6.10" />
		<PackageReference Include="ClosedXML" Version="0.105.0" />
		<PackageReference Include="Microsoft.AspNetCore.Http" Version="2.3.9" />
		<PackageReference Include="Microsoft.Extensions.Caching.Abstractions" Version="10.0.5" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.5" />
		<PackageReference Include="Microsoft.Graph" Version="5.103.0" />
		<PackageReference Include="Microsoft.Kiota.Abstractions" Version="1.22.2" />
	</ItemGroup>

	<ItemGroup>
		<!-- Entity Framework Core -->
		<PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.5" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.5" />

		<!-- Mocking -->
		<PackageReference Include="Moq" Version="4.20.72" />

		<!-- Testing Frameworks -->
		<PackageReference Include="xunit" Version="2.9.2" />
		<PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
		  <PrivateAssets>all</PrivateAssets>
		  <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>
</Project>

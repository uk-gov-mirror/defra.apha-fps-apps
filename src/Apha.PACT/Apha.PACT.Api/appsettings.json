{
	"Logging": {
		"LogLevel": {
			"Default": "Information",
			"Microsoft.AspNetCore": "Warning"
		}
	},
	"ConnectionStrings": {
		"FPSConnectionString": "<FPS-DB-Connectionstring>"
	},
	"AllowedHosts": "*",
	"AwsLogging": {
		"LogGroupName": ""
	},
	"AzureAd": {
		"Instance": "https://login.microsoftonline.com/",
		"Domain": "<domain_name>.com",
		"ClientId": "<client_Id>",
		"TenantId": "<tenant_Id>",
		"ClientSecret": "<client_Secret>",
		"ClientCertificates": [
		],
		"CallbackPath": "/signin-oidc"
	},
	"GraphEmailSettings": {
		"TenantId": "<tenant_Id>",
		"ClientId": "<client_Id>",
		"ClientSecret": "<client_Secret>",
		"SharedMailbox": "<shared_mailbox>"
	},
	"WorkGroupReportEmailSettings": {
		"GatekeeperMailbox": "<GatekeeperMailbox>",
		"EmailBodyTemplate": "Please complete and return to APHA Gatekeeper - OTL Mailbox. [Mailto:{0}]. Thank you."
	},
	"EventBridge": {
		"Region": "<Region>",
		"EventBusArn": "<EventBusArn>",
		"Source": "<Source>",
		"DetailType": "<DetailType>",
	},
	"LogsPath": "Logs",
	"ExceptionTypes": {
		"General": "FPSAPPS.EXCEPTION.PACT.GENERAL",
		"Database": "FPSAPPS.EXCEPTION.PACT.DB",
		"Authorization": "FPSAPPS.EXCEPTION.PACT.AUTHORIZATION"
	},
	"Serilog": {
		"MinimumLevel": {
			"Default": "Information",
			"Override": {
				"Microsoft": "Warning",
				"System": "Warning",
				"Microsoft.AspNetCore": "Warning"
			}
		}
	}

}

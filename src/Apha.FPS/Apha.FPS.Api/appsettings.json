{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "FPSConnectionString": "<FPS-DB-Connectionstring>"
  },
  "AllowedHosts": "*",
  "AwsLogging": {
    "LogGroupName": ""
  },
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "Domain": "<domain_name>.com",
    "ClientId": "<client_Id>",
    "TenantId": "<tenant_Id>",
    "ClientSecret": "<client_Secret>",
    "ClientCertificates": [
    ],
    "CallbackPath": "/signin-oidc"
  },
  "EventBridge": {
    "Region": "<Region>",
    "EventBusArn": "<EventBusArn>",
    "Source": "<Source>",
    "DetailType": "<DetailType>"
  },
  "LogsPath": "Logs",
  "ExceptionTypes": {
    "General": "FPSAPPS.EXCEPTION.FPS.GENERAL",
    "Database": "FPSAPPS.EXCEPTION.FPS.DB",
    "Authorization": "FPSAPPS.EXCEPTION.FPS.AUTHORIZATION"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Microsoft.AspNetCore": "Warning"
      }
    }
  }
}

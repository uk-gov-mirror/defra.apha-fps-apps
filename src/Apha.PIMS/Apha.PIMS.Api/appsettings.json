{
	"Logging": {
		"LogLevel": {
			"Default": "Information",
			"Microsoft.AspNetCore": "Warning"
		}
	},
	"AllowedHosts": "*",
	"AwsLogging": {
		"LogGroupName": ""
	},
	"AzureAd": {
		"Instance": "https://login.microsoftonline.com/",
		"Domain": "<domain_name>.com",
		"ClientId": "<client_Id>",
		"TenantId": "<tenant_Id>"
	},
	"LogsPath": "Logs",
	"ExceptionTypes": {
		"General": "FPSAPPS.EXCEPTION.PIMS.GENERAL",
		"Database": "FPSAPPS.EXCEPTION.PIMS.DB",
		"Authorization": "FPSAPPS.EXCEPTION.PIMS.AUTHORIZATION"
	},
	"Serilog": {
		"MinimumLevel": {
			"Default": "Information",
			"Override": {
				"Microsoft": "Warning",
				"System": "Warning",
				"Microsoft.AspNetCore": "Warning"
			}
		}
	}

}

@using Apha.FPSApps.Web.Models.Components.DataGrid
@model Apha.FPSApps.Web.Areas.PIMS.Models.ProjectYearCostsViewModel

@{
    ViewData["Title"] = "PIMS : Yearly Finances";
}

<div class="govuk-grid-row sup_border-bottom" style="padding: 0">
    <h5 class="govuk-heading-s sup_margin_0"
        style="padding: 10px 0 5px 24px;">
        Yearly Finances
    </h5>
</div>

<div class="d-flex govuk-!-padding-top-2">

    <!-- ── Side Navigation ──────────────────────────────────── -->
    @await Html.PartialAsync("_SideNav", new Apha.FPSApps.Web.Areas.PIMS.Models.ProjectDetailsViewModel
    {
        Parentproject = Model.Parentproject
    })

    <!-- ── Main Content ─────────────────────────────────────── -->
    <main class="main-content" style="padding-top: 0">

        <!-- ── Filters row ─────────────────────────────────── -->
        <div class="govuk-grid-row govuk-!-margin-bottom-3" id="search-grid">
            <div class="sup_search_panel sup_p_0 sup_border_b_0"
                 style="overflow: visible; border: 0; padding: 0">
                <div class="govuk-grid-column-full sup_flex_between_center"
                     style="align-items: flex-end">
                    <div class="govuk-grid-row"
                         style="margin: 8px; display: flex; align-items: flex-end;">

                        <div style="margin: 0 7px; flex: 1;">
                            <label for="dpprojectSelect " class="govuk-label tab-font-size govuk-!-font-weight-bold sup_font_weight_700">
                                Select a Project
                            </label>
                            <select id="dpprojectSelect"
                                    class="govuk-select project-dropdown tab-font-size"
                                    style="width: 100%;">
                                <option value="">Select a Project</option>
                                    @foreach (var item in Model.ProjectOptions)
                                    {
                                    if (item.Value == Model.Parentproject)
                                    {
                                        <option value="@item.Value" selected="selected">@item.Text</option>
                                    }
                                    else
                                    {
                                        <option value="@item.Value">@item.Text</option>
                                    }
                                }
                            </select>
                                </div>

                        <div style="margin: 0 5px; flex: 1;">
                            <label for="dpyear" class="govuk-label govuk-!-font-weight-bold tab-font-size sup_font_weight_700">Year</label>
                            <select id="dpyear"
                                    class="govuk-select project-dropdown tab-font-size"
                                    style="width: 100%;">
                                <option value="">Year</option>
                                @foreach (var item in Model.YearOptions)
                                {
                                    if (item.Value == Model.SelectedYear.ToString())
                                    {
                                        <option value="@item.Value" selected="selected">@item.Text</option>
                                    }
                                    else
                                    {
                                        <option value="@item.Value">@item.Text</option>
                                    }
                                }
                            </select>
                        </div>

                        <div style="margin: 0 5px; flex-shrink: 0;">
                            <label class="govuk-label govuk-visually-hidden sup_font_weight_700" for="btnExport">Export</label>
                            <button id="btnExport" type="button" class="govuk-button"
                                    style="padding: 5px 10px; font-size: 16px; line-height: 1.2; margin-bottom: 2px;">
                                Export
                            </button>
                        </div>

                    </div>
                </div>
            </div>
        </div>

        <!-- ── Tabs ─────────────────────────────────────────── -->
        <div class="govuk-template__body js-enabled govuk-frontend-supported">
            <div class="govuk-tabs" data-module="govuk-tabs">
                <ul class="govuk-tabs__list">
                    <li class="govuk-tabs__list-item govuk-tabs__list-item--selected " id="tab_nav-monthlyPact">
                        <a class="govuk-tabs__tab" href="#nav-monthlyPact" role="tab"
                           aria-controls="nav-monthlyPact" style="font-size: 14px; text-decoration: none">
                            Monthly Pact Data
                        </a>
                    </li>
                    <li class="govuk-tabs__list-item " id="tab_nav-pact-pay">
                        <a class="govuk-tabs__tab" href="#nav-pact-pay" role="tab"
                           aria-controls="nav-pact-pay" style="font-size: 14px; text-decoration: none">
                            Pact Pay
                        </a>
                    </li>
                    <li class="govuk-tabs__list-item " id="tab_nav-project-details">
                        <a class="govuk-tabs__tab" href="#nav-project-details" role="tab"
                           aria-controls="nav-project-details" style="font-size: 14px; text-decoration: none">
                            Project Details
                        </a>
                    </li>
                    <li class="govuk-tabs__list-item " id="tab_nav-plan">
                        <a class="govuk-tabs__tab" href="#nav-plan" role="tab"
                           aria-controls="nav-plan" style="font-size: 14px; text-decoration: none">
                            Plan
                        </a>
                    </li>
                    <li class="govuk-tabs__list-item " id="tab_nav-staff-plan">
                        <a class="govuk-tabs__tab" href="#nav-staff-plan" role="tab"
                           aria-controls="nav-staff-plan" style="font-size: 14px; text-decoration: none">
                            Staff Plan vs Actuals
                        </a>
                    </li>
                    <li class="govuk-tabs__list-item " id="tab_nav-test-plan">
                        <a class="govuk-tabs__tab" href="#nav-test-plan" role="tab"
                           aria-controls="nav-test-plan" style="font-size: 14px; text-decoration: none">
                            Test Plan vs Actuals
                        </a>
                    </li>
                    <li class="govuk-tabs__list-item " id="tab_nav-animal-plan">
                        <a class="govuk-tabs__tab" href="#nav-animal-plan" role="tab"
                           aria-controls="nav-animal-plan" style="font-size: 14px; text-decoration: none">
                            Animal Plan vs Actuals
                        </a>
                    </li>
                    <li class="govuk-tabs__list-item "
                        id="tab_nav-additional-cost">
                        <a class="govuk-tabs__tab" href="#nav-additional-cost" role="tab"
                           aria-controls="nav-additional-cost" style="font-size: 14px; text-decoration: none">
                            Additional Cost Plan vs Actuals
                        </a>
                    </li>
                </ul>

                <!-- Placeholder panels -->
                <div class="govuk-tabs__panel govuk-tabs__panel--hidden govuk-!-padding-2 min-height-380"
                     id="nav-monthlyPact" role="tabpanel" aria-labelledby="tab_nav-monthlyPact">
                    <div class="govuk-grid-row">
                        <div class="govuk-grid-column-full">
                            <div class="govuk-!-padding-3">
                                <div id="@($"gridContainer_{Model.MonthlyPactGrid.GridId}")">
                                    @await Html.PartialAsync("_DataGrid", Model.MonthlyPactGrid)
                                </div>
                                <!-- Totals row outside the scrollable grid -->
                                <div class="mpp-totals-wrapper" style="overflow-x: auto; overflow-y: hidden; margin-top: 0; border: none; border-radius: 0;">
                                    <table class="govuk-table govuk-table--bordered custom-table"
                                        id="monthly-data-totals" style="width: 100%;">
                                        <thead style="visibility: collapse;">
                                            <tr>
                                                <th style="width: 80px;" aria-label="Column 1"></th>
                                                <th style="width: 100px;" aria-label="Column 2"></th>
                                                <th style="width: 110px;" aria-label="Column 3"></th>
                                                <th style="width: 90px;" aria-label="Column 4"></th>
                                                <th style="width: 110px;" aria-label="Column 5"></th>
                                                <th style="width: 90px;" aria-label="Column 6"></th>
                                                <th style="width: 110px;" aria-label="Column 7"></th>
                                                <th style="width: 90px;" aria-label="Column 8"></th>
                                                <th style="width: 90px;" aria-label="Column 9"></th>
                                                <th style="width: 80px;" aria-label="Column 10"></th>
                                            </tr>
                                        </thead>
                                        <tbody class="govuk-table__body tab-font-size">
                                            <tr class="govuk-table__row" id="tableMPPTotalRow">
                                                <td class="govuk-table__cell mpp-label-cell"></td>
                                                <td class="govuk-table__cell mpp-label-cell">Totals</td>
                                                <td class="govuk-table__cell govuk-!-text-align-right"
                                                    id="mpp-total-proj-specific">£0.00</td>
                                                <td class="govuk-table__cell govuk-!-text-align-right"
                                                    id="mpp-total-animals">£0.00</td>
                                                <td class="govuk-table__cell govuk-!-text-align-right"
                                                    id="mpp-total-timecosts">£0.00</td>
                                                <td class="govuk-table__cell govuk-!-text-align-right"
                                                    id="mpp-total-transfercosts">
                                                    £0.00
                                                </td>
                                                <td class="govuk-table__cell govuk-!-text-align-right"
                                                    id="mpp-total-total-costs">£0.00</td>
                                                <td class="govuk-table__cell govuk-!-text-align-right"
                                                    id="mpp-total-total-hours">0</td>
                                                <td class="govuk-table__cell govuk-!-text-align-right"
                                                    id="mpp-total-invoices">£0.00</td>
                                                <td class="govuk-table__cell govuk-!-text-align-right"
                                                    id="mpp-total-coiw">£0.00</td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                                <!-- FPS Planned Cost section -->
                                <div class="govuk-!-margin-top-3">
                                    <strong class="govuk-body tab-font-bold-size">FPS Planned Cost</strong>
                                </div>
                                <table class="govuk-table govuk-table--s custom-table govuk-table--bordered"
                                       style="width: 100%; table-layout: fixed; border-collapse: collapse; margin-top: 4px;">
                                    <thead class="govuk-table__head tab-font-bold-size">
                                        <tr class="govuk-table__row">
                                            <th class="govuk-table__header govuk-!-text-align-right">Staff Costs</th>
                                            <th class="govuk-table__header govuk-!-text-align-right">Test Costs</th>
                                            <th class="govuk-table__header govuk-!-text-align-right">Exceptional Costs</th>
                                            <th class="govuk-table__header govuk-!-text-align-right">Animal Costs</th>
                                            <th class="govuk-table__header govuk-!-text-align-right">Total Cost</th>
                                            <th class="govuk-table__header govuk-!-text-align-right">Cust Income</th>
                                            <th class="govuk-table__header govuk-!-text-align-right">Total Income</th>
                                            <th class="govuk-table__header govuk-!-text-align-right">Budget VLA</th>
                                        </tr>
                                    </thead>
                                    <tbody class="govuk-table__body tab-font-size">
                                        <tr class="govuk-table__row">
                                            <td class="govuk-table__cell govuk-!-text-align-right" id="fps-staff-costs">£0.00</td>
                                            <td class="govuk-table__cell govuk-!-text-align-right" id="fps-test-costs">£0.00</td>
                                            <td class="govuk-table__cell govuk-!-text-align-right" id="fps-exceptional-costs">£0.00</td>
                                            <td class="govuk-table__cell govuk-!-text-align-right" id="fps-animal-costs">£0.00</td>
                                            <td class="govuk-table__cell govuk-!-text-align-right" id="fps-total-costs">£0.00</td>
                                            <td class="govuk-table__cell govuk-!-text-align-right" id="fps-cust-income">£0.00</td>
                                            <td class="govuk-table__cell govuk-!-text-align-right" id="fps-total-income">£0.00</td>
                                            <td class="govuk-table__cell govuk-!-text-align-right" id="fps-budget-vla">£0.00</td>
                                        </tr>
                                        <tr class="govuk-table__row govuk-!-font-weight-bold">
                                            <td colspan="7" class="govuk-table__cell govuk-!-text-align-right" style="vertical-align: middle;">
                                                Total Cost as Percentage of VLA Budget
                                            </td>
                                            <td class="govuk-table__cell govuk-!-text-align-right">
                                                <input class="govuk-input govuk-input--width-10"
                                                       id="fps-total-cost-pct" type="text" value=""
                                                       aria-label="Total cost as percentage of VLA budget"
                                                       style="max-width: 110px;" readonly />
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="govuk-tabs__panel govuk-tabs__panel--hidden govuk-!-padding-2 min-height-380"
                     id="nav-pact-pay" role="tabpanel" aria-labelledby="tab_nav-pact-pay">
                    <div class="govuk-grid-row">
                        <div class="govuk-grid-column-full">
                            <div class="govuk-!-padding-3">
                                <div id="@($"gridContainer_{Model.PactPayGrid.GridId}")">
                                    @await Html.PartialAsync("_DataGrid", Model.PactPayGrid)
                                </div>
                                <table id="pactPayFooterTable" class="govuk-table govuk-table--s custom-table govuk-table--bordered"
                                       style="width: 100%; table-layout: fixed; border-collapse: collapse; margin-top: 0;">
                                    <colgroup id="pactPayFooterColgroup">
                                        <col style="width: 11.6%;" />
                                        <col style="width: 15.9%;" />
                                        <col style="width: 17.4%;" />
                                        <col style="width: 17.4%;" />
                                        <col style="width: 17.4%;" />
                                        <col style="width: 20.3%;" />
                                    </colgroup>
                                    <thead class="govuk-visually-hidden" aria-label="Project year costs table headers">
+                                        <tr>
                                            <th scope="col" class="govuk-table__header" aria-label="payPact-Col1"></th>
                                            <th scope="col" class="govuk-table__header" aria-label="payPact-Col1"></th>
                                            <th scope="col" class="govuk-table__header">Pay</th>
                                            <th scope="col" class="govuk-table__header">Non-Pay</th>
                                            <th scope="col" class="govuk-table__header">Overhead</th>
                                            <th scope="col" class="govuk-table__header">Staff Costs</th>
                                        </tr>
                                    </thead>
                                    <tfoot class="govuk-table__foot tab-font-bold-size">
                                        <tr class="govuk-table__row">
                                            <td class="govuk-table__cell" colspan="2">Totals</td>
                                            <td class="govuk-table__cell govuk-text-align-right" id="pactPayTotalPay">£0.00</td>
                                            <td class="govuk-table__cell govuk-text-align-right" id="pactPayTotalNonPay">£0.00</td>
                                            <td class="govuk-table__cell govuk-text-align-right" id="pactPayTotalOverhead">£0.00</td>
                                            <td class="govuk-table__cell govuk-text-align-right" id="pactPayTotalStaffCosts">£0.00</td>
                                        </tr>
                                    </tfoot>
                                </table>
                                <div class="sup_total_footer" style="display:none;"><!-- kept for CSS compatibility --></div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="govuk-tabs__panel govuk-tabs__panel--hidden govuk-!-padding-2"
                     id="nav-project-details" role="tabpanel" aria-labelledby="tab_nav-project-details"
                     style="overflow-y: auto; max-height: 500px;">
                    <form class="govuk-form" style="width: 100%; display: flex;">
                        <fieldset class="govuk-fieldset"
                                  style="width: 100%; display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; grid-auto-flow: dense;">

                            <div class="govuk-form-group">
                                <label class="govuk-label govuk-!-font-size-16 sup_font_weight_700" for="pd-year">Year</label>
                                <input class="govuk-input govuk-!-font-size-16" id="pd-year" name="year" type="text" readonly>
                            </div>
                            <div class="govuk-form-group">
                                <label class="govuk-label govuk-!-font-size-16 sup_font_weight_700" for="pd-disease">Disease</label>
                                <input class="govuk-input govuk-!-font-size-16" id="pd-disease" name="disease" type="text" readonly>
                            </div>
                            <div class="govuk-form-group">
                                <label class="govuk-label govuk-!-font-size-16 sup_font_weight_700" for="pd-project">Project</label>
                                <input class="govuk-input govuk-!-font-size-16" id="pd-project" name="project" type="text" readonly>
                            </div>
                            <div class="govuk-form-group">
                                <label class="govuk-label govuk-!-font-size-16 sup_font_weight_700" for="pd-contract">Contract</label>
                                <input class="govuk-input govuk-!-font-size-16" id="pd-contract" name="contract" type="text" readonly>
                            </div>
                            <div class="govuk-form-group">
                                <label class="govuk-label govuk-!-font-size-16 sup_font_weight_700" for="pd-manager">Manager</label>
                                <input class="govuk-input govuk-!-font-size-16" id="pd-manager" name="manager" type="text" readonly>
                            </div>
                            <div class="govuk-form-group">
                                <label class="govuk-label govuk-!-font-size-16 sup_font_weight_700" for="pd-finished">Finished</label>
                                <input class="govuk-input govuk-!-font-size-16" id="pd-finished" name="finished" type="text" readonly>
                            </div>
                            <div class="govuk-form-group">
                                <label class="govuk-label govuk-!-font-size-16 sup_font_weight_700" for="pd-transferincome">Transfer Income</label>
                                <input class="govuk-input govuk-!-font-size-16" id="pd-transferincome" name="transferincome" type="text" readonly>
                            </div>
                            <div class="govuk-form-group">
                                <label class="govuk-label govuk-!-font-size-16 sup_font_weight_700" for="pd-custincome">Cust Income</label>
                                <input class="govuk-input govuk-!-font-size-16" id="pd-custincome" name="custincome" type="text" readonly>
                            </div>
                            <div class="govuk-form-group">
                                <label class="govuk-label govuk-!-font-size-16 sup_font_weight_700" for="pd-feecost">FE Cost</label>
                                <input class="govuk-input govuk-!-font-size-16" id="pd-feecost" name="feecost" type="text" readonly>
                            </div>
                            <div class="govuk-form-group">
                                <label class="govuk-label govuk-!-font-size-16 sup_font_weight_700" for="pd-profit">Profit</label>
                                <input class="govuk-input govuk-!-font-size-16" id="pd-profit" name="profit" type="text" readonly>
                            </div>
                            <div class="govuk-form-group">
                                <label class="govuk-label govuk-!-font-size-16 sup_font_weight_700" for="pd-carryover">Carry Over</label>
                                <input class="govuk-input govuk-!-font-size-16" id="pd-carryover" name="carryover" type="text" readonly>
                            </div>
                            <div class="govuk-form-group">
                                <label class="govuk-label govuk-!-font-size-16 sup_font_weight_700" for="pd-budgetcvl">Budget CVL</label>
                                <input class="govuk-input govuk-!-font-size-16" id="pd-budgetcvl" name="budgetcvl" type="text" readonly>
                            </div>
                            <div class="govuk-form-group">
                                <label class="govuk-label govuk-!-font-size-16 sup_font_weight_700" for="pd-caseworksub">Casework Sub</label>
                                <input class="govuk-input govuk-!-font-size-16" id="pd-caseworksub" name="caseworksub" type="text" readonly>
                            </div>
                            <div class="govuk-form-group">
                                <label class="govuk-label govuk-!-font-size-16 sup_font_weight_700" for="pd-costcentre">Cost Centre</label>
                                <input class="govuk-input govuk-!-font-size-16" id="pd-costcentre" name="costcentre" type="text" readonly>
                            </div>
                            <div class="govuk-form-group">
                                <label class="govuk-label govuk-!-font-size-16 sup_font_weight_700" for="pd-pvsincome">PVS Income</label>
                                <input class="govuk-input govuk-!-font-size-16" id="pd-pvsincome" name="pvsincome" type="text" readonly>
                            </div>
                            <div class="govuk-form-group">
                                <label class="govuk-label govuk-!-font-size-16 sup_font_weight_700" for="pd-oracleproject">Oracle Project</label>
                                <input class="govuk-input govuk-!-font-size-16" id="pd-oracleproject" name="oracleproject" type="text" readonly>
                            </div>
                            <div class="govuk-form-group">
                                <label class="govuk-label govuk-!-font-size-16 sup_font_weight_700" for="pd-plancasework">Plan Casework</label>
                                <input class="govuk-input govuk-!-font-size-16" id="pd-plancasework" name="plancasework" type="text" readonly>
                            </div>
                            <div class="govuk-form-group">
                                <label class="govuk-label govuk-!-font-size-16 sup_font_weight_700" for="pd-subaccountcod">Sub Account</label>
                                <input class="govuk-input govuk-!-font-size-16" id="pd-subaccountcod" name="subaccountcod" type="text" readonly>
                            </div>
                            <div class="govuk-form-group">
                                <label class="govuk-label govuk-!-font-size-16 sup_font_weight_700" for="pd-source">Source</label>
                                <input class="govuk-input govuk-!-font-size-16" id="pd-source" name="source" type="text" readonly>
                            </div>
                            <div class="govuk-form-group">
                                <label class="govuk-label govuk-!-font-size-16 sup_font_weight_700" for="pd-project-group">Project Group</label>
                                <input class="govuk-input govuk-!-font-size-16" id="pd-project-group" name="projectgroup" type="text" readonly>
                            </div>
                            <div class="govuk-form-group">
                                <div class="govuk-checkboxes govuk-checkboxes--small">
                                    <div class="govuk-checkboxes__item">
                                        <input class="govuk-checkboxes__input" id="pd-defraproject" name="defraproject" type="checkbox" disabled>
                                        <label class="govuk-label govuk-!-font-size-16 govuk-checkboxes__label sup_font_weight_700" for="pd-defraproject">Defra Project</label>
                                    </div>
                                </div>
                            </div>
                            <div class="govuk-form-group" style="grid-column: span 3;">
                                <label class="govuk-label govuk-!-font-size-16 sup_font_weight_700" for="pd-comments">Comments</label>
                                <textarea class="govuk-textarea govuk-!-font-size-16" id="pd-comments" name="comments" rows="2" readonly></textarea>
                            </div>

                        </fieldset>
                    </form>
                </div>

                <!-- ── Plan tab ──────────────────────────────────────────────────────────
                     Lazy-loaded: grids are rendered with empty data sets.
                     JS calls reloadGrid on first click and on filter change.          -->
                <div class="govuk-tabs__panel govuk-tabs__panel--hidden govuk-!-padding-2 min-height-380"
                     id="nav-plan" role="tabpanel" aria-labelledby="tab_nav-plan">
                    <div class="govuk-grid-row govuk-!-margin-bottom-3">

                        <!-- Staff Plan (top-left) -->
                        <div class="govuk-grid-column-one-half">
                            <div class="sup_border govuk-!-padding-3">
                                <div id="@($"gridContainer_{Model.PlanStaffGrid.GridId}")">
                                    @await Html.PartialAsync("_DataGrid", Model.PlanStaffGrid)
                                </div>
                                <div class="sup_total_footer">
                                    <span class="sup_total_footer__label">Total</span>
                                    <span id="planStaffGridTotalDisplay" class="sup_total_footer__value">£0.00</span>
                                </div>
                            </div>
                        </div>

                        <!-- Test Plan (top-right) -->
                        <div class="govuk-grid-column-one-half">
                            <div class="sup_border govuk-!-padding-3">
                                <div id="@($"gridContainer_{Model.PlanTestGrid.GridId}")">
                                    @await Html.PartialAsync("_DataGrid", Model.PlanTestGrid)
                                </div>
                                <div class="sup_total_footer">
                                    <span class="sup_total_footer__label">Total</span>
                                    <span id="planTestGridTotalDisplay" class="sup_total_footer__value">£0.00</span>
                                </div>
                            </div>
                        </div>

                    </div>
                    <div class="govuk-grid-row">

                        <!-- Animal Plan (bottom-left) -->
                        <div class="govuk-grid-column-one-half">
                            <div class="sup_border govuk-!-padding-3">

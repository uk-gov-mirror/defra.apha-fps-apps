@section Scripts {
<script>
    var plansGridId            = '@Model.AdditionalPlansGrid.GridId';
    var actualsGridId          = '@Model.AdditionalActualsGrid.GridId';
    var animalPlansGridId      = '@Model.AnimalPlansGrid.GridId';
    var animalActualsGridId    = '@Model.AnimalActualsGrid.GridId';
    var testPlansGridId        = '@Model.TestPlansGrid.GridId';
    var testActualsGridId      = '@Model.TestActualsGrid.GridId';
    var staffPlansGridId       = '@Model.StaffPlansGrid.GridId';
    var staffActualsGridId     = '@Model.StaffActualsGrid.GridId';
    var planStaffGridId        = '@Model.PlanStaffGrid.GridId';
    var planTestGridId         = '@Model.PlanTestGrid.GridId';
    var planAnimalGridId       = '@Model.PlanAnimalGrid.GridId';
    var planAdditionalGridId   = '@Model.PlanAdditionalGrid.GridId';
    var pactPayGridId          = '@Model.PactPayGrid.GridId';
    var monthlyPactGridId      = '@Model.MonthlyPactGrid.GridId';

    // ── Sidebar ──────────────────────────────────────────────────────
    function toggleSidebar() {
        document.querySelector('.sidenav').classList.toggle('collapsed');
    }

    function getYearCostsExtraFilters() {
        return {
            project: document.getElementById('dpprojectSelect').value,
            year:    document.getElementById('dpyear').value
        };
    }

    function getPlansGridManager()          { return window['gridManager_' + plansGridId]; }
    function getActualsGridManager()        { return window['gridManager_' + actualsGridId]; }
    function getAnimalPlansGridManager()    { return window['gridManager_' + animalPlansGridId]; }
    function getAnimalActualsGridManager()  { return window['gridManager_' + animalActualsGridId]; }
    function getTestPlansGridManager()      { return window['gridManager_' + testPlansGridId]; }
    function getTestActualsGridManager()    { return window['gridManager_' + testActualsGridId]; }
    function getStaffPlansGridManager()     { return window['gridManager_' + staffPlansGridId]; }
    function getStaffActualsGridManager()   { return window['gridManager_' + staffActualsGridId]; }
    function getPlanStaffGridManager()      { return window['gridManager_' + planStaffGridId]; }
    function getPlanTestGridManager()       { return window['gridManager_' + planTestGridId]; }
    function getPlanAnimalGridManager()     { return window['gridManager_' + planAnimalGridId]; }
    function getPlanAdditionalGridManager() { return window['gridManager_' + planAdditionalGridId]; }
    function getPactPayGridManager()        { return window['gridManager_' + pactPayGridId]; }
    function getMonthlyPactGridManager()   { return window['gridManager_' + monthlyPactGridId]; }

    function positionProjectPickerPanel() {
        var panel = document.getElementById('dpprojectSelectPanel');
        var display = document.getElementById('dpprojectSelectDisplay');
        if (!panel || !display) return;

        panel.style.top = 'calc(100% + 2px)';
        panel.style.bottom = 'auto';

        var rect = display.getBoundingClientRect();
        var viewportHeight = window.innerHeight || document.documentElement.clientHeight;
        var spaceBelow = viewportHeight - rect.bottom - 12;
        var spaceAbove = rect.top - 12;
        var preferredHeight = 240;

        if (spaceBelow < preferredHeight && spaceAbove > spaceBelow) {
            panel.style.top = 'auto';
            panel.style.bottom = 'calc(100% + 2px)';
            panel.style.maxHeight = Math.max(120, Math.min(preferredHeight, spaceAbove)) + 'px';
        } else {
            panel.style.maxHeight = Math.max(120, Math.min(preferredHeight, spaceBelow)) + 'px';
        }
    }

    function toggleProjectPicker(forceOpen) {
        var panel = document.getElementById('dpprojectSelectPanel');
        var display = document.getElementById('dpprojectSelectDisplay');
        if (!panel || !display) return;

        var shouldOpen = typeof forceOpen === 'boolean' ? forceOpen : panel.hidden;
        panel.hidden = !shouldOpen;
        display.setAttribute('aria-expanded', shouldOpen ? 'true' : 'false');

        if (shouldOpen) {
            positionProjectPickerPanel();
        }
    }

    function selectProjectPickerOption(value, text) {
        var hidden = document.getElementById('dpprojectSelect');
        var display = document.getElementById('dpprojectSelectDisplay');
        if (!hidden || !display) return;

        hidden.value = value || '';
        display.textContent = text || 'Select a Project';
        toggleProjectPicker(false);
        hidden.dispatchEvent(new Event('change'));
    }


    function syncPactPayFooterColumns() {
        // Read the actual rendered widths from the grid header <th> elements
        // and apply them to the footer table colgroup so totals align exactly.
        var gridContainer = document.getElementById('gridContainer_' + pactPayGridId);
        if (!gridContainer) return;
        var headerCells = gridContainer.querySelectorAll('table thead tr:first-child th');
        if (!headerCells || headerCells.length === 0) return;

        var cols = document.querySelectorAll('#pactPayFooterColgroup col');
        var totalWidth = 0;
        headerCells.forEach(function (th) { totalWidth += th.offsetWidth; });
        if (totalWidth === 0) return;

        headerCells.forEach(function (th, i) {
            if (cols[i]) {
                cols[i].style.width = ((th.offsetWidth / totalWidth) * 100).toFixed(2) + '%';
            }
        });
    }

    function refreshPactPayTotals() {
        var project = document.getElementById('dpprojectSelect').value;
        var year    = document.getElementById('dpyear').value;
        if (!project || !year) return;

        $.get('/PIMS/ProjectYearCosts/GetPactPayTotals', { project: project, year: year })
            .done(function (data) {
                document.getElementById('pactPayTotalPay').textContent        = data.payTotal;
                document.getElementById('pactPayTotalNonPay').textContent     = data.nonPayTotal;
                document.getElementById('pactPayTotalOverhead').textContent   = data.overheadTotal;
                document.getElementById('pactPayTotalStaffCosts').textContent = data.staffCostsTotal;
            });
    }

    function refreshPlanTotals() {
        var project = document.getElementById('dpprojectSelect').value;
        var year    = document.getElementById('dpyear').value;
        if (!project || !year) return;

        $.get('/PIMS/ProjectYearCosts/GetPlanTotals', { project: project, year: year })
            .done(function (data) {
                document.getElementById('planStaffGridTotalDisplay').textContent      = data.staffTotal;
                document.getElementById('planTestGridTotalDisplay').textContent       = data.testTotal;
                document.getElementById('planAnimalGridTotalDisplay').textContent     = data.animalTotal;
                document.getElementById('planAdditionalGridTotalDisplay').textContent = data.additionalTotal;
            });
    }

    function refreshMonthlyPactTotals() {
        var project = document.getElementById('dpprojectSelect').value;
        var year    = document.getElementById('dpyear').value;
        if (!project || !year) return;

        $.get('/PIMS/ProjectYearCosts/GetMonthlyPactTotals', { project: project, year: year })
            .done(function (data) {
                document.getElementById('mpp-total-proj-specific').textContent = data.totalNonAnimals;
                document.getElementById('mpp-total-animals').textContent       = data.totalAnimals;
                document.getElementById('mpp-total-timecosts').textContent     = data.totalTimeCosts;
                document.getElementById('mpp-total-transfercosts').textContent    = data.totalTransferCosts;
                document.getElementById('mpp-total-total-costs').textContent   = data.totalCost;
                document.getElementById('mpp-total-total-hours').textContent   = data.totalHours;
                document.getElementById('mpp-total-invoices').textContent      = data.totalInvoices;
                document.getElementById('mpp-total-coiw').textContent          = data.totalCoiw;
            });
    }

    function refreshMonthlyPactFpsPlanned() {
        var project = document.getElementById('dpprojectSelect').value;
        var year    = document.getElementById('dpyear').value;
        if (!project || !year) return;

        $.get('/PIMS/ProjectYearCosts/GetMonthlyPactFpsPlanned', { project: project, year: year })
            .done(function (data) {
                document.getElementById('fps-staff-costs').textContent      = data.staffCosts;
                document.getElementById('fps-test-costs').textContent       = data.testCosts;
                document.getElementById('fps-exceptional-costs').textContent= data.exceptionalCosts;
                document.getElementById('fps-animal-costs').textContent     = data.animalCosts;
                document.getElementById('fps-total-costs').textContent      = data.totalCosts;
                document.getElementById('fps-cust-income').textContent      = data.custIncome;
                document.getElementById('fps-total-income').textContent     = data.totalIncome;
                document.getElementById('fps-budget-vla').textContent       = data.budgetVla;
                document.getElementById('fps-total-cost-pct').value         = data.totalCostPct;
            });
    }

    function refreshPlanVsActualsTotals() {
        var project = document.getElementById('dpprojectSelect').value;
        var year    = document.getElementById('dpyear').value;
        if (!project || !year) return;

        $.get('/PIMS/ProjectYearCosts/GetPlanVsActualsTotals', { project: project, year: year })
            .done(function (data) {
                document.getElementById('staffPlansTotalDisplay').textContent        = data.staffPlansTotal;
                document.getElementById('staffActualsTotalDisplay').textContent      = data.staffActualsTotal;
                document.getElementById('testPlansTotalDisplay').textContent         = data.testPlansTotal;
                document.getElementById('testActualsTotalDisplay').textContent       = data.testActualsTotal;
                document.getElementById('animalPlansTotalDisplay').textContent       = data.animalPlansTotal;
                document.getElementById('animalActualsTotalDisplay').textContent     = data.animalActualsTotal;
                document.getElementById('additionalCostPlansTotalDisplay').textContent = data.additionalPlansTotal;
                document.getElementById('additionalActualsTotalDisplay').textContent = data.additionalActualsTotal;
            });
    }

    // Only the first tab (Monthly Pact Data) is server-rendered; all others are lazy-loaded.
    // Tabs are marked true once visited so filter changes also refresh them.
    var loadedTabs = {
        'nav-monthlyPact':     true,
        'nav-pact-pay':        false,
        'nav-project-details': false,
        'nav-plan':            false,
        'nav-staff-plan':      false,
        'nav-test-plan':       false,
        'nav-animal-plan':     false,
        'nav-additional-cost': false
    };
    // ── Panel visibility ──────────────────────────────────────────────────
    function showPanel(panelId) {
        document.querySelectorAll('.govuk-tabs__panel').forEach(function (p) {
            if (p.id === panelId) {
                p.classList.remove('govuk-tabs__panel--hidden');
                p.style.display = 'block';
            } else {
                p.classList.add('govuk-tabs__panel--hidden');
                p.style.display = 'none';
            }
        });

        document.querySelectorAll('.govuk-tabs__list-item').forEach(function (li) {
            li.classList.remove('govuk-tabs__list-item--selected');
        });
        var activeLink = document.querySelector('.govuk-tabs__tab[aria-controls="' + panelId + '"]');
        if (activeLink) {
            activeLink.closest('.govuk-tabs__list-item').classList.add('govuk-tabs__list-item--selected');
        }
    }

    function refreshActiveTab() {
        var activePanel = document.querySelector('.govuk-tabs__panel:not(.govuk-tabs__panel--hidden)');
        if (!activePanel) return;
        refreshTabById(activePanel.id);
    }

    function loadProjectDetails(project, year) {
        if (!project || !year) return;
        $.get('/PIMS/ProjectYearCosts/GetProjectYearDetails', { project: project, year: year })
            .done(function (r) {
                document.getElementById('pd-year').value           = r.year              ?? '';
                document.getElementById('pd-project').value        = r.parentproject     ?? '';
                document.getElementById('pd-manager').value        = r.manager           ?? '';
                document.getElementById('pd-disease').value        = r.disease           ?? '';
                document.getElementById('pd-contract').value       = r.contract          ?? '';
                document.getElementById('pd-finished').value       = r.finished          ?? '';
                document.getElementById('pd-transferincome').value = r.transferincome    ?? '';
                document.getElementById('pd-custincome').value     = r.custincome        ?? '';
                document.getElementById('pd-feecost').value        = r.feccost           ?? '';
                document.getElementById('pd-profit').value         = r.profit            ?? '';
                document.getElementById('pd-carryover').value      = r.carryover         ?? '';
                document.getElementById('pd-budgetcvl').value      = r.budgetcvl         ?? '';
                document.getElementById('pd-caseworksub').value    = r.caseworksub       ?? '';
                document.getElementById('pd-costcentre').value     = r.costcentre        ?? '';
                document.getElementById('pd-pvsincome').value      = r.pvsincome         ?? '';
                document.getElementById('pd-oracleproject').value  = r.oracleprojectcode ?? '';
                document.getElementById('pd-plancasework').value   = r.plancaseworkdebit ?? '';
                document.getElementById('pd-subaccountcod').value  = r.subaccountcode    ?? '';
                document.getElementById('pd-source').value         = r.source            ?? '';
                document.getElementById('pd-project-group').value  = r.projectgroup      ?? '';
                // Access Yes/No stores -1 for True, 0 for False (smallint)
                document.getElementById('pd-defraproject').checked = r.isdefraproject === -1;
                document.getElementById('pd-comments').value       = r.comments          ?? '';
            });
    }

    function refreshTabById(tabId) {
        var project = document.getElementById('dpprojectSelect').value;
        var year    = document.getElementById('dpyear').value;
        if (!project || !year) return;

        if (tabId === 'nav-project-details') {
            loadProjectDetails(project, year);
        } else if (tabId === 'nav-monthlyPact') {
            var monthlyPactGm = getMonthlyPactGridManager();
            if (monthlyPactGm) monthlyPactGm.reloadGrid({ page: 1 });
            refreshMonthlyPactTotals();
            refreshMonthlyPactFpsPlanned();
        } else if (tabId === 'nav-additional-cost') {
            var plansGm   = getPlansGridManager();
            var actualsGm = getActualsGridManager();
            if (plansGm)   plansGm.reloadGrid({ page: 1 });
            if (actualsGm) actualsGm.reloadGrid({ page: 1 });
            refreshPlanVsActualsTotals();
        } else if (tabId === 'nav-animal-plan') {
            var animalPlansGm   = getAnimalPlansGridManager();
            var animalActualsGm = getAnimalActualsGridManager();
            if (animalPlansGm)   animalPlansGm.reloadGrid({ page: 1 });
            if (animalActualsGm) animalActualsGm.reloadGrid({ page: 1 });
            refreshPlanVsActualsTotals();
        } else if (tabId === 'nav-test-plan') {
            var testPlansGm   = getTestPlansGridManager();
            var testActualsGm = getTestActualsGridManager();
            if (testPlansGm)   testPlansGm.reloadGrid({ page: 1 });
            if (testActualsGm) testActualsGm.reloadGrid({ page: 1 });
            refreshPlanVsActualsTotals();
        } else if (tabId === 'nav-staff-plan') {
            var staffPlansGm   = getStaffPlansGridManager();
            var staffActualsGm = getStaffActualsGridManager();
            if (staffPlansGm)   staffPlansGm.reloadGrid({ page: 1 });
            if (staffActualsGm) staffActualsGm.reloadGrid({ page: 1 });
            refreshPlanVsActualsTotals();
        } else if (tabId === 'nav-pact-pay') {
            var pactPayGm = getPactPayGridManager();
            if (pactPayGm) pactPayGm.reloadGrid({ page: 1 });
            refreshPactPayTotals();
            setTimeout(syncPactPayFooterColumns, 400);
        } else if (tabId === 'nav-plan') {
            var planStaffGm      = getPlanStaffGridManager();
            var planTestGm       = getPlanTestGridManager();
            var planAnimalGm     = getPlanAnimalGridManager();
            var planAdditionalGm = getPlanAdditionalGridManager();
            if (planStaffGm)      planStaffGm.reloadGrid({ page: 1 });
            if (planTestGm)       planTestGm.reloadGrid({ page: 1 });
            if (planAnimalGm)     planAnimalGm.reloadGrid({ page: 1 });
            if (planAdditionalGm) planAdditionalGm.reloadGrid({ page: 1 });
            refreshPlanTotals();
        }
    }

    document.addEventListener('DOMContentLoaded', function () {
        var projectPickerDisplay = document.getElementById('dpprojectSelectDisplay');
        var projectPickerPanel = document.getElementById('dpprojectSelectPanel');

        if (projectPickerDisplay && projectPickerPanel) {
            projectPickerDisplay.addEventListener('click', function (e) {
                e.stopPropagation();
                toggleProjectPicker();
            });

            window.addEventListener('resize', function () {
                if (!projectPickerPanel.hidden) {
                    positionProjectPickerPanel();
                }
            });

            window.addEventListener('scroll', function () {
                if (!projectPickerPanel.hidden) {
                    positionProjectPickerPanel();
                }
            }, true);

            projectPickerPanel.addEventListener('click', function (e) {
                var option = e.target.closest('.pims-project-picker__option');
                if (!option) return;
                selectProjectPickerOption(option.getAttribute('data-value'), option.getAttribute('data-text'));
            });

            document.addEventListener('click', function (e) {
                if (!e.target.closest('.pims-project-picker')) {
                    toggleProjectPicker(false);
                }
            });
        }

        localStorage.removeItem('monthlyPactGrid_colWidths');

        // ── Wire up tab clicks ────────────────────────────────────────────
        document.querySelectorAll('.govuk-tabs__tab').forEach(function (link) {
            link.addEventListener('click', function (e) {
                e.preventDefault();
                var panelId = this.getAttribute('aria-controls');
                if (!panelId) return;

                showPanel(panelId);

                // Mark as loaded on first visit so filter changes also refresh it
                if (!loadedTabs[panelId]) {
                    loadedTabs[panelId] = true;
                }
                refreshTabById(panelId);
            });
        });

            // ── On arrival, honour the URL hash or default to monthlyPact ─
            var hash = window.location.hash ? window.location.hash.substring(1) : 'nav-monthlyPact';
        var targetPanel = document.getElementById(hash);
            var defaultPanel = hash && targetPanel ? hash : 'nav-monthlyPact';

        document.querySelectorAll('.govuk-tabs__panel').forEach(function (p) {
            p.classList.add('govuk-tabs__panel--hidden');
            p.style.display = 'none';
        });
        showPanel(defaultPanel);

        if (loadedTabs[defaultPanel]) {
            setTimeout(function () { refreshTabById(defaultPanel); }, 300);
        }
    });

    document.getElementById('dpprojectSelect').addEventListener('change', refreshActiveTab);
    document.getElementById('dpyear').addEventListener('change', refreshActiveTab);

    document.getElementById('btnExport').addEventListener('click', function () {
        var project = document.getElementById('dpprojectSelect').value;
        var year    = document.getElementById('dpyear').value;
        if (!project || !year) {
            alert('Please select a project and year before exporting.');
            return;
        }
        window.location.href = '/PIMS/ProjectYearCosts/ExportToExcel?project=' +
            encodeURIComponent(project) + '&year=' + encodeURIComponent(year);
    });
</script>
}

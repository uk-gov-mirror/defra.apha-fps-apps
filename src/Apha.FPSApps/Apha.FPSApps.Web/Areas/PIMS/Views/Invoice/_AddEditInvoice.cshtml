@model Apha.FPSApps.Web.Areas.PIMS.Models.InvoiceItem

@{
    bool isAddingNew = ViewBag.IsAddingNew == true;
    string modalTitle  = isAddingNew ? "Add Invoice"    : "Edit Invoice";
    string saveLabel   = isAddingNew ? "Save"           : "Update";
}

<div id="editInvoiceModal" class="govuk-edit-modal" role="dialog" aria-modal="true" aria-labelledby="editInvoiceModalTitle">
    <div class="govuk-edit-modal-dialog" style="max-width: 640px;">

        <div class="govuk-edit-modal__header">
            <h3 class="govuk-edit-modal__title" id="editInvoiceModalTitle">@modalTitle</h3>
            <button type="button" onclick="closeInvoiceModal()"
                    class="govuk-edit-modal__close-btn"
                    aria-label="Close">&#x2715;</button>
        </div>

        <div class="govuk-edit-modal__body">
            <form id="editInvoiceForm" novalidate>
                @Html.AntiForgeryToken()

               
                <input type="hidden" asp-for="InvoiceCounter" />
                <input type="hidden" name="IsAddingNew" value="@(isAddingNew ? "true" : "false")" />

              
                <div class="govuk-error-summary" role="alert"
                     aria-labelledby="editInvoiceErrorTitle" tabindex="-1" style="display: none;">
                    <h2 class="govuk-error-summary__title" id="editInvoiceErrorTitle">
                        There is a problem
                    </h2>
                    <div class="govuk-error-summary__body">
                        <ul class="govuk-list govuk-error-summary__list"></ul>
                    </div>
                </div>

                @* ── Field 1: Project (select) ─────────────────────────────── *@
               
                <div class="govuk-form-group sup_margin_bottom_10">
                    <label class="govuk-label govuk-!-font-weight-bold govuk-!-font-size-16"
                           asp-for="Project">
                        Project:
                    </label>
                    <select class="govuk-select govuk-!-font-size-16 sup_select_option_width_100"
                            asp-for="Project"
                            asp-items="ViewBag.ProjectList"
                            aria-label="Select project"
                            aria-required="true">
                        <option value="">-- Select --</option>
                    </select>
                    <span asp-validation-for="Project" class="govuk-error-message" style="display:none;"></span>
                </div>

                @* ── Field 2: Contract (select) ──────────────────────────── *@
                <div class="govuk-form-group sup_margin_bottom_10">
                    <label class="govuk-label govuk-!-font-weight-bold govuk-!-font-size-16"
                           asp-for="Contract">
                        Contract:
                    </label>
                    <select class="govuk-select govuk-!-font-size-16 sup_select_option_width_100"
                            asp-for="Contract"
                            asp-items="ViewBag.ContractList"
                            aria-label="Select contract">
                        <option value="">-- Select --</option>
                    </select>
                    <span asp-validation-for="Contract" class="govuk-error-message" style="display:none;"></span>
                </div>

                @* ── Field 3: Planned Amount (currency) ────────────────────── *@
               
                <div class="govuk-form-group sup_margin_bottom_10">
                    <label class="govuk-label govuk-!-font-weight-bold govuk-!-font-size-16"
                           asp-for="PlannedAmount">
                        Planned Amount:
                    </label>
                    <div class="govuk-input__wrapper">
                        <div class="govuk-input__prefix" aria-hidden="true">£</div>
                        <input class="govuk-input  govuk-!-font-size-16"
                               asp-for="PlannedAmount"
                               type="text"
                               aria-label="Planned amount" />
                    </div>
                    <span asp-validation-for="PlannedAmount" class="govuk-error-message" style="display:none;"></span>
                </div>

                @* ── Field 4: Amount Due (currency) ────────────────────────── *@
                <div class="govuk-form-group sup_margin_bottom_10">
                    <label class="govuk-label govuk-!-font-weight-bold govuk-!-font-size-16"
                           asp-for="DueAmount">
                        Amount Due:
                    </label>
                    <div class="govuk-input__wrapper">
                        <div class="govuk-input__prefix" aria-hidden="true">£</div>
                        <input class="govuk-input  govuk-!-font-size-16"
                               asp-for="DueAmount"
                               type="text"
                               aria-label="Amount due" />
                    </div>
                    <span asp-validation-for="DueAmount" class="govuk-error-message" style="display:none;"></span>
                </div>

                @* ── Field 5: Date Due (date) ──────────────────────────────── *@
                <div class="govuk-form-group sup_margin_bottom_10">
                    <label class="govuk-label govuk-!-font-weight-bold govuk-!-font-size-16"
                           asp-for="DueDate">
                        Date Due: <span class="sup_color_red">*</span>
                    </label>
                    <div style="position:relative; display:flex; align-items:center; width:100%;">
                        <input type="text"
                               id="DueDateDisplay"
                               class="govuk-input govuk-!-font-size-16"
                               value="@Model.DueDate?.ToString("dd/MM/yyyy")"
                               placeholder="dd/mm/yyyy"
                               maxlength="10"
                               autocomplete="off"
                               aria-label="Date due, format dd/mm/yyyy"
                               oninput="formatDateInput(this)"
                               onblur="validateAndSyncDate('DueDateDisplay', 'DueDateBinding', 'DueDateError')"
                               style="flex:1;">
                        <button type="button"
                                onclick="openDatePicker('DueDatePicker')"
                                style="margin-left:4px; padding:6px 10px; cursor:pointer; background:#f3f2f1; border:2px solid #0b0c0c; font-size:1rem; line-height:1;"
                                aria-label="Open date picker for Date Due">&#128197;</button>
                        <input type="hidden"
                               name="DueDate"
                               id="DueDateBinding"
                               required
                               data-val="true"
                               data-val-required="Date Due is required"
                               aria-label="Date due hidden value"
                               value="@(Model.DueDate.HasValue ? Model.DueDate.Value.ToString("yyyy-MM-dd") : string.Empty)">
                        <input type="date"
                               id="DueDatePicker"
                               value="@(Model.DueDate.HasValue ? Model.DueDate.Value.ToString("yyyy-MM-dd") : string.Empty)"
                               style="position:absolute; top:0; left:0; opacity:0; width:1px; height:1px; pointer-events:auto;"
                               aria-label="Date due date picker"
                               onchange="syncDateToText('DueDatePicker', 'DueDateDisplay', 'DueDateBinding', 'DueDateError')">
                    </div>
                    <span id="DueDateError" class="govuk-error-message" style="display:none;"></span>
                    <span asp-validation-for="DueDate" class="govuk-error-message" style="display:none;"></span>
                </div>

                @* ── Field 6: Amount Invoiced (currency) ───────────────────── *@
                <div class="govuk-form-group sup_margin_bottom_10">
                    <label class="govuk-label govuk-!-font-weight-bold govuk-!-font-size-16"
                           asp-for="ActualAmount">
                        Amount Invoiced:
                    </label>
                    <div class="govuk-input__wrapper">
                        <div class="govuk-input__prefix" aria-hidden="true">£</div>
                        <input class="govuk-input govuk-!-font-size-16"
                               asp-for="ActualAmount"
                               type="text" />
                    </div>
                    <span asp-validation-for="ActualAmount" class="govuk-error-message" style="display:none;"></span>
                </div>

                @* ── Field 7: Date JS Raised (date) ────────────────────────── *@
                <div class="govuk-form-group sup_margin_bottom_10">
                    <label class="govuk-label govuk-!-font-weight-bold govuk-!-font-size-16"
                           asp-for="DateJobsheetRaised">
                        Date JS Raised:
                    </label>
                    <div style="position:relative; display:flex; align-items:center; width:100%;">
                        <input type="text"
                               id="DateJobsheetRaisedDisplay"
                               class="govuk-input govuk-!-font-size-16"
                               value="@Model.DateJobsheetRaised?.ToString("dd/MM/yyyy")"
                               placeholder="dd/mm/yyyy"
                               maxlength="10"
                               autocomplete="off"
                               oninput="formatDateInput(this)"
                               aria-label="Date Jobsheet Raised Display"
                               onblur="validateAndSyncDate('DateJobsheetRaisedDisplay', 'DateJobsheetRaisedBinding', 'DateJobsheetRaisedError')"
                               style="flex:1;">
                        <button type="button"
                                onclick="openDatePicker('DateJobsheetRaisedPicker')"
                                style="margin-left:4px; padding:6px 10px; cursor:pointer; background:#f3f2f1; border:2px solid #0b0c0c; font-size:1rem; line-height:1;"
                                aria-label="Open date picker for Date JS Raised">&#128197;</button>
                        <input type="hidden"
                               name="DateJobsheetRaised"
                               id="DateJobsheetRaisedBinding"
                               aria-label="Date Jobsheet Raised Picker"
                               value="@(Model.DateJobsheetRaised.HasValue ? Model.DateJobsheetRaised.Value.ToString("yyyy-MM-dd") : string.Empty)">
                        <input type="date"
                               id="DateJobsheetRaisedPicker"
                               aria-label="Date Jobsheet Raised Picker"
                               value="@(Model.DateJobsheetRaised.HasValue ? Model.DateJobsheetRaised.Value.ToString("yyyy-MM-dd") : string.Empty)"
                               style="position:absolute; top:0; left:0; opacity:0; width:1px; height:1px; pointer-events:auto;"
                               onchange="syncDateToText('DateJobsheetRaisedPicker', 'DateJobsheetRaisedDisplay', 'DateJobsheetRaisedBinding', 'DateJobsheetRaisedError')">
                    </div>
                    <span id="DateJobsheetRaisedError" class="govuk-error-message" style="display:none;"></span>
                    <span asp-validation-for="DateJobsheetRaised" class="govuk-error-message" style="display:none;"></span>
                </div>

                @* ── Field 8: Invoice Ref (text) ───────────────────────────── *@
                <div class="govuk-form-group sup_margin_bottom_10">
                    <label class="govuk-label govuk-!-font-weight-bold govuk-!-font-size-16"
                           asp-for="InvoiceRef">
                        Invoice Ref:
                    </label>
                    <input class="govuk-input govuk-!-font-size-16"
                           asp-for="InvoiceRef"
                           type="text" />
                    <span asp-validation-for="InvoiceRef" class="govuk-error-message" style="display:none;"></span>
                </div>

                @* ── Field 9: Paid? (checkbox) ─────────────────────────────── *@
                <div class="govuk-form-group sup_margin_bottom_10">
                    <div class="govuk-checkboxes govuk-checkboxes--small" data-module="govuk-checkboxes">
                        <div class="govuk-checkboxes__item">
                            <input class="govuk-checkboxes__input govuk-!-font-size-16"
                                   id="invModalPaid"
                                   name="InvoicePaid"
                                   type="checkbox"
                                   value="-1"
                                   @(Model.InvoicePaid == -1 ? "checked" : "") />
                            <label class="govuk-label govuk-checkboxes__label sup_label_auto_width govuk-!-font-weight-bold"
                                   for="invModalPaid">
                                Paid?
                            </label>
                            <input type="hidden" name="InvoicePaid" value="0" />
                        </div>
                    </div>
                </div>

                @* ── Field 10: Date Invoiced (date) ────────────────────────── *@
                <div class="govuk-form-group sup_margin_bottom_10">
                    <label class="govuk-label govuk-!-font-weight-bold govuk-!-font-size-16"
                           asp-for="DateInvoiced">
                        Date Invoiced:
                    </label>
                    <div style="position:relative; display:flex; align-items:center; width:100%;">
                        <input type="text"
                               id="DateInvoicedDisplay"
                               class="govuk-input govuk-!-font-size-16"
                               value="@Model.DateInvoiced?.ToString("dd/MM/yyyy")"
                               placeholder="dd/mm/yyyy"
                               aria-label="Date Invoiced Display"
                               maxlength="10"
                               autocomplete="off"
                               oninput="formatDateInput(this)"
                               onblur="validateAndSyncDate('DateInvoicedDisplay', 'DateInvoicedBinding', 'DateInvoicedError')"
                               style="flex:1;">
                        <button type="button"
                                onclick="openDatePicker('DateInvoicedPicker')"
                                style="margin-left:4px; padding:6px 10px; cursor:pointer; background:#f3f2f1; border:2px solid #0b0c0c; font-size:1rem; line-height:1;"
                                aria-label="Open date picker for Date Invoiced">&#128197;</button>
                        <input type="hidden"
                               name="DateInvoiced"
                               id="DateInvoicedBinding"
                               value="@(Model.DateInvoiced.HasValue ? Model.DateInvoiced.Value.ToString("yyyy-MM-dd") : string.Empty)">
                        <input type="date"
                               id="DateInvoicedPicker"
                               aria-label="Date Invoiced Picker"
                               value="@(Model.DateInvoiced.HasValue ? Model.DateInvoiced.Value.ToString("yyyy-MM-dd") : string.Empty)"
                               style="position:absolute; top:0; left:0; opacity:0; width:1px; height:1px; pointer-events:auto;"
                               onchange="syncDateToText('DateInvoicedPicker', 'DateInvoicedDisplay', 'DateInvoicedBinding', 'DateInvoicedError')">
                    </div>
                    <span id="DateInvoicedError" class="govuk-error-message" style="display:none;"></span>
                    <span asp-validation-for="DateInvoiced" class="govuk-error-message" style="display:none;"></span>
                </div>

            </form>
        </div>

        @* ── Footer: Cancel / Save / Update ─────────────────────────────── *@
        <div class="govuk-edit-modal__footer"
             style="display: flex; justify-content: space-between; align-items: center;">
            <button type="button"
                    class="govuk-button govuk-button--secondary sup_margin_0 govuk-!-font-size-16"
                    onclick="closeInvoiceModal()">
                Cancel
            </button>
            <button type="button"
                    class="govuk-button sup_margin_0 govuk-!-font-size-16"
                    id="invSaveBtn"
                    onclick="saveInvoice()">
                @saveLabel
            </button>
        </div>

    </div>
</div>

<script>
    function openDatePicker(pickerId) {
        var picker = document.getElementById(pickerId);
        if (picker) {
            try { picker.showPicker(); } catch (e) { picker.click(); }
        }
    }

    function syncDateToText(pickerId, displayId, hiddenId, errorId) {
        var picker = document.getElementById(pickerId);
        if (picker.value) {
            var parts = picker.value.split('-');
            document.getElementById(displayId).value = parts[2] + '/' + parts[1] + '/' + parts[0];
            document.getElementById(hiddenId).value = picker.value;
        } else {
            document.getElementById(displayId).value = '';
            document.getElementById(hiddenId).value = '';
        }
        if (errorId) {
            var err = document.getElementById(errorId);
            if (err) { err.style.display = 'none'; err.textContent = ''; }
        }
    }

    function formatDateInput(input) {
        // Allow only digits and / or - separators; strip everything else and cap at 10 chars.
        // No auto-slash insertion so the user can freely type any format (e.g. yyyy/mm/dd)
        // and validateAndSyncDate will catch the wrong format on blur.
        var val = input.value.replace(/[^\d\/\-]/g, '');
        if (val.length > 10) val = val.substring(0, 10);
        input.value = val;
    }

    function validateAndSyncDate(displayId, hiddenId, errorId) {
        var display = document.getElementById(displayId);
        var hidden  = document.getElementById(hiddenId);
        var errorEl = document.getElementById(errorId);
        var val = display.value.trim();

        if (!val) {
            hidden.value = '';
            errorEl.style.display = 'none';
            errorEl.textContent = '';
            return;
        }

        // Detect yyyy/mm/dd or yyyy-mm-dd entered by mistake
        if (/^\d{4}[\/\-]\d{2}[\/\-]\d{2}$/.test(val)) {
            hidden.value = '';
            errorEl.textContent = 'Enter the date in dd/mm/yyyy format, not yyyy/mm/dd';
            errorEl.style.display = 'block';
            return;
        }

        // Detect mm/dd/yyyy (US format): if the second segment > 12 it cannot be a month
        var usMatch = val.match(/^(\d{2})\/(\d{2})\/(\d{4})$/);
        if (usMatch && parseInt(usMatch[2], 10) > 12) {
            hidden.value = '';
            errorEl.textContent = 'Enter the date in dd/mm/yyyy format, not mm/dd/yyyy';
            errorEl.style.display = 'block';
            return;
        }

        var match = val.match(/^(\d{2})\/(\d{2})\/(\d{4})$/);
        if (!match) {
            hidden.value = '';
            errorEl.textContent = 'Enter the date in dd/mm/yyyy format';
            errorEl.style.display = 'block';
            return;
        }

        var day   = parseInt(match[1], 10);
        var month = parseInt(match[2], 10);
        var year  = parseInt(match[3], 10);
        var date  = new Date(year, month - 1, day);

        if (date.getFullYear() !== year || date.getMonth() !== (month - 1) || date.getDate() !== day) {
            hidden.value = '';
            errorEl.textContent = 'Enter a valid date in dd/mm/yyyy format';
            errorEl.style.display = 'block';
            return;
        }

        var mm = String(month).padStart(2, '0');
        var dd = String(day).padStart(2, '0');
        hidden.value = year + '-' + mm + '-' + dd;
        errorEl.style.display = 'none';
        errorEl.textContent = '';
    }
</script>


@using Apha.FPSApps.Web.Models.Components.DataGrid
@model Apha.FPSApps.Web.Areas.PIMS.Models.InvoiceViewModel

@{
    ViewData["Title"] = "PIMS : Invoices";
}

<div class="govuk-grid-row sup_border-bottom govuk-!-margin-bottom-1 govuk-!-padding-0">
    <h5 class="govuk-heading-s sup_margin_0 govuk-!-padding-top-2 govuk-!-padding-right-0 govuk-!-padding-bottom-1 govuk-!-padding-left-5">
        Invoices
    </h5>
</div>

<div class="sup_flex">

    <main class="main-content govuk-!-padding-top-0 sup_overflow_hidden">

        <div class="govuk-grid-row">
            <div class="govuk-grid-column-full">

                <!-- ── Filter toolbar ──────────────────────────────────────── -->
               
                <div class="inv-toolbar">
                    <div class="inv-toolbar__row">
                        <div class="inv-toolbar__item govuk-!-margin-left-1 govuk-!-margin-right-2 ">
                            <span class="govuk-label govuk-!-font-size-19 govuk-!-font-weight-bold">Filter</span>
                        </div>

                        @* Filter 1: Project *@
                        <div class="inv-toolbar__item">
                            <label class="govuk-label govuk-!-font-size-16" for="invFilterProject">Project</label>
                            <select class="govuk-select govuk-!-font-size-16 sup_select_option_width_100"
                                    id="invFilterProject"
                                    onchange="onInvProjectChange()"
                                    aria-label="Filter by project">
                                <option value="">       </option>
                                @foreach (var item in Model.ProjectList)
                                {
                                    if (item.Selected)
                                    {
                                        <option value="@item.Value" selected>@item.Text</option>
                                    }
                                    else
                                    {
                                        <option value="@item.Value">@item.Text</option>
                                    }
                                }
                            </select>
                        </div>

                        @* Filter 2: Surv Contract *@
                       
                        <div class="inv-toolbar__item">
                            <label class="govuk-label govuk-!-font-size-16" for="invFilterSurvContract">Surv Contract</label>
                            <select class="govuk-select govuk-!-font-size-16 sup_select_option_width_100"
                                    id="invFilterSurvContract"
                                    onchange="onInvContractChange()"
                                    aria-label="Filter by surveillance contract">
                                <option value="">       </option>
                                @foreach (var item in Model.ContractList)
                                {
                                    if (item.Value == Model.FilterContract)
                                    {
                                        <option value="@item.Value" selected>@item.Text</option>
                                    }
                                    else
                                    {
                                        <option value="@item.Value">@item.Text</option>
                                    }
                                }
                            </select>
                        </div>

                        @* Filter 3: Year *@
                        <div class="inv-toolbar__item">
                            <label class="govuk-label govuk-!-font-size-16" for="invFilterYear">Year</label>
                            <select class="govuk-select govuk-!-font-size-16 sup_select_option_width_100"
                                    id="invFilterYear"
                                    onchange="applyInvoiceFilters()"
                                    aria-label="Filter by year">
                                <option value="">       </option>
                                @foreach (var item in Model.YearList)
                                {
                                    if (item.Selected)
                                    {
                                        <option value="@item.Value" selected>@item.Text</option>
                                    }
                                    else
                                    {
                                        <option value="@item.Value">@item.Text</option>
                                    }
                                }
                            </select>
                        </div>

                        @* Filter 4: Program *@
                        
                        <div class="inv-toolbar__item">
                            <label class="govuk-label govuk-!-font-size-16" for="invFilterProgram">Program</label>
                            <select class="govuk-select govuk-!-font-size-16 sup_select_option_width_100"
                                    id="invFilterProgram"
                                    onchange="onInvProgramChange()"
                                    aria-label="Filter by program">
                                <option value="">       </option>
                                @foreach (var item in Model.ProgramList)
                                {
                                    if (item.Value == Model.FilterProgram)
                                    {
                                        <option value="@item.Value" selected>@item.Text</option>
                                    }
                                    else
                                    {
                                        <option value="@item.Value">@item.Text</option>
                                    }
                                }
                            </select>
                        </div>


                    </div>
                </div>

                <!-- ── Invoices grid ────────────────────────────────────────── -->
                <div class="govuk-grid-row sup_margin_left_right_0" style="margin-top: 8px;">
                    <div class="govuk-grid-column-full">

                        <div id="gridContainer_invoicesGrid">
                            @await Html.PartialAsync("_DataGrid", Model.InvoicesGrid)
                        </div>

                    </div>

                </div>
                <!-- ── Totals row — separate row below the grid (outside grid container),
                             values populated via AJAX on load and on filter change,
                             columns kept pixel-aligned with the invoices grid via JS ──── -->
                <div class="govuk-grid-row sup_margin_left_right_0 sup_margin_bottom_10" style="margin-top: 8px;">
                    <div class="govuk-grid-column-full sup_p_0">
                        <div id="invTotalsContainer">
                            <div id="invTotalsScrollWrapper" class="yfd-scroll-wrapper">
                                <table id="tblInvTotals" class="govuk-table custom-table yfd-totals-table" aria-label="Invoice totals">
                                    <colgroup>
                                        <col />
                                        <col />
                                        <col />
                                        <col />
                                        <col />
                                        <col />
                                        <col />
                                        <col />
                                        <col />
                                        <col />
                                        <col />
                                    </colgroup>
                                    <tbody class="govuk-table__body">
                                        <tr class="govuk-table__row">
                                            <td class="govuk-table__cell yfd-total-label" colspan="2">Totals</td>
                                            <td class="govuk-table__cell sup_text_right_align" id="invTotalPlanned"></td>
                                            <td class="govuk-table__cell sup_text_right_align" id="invTotalAmountDue"></td>
                                            <td class="govuk-table__cell yfd-total-hidden"></td>
                                            <td class="govuk-table__cell sup_text_right_align" id="invTotalAmountInvoiced"></td>
                                            <td class="govuk-table__cell yfd-total-hidden"></td>
                                            <td class="govuk-table__cell yfd-total-hidden"></td>
                                            <td class="govuk-table__cell yfd-total-hidden"></td>
                                            <td class="govuk-table__cell yfd-total-hidden"></td>
                                            <td class="govuk-table__cell yfd-total-hidden"></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>
</div>

<!-- ── Modal container (loaded via $.get AJAX) ──────────────────────── -->

<div id="invModalContainer"></div>
@Html.AntiForgeryToken()

<script src="~/js/ajax-form-validation.js"></script>

@section Scripts {
    <script>
        // ── Cached reference to the totals container ─────────────────────────────
      
        var $invTotals = null;

        // ── Extra filter method — called automatically by _DataGrid on every reload ──
       
        function getInvoiceExtraFilters() {
            return {
                project:  document.getElementById('invFilterProject')?.value  || '',
                contract: document.getElementById('invFilterSurvContract')?.value || '',
                year:     document.getElementById('invFilterYear')?.value     || '',
                program:  document.getElementById('invFilterProgram')?.value  || ''
            };
        }

        // ── Mutual-exclusivity handlers ─────────────────────────────────────────

        function onInvProjectChange() {
            document.getElementById('invFilterSurvContract').value = '';
            document.getElementById('invFilterProgram').value = '';
            applyInvoiceFilters();
        }

        function onInvContractChange() {
               document.getElementById('invFilterProgram').value = '';
               applyInvoiceFilters();
        }

        function onInvProgramChange() {            
            document.getElementById('invFilterSurvContract').value = '';
            applyInvoiceFilters();
        }

        // ── Apply filters — reload grid ───────────────────────────────────────────

        function applyInvoiceFilters() {
            // Reload the DataGrid — ALWAYS gm.reloadGrid({ page: 1 }), not gm.reload()
            var gm = window['gridManager_invoicesGrid'];
            if (gm) { gm.reloadGrid({ page: 1 }); }
        }

        // ── Refresh invoice totals via AJAX ──────────────────────────────────────
       
        function refreshInvoiceTotals() {
            var filters = getInvoiceExtraFilters();
            $.get('@Url.Action("GetInvoiceTotals", "Invoice", new { area = "PIMS" })', filters,
                function (data) {
                    if (!$invTotals) return;
                    $invTotals.find('#invTotalPlanned').text(data.totalPlanned      ?? '');
                    $invTotals.find('#invTotalAmountDue').text(data.totalDue         ?? '');
                    $invTotals.find('#invTotalAmountInvoiced').text(data.totalInvoiced ?? '');
                });
        }

        // ── Sync totals row column widths with the DataGrid columns ──────────────
        // Keeps every #tblInvTotals column (including the "Totals" label columns)
        // pixel-aligned with the corresponding invoicesGrid columns, including
        // after manual column resizing.
        function syncInvTotalsRowWithGridColumns() {
            var gridTable = document.querySelector('#gridContainer_invoicesGrid table');
            var totalsTable = document.getElementById('tblInvTotals');
            if (!gridTable || !totalsTable) return;

            var gridHeaderCells = gridTable.querySelectorAll('thead tr.govuk-table__row > th');
            var totalsCols = totalsTable.querySelectorAll('colgroup > col');
            if (!gridHeaderCells.length || !totalsCols.length) return;

            // Use offsetWidth (integer, snapped to the browser's actual rendered
            // column width) instead of getBoundingClientRect (fractional) to avoid
            // cumulative sub-pixel drift across many columns.
            var count = Math.min(gridHeaderCells.length, totalsCols.length);
            for (var i = 0; i < count; i++) {
                var width = gridHeaderCells[i].offsetWidth;
                if (width > 0) {
                    totalsCols[i].style.width = width + 'px';
                }
            }

            // Match the totals table's overall rendered width to the grid table's
            // rendered width exactly, so both tables' columns line up pixel-for-pixel.
            var gridTableWidth = gridTable.offsetWidth;
            if (gridTableWidth > 0) {
                totalsTable.style.width = gridTableWidth + 'px';
                totalsTable.style.minWidth = gridTableWidth + 'px';
            }
        }

        // ── Sync horizontal scroll of totals row with the DataGrid ────────────────
        // Keeps #invTotalsScrollWrapper's horizontal scroll position in lockstep
        // with the data grid's own scroll container, and keeps totals cell text
        // left-aligned with the label right-aligned.
        function syncInvTotalsRowScrollWithGrid() {
            var gridScrollContainer = document.querySelector('#gridContainer_invoicesGrid .grid-scroll-container');
            var totalsScrollWrapper = document.getElementById('invTotalsScrollWrapper');
            if (!gridScrollContainer || !totalsScrollWrapper) return;

            var syncingFromGrid = false;
            var syncingFromTotals = false;

            gridScrollContainer.addEventListener('scroll', function () {
                if (syncingFromTotals) return;
                syncingFromGrid = true;
                totalsScrollWrapper.scrollLeft = gridScrollContainer.scrollLeft;
                syncingFromGrid = false;
            });

            totalsScrollWrapper.addEventListener('scroll', function () {
                if (syncingFromGrid) return;
                syncingFromTotals = true;
                gridScrollContainer.scrollLeft = totalsScrollWrapper.scrollLeft;
                syncingFromTotals = false;
            });

            totalsScrollWrapper.querySelectorAll('.govuk-table__cell:not(.yfd-total-label)').forEach(function (cell) {
                cell.style.textAlign = 'left';
            });
            totalsScrollWrapper.querySelectorAll('.govuk-table__cell.yfd-total-label').forEach(function (cell) {
                cell.style.textAlign = 'right';
            });
        }

        // ── Add Invoice ──────────────────────────────────────────────────────────
        
        function addInvoice() {
            var selectedProject  = document.getElementById('invFilterProject')?.value  || '';
            var selectedContract = document.getElementById('invFilterSurvContract')?.value || '';
            $.get('@Url.Action("GetAddEditInvoicePartial", "Invoice", new { area = "PIMS" })',
                { project: selectedProject, contract: selectedContract },
                function (html) {
                    $('#invModalContainer').html(html);
                    var modal = document.getElementById('editInvoiceModal');
                    if (modal) { modal.classList.add('open'); }
                });
        }

        // ── Edit Invoice ─────────────────────────────────────────────────────────
        function editInvoice(btn) {
            var id = $(btn).data('id');
            $.get('@Url.Action("GetAddEditInvoicePartial", "Invoice", new { area = "PIMS" })',
                { id: id },
                function (html) {
                    $('#invModalContainer').html(html);
                    var modal = document.getElementById('editInvoiceModal');
                    if (modal) { modal.classList.add('open'); }
                });
        }

        // ── Delete Invoice ────────────────────────────────────────────────────────
        function deleteInvoice(btn) {
            var id = $(btn).data('id');
            showGovukConfirm('Are you sure you want to delete this invoice? This action cannot be undone.').then(function (result) {
                if (!result) return;
                var token = $('input[name="__RequestVerificationToken"]').val();
                $.ajax({
                    url: '@Url.Action("DeleteInvoice", "Invoice", new { area = "PIMS" })',
                    type: 'DELETE',
                    headers: { 'RequestVerificationToken': token },
                    data: { id: id },
                    success: function (data) {
                        if (data.success) {
                            showAlertMessage(data.message, AlertType.SUCCESS).then(function () {
                                var gm = window['gridManager_invoicesGrid'];
                                if (gm) { gm.reloadGrid({ page: 1 }); }
                                applyInvoiceFilters();
                            });
                        } else {
                            showAlertMessage(data.errors?.map(function(e) { return e.message; }).join(', ') || 'Delete failed. Please try again.', AlertType.ERROR);
                        }
                    },
                    error: function () {
                        showAlertMessage('An error occurred while deleting the invoice.', AlertType.ERROR);
                    }
                });
            });
        }

        // ── Save Invoice (called from _AddEditInvoice partial) ────────────────────
        function saveInvoice() {
            var form = document.getElementById('editInvoiceForm');
            if (!form) return;
            var $form  = $(form);
            var $modal = $('#editInvoiceModal');

            clearValidationErrors($modal);

            if (!isFormValid($form)) {
                displayClientValidationErrors($form, $modal);
                return;
            }

            var token = $('input[name="__RequestVerificationToken"]').val();

            $.ajax({
                url: '@Url.Action("SaveInvoice", "Invoice", new { area = "PIMS" })',
                type: 'POST',
                headers: { 'RequestVerificationToken': token },
                data: $form.serialize(),
                success: function (result) {
                    if (result.success) {
                        closeInvoiceModal();
                        showAlertMessage(result.message, AlertType.SUCCESS).then(function () {
                            var gm = window['gridManager_invoicesGrid'];
                            if (gm) { gm.reloadGrid({ page: 1 }); }
                            applyInvoiceFilters();
                        });
                    } else {
                        displayServerValidationErrors(result.errors, 'Failed to save invoice.', '#editInvoiceModal');
                    }
                },
                error: function () {
                    showAlertMessage('An error occurred while saving the invoice.', AlertType.ERROR);
                }
            });
        }

        // ── Modal close helper ────────────────────────────────────────────────────
        function closeInvoiceModal() {
            var modal = document.getElementById('editInvoiceModal');
            if (modal) { modal.classList.remove('open'); }
        }

        // ── Initialise totals on page load ────────────────────────────────────────
        // #invTotalsContainer lives as its own row below the grid (outside
        // #gridContainer_invoicesGrid), so it is unaffected when the grid's inner
        // HTML is replaced on reload — no DOM re-parenting needed.
        document.addEventListener('DOMContentLoaded', function () {
            $invTotals = $('#invTotalsContainer');

            // Persistent listener — fires after every grid reload (sort, page, filter).
            document.addEventListener('gridReloaded', function (e) {
                if (e.detail && e.detail.gridId === 'invoicesGrid') {
                    refreshInvoiceTotals();   // fetch real values
                    setTimeout(syncInvTotalsRowWithGridColumns, 0);
                }
            });

            setTimeout(applyInvoiceFilters, 300);

            setTimeout(syncInvTotalsRowWithGridColumns, 0);
            setTimeout(syncInvTotalsRowScrollWithGrid, 0);

            // Re-sync after manual column resize (mouseup ends the drag in _DataGrid.cshtml)
            window.addEventListener('mouseup', function () {
                setTimeout(syncInvTotalsRowWithGridColumns, 0);
            });

            window.addEventListener('resize', syncInvTotalsRowWithGridColumns);
        });
    </script>
}

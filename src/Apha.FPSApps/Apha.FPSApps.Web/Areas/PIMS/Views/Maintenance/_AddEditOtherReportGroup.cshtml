@model Apha.FPSApps.Web.Areas.PIMS.Models.ReportGroupItem

@{
    var isAddingNew = ViewBag.IsAddingNew as bool? ?? Model.GroupId == 0;
    var isEditMode = !isAddingNew;
    var title = isEditMode ? "Edit Report Group" : "Add Report Group";
    var saveLabel = isEditMode ? "Update" : "Save";
}

<div class="modal-header flex-space-center">
    <h3 class="modal-title" style="margin: 0;">@title</h3>
    <button type="button" class="btn-close btn-red" onclick="closeModal()">X</button>
</div>
<div class="modal-body" style="padding-top: 5px;">
    <form class="row" id="formOtherReportGroup" data-is-edit="@isEditMode.ToString().ToLowerInvariant()">
        @Html.AntiForgeryToken()

        <div class="govuk-error-summary ra-form-error-banner ra-hidden"
             id="otherReportGroupDbError" role="alert" aria-labelledby="otherReportGroupDbErrorTitle" tabindex="-1">
            <h2 class="govuk-error-summary__title govuk-!-font-size-14" id="otherReportGroupDbErrorTitle">There is a problem</h2>
            <div class="govuk-error-summary__body">
                <ul class="govuk-list govuk-error-summary__list"></ul>
                <p class="govuk-body govuk-!-font-size-14" id="otherReportGroupDbErrorText"></p>
            </div>
        </div>

        <div class="govuk-grid-row">
            <div class="govuk-grid-column-one-half">
                <div class="govuk-form-group sup_margin_bottom_10" id="otherReportGroupIdGroup">
                    <label class="govuk-label govuk-!-font-weight-bold govuk-!-font-size-16" asp-for="GroupId">
                        Group Id: <span class="ra-required-star" aria-hidden="true">*</span>
                    </label>
                    @if (isEditMode)
                    {
                        <input class="govuk-input govuk-!-font-size-16"
                               asp-for="GroupId"
                               id="otherGroupId"
                               type="number"
                               readonly
                               aria-required="true"
                               aria-label="Group Id"
                               aria-describedby="otherGroupIdError" />
                    }
                    else
                    {
                        <input class="govuk-input govuk-!-font-size-16"
                               asp-for="GroupId"
                               id="otherGroupId"
                               type="number"
                               required
                               aria-required="true"
                               aria-label="Group Id"
                               aria-describedby="otherGroupIdError" />
                    }
                    <span asp-validation-for="GroupId"
                          data-valmsg-for="GroupId"
                          class="govuk-error-message"
                          id="otherGroupIdError"
                          style="display:none;"></span>
                </div>
            </div>
            <div class="govuk-grid-column-one-half">
                <div class="govuk-form-group sup_margin_bottom_10" id="otherReportGroupDescriptionGroup">
                    <label class="govuk-label govuk-!-font-weight-bold govuk-!-font-size-16" asp-for="Description">
                        Description: <span class="ra-required-star" aria-hidden="true">*</span>
                    </label>
                    <input class="govuk-input govuk-!-font-size-16"
                           asp-for="Description"
                           id="otherReportGroupDescription"
                           type="text"
                           required
                           aria-required="true"
                           aria-label="Description"
                           aria-describedby="otherReportGroupDescriptionError" />
                    <span asp-validation-for="Description"
                          data-valmsg-for="Description"
                          class="govuk-error-message"
                          id="otherReportGroupDescriptionError"
                          style="display:none;"></span>
                </div>
            </div>
        </div>

        <div class="col-12" style="display: flex; justify-content: space-between; margin-top: 10px;">
            <button type="button"
                    class="govuk-button govuk-button--secondary sup_margin_0"
                    onclick="closeModal()">
                Cancel
            </button>
            <button type="button"
                    class="govuk-button sup_margin_0"
                    onclick="saveOtherReportGroup()">
                @saveLabel
            </button>
        </div>
    </form>
</div>

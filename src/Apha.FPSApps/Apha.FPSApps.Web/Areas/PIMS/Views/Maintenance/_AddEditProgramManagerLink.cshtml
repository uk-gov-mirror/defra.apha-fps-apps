@model Apha.FPSApps.Web.Areas.PIMS.Models.ProgramManagerLinkItem

@{
    var isEditMode = ViewBag.IsEditMode as bool? ?? false;
    var originalProgram = ViewBag.OriginalProgram as string;
    var title = isEditMode ? "Edit Program" : "Add Program";
}

<div class="modal-header flex-space-center">
    <h3 class="modal-title" style="margin: 0;">@title</h3>
    <button type="button" class="btn-close btn-red" onclick="closeModal()">X</button>
</div>
<div class="modal-body" style="padding-top: 5px;">
    <form class="row" id="formProgramManagerLink">
        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="Manager" id="hdnLinkManager" />
        <input type="hidden" id="hdnOriginalProgram" value="@originalProgram" />
        <input type="hidden" id="hdnIsProgramEditMode" value="@(isEditMode ? "true" : "false")" />

        <div class="govuk-error-summary ra-form-error-banner ra-hidden"
             id="mgrAssignDbError" role="alert" aria-labelledby="mgrAssignDbErrorTitle" tabindex="-1">
            <h2 class="govuk-error-summary__title govuk-!-font-size-14" id="mgrAssignDbErrorTitle">There is a problem</h2>
            <div class="govuk-error-summary__body">
                <ul class="govuk-list govuk-error-summary__list"></ul>
                <p class="govuk-body govuk-!-font-size-14" id="mgrAssignDbErrorText"></p>
            </div>
        </div>

        <div class="govuk-form-group" id="mgrAssignValueGroup">
            <label class="govuk-label govuk-!-font-weight-bold govuk-!-font-size-16" for="mgrAssignValue">
                <span id="mgrAssignLabel">Program:</span> <span class="ra-required-star" aria-hidden="true">*</span>
            </label>
            <select class="govuk-select govuk-!-font-size-16 ra-select-full"
                    asp-for="Program"
                    asp-items="ViewBag.ProgramOptions"
                    id="mgrAssignValue"
                    required
                    aria-required="true"
                    aria-label="Program"
                    aria-describedby="mgrAssignValueError">
                <option value="">-- Select --</option>
            </select>
            <span asp-validation-for="Program" 
                  data-valmsg-for="Program"
                  class="govuk-error-message" 
                  id="mgrAssignValueError" 
                  style="display:none;"></span>
        </div>

        <div class="col-12" style="display: flex; justify-content: space-between; margin-top: 10px;">
            <button type="button"
                    class="govuk-button govuk-button--secondary sup_margin_0"
                    onclick="closeModal()">
                Cancel
            </button>
            <button type="button"
                    class="govuk-button sup_margin_0"
                    onclick="saveProgramManagerLink()">
                Save
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        function saveProgramManagerLink() {
            var $form = $('#formProgramManagerLink');

            // Clear and validate form using existing helper functions
            displayClientValidationErrors($form, $form);
            if (!isFormValid($form)) return;

            var dbError     = document.getElementById('mgrAssignDbError');
            var dbErrorText = document.getElementById('mgrAssignDbErrorText');
            if (dbError) dbError.classList.add('ra-hidden');

            var program = document.getElementById('mgrAssignValue')?.value || '';
            var manager = document.getElementById('hdnLinkManager')?.value || '';

            var isEditMode = (document.getElementById('hdnIsProgramEditMode')?.value || '').toLowerCase() === 'true';
            var originalProgram = document.getElementById('hdnOriginalProgram')?.value || '';
            var url = isEditMode
                ? '/PIMS/Maintenance/UpdateProgramManagerLink'
                : '/PIMS/Maintenance/SaveProgramManagerLink';

            var payload = isEditMode
                ? {
                    originalProgram: originalProgram,
                    originalManager: manager,
                    program: program,
                    manager: manager
                }
                : {
                    program: program,
                    manager: manager
                };

            $.ajax({
                url: url,
                type: 'POST',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify(payload),
                headers: { 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').first().val() },
                success: function (data) {
                    if (data.success) {
                        showAlertMessage(data.message || (isEditMode ? 'Programme assignment updated successfully.' : 'Programme assignment added successfully.'), AlertType.SUCCESS)
                            .then(function () {
                                closeModal();
                                reloadProgramManagerLinksGrid();
                            });
                    } else {
                        var msg = data.message || 'Save failed.';
                        if (dbErrorText) dbErrorText.textContent = msg;
                        if (dbError) dbError.classList.remove('ra-hidden');
                    }
                },
                error: function () {
                    if (dbErrorText) dbErrorText.textContent = 'An error occurred while saving.';
                    if (dbError) dbError.classList.remove('ra-hidden');
                }
            });
        }
    </script>
}

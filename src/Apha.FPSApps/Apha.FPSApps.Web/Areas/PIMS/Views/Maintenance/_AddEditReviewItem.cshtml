@model Apha.FPSApps.Web.Areas.PIMS.Models.ReviewItemItem

@{
    var isAddingNew = ViewBag.IsAddingNew as bool? ?? Model.Itemid == 0;
    var isEditMode = !isAddingNew;
    var title = isEditMode ? "Edit Review Item" : "Add Review Item";
    var saveLabel = isEditMode ? "Update" : "Save";
}

<div class="modal-header flex-space-center">
    <h3 class="modal-title" style="margin: 0;">@title</h3>
    <button type="button" class="btn-close btn-red" onclick="closeModal()">X</button>
</div>
<div class="modal-body" style="padding-top: 5px;">
    <form class="row" id="formReviewItem" data-is-edit="@isEditMode.ToString().ToLowerInvariant()">
        @Html.AntiForgeryToken()

        <div class="govuk-error-summary ra-form-error-banner ra-hidden"
             id="reviewItemDbError" role="alert" aria-labelledby="reviewItemDbErrorTitle" tabindex="-1">
            <h2 class="govuk-error-summary__title govuk-!-font-size-14" id="reviewItemDbErrorTitle">There is a problem</h2>
            <div class="govuk-error-summary__body">
                <ul class="govuk-list govuk-error-summary__list"></ul>
                <p class="govuk-body govuk-!-font-size-14" id="reviewItemDbErrorText"></p>
            </div>
        </div>

        <div class="govuk-grid-row">
            <div class="govuk-grid-column-one-half">
                <div class="govuk-form-group sup_margin_bottom_10" id="editReviewItemGroup">
                    <label class="govuk-label govuk-!-font-weight-bold govuk-!-font-size-16" asp-for="Itemid">
                        Item Id: <span class="ra-required-star" aria-hidden="true">*</span>
                    </label>
                    @if (isEditMode)
                    {
                        <input class="govuk-input govuk-!-font-size-16"
                               asp-for="Itemid"
                               id="editReviewItemid"
                               type="number"
                               readonly
                               aria-required="true"
                               aria-label="Item Id"
                               aria-describedby="editReviewItemidError" />
                    }
                    else
                    {
                        <input class="govuk-input govuk-!-font-size-16"
                               asp-for="Itemid"
                               id="editReviewItemid"
                               type="number"
                               required
                               aria-required="true"
                               aria-label="Item Id"
                               aria-describedby="editReviewItemidError" />
                    }   
                    <span asp-validation-for="Itemid"
                          data-valmsg-for="Itemid"
                          class="govuk-error-message"
                          id="editReviewItemidError"
                          style="display:none;"></span>
                </div>
            </div>
            <div class="govuk-grid-column-one-half">
                <div class="govuk-form-group sup_margin_bottom_10" id="editReviewItemGroup">
                    <label class="govuk-label govuk-!-font-weight-bold govuk-!-font-size-16" asp-for="Item">
                        Item: <span class="ra-required-star" aria-hidden="true">*</span>
                    </label>
                    <input class="govuk-input govuk-!-font-size-16"
                           asp-for="Item"
                           id="editReviewItem"
                           type="text"
                           required
                           aria-required="true"
                           aria-label="Item"
                           aria-describedby="editReviewItemError" />
                    <span asp-validation-for="Item"
                          data-valmsg-for="Item"
                          class="govuk-error-message"
                          id="editReviewItemError"
                          style="display:none;"></span>
                </div>
            </div>
        </div>

        <div class="col-12" style="display: flex; justify-content: space-between; margin-top: 10px;">
            <button type="button"
                    class="govuk-button govuk-button--secondary sup_margin_0"
                    onclick="closeModal()">
                Cancel
            </button>
            <button type="button"
                    class="govuk-button sup_margin_0"
                    onclick="saveReviewItem()">
                @saveLabel
            </button>
        </div>
    </form>
</div>

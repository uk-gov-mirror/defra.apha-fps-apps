@model Apha.FPSApps.Web.Areas.PIMS.Models.RiskItem

@{
    var isAddingNew = ViewBag.IsAddingNew as bool? ?? Model.Riskid == 0;
    var isEditMode = !isAddingNew;
    var title = isEditMode ? "Edit Risk Rating" : "Add Risk Rating";
    var saveLabel = isEditMode ? "Update" : "Save";
}

<div class="modal-header flex-space-center">
    <h3 class="modal-title" style="margin: 0;">@title</h3>
    <button type="button" class="btn-close btn-red" onclick="closeModal()">X</button>
</div>
<div class="modal-body" style="padding-top: 5px;">
    <form class="row" id="formRisk" data-is-edit="@isEditMode.ToString().ToLowerInvariant()">
        @Html.AntiForgeryToken()

        <div class="govuk-error-summary ra-form-error-banner ra-hidden"
             id="riskDbError" role="alert" aria-labelledby="riskDbErrorTitle" tabindex="-1">
            <h2 class="govuk-error-summary__title govuk-!-font-size-14" id="riskDbErrorTitle">There is a problem</h2>
            <div class="govuk-error-summary__body">
                <ul class="govuk-list govuk-error-summary__list"></ul>
                <p class="govuk-body govuk-!-font-size-14" id="riskDbErrorText"></p>
            </div>
        </div>

        <div class="govuk-grid-row">
            <div class="govuk-grid-column-one-half">
                <div class="govuk-form-group sup_margin_bottom_10" id="editRiskidGroup">
                    <label class="govuk-label govuk-!-font-weight-bold govuk-!-font-size-16" asp-for="Riskid">
                        RiskID: <span class="ra-required-star" aria-hidden="true">*</span>
                    </label>
                    <input class="govuk-input govuk-!-font-size-16"
                           asp-for="Riskid"
                           id="editRiskid"
                           type="number"
                           required
                           aria-required="true"
                           aria-label="editRiskid"
                           aria-describedby="editRiskidError" />
                    <span asp-validation-for="Riskid"
                          data-valmsg-for="Riskid"
                          class="govuk-error-message"
                          id="editRiskidError"
                          style="display:none;"></span>
                </div>
            </div>

            <div class="govuk-grid-column-one-half">
                <div class="govuk-form-group sup_margin_bottom_10" id="editRiskRatingGroup">
                    <label class="govuk-label govuk-!-font-weight-bold govuk-!-font-size-16" asp-for="Riskrating">
                        RiskRating: <span class="ra-required-star" aria-hidden="true">*</span>
                    </label>
                    <input class="govuk-input govuk-!-font-size-16"
                           asp-for="Riskrating"
                           id="editRiskRating"
                           type="text"
                           required
                           aria-required="true"
                           aria-label="RiskRating"
                           aria-describedby="editRiskRatingError" />
                    <span asp-validation-for="Riskrating"
                          data-valmsg-for="Riskrating"
                          class="govuk-error-message"
                          id="editRiskRatingError"
                          style="display:none;"></span>
                </div>
            </div>
        </div>

        <div class="col-12" style="display: flex; justify-content: space-between; margin-top: 10px;">
            <button type="button"
                    class="govuk-button govuk-button--secondary sup_margin_0"
                    onclick="closeModal()">
                Cancel
            </button>
            <button type="button"
                    class="govuk-button sup_margin_0"
                    onclick="saveRisk()">
                @saveLabel
            </button>
        </div>
    </form>
</div>

@model Apha.FPSApps.Web.Areas.PIMS.Models.MilestoneFormDatesItem
@{
    string? yearReadonly = ViewBag.IsAddingNew == true ? null : "readonly";
}

<div id="editFormDatesModal" class="govuk-edit-modal">
    <div class="govuk-edit-modal-dialog" style="max-width: 580px;">
        <div class="govuk-edit-modal__header">
            <h3 class="govuk-edit-modal__title">
                @(ViewBag.IsAddingNew == true ? "Add Financial Year Record" : "Edit Financial Year Record")
            </h3>
            <button type="button" onclick="closeFormDatesModal()"
                    aria-label="Close" class="govuk-edit-modal__close-btn">
                ✕
            </button>
        </div>
        <div class="govuk-edit-modal__body">
            <form id="editFormDatesForm" novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="ParentProject" />

                <div class="govuk-error-summary" role="alert"
                     aria-labelledby="editFormDatesErrorTitle" tabindex="-1" style="display: none;">
                    <h2 class="govuk-error-summary__title" id="editFormDatesErrorTitle">
                        There is a problem
                    </h2>
                    <div class="govuk-error-summary__body">
                        <ul class="govuk-list govuk-error-summary__list"></ul>
                    </div>
                </div>

                <div class="govuk-form-group govuk-!-margin-bottom-4" id="fgFinYear">
                    <label class="govuk-label font-size-16" asp-for="Year">
                        Financial Year <span class="sup_color_red">*</span>
                    </label>
                    <input class="govuk-input" asp-for="Year"
                           type="text" placeholder="e.g. 2026"
                           maxlength="4" pattern="\d{4}" min="1900" max="2100"
                           style="width: 100%;"
                           aria-label="Financial Year"
                           required="@(yearReadonly is null ? "required" : null)"
                           readonly="@yearReadonly" />
                    <span asp-validation-for="Year" class="govuk-error-message" style="display:none;"></span>
                </div>

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0 20px;">
                    <div class="govuk-form-group">
                        <label class="govuk-label font-size-16" asp-for="Jun">Jun</label>
                        <div style="position:relative; display:flex; align-items:center;">
                            <input type="text" id="JunDisplay" class="govuk-input govuk-input--width-20"
                                   value="@Model.Jun?.ToString("dd/MM/yyyy")"
                                   placeholder="dd/mm/yyyy" maxlength="10"
                                   autocomplete="off"
                                   aria-label="Jun date"
                                   oninput="formatDateInput(this)"
                                   onblur="validateAndSyncDate('JunDisplay', 'JunBinding', 'JunError')"
                                   style="flex:1;">
                            <button type="button" onclick="openDatePicker('JunPicker')"
                                    style="margin-left:4px; padding:6px 10px; cursor:pointer; background:#f3f2f1; border:2px solid #0b0c0c; font-size:1rem; line-height:1;"
                                    aria-label="Open date picker for Jun">&#128197;</button>
                            <input type="hidden" name="Jun" id="JunBinding"
                                   value="@(Model.Jun.HasValue ? Model.Jun.Value.ToString("yyyy-MM-dd") : string.Empty)">
                            <input type="date" id="JunPicker"
                                   value="@(Model.Jun.HasValue ? Model.Jun.Value.ToString("yyyy-MM-dd") : string.Empty)"
                                   aria-label="Jun date picker"
                                   style="position:absolute; top:0; left:0; opacity:0; width:1px; height:1px; pointer-events:auto;"
                                   onchange="syncDateToText('JunPicker', 'JunDisplay', 'JunBinding', 'JunError')">
                        </div>
                        <span id="JunError" class="govuk-error-message" style="display:none;"></span>
                    </div>
                    <div class="govuk-form-group">
                        <label class="govuk-label font-size-16" asp-for="Sep">Sep</label>
                        <div style="position:relative; display:flex; align-items:center;">
                            <input type="text" id="SepDisplay" class="govuk-input govuk-input--width-20"
                                   value="@Model.Sep?.ToString("dd/MM/yyyy")"
                                   placeholder="dd/mm/yyyy" maxlength="10"
                                   autocomplete="off"
                                   aria-label="Sep date"
                                   oninput="formatDateInput(this)"
                                   onblur="validateAndSyncDate('SepDisplay', 'SepBinding', 'SepError')"
                                   style="flex:1;">
                            <button type="button" onclick="openDatePicker('SepPicker')"
                                    style="margin-left:4px; padding:6px 10px; cursor:pointer; background:#f3f2f1; border:2px solid #0b0c0c; font-size:1rem; line-height:1;"
                                    aria-label="Open date picker for Sep">&#128197;</button>
                            <input type="hidden" name="Sep" id="SepBinding"
                                   value="@(Model.Sep.HasValue ? Model.Sep.Value.ToString("yyyy-MM-dd") : string.Empty)">
                            <input type="date" id="SepPicker"
                                   value="@(Model.Sep.HasValue ? Model.Sep.Value.ToString("yyyy-MM-dd") : string.Empty)"
                                   aria-label="Sep date picker"
                                   style="position:absolute; top:0; left:0; opacity:0; width:1px; height:1px; pointer-events:auto;"
                                   onchange="syncDateToText('SepPicker', 'SepDisplay', 'SepBinding', 'SepError')">
                        </div>
                        <span id="SepError" class="govuk-error-message" style="display:none;"></span>
                    </div>
                    <div class="govuk-form-group">
                        <label class="govuk-label font-size-16" asp-for="Dec">Dec</label>
                        <div style="position:relative; display:flex; align-items:center;">
                            <input type="text" id="DecDisplay" class="govuk-input govuk-input--width-20"
                                   value="@Model.Dec?.ToString("dd/MM/yyyy")"
                                   placeholder="dd/mm/yyyy" maxlength="10"
                                   autocomplete="off"
                                   aria-label="Dec date"
                                   oninput="formatDateInput(this)"
                                   onblur="validateAndSyncDate('DecDisplay', 'DecBinding', 'DecError')"
                                   style="flex:1;">
                            <button type="button" onclick="openDatePicker('DecPicker')"
                                    style="margin-left:4px; padding:6px 10px; cursor:pointer; background:#f3f2f1; border:2px solid #0b0c0c; font-size:1rem; line-height:1;"
                                    aria-label="Open date picker for Dec">&#128197;</button>
                            <input type="hidden" name="Dec" id="DecBinding"
                                   value="@(Model.Dec.HasValue ? Model.Dec.Value.ToString("yyyy-MM-dd") : string.Empty)">
                            <input type="date" id="DecPicker"
                                   value="@(Model.Dec.HasValue ? Model.Dec.Value.ToString("yyyy-MM-dd") : string.Empty)"
                                   aria-label="Dec date picker"
                                   style="position:absolute; top:0; left:0; opacity:0; width:1px; height:1px; pointer-events:auto;"
                                   onchange="syncDateToText('DecPicker', 'DecDisplay', 'DecBinding', 'DecError')">
                        </div>
                        <span id="DecError" class="govuk-error-message" style="display:none;"></span>
                    </div>
                    <div class="govuk-form-group">
                        <label class="govuk-label font-size-16" asp-for="Jan">Jan</label>
                        <div style="position:relative; display:flex; align-items:center;">
                            <input type="text" id="JanDisplay" class="govuk-input govuk-input--width-20"
                                   value="@Model.Jan?.ToString("dd/MM/yyyy")"
                                   placeholder="dd/mm/yyyy" maxlength="10"
                                   autocomplete="off"
                                   aria-label="Jan date"
                                   oninput="formatDateInput(this)"
                                   onblur="validateAndSyncDate('JanDisplay', 'JanBinding', 'JanError')"
                                   style="flex:1;">
                            <button type="button" onclick="openDatePicker('JanPicker')"
                                    style="margin-left:4px; padding:6px 10px; cursor:pointer; background:#f3f2f1; border:2px solid #0b0c0c; font-size:1rem; line-height:1;"
                                    aria-label="Open date picker for Jan">&#128197;</button>
                            <input type="hidden" name="Jan" id="JanBinding"
                                   value="@(Model.Jan.HasValue ? Model.Jan.Value.ToString("yyyy-MM-dd") : string.Empty)">
                            <input type="date" id="JanPicker"
                                   value="@(Model.Jan.HasValue ? Model.Jan.Value.ToString("yyyy-MM-dd") : string.Empty)"
                                   aria-label="Jan date picker"
                                   style="position:absolute; top:0; left:0; opacity:0; width:1px; height:1px; pointer-events:auto;"
                                   onchange="syncDateToText('JanPicker', 'JanDisplay', 'JanBinding', 'JanError')">
                        </div>
                        <span id="JanError" class="govuk-error-message" style="display:none;"></span>
                    </div>
                    <div class="govuk-form-group">
                        <label class="govuk-label font-size-16" asp-for="Feb">Feb</label>
                        <div style="position:relative; display:flex; align-items:center;">
                            <input type="text" id="FebDisplay" class="govuk-input govuk-input--width-20"
                                   value="@Model.Feb?.ToString("dd/MM/yyyy")"
                                   placeholder="dd/mm/yyyy" maxlength="10"
                                   autocomplete="off"
                                   aria-label="Feb date"
                                   oninput="formatDateInput(this)"
                                   onblur="validateAndSyncDate('FebDisplay', 'FebBinding', 'FebError')"
                                   style="flex:1;">
                            <button type="button" onclick="openDatePicker('FebPicker')"
                                    style="margin-left:4px; padding:6px 10px; cursor:pointer; background:#f3f2f1; border:2px solid #0b0c0c; font-size:1rem; line-height:1;"
                                    aria-label="Open date picker for Feb">&#128197;</button>
                            <input type="hidden" name="Feb" id="FebBinding"
                                   value="@(Model.Feb.HasValue ? Model.Feb.Value.ToString("yyyy-MM-dd") : string.Empty)">
                            <input type="date" id="FebPicker"
                                   value="@(Model.Feb.HasValue ? Model.Feb.Value.ToString("yyyy-MM-dd") : string.Empty)"
                                   aria-label="Feb date picker"
                                   style="position:absolute; top:0; left:0; opacity:0; width:1px; height:1px; pointer-events:auto;"
                                   onchange="syncDateToText('FebPicker', 'FebDisplay', 'FebBinding', 'FebError')">
                        </div>
                        <span id="FebError" class="govuk-error-message" style="display:none;"></span>
                    </div>
                    <div class="govuk-form-group">
                        <label class="govuk-label font-size-16" asp-for="Mar">Mar</label>
                        <div style="position:relative; display:flex; align-items:center;">
                            <input type="text" id="MarDisplay" class="govuk-input govuk-input--width-20"
                                   value="@Model.Mar?.ToString("dd/MM/yyyy")"
                                   placeholder="dd/mm/yyyy" maxlength="10"
                                   autocomplete="off"
                                   aria-label="Mar date"
                                   oninput="formatDateInput(this)"
                                   onblur="validateAndSyncDate('MarDisplay', 'MarBinding', 'MarError')"
                                   style="flex:1;">
                            <button type="button" onclick="openDatePicker('MarPicker')"
                                    style="margin-left:4px; padding:6px 10px; cursor:pointer; background:#f3f2f1; border:2px solid #0b0c0c; font-size:1rem; line-height:1;"
                                    aria-label="Open date picker for Mar">&#128197;</button>
                            <input type="hidden" name="Mar" id="MarBinding"
                                   value="@(Model.Mar.HasValue ? Model.Mar.Value.ToString("yyyy-MM-dd") : string.Empty)">
                            <input type="date" id="MarPicker"
                                   value="@(Model.Mar.HasValue ? Model.Mar.Value.ToString("yyyy-MM-dd") : string.Empty)"
                                   aria-label="Mar date picker"
                                   style="position:absolute; top:0; left:0; opacity:0; width:1px; height:1px; pointer-events:auto;"
                                   onchange="syncDateToText('MarPicker', 'MarDisplay', 'MarBinding', 'MarError')">
                        </div>
                        <span id="MarError" class="govuk-error-message" style="display:none;"></span>
                    </div>
                </div>
            </form>
        </div>
        <div class="govuk-edit-modal__footer">
            <button type="button"
                    class="govuk-button govuk-button--secondary font-size-16"
                    onclick="closeFormDatesModal()">
                Cancel
            </button>
            <button type="button"
                    class="govuk-button font-size-16"
                    id="saveFormDatesBtn"
                    onclick="saveMilestoneFormDates()">
                @(ViewBag.IsAddingNew == true ? "Save" : "Update")
            </button>
        </div>
    </div>
</div>

<script>
    function openDatePicker(pickerId) {
        var picker = document.getElementById(pickerId);
        if (picker) {
            try { picker.showPicker(); } catch (e) { picker.click(); }
        }
    }

    function syncDateToText(pickerId, displayId, hiddenId, errorId) {
        var picker = document.getElementById(pickerId);
        if (picker.value) {
            var parts = picker.value.split('-');
            document.getElementById(displayId).value = parts[2] + '/' + parts[1] + '/' + parts[0];
            document.getElementById(hiddenId).value = picker.value;
        } else {
            document.getElementById(displayId).value = '';
            document.getElementById(hiddenId).value = '';
        }
        if (errorId) {
            var err = document.getElementById(errorId);
            if (err) { err.style.display = 'none'; err.textContent = ''; }
        }
    }

    function formatDateInput(input) {
        var val = input.value.replace(/[^\d\/\-]/g, '');
        if (val.length > 10) val = val.substring(0, 10);
        input.value = val;
    }

    function validateAndSyncDate(displayId, hiddenId, errorId) {
        var display = document.getElementById(displayId);
        var hidden  = document.getElementById(hiddenId);
        var errorEl = document.getElementById(errorId);
        var val = display.value.trim();

        if (!val) {
            hidden.value = '';
            errorEl.style.display = 'none';
            errorEl.textContent = '';
            return;
        }

        if (/^\d{4}[\/\-]\d{2}[\/\-]\d{2}$/.test(val)) {
            hidden.value = '';
            errorEl.textContent = 'Enter the date in dd/mm/yyyy format, not yyyy/mm/dd';
            errorEl.style.display = 'block';
            return;
        }

        var usMatch = val.match(/^(\d{2})\/(\d{2})\/(\d{4})$/);
        if (usMatch && parseInt(usMatch[2], 10) > 12) {
            hidden.value = '';
            errorEl.textContent = 'Enter the date in dd/mm/yyyy format, not mm/dd/yyyy';
            errorEl.style.display = 'block';
            return;
        }

        var match = val.match(/^(\d{2})\/(\d{2})\/(\d{4})$/);
        if (!match) {
            hidden.value = '';
            errorEl.textContent = 'Enter the date in dd/mm/yyyy format';
            errorEl.style.display = 'block';
            return;
        }

        var day   = parseInt(match[1], 10);
        var month = parseInt(match[2], 10);
        var year  = parseInt(match[3], 10);
        var date  = new Date(year, month - 1, day);

        if (date.getFullYear() !== year || date.getMonth() !== (month - 1) || date.getDate() !== day) {
            hidden.value = '';
            errorEl.textContent = 'Enter a valid date in dd/mm/yyyy format';
            errorEl.style.display = 'block';
            return;
        }

        var mm = String(month).padStart(2, '0');
        var dd = String(day).padStart(2, '0');
        hidden.value = year + '-' + mm + '-' + dd;
        errorEl.style.display = 'none';
        errorEl.textContent = '';
    }
</script>

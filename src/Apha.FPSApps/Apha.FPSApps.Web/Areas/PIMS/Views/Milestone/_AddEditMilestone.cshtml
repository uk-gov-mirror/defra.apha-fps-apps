@model Apha.FPSApps.Web.Areas.PIMS.Models.MilestoneItem
@{
    string? numberReadonly = ViewBag.IsAddingNew == true ? null : "readonly";
}

<div id="editRecordModal" class="govuk-edit-modal">
    <div class="govuk-edit-modal-dialog">
        <div class="govuk-edit-modal__header">
            <h3 class="govuk-edit-modal__title">
                @(ViewBag.IsAddingNew == true ? "Add Milestone/Deliverable" : "Edit Milestone/Deliverable")
            </h3>
            <button type="button" onclick="closeEditModal()"
                    aria-label="Close" class="govuk-edit-modal__close-btn">
                ✕
            </button>
        </div>
        <div class="govuk-edit-modal__body">
            <form id="editRecordForm" novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Project" />
                <input type="hidden" name="IsAddingNew" value="@(ViewBag.IsAddingNew == true ? "true" : "false")" />

                <div class="govuk-error-summary" role="alert"
                     aria-labelledby="editFormErrorTitle" tabindex="-1" style="display: none;">
                    <h2 class="govuk-error-summary__title" id="editFormErrorTitle">
                        There is a problem
                    </h2>
                    <div class="govuk-error-summary__body">
                        <ul class="govuk-list govuk-error-summary__list"></ul>
                    </div>
                </div>

                <div class="govuk-grid-row">
                    <div class="govuk-grid-column-one-half">
                        <div class="govuk-form-group govuk-!-margin-bottom-4" id="numberGroup">
                            <label class="govuk-label font-size-16 sup_font_weight_700" asp-for="Number">
                                Number <span class="sup_color_red">*</span>
                            </label>
                            <input class="govuk-input" asp-for="Number"
                                   pattern="\d{1,2}/\d{1,2}" maxlength="5" required
                                   placeholder="e.g. 01/01"
                                   readonly="@numberReadonly" />
                            <span asp-validation-for="Number" class="govuk-error-message" style="display:none;"></span>
                        </div>
                    </div>
                    <div class="govuk-grid-column-one-half">
                        <div class="govuk-form-group govuk-!-margin-bottom-4" id="typeGroup">
                            <label class="govuk-label font-size-16 sup_font_weight_700" asp-for="IdType">
                                Type <span class="sup_color_red">*</span>
                            </label>
                            <select class="govuk-select" asp-for="IdType"
                                    asp-items="ViewBag.MilestoneTypeOptions"
                                    required
                                    style="width: stretch;">
                                <option value="">Select type</option>
                            </select>
                            <span asp-validation-for="IdType" class="govuk-error-message" style="display:none;"></span>
                        </div>
                    </div>
                </div>

                <div class="govuk-form-group govuk-!-margin-bottom-4">
                    <label class="govuk-label font-size-16 sup_font_weight_700" asp-for="Description">Description</label>
                    <textarea class="govuk-textarea" asp-for="Description"
                              rows="3" style="width: stretch;"></textarea>
                </div>

                <div class="govuk-form-group govuk-!-margin-bottom-4">
                    <label class="govuk-label font-size-16 sup_font_weight_700" asp-for="ProjectLeaderComment">
                        P Leader's Comment
                    </label>
                    <textarea class="govuk-textarea" asp-for="ProjectLeaderComment"
                              rows="2" style="width: stretch;"></textarea>
                </div>

                <div class="govuk-form-group govuk-!-margin-bottom-4">
                    <label class="govuk-label font-size-16 sup_font_weight_700" asp-for="CapsComment">
                        CAP's Comment
                    </label>
                    <textarea class="govuk-textarea" asp-for="CapsComment"
                              rows="2" style="width: stretch;"></textarea>
                </div>

                <div class="govuk-grid-row">
                    <div class="govuk-grid-column-one-half">
                        <div class="govuk-form-group govuk-!-margin-bottom-4" id="dueGroup">
                            <label class="govuk-label font-size-16 sup_font_weight_700" asp-for="DateDue">
                                Due <span class="sup_color_red">*</span>
                            </label>
                            <div style="position:relative; display:flex; align-items:center; width:stretch;">
                                <input type="text"
                                       id="DateDueDisplay"
                                       class="govuk-input"
                                       value="@Model.DateDue?.ToString("dd/MM/yyyy")"
                                       aria-label="DateDueDisplay"
                                       placeholder="dd/mm/yyyy"
                                       maxlength="10"
                                       autocomplete="off"
                                       oninput="formatDateInput(this)"
                                       onblur="validateAndSyncDate('DateDueDisplay', 'DateDueBinding', 'DateDueError')"
                                       style="flex:1;">
                                <button type="button"
                                        onclick="openDatePicker('DateDuePicker')"
                                        style="margin-left:4px; padding:6px 10px; cursor:pointer; background:#f3f2f1; border:2px solid #0b0c0c; font-size:1rem; line-height:1;"
                                        aria-label="Open date picker for Due date">&#128197;</button>
                                <input type="hidden"
                                       name="DateDue"
                                       id="DateDueBinding"
                                       value="@(Model.DateDue.HasValue ? Model.DateDue.Value.ToString("yyyy-MM-dd") : string.Empty)">
                                <input type="date"
                                       id="DateDuePicker"
                                       value="@(Model.DateDue.HasValue ? Model.DateDue.Value.ToString("yyyy-MM-dd") : string.Empty)"
                                       style="position:absolute; top:0; left:0; opacity:0; width:1px; height:1px; pointer-events:auto;"
                                       aria-label="DateDuePicker"
                                       onchange="syncDateToText('DateDuePicker', 'DateDueDisplay', 'DateDueBinding', 'DateDueError')">
                            </div>
                            <span id="DateDueError" class="govuk-error-message" style="display:none;"></span>
                            <span asp-validation-for="DateDue" class="govuk-error-message" style="display:none;"></span>
                        </div>
                    </div>
                    <div class="govuk-grid-column-one-half">
                        <div class="govuk-form-group govuk-!-margin-bottom-4" id="completedGroup">
                            <label class="govuk-label font-size-16 sup_font_weight_700" asp-for="DateCompleted">
                                Completed/Delivered
                            </label>
                            <div style="position:relative; display:flex; align-items:center; width:stretch;">
                                <input type="text"
                                       id="DateCompletedDisplay"
                                       class="govuk-input"
                                       value="@Model.DateCompleted?.ToString("dd/MM/yyyy")"
                                       placeholder="dd/mm/yyyy"
                                       maxlength="10"
                                       autocomplete="off"
                                       aria-label="DateCompletedDisplay"
                                       oninput="formatDateInput(this)"
                                       onblur="validateAndSyncDate('DateCompletedDisplay', 'DateCompletedBinding', 'DateCompletedError')"
                                       style="flex:1;">
                                <button type="button"
                                        onclick="openDatePicker('DateCompletedPicker')"
                                        style="margin-left:4px; padding:6px 10px; cursor:pointer; background:#f3f2f1; border:2px solid #0b0c0c; font-size:1rem; line-height:1;"
                                        aria-label="Open date picker for Completed date">&#128197;</button>
                                <input type="hidden"
                                       name="DateCompleted"
                                       id="DateCompletedBinding"
                                       value="@(Model.DateCompleted.HasValue ? Model.DateCompleted.Value.ToString("yyyy-MM-dd") : string.Empty)">
                                <input type="date"
                                       id="DateCompletedPicker"
                                       aria-label="DateCompletedBinding"
                                       value="@(Model.DateCompleted.HasValue ? Model.DateCompleted.Value.ToString("yyyy-MM-dd") : string.Empty)"
                                       style="position:absolute; top:0; left:0; opacity:0; width:1px; height:1px; pointer-events:auto;"
                                       onchange="syncDateToText('DateCompletedPicker', 'DateCompletedDisplay', 'DateCompletedBinding', 'DateCompletedError')">
                            </div>
                            <span id="DateCompletedError" class="govuk-error-message" style="display:none;"></span>
                        </div>
                    </div>
                </div>

                <div class="govuk-grid-row">
                    <div class="govuk-grid-column-one-half">
                        <div class="govuk-checkboxes govuk-checkboxes--small">
                            <div class="govuk-checkboxes__item">
                                <input class="govuk-checkboxes__input"
                                       id="underSdReviewChk" name="UnderSdReview"
                                       type="checkbox" value="-1"
                                       @(Model.UnderSdReview == -1 ? "checked" : "")
                                       onchange="onUnderReviewChanged(this)" />
                                <label class="govuk-checkboxes__label  font-size-16 sup_font_weight_700"
                                       for="underSdReviewChk"
                                       style="font-weight: normal;">
                                    Under Review?
                                </label>
                                <input type="hidden" name="UnderSdReview" value="0" />
                            </div>
                        </div>
                    </div>
                    <div class="govuk-grid-column-one-half">
                        <div class="govuk-checkboxes govuk-checkboxes--small">
                            <div class="govuk-checkboxes__item">
                                <input class="govuk-checkboxes__input"
                                       id="onTargetChk" name="OnTarget"
                                       type="checkbox" value="-1"
                                       @(Model.OnTarget == -1 ? "checked" : "")
                                       onchange="onOnTargetChanged(this)" />
                                <label class="govuk-checkboxes__label font-size-16 sup_font_weight_700"
                                       for="onTargetChk"
                                       style="font-weight: normal;">
                                    On Target
                                </label>
                                <input type="hidden" name="OnTarget" value="0" />
                            </div>
                        </div>
                    </div>
                </div>
            </form>
        </div>
        <div class="govuk-edit-modal__footer">
            <button type="button"
                    class="govuk-button govuk-button--secondary font-size-16"
                    onclick="closeEditModal()">
                Cancel
            </button>
            <button type="button"
                    class="govuk-button font-size-16"
                    id="saveRecordBtn"
                    onclick="saveMilestone()">
                @(ViewBag.IsAddingNew == true ? "Save" : "Update")
            </button>
        </div>
    </div>
</div>

<script>
    function openDatePicker(pickerId) {
        var picker = document.getElementById(pickerId);
        if (picker) {
            try { picker.showPicker(); } catch (e) { picker.click(); }
        }
    }

    function syncDateToText(pickerId, displayId, hiddenId, errorId) {
        var picker = document.getElementById(pickerId);
        if (picker.value) {
            var parts = picker.value.split('-');
            document.getElementById(displayId).value = parts[2] + '/' + parts[1] + '/' + parts[0];
            document.getElementById(hiddenId).value = picker.value;
        } else {
            document.getElementById(displayId).value = '';
            document.getElementById(hiddenId).value = '';
        }
        if (errorId) {
            var err = document.getElementById(errorId);
            if (err) { err.style.display = 'none'; err.textContent = ''; }
        }
    }

    function formatDateInput(input) {
        var val = input.value.replace(/[^\d\/\-]/g, '');
        if (val.length > 10) val = val.substring(0, 10);
        input.value = val;
    }

    function validateAndSyncDate(displayId, hiddenId, errorId) {
        var display = document.getElementById(displayId);
        var hidden  = document.getElementById(hiddenId);
        var errorEl = document.getElementById(errorId);
        var val = display.value.trim();

        if (!val) {
            hidden.value = '';
            errorEl.style.display = 'none';
            errorEl.textContent = '';
            return;
        }

        if (/^\d{4}[\/\-]\d{2}[\/\-]\d{2}$/.test(val)) {
            hidden.value = '';
            errorEl.textContent = 'Enter the date in dd/mm/yyyy format, not yyyy/mm/dd';
            errorEl.style.display = 'block';
            return;
        }

        var usMatch = val.match(/^(\d{2})\/(\d{2})\/(\d{4})$/);
        if (usMatch && parseInt(usMatch[2], 10) > 12) {
            hidden.value = '';
            errorEl.textContent = 'Enter the date in dd/mm/yyyy format, not mm/dd/yyyy';
            errorEl.style.display = 'block';
            return;
        }

        var match = val.match(/^(\d{2})\/(\d{2})\/(\d{4})$/);
        if (!match) {
            hidden.value = '';
            errorEl.textContent = 'Enter the date in dd/mm/yyyy format';
            errorEl.style.display = 'block';
            return;
        }

        var day   = parseInt(match[1], 10);
        var month = parseInt(match[2], 10);
        var year  = parseInt(match[3], 10);
        var date  = new Date(year, month - 1, day);

        if (date.getFullYear() !== year || date.getMonth() !== (month - 1) || date.getDate() !== day) {
            hidden.value = '';
            errorEl.textContent = 'Enter a valid date in dd/mm/yyyy format';
            errorEl.style.display = 'block';
            return;
        }

        var mm = String(month).padStart(2, '0');
        var dd = String(day).padStart(2, '0');
        hidden.value = year + '-' + mm + '-' + dd;
        errorEl.style.display = 'none';
        errorEl.textContent = '';
    }

    // Mutual-exclusion logic mirrors Access VBA AfterUpdate handlers
    function onUnderReviewChanged(chk) {
        if (chk.checked) {
            document.getElementById('onTargetChk').checked = false;
            document.getElementById('DateCompletedDisplay').value = '';
            document.getElementById('DateCompletedBinding').value = '';
            document.getElementById('DateCompletedPicker').value = '';
        }
    }

    function onOnTargetChanged(chk) {
        if (chk.checked) {
            document.getElementById('underSdReviewChk').checked = false;
            document.getElementById('DateCompletedDisplay').value = '';
            document.getElementById('DateCompletedBinding').value = '';
            document.getElementById('DateCompletedPicker').value = '';
        }
    }

    document.getElementById('DateCompletedPicker').addEventListener('change', function () {
        if (this.value) {
            document.getElementById('underSdReviewChk').checked = false;
            document.getElementById('onTargetChk').checked = false;
        }
    });
</script>

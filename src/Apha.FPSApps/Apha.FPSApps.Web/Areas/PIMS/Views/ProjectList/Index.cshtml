@using Apha.FPSApps.Web.Models.Components.DataGrid
@model Apha.FPSApps.Web.Areas.PIMS.Models.ProjectListViewModel

@{
    ViewData["Title"] = "PIMS : Select Project";
}

<style>
    .input-group-text {
        border-radius: 0 5px 5px 0;
        padding: 7px 6px 6px 6px;
        border: 1px solid #919191;
    }
</style>

<div class="row">
    <div class="col-lg-12">
        <main class="main-content" style="padding: 0;">
            <div class="container-fluid" style="padding: 0;">
                <div class="col-12">
                    <div class="align-items-start m-10">

                        <div class="search-panel">
                            <div class="govuk-grid-column-full display-flex justify-content-between">
                                <div>
                                </div>
                                <div>
                                    <div class="govuk-radios govuk-radios--inline govuk-radios govuk-radios--small" data-module="govuk-radios">
                                        <div class="govuk-!-padding-top-2 govuk-!-padding-right-5">Show Which Project?</div>
                                        <div class="govuk-radios__item">
                                            <input class="govuk-radios__input"
                                                   type="radio"
                                                   name="projectFilter"
                                                   id="rdactive"
                                                   value="1"
                                            @(Model.FilterOption == 1 ? "checked" : "")
                                                   onchange="applyProjectFilter()" />
                                            <label class="govuk-label govuk-radios__label" for="rdactive">Active</label>
                                        </div>
                                        <div class="govuk-radios__item">
                                            <input class="govuk-radios__input"
                                                   type="radio"
                                                   name="projectFilter"
                                                   id="rdall"
                                                   value="2"
                                            @(Model.FilterOption == 2 ? "checked" : "")
                                                   onchange="applyProjectFilter()" />
                                            <label class="govuk-label govuk-radios__label" for="rdall">All</label>
                                        </div>
                                    </div>
                                </div>
                                <div class="govuk-!-margin-right-10">
                                    <button class="govuk-button sup_margin_0" id="addBtn">
                                        + &nbsp;New Project
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- Grid Container -->
                        <div class = "isProjectList" id="@($"gridContainer_{Model.ProjectGrid.GridId}")">
                            @await Html.PartialAsync("_DataGrid", Model.ProjectGrid)
                        </div>

                    </div>
                </div>
            </div>
        </main>
    </div>
</div>

@section Scripts {
    <script>
        var projectGridId = '@Model.ProjectGrid.GridId';

        $(document).ready(function () {
            @if (TempData["SuccessMessage"] != null)
            {
                <text>showAlertMessage('@Html.Raw(TempData["SuccessMessage"])', AlertType.SUCCESS);</text>
            }
            @if (TempData["Error"] != null)
            {
                <text>showAlertMessage('@Html.Raw(TempData["Error"])', AlertType.ERROR);</text>
            }

            $('#addBtn').on('click', function () {
                window.location.href = '@Url.Action("Index", "ProposedProject", new { area = "PIMS" })';
            });
        });

        function getGridManager() {
            return window['gridManager_' + projectGridId];
        }

        function applyProjectFilter() {
            var gridManager = getGridManager();
            if (gridManager) {
                gridManager.reloadGrid({ page: 1 });
            } else {
                console.error('Grid manager not found for grid:', projectGridId);
            }
        }

        function getProjectExtraFilters() {
            const radios = document.querySelectorAll('input[name="projectFilter"]');
            let filterOption = 1; // Default: Active
            radios.forEach(function (radio) {
                if (radio.checked) {
                    filterOption = parseInt(radio.value);
                }
            });
            return { filterOption: filterOption };
        }

        function searchTable() {
            var filter = document.getElementById("searchInput").value.toUpperCase();
            var tbody = document.querySelector('#tbl_@(Model.ProjectGrid.GridId) tbody');
            if (!tbody) return;

            Array.from(tbody.getElementsByTagName("tr")).forEach(function (row) {
                var cells = row.getElementsByTagName("td");
                var found = Array.from(cells).some(function (cell) {
                    return cell.innerHTML.toUpperCase().includes(filter);
                });
                row.style.display = found ? "" : "none";
            });
        }

        function viewProject(btn) {
            var parentproject = $(btn).data('id');
            window.location.href = '/PIMS/ProjectDetails/Index?parentproject=' + encodeURIComponent(parentproject);
        }
    </script>
}

@model Apha.FPSApps.Web.Areas.PIMS.Models.MilestoneItem
@{
    ViewData["Title"] = "PIMS : PMD Milestone Details";
    string parentproject = Model?.Project ?? string.Empty;
}

@if (Model != null)
{
<div class="govuk-grid-row govuk-!-margin-bottom-3 sup_border-bottom govuk-!-padding-left-1 govuk-!-padding-right-1">
    <div class="govuk-grid-column-full sup_flex_between_center">
        <h1 class="govuk-heading-s sup_margin_0 govuk-!-padding-top-2 govuk-!-padding-bottom-2">
            Milestone List Details
        </h1>
        <a href="@Url.Action("Index", "PMDMilestone", new { area = "PIMS", parentproject })"
           class="govuk-back-link govuk-!-margin-top-0 govuk-!-margin-bottom-0 govuk-!-margin-left-3 govuk-!-margin-right-3">Back</a>
    </div>
</div>

<div class="govuk-grid-row sup_margin_left_right_10">
    <div class="govuk-grid-column-full">

        <div id="dbErrorSummary" class="govuk-error-summary govuk-!-display-none" role="alert"
             aria-labelledby="dbErrorSummaryTitle" tabindex="-1">
            <h2 class="govuk-error-summary__title govuk-!-font-size-16" id="dbErrorSummaryTitle">There is a problem</h2>
            <div class="govuk-error-summary__body">
                <ul class="govuk-list govuk-error-summary__list" id="dbErrorSummaryList"></ul>
            </div>
        </div>

        <form id="milestoneDetailsForm" novalidate class="govuk-grid-column-one-third govuk-!-padding-left-0">
            @Html.AntiForgeryToken()
            <input type="hidden" name="Project" value="@Model?.Project" />
            <input type="hidden" name="Number" value="@Model?.Number" />
          

            <div class="govuk-form-group" id="fg-projectcode">
                <span class="govuk-label govuk-!-font-weight-bold govuk-!-font-size-16" style="display: inline-block; min-width: 150px;">Project:</span>
                <span class="govuk-body govuk-!-font-size-16">@Model?.Project</span>
            </div>

            <div class="govuk-form-group" id="fg-milestone">
                <span class="govuk-label govuk-!-font-weight-bold govuk-!-font-size-16" style="display: inline-block; min-width: 150px;">Milestone :</span>
                <span class="govuk-body govuk-!-font-size-16">@Model?.Number</span>
            </div>

            <div class="govuk-form-group" id="fg-description">
                <span class="govuk-label govuk-!-font-weight-bold govuk-!-font-size-16" style="display: inline-block; min-width: 150px;">Description :</span>
                <span class="govuk-body govuk-!-font-size-16">@Model?.Description</span>
            </div>

            <div class="govuk-form-group" id="fg-datedue">
                <span class="govuk-label govuk-!-font-weight-bold govuk-!-font-size-16" style="display: inline-block; min-width: 150px;">Date Due :</span>
                <span class="govuk-body govuk-!-font-size-16">@Model?.DateDue?.ToString("dd/MM/yyyy")</span>
            </div>

            <div class="govuk-form-group">
                <div class="govuk-checkboxes govuk-checkboxes--small">
                    <div class="govuk-checkboxes__item">
                        <input class="govuk-checkboxes__input"
                               id="underreview"
                               name="UnderSdReview"
                               type="checkbox"
                               value="-1"
                               @(Model?.UnderSdReview == -1 ? "checked" : "")
                               onchange="onUnderReviewChanged(this)">
                        <label class="govuk-checkboxes__label govuk-!-font-size-16" for="underreview">Under Review</label>
                        <input type="hidden" name="UnderSdReview" value="0" />
                    </div>
                </div>
            </div>

            <div class="govuk-form-group">
                <div class="govuk-checkboxes govuk-checkboxes--small">
                    <div class="govuk-checkboxes__item">
                        <input class="govuk-checkboxes__input"
                               id="ontarget"
                               name="OnTarget"
                               type="checkbox"
                               value="-1"
                               @(Model?.OnTarget == -1 ? "checked" : "")
                               onchange="onOnTargetChanged(this)">
                        <label class="govuk-checkboxes__label govuk-!-font-size-16" for="ontarget">On Target</label>
                        <input type="hidden" name="OnTarget" value="0" />
                    </div>
                </div>
            </div>

            <div class="govuk-form-group" id="fg-datecompleted">
                <label class="govuk-label govuk-!-font-weight-bold govuk-!-font-size-16" for="DateCompletedDisplay">Date Completed</label>
                <div style="position:relative; display:flex; align-items:center; width:stretch;">
                    <input type="text"
                           id="DateCompletedDisplay"
                           class="govuk-input govuk-!-font-size-16"
                           value="@(Model?.DateCompleted?.ToString("dd/MM/yyyy") ?? string.Empty)"
                           aria-label="DateCompletedDisplay"
                           placeholder="dd/mm/yyyy"
                           maxlength="10"
                           autocomplete="off"
                           oninput="formatDateInput(this)"
                           onblur="validateAndSyncDate('DateCompletedDisplay', 'DateCompletedBinding', 'DateCompletedError')"
                           style="flex:1;">
                    <button type="button"
                            onclick="openDatePicker('DateCompletedPicker')"
                            style="margin-left:4px; padding:6px 10px; cursor:pointer; background:#f3f2f1; border:2px solid #0b0c0c; font-size:1rem; line-height:1;"
                            aria-label="Open date picker for Date Completed">&#128197;</button>
                    <input type="hidden"
                           name="DateCompleted"
                           id="DateCompletedBinding"
                           value="@(Model?.DateCompleted?.ToString("yyyy-MM-dd") ?? string.Empty)">
                    <input type="date"
                           id="DateCompletedPicker"
                           value="@(Model?.DateCompleted?.ToString("yyyy-MM-dd") ?? string.Empty)"
                           onchange="syncDateToText('DateCompletedPicker', 'DateCompletedDisplay', 'DateCompletedBinding', 'DateCompletedError')"
                           style="display:none;">
                </div>
                <span id="DateCompletedError" class="govuk-error-message" style="display:none;"></span>
            </div>

            <div class="govuk-form-group" id="fg-comment">
                <label class="govuk-label govuk-!-font-weight-bold govuk-!-font-size-16" asp-for="ProjectLeaderComment">
                    Project Leaders Comment <span class="app-required" aria-hidden="true">*</span>
                </label>
                <textarea class="govuk-textarea govuk-!-font-size-16" asp-for="ProjectLeaderComment" rows="4"></textarea>
                <span asp-validation-for="ProjectLeaderComment" class="govuk-error-message govuk-!-display-none"></span>
            </div>

            <div class="govuk-button-group">
                <button type="button" class="govuk-button govuk-!-font-size-16" onclick="submitMilestoneDetails()">Update</button>
                <button type="button" class="govuk-button govuk-button--secondary govuk-!-font-size-16"
                        onclick="window.location.href='@Url.Action("Index", "PMDMilestone", new { area = "PIMS", parentproject })'">Cancel</button>
            </div>
        </form>
    </div>
</div>
}
else
{
    <div class="govuk-grid-row sup_margin_left_right_10">
        <div class="govuk-grid-column-full">
            <p class="govuk-body">No milestone data available.</p>
        </div>
    </div>
}

@section Scripts {
    <script>
        // Date handling functions (same as in _AddEditMilestone.cshtml)
        function openDatePicker(pickerId) {
            var picker = document.getElementById(pickerId);
            if (picker) {
                try { picker.showPicker(); } catch (e) { picker.click(); }
            }
        }

        function syncDateToText(pickerId, displayId, hiddenId, errorId) {
            var picker = document.getElementById(pickerId);
            if (picker.value) {
                var parts = picker.value.split('-');
                document.getElementById(displayId).value = parts[2] + '/' + parts[1] + '/' + parts[0];
                document.getElementById(hiddenId).value = picker.value;
            } else {
                document.getElementById(displayId).value = '';
                document.getElementById(hiddenId).value = '';
            }
            if (errorId) {
                var err = document.getElementById(errorId);
                if (err) { err.style.display = 'none'; err.textContent = ''; }
            }
        }

        function formatDateInput(input) {
            var val = input.value.replace(/[^\d\/\-]/g, '');
            if (val.length > 10) val = val.substring(0, 10);
            input.value = val;
        }

        function validateAndSyncDate(displayId, hiddenId, errorId) {
            var display = document.getElementById(displayId);
            var hidden  = document.getElementById(hiddenId);
            var errorEl = document.getElementById(errorId);
            var val = display.value.trim();

            if (!val) {
                hidden.value = '';
                errorEl.style.display = 'none';
                errorEl.textContent = '';
                return;
            }

            if (/^\d{4}[\\/\-]\d{2}[\\/\-]\d{2}$/.test(val)) {
                hidden.value = '';
                errorEl.textContent = 'Enter the date in dd/mm/yyyy format, not yyyy/mm/dd';
                errorEl.style.display = 'block';
                return;
            }

            var usMatch = val.match(/^(\d{2})\/(\d{2})\/(\d{4})$/);
            if (usMatch && parseInt(usMatch[2], 10) > 12) {
                hidden.value = '';
                errorEl.textContent = 'Enter the date in dd/mm/yyyy format, not mm/dd/yyyy';
                errorEl.style.display = 'block';
                return;
            }

            var match = val.match(/^(\d{2})\/(\d{2})\/(\d{4})$/);
            if (!match) {
                hidden.value = '';
                errorEl.textContent = 'Enter the date in dd/mm/yyyy format';
                errorEl.style.display = 'block';
                return;
            }

            var day   = parseInt(match[1], 10);
            var month = parseInt(match[2], 10);
            var year  = parseInt(match[3], 10);
            var date  = new Date(year, month - 1, day);

            if (date.getFullYear() !== year || date.getMonth() !== (month - 1) || date.getDate() !== day) {
                hidden.value = '';
                errorEl.textContent = 'Enter a valid date in dd/mm/yyyy format';
                errorEl.style.display = 'block';
                return;
            }

            var mm = String(month).padStart(2, '0');
            var dd = String(day).padStart(2, '0');
            hidden.value = year + '-' + mm + '-' + dd;
            errorEl.style.display = 'none';
            errorEl.textContent = '';
        }

        function onUnderReviewChanged(checkbox) {
            // Update hidden input based on checkbox state
            const hiddenInput = checkbox.parentElement.querySelector('input[type="hidden"][name="UnderSdReview"]');
            if (hiddenInput) {
                hiddenInput.value = checkbox.checked ? -1 : 0;
            }
        }

        function onOnTargetChanged(checkbox) {
            // Update hidden input based on checkbox state
            const hiddenInput = checkbox.parentElement.querySelector('input[type="hidden"][name="OnTarget"]');
            if (hiddenInput) {
                hiddenInput.value = checkbox.checked ? -1 : 0;
            }
        }

        function submitMilestoneDetails() {
            const form = document.getElementById('milestoneDetailsForm');
            if (!form) return;

            // Validate form
            if (!validateMilestoneForm()) {
                return;
            }

            // Sync hidden values for date
            validateAndSyncDate('DateCompletedDisplay', 'DateCompletedBinding', 'DateCompletedError');

            // Prepare form data
            const formData = new FormData(form);
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

            $.ajax({
                url: '@Url.Action("EditMilestoneDetails", "PMDMilestone", new { area = "PIMS" })',
                type: 'POST',
                headers: { 'RequestVerificationToken': token },
                data: {
                    project: formData.get('Project'),
                    number: formData.get('Number'),
                    datecompleted: formData.get('DateCompleted'),
                    underreview: formData.get('UnderSdReview'),
                    ontarget: formData.get('OnTarget'),
                    projectleadercomment: formData.get('ProjectLeaderComment'),
                    __RequestVerificationToken: token
                },
                success: function (result) {
                    if (result.success) {
                        showAlertMessage(result.message, AlertType.SUCCESS).then(function () {
                            window.location.href = '@Url.Action("Index", "PMDMilestone", new { area = "PIMS", parentproject })';
                        });
                    } else {
                        displayErrorSummary(result.errors || ['Failed to update milestone.']);
                    }
                },
                error: function (xhr) {
                    displayErrorSummary(['An unexpected error occurred.']);
                }
            });
        }

        function validateMilestoneForm() {
            const errors = [];
            const projectLeaderComment = document.querySelector('[name="ProjectLeaderComment"]')?.value || '';
            const dateCompletedError = document.getElementById('DateCompletedError');

            if (!projectLeaderComment.trim()) {
                errors.push('Project Leaders Comment is required.');
            }

            // Check if there are any date validation errors
            if (dateCompletedError && dateCompletedError.style.display === 'block') {
                errors.push('Please fix the Date Completed field.');
            }

            if (errors.length > 0) {
                displayErrorSummary(errors);
                return false;
            }

            return true;
        }

        function displayErrorSummary(errors) {
            const errorSummary = document.getElementById('dbErrorSummary');
            const errorList = document.getElementById('dbErrorSummaryList');

            if (errorSummary && errorList) {
                errorList.innerHTML = '';
                errors.forEach(error => {
                    const li = document.createElement('li');
                    li.textContent = typeof error === 'string' ? error : error.message || 'An error occurred';
                    errorList.appendChild(li);
                });
                errorSummary.classList.remove('govuk-!-display-none');
            }
        }
    </script>
}



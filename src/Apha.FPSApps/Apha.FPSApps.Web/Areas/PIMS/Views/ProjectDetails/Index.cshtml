@using Apha.FPSApps.Web.Models.Components.DataGrid
@model Apha.FPSApps.Web.Areas.PIMS.Models.ProjectDetailsViewModel

@{
    ViewData["Title"] = "PIMS : Project Details";
    string parentproject = Model.Parentproject;
}

<div class="govuk-grid-row sup_border-bottom" style="padding: 0">
    <h5 class="govuk-heading-s sup_margin_0"
        style="padding: 10px 0 5px 24px;">
        Project Details
    </h5>
</div>

<div id="saveSuccessAlert" class="alert alert-success alert-dismissible fade" role="alert" style="display: none; margin: 10px 24px 0 24px;">
    <span id="saveSuccessMessage"></span>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
</div>

<div class="d-flex govuk-!-padding-top-2">

    <!-- ── Side Navigation ─────────────────────────────────────────── -->
    @await Html.PartialAsync("_SideNav", @Model)

    <!-- ── Main Content ────────────────────────────────────────────── -->
    <main class="main-content" style="padding-top: 0px">
        <div class="govuk-grid-row">
            <div class="govuk-grid-column-full"
                 style="display: flex; align-items: flex-start; gap: 20px;">

                <!-- ── Left Column: Tabs ──────────────────────────────────── -->
                <div class="govuk-grid-column-one-half p-0">
                    <div class="govuk-template__body js-enabled govuk-frontend-supported">
                        <div class="govuk-tabs" data-module="govuk-tabs" id="projectDetailsTabs">
                            <ul class="govuk-tabs__list">
                                <li class="govuk-tabs__list-item  @(Model.IsFPS ? "govuk-tabs__list-item--selected" : "")"
                                    id="tab_nav-home">
                                    <a class="govuk-tabs__tab tab-font-bold-size"
                                           href="#nav-home" role="tab"
                                           aria-controls="nav-home" aria-selected="@(Model.IsFPS ? "true" : "false")" @(!Model.IsFPS ? "tabindex=\"-1\"" : "")>
                                        FPS Project Details
                                    </a>
                                </li>
                                <li class="govuk-tabs__list-item  @(!Model.IsFPS ? "govuk-tabs__list-item--selected" : "")"
                                    id="tab_nav-profile">
                                    <a class="govuk-tabs__tab tab-font-bold-size"
                                           href="#nav-profile" role="tab"
                                           aria-controls="nav-profile" aria-selected="@(!Model.IsFPS ? "true" : "false")" @(Model.IsFPS ? "tabindex=\"-1\"" : "")>
                                        Proposed Project Details
                                    </a>
                                </li>
                                <li class="govuk-tabs__list-item "
                                    id="tab_nav-contact">
                                    <a class="govuk-tabs__tab tab-font-bold-size"
                                           href="#nav-contact" role="tab"
                                           aria-controls="nav-contact" aria-selected="false" tabindex="-1">
                                        FPS Yearly Details
                                    </a>
                                </li>
                            </ul>

                            <!-- Tab 1: FPS Project Details (read-only) -->
                            <div class="govuk-tabs__panel govuk-!-padding-2 @(!Model.IsFPS ? "govuk-tabs__panel--hidden" : "")"
                                 id="nav-home" role="tabpanel"
                                 style="min-height: 40px"
                                 hidden=@(!Model.IsFPS)
                                 aria-labelledby="tab_nav-home">
                                @if (Model.FpsProjectDetails is not null)
                                {
                                    <div class="govuk-grid-row" style="align-items: flex-start">
                                        <div class="govuk-grid-column-one-quarter">
                                            <label class="govuk-!-font-size-16 sup_font_weight_700"
                                                   asp-for="FpsProjectDetails.Parentproject">
                                                Project
                                            </label>
                                        </div>
                                        <div class="govuk-grid-column-three-quarters sup_font_weight_700">
                                            <p id="selected_project" class="govuk-!-font-size-16 sup_font_weight_700">
                                                @Model.FpsProjectDetails.Parentproject
                                            </p>
                                        </div>
                                    </div>
                                    <div class="govuk-grid-row">
                                        <div class="govuk-grid-column-one-quarter">
                                            <label class="govuk-!-font-size-16 sup_font_weight_700"
                                                   asp-for="FpsProjectDetails.Projecttitle">
                                                Title
                                            </label>
                                        </div>
                                        <div class="govuk-grid-column-three-quarters sup_font_weight_700">
                                            <p class="govuk-!-font-size-16 sup_font_weight_700">@Model.FpsProjectDetails.Projecttitle</p>
                                        </div>
                                    </div>
                                    <div class="govuk-grid-row">
                                        <div class="govuk-grid-column-one-quarter">
                                            <label class="govuk-!-font-size-16 sup_font_weight_700"
                                                   asp-for="FpsProjectDetails.Disease">
                                                Disease
                                            </label>
                                        </div>
                                        <div class="govuk-grid-column-three-quarters sup_font_weight_700">
                                            <p class="govuk-!-font-size-16 sup_font_weight_700">
                                                @(string.IsNullOrWhiteSpace(Model.FpsProjectDetails.Disease)
                                                    ? "Not Specified"
                                                    : Model.FpsProjectDetails.Disease)
                                            </p>
                                        </div>
                                    </div>
                                    <div class="govuk-grid-row">
                                        <div class="govuk-grid-column-one-quarter">
                                            <label class="govuk-!-font-size-16 sup_font_weight_700"
                                                   asp-for="FpsProjectDetails.Contract">
                                                Contract
                                            </label>
                                        </div>
                                        <div class="govuk-grid-column-three-quarters sup_font_weight_700">
                                            <p class="govuk-!-font-size-16 sup_font_weight_700">@Model.FpsProjectDetails.Contract</p>
                                        </div>
                                    </div>
                                    <div class="govuk-grid-row">
                                        <div class="govuk-grid-column-one-quarter">
                                            <label class="govuk-!-font-size-16 sup_font_weight_700"
                                                   asp-for="FpsProjectDetails.Projectstatus">
                                                Status
                                            </label>
                                        </div>
                                        <div class="govuk-grid-column-three-quarters sup_font_weight_700">
                                            <p class="govuk-!-font-size-16 sup_font_weight_700">@Model.FpsProjectDetails.Projectstatus</p>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <p class="tab-font-size govuk-hint">No FPS record found for this project.</p>
                                }
                            </div>

                            <!-- Tab 2: Proposed Project Details (editable) -->
                            <div class="govuk-tabs__panel govuk-!-padding-2 @(Model.IsFPS ? "govuk-tabs__panel--hidden" : "")"
                                 id="nav-profile" role="tabpanel"
                                 style="min-height: 460px;"
                                 hidden=@(Model.IsFPS)
                                 aria-labelledby="tab_nav-profile">
                                <div class="govuk-grid-column-full p-0">
                                    <div class="govuk-form-group">
                                        <form asp-action="UpdateProposedProject"
                                              asp-controller="ProjectDetails"
                                              asp-area="PIMS"
                                              asp-route-parentproject="@parentproject"
                                              method="post"
                                              class="govuk-form-group"
                                              id="formProposedDetail">
                                            @Html.AntiForgeryToken()
                                            <fieldset class="govuk-fieldset">
                                                <input type="hidden" asp-for="ProposedProjectDetails.Id" />
                                                <div class="govuk-grid-row">
                                                    <div class="govuk-grid-column-one-half">
                                                        <div class="govuk-form-group mb-2">
                                                            <label class="govuk-label govuk-!-font-size-16 sup_font_weight_700"
                                                                   for="project-transfer">Project</label>
                                                            <input class="govuk-input govuk-!-font-size-16"
                                                                   id="project-transfer"
                                                                   type="text"
                                                                   readonly="readonly"
                                                                   maxlength="20"
                                                                   asp-for="ProposedProjectDetails.Parentproject" />
                                                        </div>
                                                    </div>
                                                    <div class="govuk-grid-column-one-half">
                                                        <div class="govuk-form-group mb-2">
                                                            <label class="govuk-label govuk-!-font-size-16 sup_font_weight_700"
                                                                   for="transfer-to">Transfer to</label>
                                                            <select class="govuk-select govuk-!-font-size-16"
                                                                    id="transfer-to"
                                                                    asp-for="ProposedProjectDetails.TransferTo"
                                                                    asp-items="Model.TransferToOptions"
                                                                    style="min-width: stretch;">
                                                            </select>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="govuk-form-group mb-2">
                                                    <label class="govuk-label govuk-!-font-size-16 sup_font_weight_700"
                                                        aria-label="title-transfer"
                                                        asp-for="ProposedProjectDetails.Projecttitle">
                                                        Title
                                                    </label>
                                                    <textarea class="govuk-textarea govuk-!-font-size-16"
                                                              id="title-transfer"
                                                              aria-label="title-transfer"
                                                              asp-for="ProposedProjectDetails.Projecttitle"
                                                              rows="2"
                                                              style="margin-bottom: auto;">ProposedProjectDetails.Projecttitle</textarea>
                                                </div>
                                                <div class="govuk-grid-row">
                                                    <div class="govuk-grid-column-one-half">
                                                        <div class="govuk-form-group mb-2">
                                                            <label class="govuk-label govuk-!-font-size-16 sup_font_weight_700"
                                                                   for="costbook-transfer"
                                                                   asp-for="ProposedProjectDetails.Costbookno">
                                                                Costbook No
                                                            </label>
                                                            <input class="govuk-input govuk-!-font-size-16"
                                                                   id="costbook-transfer"
                                                                   asp-for="ProposedProjectDetails.Costbookno"
                                                                   type="text" />
                                                        </div>
                                                    </div>
                                                    <div class="govuk-grid-column-one-half">
                                                        <div class="govuk-form-group mb-2">
                                                            <label class="govuk-label govuk-!-font-size-16 sup_font_weight_700"
                                                                   asp-for="ProposedProjectDetails.Disease">
                                                                Disease
                                                            </label>
                                                            <input class="govuk-input govuk-!-font-size-16"
                                                                   id="disease-transfer"
                                                                   aria-label="disease-transfer"
                                                                   asp-for="ProposedProjectDetails.Disease"
                                                                   type="text" />
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="govuk-grid-row">
                                                    <div class="govuk-grid-column-one-half">
                                                        <div class="govuk-form-group mb-2">
                                                            <label class="govuk-label govuk-!-font-size-16 sup_font_weight_700"
                                                                   asp-for="ProposedProjectDetails.Program">
                                                                Program
                                                            </label>
                                                            <input class="govuk-input govuk-!-font-size-16"
                                                                   id="program-transfer"
                                                                   aria-label="program-transfer"
                                                                   asp-for="ProposedProjectDetails.Program"
                                                                   type="text" />
                                                        </div>
                                                    </div>
                                                    <div class="govuk-grid-column-one-half">
                                                        <div class="govuk-form-group mb-2">
                                                            <label class="govuk-label govuk-!-font-size-16 sup_font_weight_700"
                                                                   asp-for="ProposedProjectDetails.Customer">
                                                                Customer
                                                            </label>
                                                            <input class="govuk-input govuk-!-font-size-16"
                                                                   id="customer-transfer"
                                                                   aria-label="customer-transfer"
                                                                   asp-for="ProposedProjectDetails.Customer"
                                                                   type="text" />
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="govuk-form-group mb-2">
                                                    <label class="govuk-label govuk-!-font-size-16 sup_font_weight_700"
                                                           asp-for="ProposedProjectDetails.Manager">
                                                        Manager
                                                    </label>
                                                    <input class="govuk-input govuk-!-font-size-16"
                                                           id="manager-transfer"
                                                           aria-label="manager-transfer"
                                                           asp-for="ProposedProjectDetails.Manager"
                                                         
                                                           type="text" />
                                                </div>
                                            </fieldset>
                                            <div class="govuk-button-group govuk-!-margin-top-2 govuk-!-margin-bottom-2"
                                                 style="display: flex; justify-content: end;">
                                                <a href="@Url.Action("Index", "ProjectList", new { area = "PIMS" })"
                                                   class="govuk-button govuk-button--secondary govuk-!-font-size-16">Cancel</a>
                                                <button type="submit" class="govuk-button govuk-!-font-size-16">Save</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>

                            <!-- Tab 3: FPS Yearly Details (read-only) -->
                            <div class="govuk-tabs__panel govuk-!-padding-2 govuk-tabs__panel--hidden"
                                 id="nav-contact" role="tabpanel"
                                 style="min-height: 460px; overflow: auto"
                                 hidden=@(!Model.IsFPS)
                                 aria-labelledby="tab_nav-contact">
                                <div class="sup_overflow_y_400 ">
                                    <table class="govuk-table custom-table"
                                           style="border-right: 1px solid; border-bottom-color: var(--govuk-border-colour, #cecece); word-wrap: break-word; overflow-wrap: break-word;">
                                        <thead class="govuk-table__head tab-font-bold-size">
                                            <tr class="govuk-table__row">
                                                <th class="govuk-table__header">Year</th>
                                                <th class="govuk-table__header">Program</th>
                                                <th class="govuk-table__header">Customer</th>
                                                <th class="govuk-table__header">Manager</th>
                                            </tr>
                                        </thead>
                                        <tbody class="govuk-table__body tab-font-size">
                                            @if (Model.YearlyDetails.Any())
                                            {
                                                @foreach (var row in Model.YearlyDetails)
                                                {
                                                    <tr class="govuk-table__row">
                                                        <td class="govuk-table__cell">@row.Year</td>
                                                        <td class="govuk-table__cell">@row.Program</td>
                                                        <td class="govuk-table__cell">@row.Customer</td>
                                                        <td class="govuk-table__cell">@row.Manager</td>
                                                    </tr>
                                                }
                                            }
                                            else
                                            {
                                                <tr class="govuk-table__row">
                                                    <td class="govuk-table__cell text-center" colspan="4">No yearly records found.</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ── Right Column: PIMS Details Form ───────────────────── -->
                <div class="govuk-grid-column-one-half">
                    <form asp-action="SavePimsDetail"
                          asp-controller="ProjectDetails"
                          asp-area="PIMS"
                          asp-route-parentproject="@parentproject"
                          method="post"
                          class="govuk-form-group selectedProjectForm "
                          id="formPimsDetailRight">
                        @Html.AntiForgeryToken()
                        <div class="flex-column">
                            <fieldset class="govuk-fieldset">
                                <div class="headline">
                                    <h6 class="selectedProjectForm sup_font_weight_700 govuk-form-group">PIMS Details</h6>
                                </div>
                                <div class="govuk-grid-row">
                                    <!-- Left sub-column -->
                                    <div class="govuk-grid-column-one-half">
                                        <div class="govuk-form-group">      
                                            <label class="govuk-label govuk-!-font-size-16 sup_font_weight_700" for="pims-version">
                                                Version
                                            </label>
                                            <input class="govuk-input govuk-!-font-size-16"
                                                   id="pims-version"
                                                   asp-for="ProjectDetails.Version"
                                                   type="text"
                                                   maxlength="10" />
                                        </div>
                                        <div class="govuk-form-group">
                                            <label class="govuk-label govuk-!-font-size-16 sup_font_weight_700" for="file-ref">
                                                File Ref
                                            </label>
                                            <input class="govuk-input govuk-!-font-size-16"
                                                   id="file-ref"
                                                   asp-for="ProjectDetails.FileRef"
                                                   type="text"
                                                   maxlength="20" />
                                        </div>
                                        <div class="govuk-form-group">
                                            <label class="govuk-label govuk-!-font-size-16 sup_font_weight_700" for="customer-ref">
                                                Customer Ref
                                            </label>
                                            <input class="govuk-input govuk-!-font-size-16"
                                                   id="customer-ref"
                                                   asp-for="ProjectDetails.CustomerRef"
                                                   type="text"
                                                   maxlength="20" />
                                        </div>
                                        <div class="govuk-form-group">
                                            <label class="govuk-label govuk-!-font-size-16 sup_font_weight_700" for="StartDateDisplay">
                                                Start Date
                                            </label>
                                            <div style="position:relative; display:flex; align-items:center; width:100%;">
                                                <input type="text"
                                                       id="StartDateDisplay"
                                                       class="govuk-input govuk-!-font-size-16"
                                                       value="@(Model.ProjectDetails?.StartDate?.ToString("dd/MM/yyyy") ?? string.Empty)"
                                                       placeholder="dd/mm/yyyy"
                                                       maxlength="10"
                                                       autocomplete="off"
                                                       oninput="formatDateInput(this)"
                                                       onblur="validateAndSyncDate('StartDateDisplay', 'StartDateBinding', 'StartDateError')"
                                                       style="flex:1;">
                                                <button type="button"
                                                        onclick="openDatePicker('StartDatePicker')"
                                                        style="margin-left:4px; padding:6px 10px; cursor:pointer; background:#f3f2f1; border:2px solid #0b0c0c; font-size:1rem; line-height:1;"
                                                        aria-label="Open date picker for Start Date">&#128197;</button>
                                                <input type="hidden"
                                                       name="ProjectDetails.StartDate"
                                                       id="StartDateBinding"
                                                       value="@(Model.ProjectDetails?.StartDate?.ToString("yyyy-MM-dd") ?? string.Empty)">
                                                <input type="date"
                                                       id="StartDatePicker"
                                                       value="@(Model.ProjectDetails?.StartDate?.ToString("yyyy-MM-dd") ?? string.Empty)"
                                                       aria-label="Start Date picker"
                                                       style="position:absolute; top:0; left:0; opacity:0; width:1px; height:1px; pointer-events:auto;"
                                                       onchange="onStartDateChanged('StartDatePicker', 'StartDateDisplay', 'StartDateBinding', 'StartDateError')">
                                            </div>
                                            <span id="StartDateError" class="govuk-error-message" style="display:none;"></span>
                                        </div>
                                        <div class="govuk-form-group">
                                            <label class="govuk-label govuk-!-font-size-16 sup_font_weight_700" for="EndDateDisplay">
                                                End Date
                                            </label>
                                            <div style="position:relative; display:flex; align-items:center; width:100%;">
                                                <input type="text"
                                                       id="EndDateDisplay"
                                                       class="govuk-input govuk-!-font-size-16"
                                                       value="@(Model.ProjectDetails?.EndDate?.ToString("dd/MM/yyyy") ?? string.Empty)"
                                                       placeholder="dd/mm/yyyy"
                                                       maxlength="10"
                                                       autocomplete="off"
                                                       oninput="formatDateInput(this)"
                                                       onblur="validateAndSyncDate('EndDateDisplay', 'EndDateBinding', 'EndDateError')"
                                                       style="flex:1;">
                                                <button type="button"
                                                        onclick="openDatePicker('EndDatePicker')"
                                                        style="margin-left:4px; padding:6px 10px; cursor:pointer; background:#f3f2f1; border:2px solid #0b0c0c; font-size:1rem; line-height:1;"
                                                        aria-label="Open date picker for End Date">&#128197;</button>
                                                <input type="hidden"
                                                       name="ProjectDetails.EndDate"
                                                       id="EndDateBinding"
                                                       value="@(Model.ProjectDetails?.EndDate?.ToString("yyyy-MM-dd") ?? string.Empty)"
                                                       data-original-value="@(Model.ProjectDetails?.EndDate?.ToString("yyyy-MM-dd") ?? string.Empty)">
                                                <input type="date"
                                                       id="EndDatePicker"
                                                       value="@(Model.ProjectDetails?.EndDate?.ToString("yyyy-MM-dd") ?? string.Empty)"
                                                       aria-label="End Date picker"
                                                       style="position:absolute; top:0; left:0; opacity:0; width:1px; height:1px; pointer-events:auto;"
                                                       onchange="onEndDateChanged('EndDatePicker', 'EndDateDisplay', 'EndDateBinding', 'EndDateError')">
                                            </div>
                                            <span id="EndDateError" class="govuk-error-message" style="display:none;"></span>
                                        </div>
                                    </div>
                                    <!-- Right sub-column -->
                                    <div class="govuk-grid-column-one-half">
                                        <div class="govuk-form-group">
                                            <label class="govuk-label govuk-!-font-size-16 sup_font_weight_700" for="costbook-number">
                                                Costbook Number
                                            </label>
                                            <input class="govuk-input govuk-!-font-size-16"
                                                   id="costbook-number"
                                                   asp-for="ProjectDetails.CostbookNumber"
                                                   type="text"
                                                   maxlength="10" />
                                        </div>
                                        <div class="govuk-form-group">
                                            <label class="govuk-label govuk-!-font-size-16 sup_font_weight_700" for="risk-rating">
                                                Risk Rating
                                            </label>
                                            <select class="govuk-select govuk-!-font-size-16"
                                                    id="risk-rating"
                                                    asp-for="ProjectDetails.Riskid"
                                                    asp-items="Model.RiskRatingOptions"
                                                    style="min-width: stretch;">
                                            </select>
                                        </div>
                                        <div class="govuk-checkboxes govuk-checkboxes--small"
                                             style="margin-top: 33px;">
                                            <div class="govuk-checkboxes__item">
                                                <input class="govuk-checkboxes__input govuk-!-font-size-16"
                                                       id="use-project-yr"
                                                       asp-for="UseProjectYears"
                                                       type="checkbox"
                                                       value="true" />
                                                <label class="govuk-label govuk-checkboxes__label govuk-!-font-size-16 sup_font_weight_700"
                                                       for="use-project-yr">
                                                    Use Project Years?
                                                </label>
                                            </div>
                                        </div>
                                        <div class="govuk-form-group" style="margin-top: 18px;">
                                            <label class="govuk-label govuk-!-font-size-16 sup_font_weight_700"
                                                   for="RevisedEndDateDisplay">Revised End Date</label>
                                            <div style="position:relative; display:flex; align-items:center; width:100%;">
                                                <input type="text"
                                                       id="RevisedEndDateDisplay"
                                                       class="govuk-input govuk-!-font-size-16"
                                                       value="@(Model.ProjectDetails?.RevisedEndDate?.ToString("dd/MM/yyyy") ?? string.Empty)"
                                                       placeholder="dd/mm/yyyy"
                                                       maxlength="10"
                                                       autocomplete="off"
                                                       oninput="formatDateInput(this)"
                                                       onblur="validateAndSyncDate('RevisedEndDateDisplay', 'RevisedEndDateBinding', 'RevisedEndDateError')"
                                                       style="flex:1;">
                                                <button type="button"
                                                        onclick="openDatePicker('RevisedEndDatePicker')"
                                                        style="margin-left:4px; padding:6px 10px; cursor:pointer; background:#f3f2f1; border:2px solid #0b0c0c; font-size:1rem; line-height:1;"
                                                        aria-label="Open date picker for Revised End Date">&#128197;</button>
                                                <input type="hidden"
                                                       name="ProjectDetails.RevisedEndDate"
                                                       id="RevisedEndDateBinding"
                                                       value="@(Model.ProjectDetails?.RevisedEndDate?.ToString("yyyy-MM-dd") ?? string.Empty)"
                                                       data-original-value="@(Model.ProjectDetails?.RevisedEndDate?.ToString("yyyy-MM-dd") ?? string.Empty)">
                                                <input type="date"
                                                       id="RevisedEndDatePicker"
                                                       value="@(Model.ProjectDetails?.RevisedEndDate?.ToString("yyyy-MM-dd") ?? string.Empty)"
                                                       aria-label="Revised End Date picker"
                                                       style="position:absolute; top:0; left:0; opacity:0; width:1px; height:1px; pointer-events:auto;"
                                                       onchange="onRevisedEndDateChanged('RevisedEndDatePicker', 'RevisedEndDateDisplay', 'RevisedEndDateBinding', 'RevisedEndDateError')">
                                            </div>
                                            <span id="RevisedEndDateError" class="govuk-error-message" style="display:none;"></span>
                                        </div>
                                        <div class="govuk-form-group">
                                            <label class="govuk-label govuk-!-font-size-16 sup_font_weight_700" for="ClosedDateDisplay">
                                                Closed Date
                                            </label>
                                            <div style="position:relative; display:flex; align-items:center; width:100%;">
                                                <input type="text"
                                                       id="ClosedDateDisplay"
                                                       class="govuk-input govuk-!-font-size-16"
                                                       value="@(Model.ProjectDetails?.ClosedDate?.ToString("dd/MM/yyyy") ?? string.Empty)"
                                                       placeholder="dd/mm/yyyy"
                                                       maxlength="10"
                                                       autocomplete="off"
                                                       oninput="formatDateInput(this)"
                                                       onblur="validateAndSyncDate('ClosedDateDisplay', 'ClosedDateBinding', 'ClosedDateError')"
                                                       style="flex:1;">
                                                <button type="button"
                                                        onclick="openDatePicker('ClosedDatePicker')"
                                                        style="margin-left:4px; padding:6px 10px; cursor:pointer; background:#f3f2f1; border:2px solid #0b0c0c; font-size:1rem; line-height:1;"
                                                        aria-label="Open date picker for Closed Date">&#128197;</button>
                                                <input type="hidden"
                                                       name="ProjectDetails.ClosedDate"
                                                       id="ClosedDateBinding"
                                                       value="@(Model.ProjectDetails?.ClosedDate?.ToString("yyyy-MM-dd") ?? string.Empty)">
                                                <input type="date"
                                                       id="ClosedDatePicker"
                                                       value="@(Model.ProjectDetails?.ClosedDate?.ToString("yyyy-MM-dd") ?? string.Empty)"
                                                       aria-label="Closed Date picker"
                                                       style="position:absolute; top:0; left:0; opacity:0; width:1px; height:1px; pointer-events:auto;"
                                                       onchange="syncDateToText('ClosedDatePicker', 'ClosedDateDisplay', 'ClosedDateBinding', 'ClosedDateError')">
                                            </div>
                                            <span id="ClosedDateError" class="govuk-error-message" style="display:none;"></span>
                                        </div>
                                    </div>
                                </div>
                            </fieldset>
                            <div class="govuk-button-group govuk-!-margin-top-2"
                                 style="display: flex; justify-content: flex-end;">
                                <a href="@Url.Action("Index", "ProjectList", new { area = "PIMS" })"
                                   class="govuk-button govuk-button--secondary govuk-!-font-size-16">Cancel</a>
                                <button type="button" class="govuk-button govuk-!-font-size-16" onclick="savePimsDetail()">Save</button>
                            </div>
                        </div>
                    </form>
                </div>

            </div><!-- end govuk-grid-column-full -->
            <!-- ── Comments Section ─────────────────────────────────────── -->
            <div class="govuk-grid-column-full">
                <div class="sup_search_panel sup_p_0 sup_border_b_0"
                     style="margin-top: 20px; padding-top: 0">
                    <div class="sup_flex_between_center" style="padding: 8px 10px 8px">
                        <div style="display: flex; justify-content: flex-start; gap: 30px;">
                            <div class="input-group searchfiels"
                                 style="flex-direction: column; align-items: flex-start; margin-right: -20px;">
                                <label for="dpselectyear" class="govuk-label govuk-!-font-size-16 sup_font_weight_700">
                                    Select year
                                </label>
                                <select id="dpselectyear"
                                        class="govuk-select govuk-!-font-size-16"
                                        asp-for="SelectedCommentYear"
                                        asp-items="Model.YearOptions"
                                        onchange="filterCommentsByYear(this.value)">
                                    <option value="">All years</option>
                                </select>
                            </div>
                            <div style="align-content: end;">
                                <button type="button"
                                        class="govuk-button sup_margin_0 sup_flex govuk-!-font-size-16"
                                        style="height: max-content; width: max-content; align-items: flex-end;"
                                        onclick="openAddCommentModal()">
                                    <i class="fa-solid fa-comment govuk-!-font-size-16"
                                       style="color: #ffffff"></i>
                                    &nbsp; Add Comments
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <div style="overflow: auto;">
                    <div id="@($"gridContainer_{Model.CommentsGrid.GridId}")">
                        @await Html.PartialAsync("_DataGrid", Model.CommentsGrid)
                    </div>
                </div>
            </div>

        </div><!-- end govuk-grid-row -->
    </main>

</div><!-- end d-flex -->
<!-- ── Edit / Add Comment Modal (GOV.UK compliant) ─────────────────────── -->
<div id="addEditCommentContainer"></div>

<script src="~/js/ajax-form-validation.js"></script>

@section Scripts {
    <script>
        function openDatePicker(pickerId) {
            var picker = document.getElementById(pickerId);
            if (picker) {
                try { picker.showPicker(); } catch (e) { picker.click(); }
            }
        }

        function syncDateToText(pickerId, displayId, hiddenId, errorId) {
            var picker = document.getElementById(pickerId);
            if (picker.value) {
                var parts = picker.value.split('-');
                document.getElementById(displayId).value = parts[2] + '/' + parts[1] + '/' + parts[0];
                document.getElementById(hiddenId).value = picker.value;
            } else {
                document.getElementById(displayId).value = '';
                document.getElementById(hiddenId).value = '';
            }
            if (errorId) {
                var err = document.getElementById(errorId);
                if (err) { err.style.display = 'none'; err.textContent = ''; }
            }
        }

        function formatDateInput(input) {
            var val = input.value.replace(/[^\d\/\-]/g, '');
            if (val.length > 10) val = val.substring(0, 10);
            input.value = val;
        }

        function validateAndSyncDate(displayId, hiddenId, errorId) {
            var display = document.getElementById(displayId);
            var hidden  = document.getElementById(hiddenId);
            var errorEl = document.getElementById(errorId);
            var val = display.value.trim();

            if (!val) {
                hidden.value = '';
                errorEl.style.display = 'none';
                errorEl.textContent = '';
                return;
            }

            if (/^\d{4}[\/\-]\d{2}[\/\-]\d{2}$/.test(val)) {
                hidden.value = '';
                errorEl.textContent = 'Enter the date in dd/mm/yyyy format, not yyyy/mm/dd';
                errorEl.style.display = 'block';
                return;
            }

            var usMatch = val.match(/^(\d{2})\/(\d{2})\/(\d{4})$/);
            if (usMatch && parseInt(usMatch[2], 10) > 12) {
                hidden.value = '';
                errorEl.textContent = 'Enter the date in dd/mm/yyyy format, not mm/dd/yyyy';
                errorEl.style.display = 'block';
                return;
            }

            var match = val.match(/^(\d{2})\/(\d{2})\/(\d{4})$/);
            if (!match) {
                hidden.value = '';
                errorEl.textContent = 'Enter the date in dd/mm/yyyy format';
                errorEl.style.display = 'block';
                return;
            }

            var day   = parseInt(match[1], 10);
            var month = parseInt(match[2], 10);
            var year  = parseInt(match[3], 10);
            var date  = new Date(year, month - 1, day);

            if (date.getFullYear() !== year || date.getMonth() !== (month - 1) || date.getDate() !== day) {
                hidden.value = '';
                errorEl.textContent = 'Enter a valid date in dd/mm/yyyy format';
                errorEl.style.display = 'block';
                return;
            }

            var mm = String(month).padStart(2, '0');
            var dd = String(day).padStart(2, '0');
            hidden.value = year + '-' + mm + '-' + dd;
            errorEl.style.display = 'none';
            errorEl.textContent = '';
        }

        var commentsGridId   = '@Model.CommentsGrid.GridId';
        var currentProject   = '@parentproject';
        var currentEditIndex = null;
        var isAddingNew      = false;

        function getCommentsGridManager() {
            return window['gridManager_' + commentsGridId];
        }

        // ── Sidebar ──────────────────────────────────────────────────────
        function toggleSidebar() {
            document.querySelector('.sidenav').classList.toggle('collapsed');
        }

        // ── Tabs ─────────────────────────────────────────────────────────
        document.addEventListener('DOMContentLoaded', function () {
            const tabs   = document.querySelectorAll('.govuk-tabs__tab');
            const panels = document.querySelectorAll('.govuk-tabs__panel');

            tabs.forEach(tab => {
                tab.addEventListener('click', function (e) {
                    e.preventDefault();
                    const targetId = this.getAttribute('href').substring(1);

                    panels.forEach(p => p.classList.add('govuk-tabs__panel--hidden'));
                    document.querySelectorAll('.govuk-tabs__list-item')
                            .forEach(li => li.classList.remove('govuk-tabs__list-item--selected'));

                    document.getElementById(targetId).classList.remove('govuk-tabs__panel--hidden');
                    this.parentElement.classList.add('govuk-tabs__list-item--selected');
                });
            });
        });

        // ── PIMS Details save ────────────────────────────────────────────
        function savePimsDetail() {
            const form  = document.getElementById('formPimsDetailRight');
            const token = form.querySelector('input[name="__RequestVerificationToken"]').value || null;
            const payload = {
                Version: form.querySelector('[name="ProjectDetails.Version"]').value || null,
                FileRef: form.querySelector('[name="ProjectDetails.FileRef"]').value || null,
                CustomerRef: form.querySelector('[name="ProjectDetails.CustomerRef"]').value || null,
                StartDate: form.querySelector('[name="ProjectDetails.StartDate"]').value || null,
                EndDate: form.querySelector('[name="ProjectDetails.EndDate"]').value || null,
                CostbookNumber: form.querySelector('[name="ProjectDetails.CostbookNumber"]').value || null,
                Riskid: parseInt(form.querySelector('[name="ProjectDetails.Riskid"]').value) || null,
                UseProjectYears: document.getElementById('use-project-yr').checked,
                RevisedEndDate: form.querySelector('[name="ProjectDetails.RevisedEndDate"]').value || null,
                ClosedDate: form.querySelector('[name="ProjectDetails.ClosedDate"]').value || null
            };

            fetch('/PIMS/ProjectDetails/SavePimsDetail?parentproject=' + encodeURIComponent(currentProject), {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
                body: JSON.stringify(payload)
            })
            .then(r => r.json())
            .then(data => {
                if (data.success) {
                    showAlertMessage(data.message, AlertType.SUCCESS);
                } else {
                    showAlertMessage(data.errors?.map(e => e.message).join(', ') || 'Failed to save PIMS details.', AlertType.ERROR);
                }
            })
            .catch(() => showAlertMessage('An error occurred while saving PIMS details.', AlertType.ERROR));
        }

        // ── VBA: EndDate_BeforeUpdate — Yes/No confirm when changing an existing end date ──
        function onEndDateChanged(pickerId, displayId, bindingId, errorId) {
            var picker   = document.getElementById(pickerId);
            var binding  = document.getElementById(bindingId);
            var display  = document.getElementById(displayId);
            var original = binding.getAttribute('data-original-value') || '';
            var newVal   = picker.value;

            if (original && newVal !== original) {
                showGovukYesNo(
                    'If the end date of a project has been changed with the agreement of the customer, ' +
                    'please enter in the \'Revised End Date\' field below, do not edit this field. ' +
                    'Do you want to change the date in this field?'
                ).then(function (confirmed) {
                    if (confirmed) {
                        syncDateToText(pickerId, displayId, bindingId, errorId);
                    } else {
                        // VBA: Cancel = True / Me.Undo — revert field to original
                        picker.value  = original;
                        binding.value = original;
                        var parts     = original.split('-');
                        display.value = original ? parts[2] + '/' + parts[1] + '/' + parts[0] : '';
                    }
                });
            } else {
                syncDateToText(pickerId, displayId, bindingId, errorId);
            }
        }

        // ── VBA: StartDate_AfterUpdate — informational message, no cancel ──
        function onStartDateChanged(pickerId, displayId, bindingId, errorId) {
            syncDateToText(pickerId, displayId, bindingId, errorId);
            var picker = document.getElementById(pickerId);
            if (picker.value) {
                var day = new Date(picker.value).getDate();
                if (day !== 1) {
                    showAlertMessage('Note, all calculations will use the first of this month as the start date.', AlertType.INFO);
                }
            }
        }

        // ── VBA: RevisedEndDate_AfterUpdate — save then show informational message ──
        function onRevisedEndDateChanged(pickerId, displayId, bindingId, errorId) {
            syncDateToText(pickerId, displayId, bindingId, errorId);
            var picker   = document.getElementById(pickerId);
            var original = document.getElementById(bindingId).getAttribute('data-original-value') || '';
            if (picker.value && picker.value !== original) {
                showAlertMessage('Please remember to update the A&F Report data for this project.', AlertType.INFO);
            }
        }

        // ── Comment modal ─────────────────────────────────────────────────
        function clearFormErrors() {
            clearValidationErrors('#editRecordModal');
        }

        function closeEditModal() {
            var modal = document.getElementById('editRecordModal');
            if (modal) modal.classList.remove('open');
            clearFormErrors();
        }

        function openAddCommentModal() {
            var selectedYear = document.getElementById('dpselectyear').value || '';
            var url = '/PIMS/ProjectDetails/GetAddEditCommentPartial?parentproject=' + encodeURIComponent(currentProject)
                    + '&selectedYear=' + encodeURIComponent(selectedYear);
            fetch(url)
                .then(r => r.text())
                .then(html => {
                    document.getElementById('addEditCommentContainer').innerHTML = html;
                    document.getElementById('editRecordModal').classList.add('open');
                    isAddingNew = true;
                    currentEditIndex = null;
                })
                .catch(() => showAlertMessage('An error occurred while loading the comment form.', AlertType.ERROR));
        }

        function saveRecord() {
            var $form = $('#editRecordForm');
            var $modal = $('#editRecordModal');

            clearValidationErrors($modal);

            if (!isFormValid($form)) {
                displayClientValidationErrors($form, $modal);
                return;
            }

            const form    = $form[0];
            const year    = form.querySelector('[name="Year"]').value.trim();
            const topic   = form.querySelector('[name="Topic"]').value || null;
            const comment = form.querySelector('[name="CommentText"]').value.trim()|| null;
            const token   = form.querySelector('input[name="__RequestVerificationToken"]').value;
            const payload = { Project: currentProject, Year: parseInt(year), Comment: comment, Topic: topic, Commentno: isAddingNew ? 0 : parseInt(currentEditIndex) };

            const url = isAddingNew
                ? '/PIMS/ProjectDetails/CreateComment'
                : '/PIMS/ProjectDetails/UpdateComment';
            fetch(url, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
                body: JSON.stringify(payload)
            })
            .then(r => r.json())
            .then(data => {
                if (data.success) {
                    closeEditModal();
                    showAlertMessage(data.message, AlertType.SUCCESS).then(function () {
                        var gm = getCommentsGridManager();
                        if (gm) gm.reloadGrid({ page: 1 });
                    });
                } else {
                    displayServerValidationErrors(data.errors, 'Failed to save comment.', '#editRecordModal');
                }
            })
            .catch(() => showAlertMessage('An error occurred while saving the comment.', AlertType.ERROR));
        }

        function editComment(btn) {
            var commentno = btn.dataset.id;
            var url = '/PIMS/ProjectDetails/GetAddEditCommentPartial?parentproject=' + encodeURIComponent(currentProject)
                    + '&commentno=' + encodeURIComponent(commentno);
            fetch(url)
                .then(r => r.text())
                .then(html => {
                    document.getElementById('addEditCommentContainer').innerHTML = html;
                    document.getElementById('editRecordModal').classList.add('open');
                    isAddingNew = false;
                    currentEditIndex = commentno;
                })
                .catch(() => showAlertMessage('An error occurred while loading the comment form.', AlertType.ERROR));
        }

        function deleteComment(btn) {
            var commentno = btn.dataset.id;
            showGovukConfirm('Are you sure you want to delete this comment?').then(function (result) {
                if (!result) return;
                const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                fetch('/PIMS/ProjectDetails/DeleteComment?commentno=' + commentno, {
                    method: 'DELETE',
                    headers: { 'RequestVerificationToken': token }
                })
                .then(r => r.json())
                .then(data => {
                    if (data.success) {
                        showAlertMessage(data.message, AlertType.SUCCESS).then(function () {
                            var gm = getCommentsGridManager();
                            if (gm) gm.reloadGrid({ page: 1 });
                        });
                    } else {
                        showAlertMessage(data.errors?.map(e => e.message).join(', ') || 'Failed to delete comment.', AlertType.ERROR);
                    }
                })
                .catch(() => showAlertMessage('An error occurred while deleting the comment.', AlertType.ERROR));
            });
        }

        function filterCommentsByYear(year) {
            var gm = getCommentsGridManager();
            if (gm) gm.reloadGrid({ page: 1 });
        }

        function getProjectDetailsExtraFilters() {
            return {
                parentproject: currentProject,
                year: document.getElementById('dpselectyear').value || null
            };
        }
    </script>
}

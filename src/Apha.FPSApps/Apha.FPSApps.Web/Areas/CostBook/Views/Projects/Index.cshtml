<div class="govuk-grid-row sup_margin_left_right_0 sup_border-bottom">
    <div class="govuk-grid-column-full sup_flex_left_center sup_p_0">
        <div class="govuk-grid-column-one-half">

            <h1 class="heading_with_txtbox govuk-heading-s sup_margin_bottom_0 govuk-!-margin-top-2 govuk-!-margin-bottom-0">
                Choose Existing Project
            </h1>
        </div>

        <div class="govuk-grid-column-one-half sup_p_0 sup_align_right">
            <a asp-area="CostBook" asp-controller="Projects" asp-action="Create" class="govuk-button govuk-!-margin-bottom-1 govuk-!-margin-top-1 floatRight">
                + Add New Project
            </a>
        </div>
    </div>
</div>

<div class="govuk-grid-row sup_margin_left_right_0 sup_margin_top_10 sup_margin_bottom_10">
   
    <div class="govuk-grid-column-full"> 
       
                    <div class="align-items-start" id="search-grid"> 
                        <!-- Grid Container -->
                        <div id="@($"gridContainer_{Model.ProjectGrid.GridId}")">
                            @await Html.PartialAsync("_DataGrid", Model.ProjectGrid)
                        </div>

                   
                </div>
             
       
    </div>
</div>

@section Scripts {
    <script>
        window.addEventListener('load', function () {
            const myModal = new bootstrap.Modal(document.getElementById('exampleModal'));
            myModal.show();
        });

        function searchTable() {
            var input, filter, found, table, tr, td, i, j;
            input = document.getElementById("searchInput");
            filter = input.value.toUpperCase();
            table = document.getElementById("tableBody");
            tr = table.getElementsByTagName("tr");
            for (i = 0; i < tr.length; i++) {
                td = tr[i].getElementsByTagName("td");
                for (j = 0; j < td.length; j++) {
                    if (td[j].innerHTML.toUpperCase().indexOf(filter) > -1) {
                        found = true;
                    }
                }
                if (found) {
                    tr[i].style.display = "";
                    found = false;
                } else {
                    tr[i].style.display = "none";
                }
            }
        }
        function viewProject(btn) {
            var parentProject = $(btn).data('id');
            debugger;
            window.location.href = '/Costbook/Projects/Edit/' + encodeURIComponent(parentProject);
        }
        function goToPage(pageNumber) {
            if (pageNumber < 1 || pageNumber > @Model.TotalPages) {
                return;
            }
            window.location.href = '?page=' + pageNumber + '&year=' + @Model.SelectedYear + '&recordsPerPage=' + @Model.RecordsPerPage + '&searchTerm=' + encodeURIComponent('@Model.SearchTerm');
        }

        function closeEditModal() {
            document.getElementById('editModal').style.display = 'none';
        }
    </script>
}
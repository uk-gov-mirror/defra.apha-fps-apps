                            </div>
                        }

                        <div class="">
                            <div class="govuk-grid-row">
                                <div class="govuk-grid-column-three-quarters govuk-!-margin-top-5">
                                    <table class="govuk-table isProjectSeclectionGrid">
                                        <tbody class="govuk-table__body">
                                            <tr class="govuk-table__row">
                                                <td scope="row" class="govuk-table__header">
                                                    <label class="govuk-label govuk-label govuk-!-margin-bottom-4 sup_select_option_width_100">Costing Book Code:</label>
                                                </td>
                                                <td class="govuk-table__cell">
                                                    <input type="text"
                                                           id="CostingBookCode"
                                                           class="govuk-input sup_select_option_width_100 read-only margin_left_5 govuk-!-margin-bottom-2"
                                                           value="@Model.ProjectId"
                                                           placeholder=""
                                                           readonly
                                                           tabindex="-1"
                                                           aria-label="Costing Book Code">
                                                </td>

                                                <td class="govuk-table__cell">
                                                    <label class="govuk-label govuk-label govuk-!-margin-bottom-4 govuk-!-text-align-right" asp-for="ContractNumber">Contract Number:</label>
                                                </td>
                                                <td class="govuk-table__cell">
                                                    <input asp-for="ContractNumber" class="govuk-input sup_select_option_width_100 margin_left_5" />

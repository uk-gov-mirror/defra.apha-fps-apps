                                        <span asp-validation-for="ProjectTitle" class="govuk-error-message"></span>
                                    </div>
                                </td>
                                <td class="govuk-table__cell">&nbsp;</td>
                            </tr>

                            <tr class="govuk-table__row">
                                <td scope="row" class="govuk-table__header">
                                    <label class="govuk-label govuk-label govuk-!-margin-bottom-4" asp-for="FinancialYears">Year Type:</label>
                                </td>
                                <td class="govuk-table__cell">
                                    <select asp-for="FinancialYears" asp-items="Model.AvailableFinancialYears" class="govuk-select margin_left_5" style="width: 100%;"></select>
                                    <span asp-validation-for="FinancialYears" class="govuk-error-message"></span>
                                </td>


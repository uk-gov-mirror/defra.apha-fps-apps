                                                    style="margin-left:4px; padding:6px 10px; cursor:pointer; background:#f3f2f1; border:2px solid #0b0c0c; font-size:1rem; line-height:1;">
                                                &#128197;
                                            </button>
                                            <input type="hidden"
                                                   name="DateOfSubmission"
                                                   id="DateOfSubmissionBinding"
                                                   value="@Model.DateOfSubmission?.ToString("yyyy-MM-dd")"
                                                   aria-hidden="true">
                                            <input type="date"
                                                   id="DateOfSubmissionPicker"
                                                   name="DateOfSubmissionPicker"

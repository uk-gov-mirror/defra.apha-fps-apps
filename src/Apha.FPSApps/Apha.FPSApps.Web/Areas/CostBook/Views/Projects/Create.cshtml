                                                   style="position:absolute; top:0; left:0; opacity:0; width:1px; height:1px; pointer-events:auto;"
                                                   onchange="syncDateToText('StartdatePicker', 'StartdateDisplay', 'StartdateBinding', 'StartdateError')" />
                                        </div>

                                        <span id="StartdateError" class="govuk-error-message" style="display:none;"></span>
                                        <span asp-validation-for="StartDate" class="govuk-error-message"></span>
                                    </div>
                                </td>

                                <td scope="row" class="govuk-table__header">
                                    <label class="govuk-label govuk-label govuk-!-margin-bottom-4" asp-for="IsDefraProject">Is Defra Project?:<span class="sup_color_red">*</span></label>
                                </td>
                                <td class="govuk-table__cell">
                                    <div id="IsDefraProjectFormGroup" class="govuk-form-group govuk-!-margin-bottom-0">
                                        <select asp-for="IsDefraProject" asp-items="Model.AvailableDefraProjectOptions" class="govuk-select sup_select_option_width_100" style="width: 100%">
                                            <option value="">Select IsDefraProject </option>
                                        </select>
                                        <span asp-validation-for="IsDefraProject" class="govuk-error-message"></span>
                                    </div>
                                </td>
                                <td class="govuk-table__cell">
                                    <span class="warning-text" style="margin-left: -10px;font-weight:bold; margin-bottom: 20px;display:block; font-size:13px; width:217px; color:#353535; border:1px dashed #0d6efd; border-radius:4px; padding:2px;">
                                        Changing this option will recost existing projects with current rates.
                                    </span>
                                </td>
                            </tr>

                            <tr class="govuk-table__row">
                                <td scope="row" class="govuk-table__header">
                                    <label asp-for="StartFYear" class="govuk-label govuk-label govuk-!-margin-bottom-4">Start (Financial) Year:</label>
                                </td>
                                <td class="govuk-table__cell">
                                    <input asp-for="StartFYear" asp-format="{0:0}" class="govuk-input sup_select_option_width_100 margin_left_5 read-only" readonly tabindex="-1">
                                    <span asp-validation-for="StartFYear" class="govuk-error-message"></span>
                                </td>

                                <td scope="row" class="govuk-table__header">
                                    <label asp-for="Euroconvrate" class="govuk-label govuk-label govuk-!-margin-bottom-4">Rate Used (£):</label>
                                </td>
                                <td class="govuk-table__cell">
                                    <input asp-for="Euroconvrate" class="govuk-input sup_select_option_width_100 margin_left_5">
                                    <span asp-validation-for="Euroconvrate" class="govuk-error-message"></span>
                                </td>
                                <td class="govuk-table__cell">&nbsp;</td>
                            </tr>

                            <tr class="govuk-table__row">
                                <td scope="row" class="govuk-table__header">
                                    <label asp-for="SubmittedByFName" class="govuk-label govuk-label govuk-!-margin-bottom-4">Submitted By - Firstname:</label>
                                </td>
                                <td class="govuk-table__cell">
                                    <input asp-for="SubmittedByFName" class="govuk-input sup_select_option_width_100 margin_left_5">
                                    <span asp-validation-for="SubmittedByFName" class="govuk-error-message"></span>
                                </td>

                                <td scope="row" class="govuk-table__header">
                                    <label asp-for="PreparedBy" class="govuk-label govuk-label govuk-!-margin-bottom-4">Prepared by:<span class="sup_color_red">*</span></label>
                                </td>
                                <td class="govuk-table__cell">
                                    <div id="PreparedByFormGroup" class="govuk-form-group govuk-!-margin-bottom-0">
                                        <select asp-for="PreparedBy" asp-items="Model.AvailableStaff" class="govuk-select inline-select" style="width: 100%">
                                            <option value="">Select PreparedBy </option>
                                        </select>
                                        <span asp-validation-for="PreparedBy" class="govuk-error-message"></span>
                                    </div>
                                </td>
                                <td class="govuk-table__cell">&nbsp;</td>
                            </tr>

                            <tr class="govuk-table__row">
                                <td scope="row" class="govuk-table__header">
                                    <label asp-for="SubmittedByLName" class="govuk-label govuk-label govuk-!-margin-bottom-4">Lastname:</label>
                                </td>
                                <td class="govuk-table__cell">
                                    <input asp-for="SubmittedByLName" class="govuk-input width-200 margin_left_5" style="width: 100%">
                                    <span asp-validation-for="SubmittedByLName" class="govuk-error-message"></span>
                                </td>

                                <td scope="row" class="govuk-table__header">
                                    <label class="govuk-label label_width mb-0 pt-1 govuk-!-margin-top-2">Include Inflation?:</label>
                                </td>
                                <td class="govuk-table__cell">

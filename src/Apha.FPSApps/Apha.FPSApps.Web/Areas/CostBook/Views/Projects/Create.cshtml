                                        <span id="DateOfSubmissionError" class="govuk-error-message" style="display:none;"></span>
                                        <span asp-validation-for="DateOfSubmission" class="govuk-error-message"></span>
                                    </div>
                                </td>
                                <td class="govuk-table__cell">&nbsp;</td>
                                <td class="govuk-table__cell">&nbsp;</td>
                            </tr>

                                                    <tr class="govuk-table__row">
                                                        <td scope="row" class="govuk-table__header">
                                                            <label class="govuk-label govuk-label govuk-!-margin-bottom-4" asp-for="Notes">
                                                                Notes:
                                                            </label>
                                                        </td>
                                                        <td class="govuk-table__cell" colspan="3">
                                                            <textarea asp-for="Notes" class="govuk-textarea" style="width: 99% !important;"></textarea>
                                                            <span asp-validation-for="Notes" class="govuk-error-message"></span>
                                                        </td>
                                                    </tr>
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>

                                    <div class="edit-action-buttons  govuk-grid-column-two-thirds govuk-!-text-align-right">
                                        <a asp-area="CostBook" asp-controller="Projects" asp-action="Index" class="govuk-button govuk-button--secondary govuk-!-margin-right-3">Cancel</a>
                                        <button type="submit" class="govuk-button govuk-!-margin-right-2">Save</button>
                                    </div>

                                </div>
                            </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {    
    <script>
        $(document).ready(function () {
            @if (TempData["Success"] != null)
            {
                <text>showAlertMessage('@Html.Raw(TempData["Success"])', AlertType.SUCCESS);</text>
            }
            @if (TempData["Error"] != null)
            {
                <text>showAlertMessage('@Html.Raw(TempData["Error"])', AlertType.ERROR);</text>
            }

            function toggleGovukErrorState(groupSelector, inputSelector, messageForSelector, errorClass) {
                var $group = $(groupSelector);
                var $input = $(inputSelector);
                var $message = $(messageForSelector);

                if (!$group.length || !$input.length || !$message.length) {
                    return;
                }

                var hasError = $message.hasClass('field-validation-error') && $.trim($message.text()).length > 0;

                if (hasError) {
                    $group.addClass('govuk-form-group--error');
                    $input.addClass(errorClass);
                } else {
                    $group.removeClass('govuk-form-group--error');
                    $input.removeClass(errorClass);
                }
            }

            function syncCreateFormErrorStyling() {
                toggleGovukErrorState('#ProjectTitleFormGroup', '#ProjectTitle', '[data-valmsg-for="ProjectTitle"]', 'govuk-textarea--error');
                toggleGovukErrorState('#PreparedByFormGroup', '#PreparedBy', '[data-valmsg-for="PreparedBy"]', 'govuk-select--error');
                toggleGovukErrorState('#IsDefraProjectFormGroup', '#IsDefraProject', '[data-valmsg-for="IsDefraProject"]', 'govuk-select--error');
            }

            // ── Client-side validation for StartDate (custom date picker) ─────
            // jQuery Validate ignores hidden inputs by default, so intercept submit
            $('form').on('submit', function (e) {
                var $startBinding = $('#StartdateBinding');
                var $startMsg = $('[data-valmsg-for="StartDate"]');
                var $startDisplay = $('#StartdateDisplay');
                var $startFg = $startDisplay.closest('.govuk-form-group');

                if (!$startBinding.val()) {
                    e.preventDefault();
                    $startFg.addClass('govuk-form-group--error');
                    $startDisplay.addClass('govuk-input--error');
                    $startMsg.text('Start Date is required.')
                             .removeClass('field-validation-valid')
                             .addClass('field-validation-error')
                             .show();
                }

                // Clear StartDate error as soon as a date is picked
                $('#StartdatePicker').off('change.startval').on('change.startval', function () {
                    $startFg.removeClass('govuk-form-group--error');
                    $startDisplay.removeClass('govuk-input--error');
                    $startMsg.text('')
                             .removeClass('field-validation-error')
                             .addClass('field-validation-valid')
                             .hide();
                });

                setTimeout(syncCreateFormErrorStyling, 0);
            });

            $('#ProjectTitle').on('input blur', syncCreateFormErrorStyling);
            $('#PreparedBy, #IsDefraProject').on('change blur', syncCreateFormErrorStyling);
            syncCreateFormErrorStyling();
        });

        function getAntiForgeryToken() {
            return $('input[name="__RequestVerificationToken"]').val();
        }
    </script>
}

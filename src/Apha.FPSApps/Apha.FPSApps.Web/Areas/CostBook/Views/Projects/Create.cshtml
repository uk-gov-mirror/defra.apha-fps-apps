                                                   tabindex="-1"
                                                   aria-hidden="true"
                                                   aria-label="Date of submission calendar picker"
                                                   style="position:absolute; top:0; left:0; opacity:0; width:1px; height:1px; pointer-events:auto;"
                                                   onchange="syncDateToText('DateOfSubmissionPicker', 'DateOfSubmissionDisplay', 'DateOfSubmissionBinding', 'DateOfSubmissionError')">

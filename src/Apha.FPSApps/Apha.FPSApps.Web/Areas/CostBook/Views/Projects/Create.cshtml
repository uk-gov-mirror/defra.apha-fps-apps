                                    <select asp-for="CustomerName" asp-items="Model.AvailableCustomers" class="govuk-select sup_select_option_width_100 margin_left_5">
                                        <option value="">Select Customer</option>
                                    </select>
                                    <span asp-validation-for="CustomerName" class="govuk-error-message"></span>
                                </td>

                                <td scope="row" class="govuk-table__header">
                                    <label class="govuk-label govuk-label govuk-!-margin-bottom-4" asp-for="Disease">Disease:</label>
                                </td>

                                </td>

                                <td class="govuk-table__cell">
                                    <div>
                                        <div style="position:relative; display:flex; align-items:center;">
                                            <input type="text"
                                                   id="DateOfSubmissionDisplay"
                                                   class="govuk-input width-200 margin_left_5"
                                                   style="width: 86%"
                                                   value="@Model.DateOfSubmission?.ToString("dd/MM/yyyy")"
                                                   placeholder="dd/mm/yyyy"
                                                   maxlength="10"
                                                   autocomplete="off"
                                                   aria-describedby="DateOfSubmissionError"
                                                   oninput="formatDateInput(this)"

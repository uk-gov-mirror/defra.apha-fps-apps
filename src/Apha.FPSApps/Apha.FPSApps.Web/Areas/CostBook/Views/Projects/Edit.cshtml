@section Scripts {
    <script>
         var successMessage = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["Success"]?.ToString()));
         var errorMessage = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["Error"]?.ToString()));

         function setFieldError(errorId, message) {
             var err = document.getElementById(errorId);
             if (!err) return;

             err.textContent = message;
             err.style.display = 'block';

             var formGroup = err.closest('.govuk-form-group');
             if (formGroup) {
                 formGroup.classList.add('govuk-form-group--error');
                 var field = formGroup.querySelector('textarea, input, select');
                 if (field) {
                     if (field.tagName === 'TEXTAREA') {
                         field.classList.add('govuk-textarea--error');
                     } else if (field.tagName === 'SELECT') {
                         field.classList.add('govuk-select--error');
                     } else {
                         field.classList.add('govuk-input--error');
                     }
                 }
             }
         }

         function clearFieldError(errorId) {
             var err = document.getElementById(errorId);
             if (!err) return;

             err.textContent = '';
             err.style.display = 'none';

             var formGroup = err.closest('.govuk-form-group');
             if (formGroup) {
                 formGroup.classList.remove('govuk-form-group--error');
                 formGroup.querySelectorAll('.govuk-input--error, .govuk-textarea--error, .govuk-select--error').forEach(function (el) {
                     el.classList.remove('govuk-input--error', 'govuk-textarea--error', 'govuk-select--error');
                 });
             }
         }

         function validateProjectEditForm() {
             var isValid = true;
             var titleInput = document.getElementById('ProjectTitle');
             var startDateDisplay = document.getElementById('StartdateDisplay');
             var startDateBinding = document.getElementById('StartdateBinding');

             if (titleInput) {
                 if (!titleInput.value || !titleInput.value.trim()) {
                     setFieldError('ProjectTitleError', 'Enter title');
                     isValid = false;
                 } else {
                     clearFieldError('ProjectTitleError');
                 }
             }

             validateAndSyncDate('StartdateDisplay', 'StartdateBinding', 'StartdateError');
             if (startDateDisplay && startDateBinding && !startDateBinding.value) {
                 if (!startDateDisplay.value || !startDateDisplay.value.trim()) {
                     setFieldError('StartdateError', 'Enter the date in dd/mm/yyyy format');
                 }
                 isValid = false;
             }

             return isValid;
         }

         $(document).ready(function () {
             if (successMessage) {
                 showAlertMessage(successMessage, AlertType.SUCCESS);
             }
             if (errorMessage) {
                 showAlertMessage(errorMessage, AlertType.ERROR);
             }

             var form = document.getElementById('projectEditForm');
             if (form) {
                 form.addEventListener('submit', function (e) {
                     if (!validateProjectEditForm()) {
                         e.preventDefault();
                     }
                 });
             }

             var titleInput = document.getElementById('ProjectTitle');
             if (titleInput) {
                 titleInput.addEventListener('input', function () {
                     if (titleInput.value && titleInput.value.trim()) {
                         clearFieldError('ProjectTitleError');
                     }
                 });
             }
         });

        function confirmDelete() {
                                    showGovukConfirm('This will delete all details for this project.  Are you sure?').then(function (result) {
                if (!result) return;

                document.body.style.cursor = 'wait';
                var deleteBtn = event.target;
                if (deleteBtn) { deleteBtn.disabled = true; deleteBtn.textContent = 'Deleting...'; }

                var projectId = '@Html.Raw(Model.ProjectId)';
                if (!projectId || projectId === '') {
                    showAlertMessage('Project ID is missing. Cannot delete project.', AlertType.INFO);
                    if (deleteBtn) { deleteBtn.disabled = false; deleteBtn.textContent = 'Delete'; }
                    document.body.style.cursor = 'default';
                    return;
                }

                $.ajax({
                    url: '@Url.Action("Delete", "Projects", new { area = "CostBook" })' + '/' + encodeURIComponent(projectId),
                    type: 'POST',
                    data: {
                        id: projectId,
                        __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                    },
                    success: function (response) {
                        if (response.success) {
                            showAlertMessage('Project deleted successfully.', AlertType.SUCCESS).then(function () {
                                window.location.href = '@Url.Action("Index", "Projects", new { area = "CostBook" })';
                            });
                        } else {
                            showAlertMessage('Failed to delete project: ' + (response.message || 'Unknown error'), AlertType.ERROR);
                            if (deleteBtn) { deleteBtn.disabled = false; deleteBtn.textContent = 'Delete'; }
                            document.body.style.cursor = 'default';
                        }
                    },
                    error: function () {
                        showAlertMessage('An error occurred while deleting the project.', AlertType.ERROR);
                        if (deleteBtn) { deleteBtn.disabled = false; deleteBtn.textContent = 'Delete'; }
                        document.body.style.cursor = 'default';
                    }
                });
            });
        }

        function copyProject() {
        var projectId = '@Html.Raw(Model.ProjectId)';
        showGovukConfirm('Copy project "' + projectId + '"?').then(function (result) {
            if (!result) return;

            var copyBtn = event.target;
            if (copyBtn) { copyBtn.disabled = true; copyBtn.textContent = 'Copying...'; }

            $.ajax({
                url: '@Url.Action("Copy", "Projects", new { area = "CostBook" })',
                type: 'POST',
                data: {
                    sourceProjectId: projectId,
                    __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                },
                success: function (data) {
                    if (data.success) {
                        var newId = data.generatedId || data.projectId;

                        // Ask user if they want to recost the project
                        showGovukConfirm('Do you want to recost this project at todays rates, (including inflation if specified)?').then(function (recostResult) {
                            if (recostResult) {
                                // Call Recost method
                                if (copyBtn) { copyBtn.textContent = 'Recosting...'; }

                                $.ajax({
                                    url: '@Url.Action("Recost", "Projects", new { area = "CostBook" })',
                                    type: 'POST',
                                    data: {
                                        id: newId,
                                        __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                                    },
                                    success: function (recostData) {
                                        if (recostData.success) {
                                            // Navigate to edit page after successful recost
                                            var editUrl = '@Url.Action("Edit", "Projects", new { area = "CostBook", id = "PLACEHOLDER" })';
                                            editUrl = editUrl.replace('PLACEHOLDER', encodeURIComponent(newId));
                                            window.location.href = editUrl;
                                        } else {
                                            showAlertMessage('Failed to recost project. Redirecting to edit page.', AlertType.ERROR).then(function () {
                                                var editUrl = '@Url.Action("Edit", "Projects", new { area = "CostBook", id = "PLACEHOLDER" })';
                                                editUrl = editUrl.replace('PLACEHOLDER', encodeURIComponent(newId));
                                                window.location.href = editUrl;
                                            });
                                        }
                                    },
                                    error: function () {
                                        showAlertMessage('Error occurred during recost. Redirecting to edit page.', AlertType.ERROR).then(function () {
                                            var editUrl = '@Url.Action("Edit", "Projects", new { area = "CostBook", id = "PLACEHOLDER" })';
                                            editUrl = editUrl.replace('PLACEHOLDER', encodeURIComponent(newId));
                                            window.location.href = editUrl;
                                        });
                                    }
                                });
                            } else {
                                // User chose not to recost, navigate directly to edit page
                                var editUrl = '@Url.Action("Edit", "Projects", new { area = "CostBook", id = "PLACEHOLDER" })';
                                editUrl = editUrl.replace('PLACEHOLDER', encodeURIComponent(newId));
                                window.location.href = editUrl;
                            }
                        });
                    } else {
                        showAlertMessage('Failed to copy project: ' + (data.errors ? data.errors.join(', ') : 'Unknown error'), AlertType.ERROR);
                        if (copyBtn) { copyBtn.disabled = false; copyBtn.textContent = 'Copy'; }
                    }
                },
                error: function () {
                    showAlertMessage('Failed to copy project. Please try again.', AlertType.ERROR);
                    if (copyBtn) { copyBtn.disabled = false; copyBtn.textContent = 'Copy'; }
                }
            });
        });
        }
    </script>
    }

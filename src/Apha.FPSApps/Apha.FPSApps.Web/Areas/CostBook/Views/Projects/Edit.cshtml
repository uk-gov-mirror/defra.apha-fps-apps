@model Apha.FPSApps.Web.Areas.CostBook.Models.ProjectCreateEditViewModel

@{
    ViewData["Title"] = "Project Edit";
}

<script>
    function openDatePicker(pickerId) {
        var picker = document.getElementById(pickerId);
        if (picker) {
            try { picker.showPicker(); } catch (e) { picker.click(); }
        }
    }

    function syncDateToText(pickerId, displayId, hiddenId, errorId) {
        var picker = document.getElementById(pickerId);
        if (picker.value) {
            var parts = picker.value.split('-');
            document.getElementById(displayId).value = parts[2] + '/' + parts[1] + '/' + parts[0];
            document.getElementById(hiddenId).value = picker.value;
        } else {
            document.getElementById(displayId).value = '';
            document.getElementById(hiddenId).value = '';
        }

        if (errorId) {
            var err = document.getElementById(errorId);
            if (err) { err.style.display = 'none'; err.textContent = ''; }
        }

        // Auto-calculate StartFYear when StartDate changes
        if (pickerId === 'StartdatePicker') {
            calculateStartFYear();
        }
    }

    function formatDateInput(input) {
        var val = input.value.replace(/[^\d\/\-]/g, '');
        if (val.length > 10) val = val.substring(0, 10);
        input.value = val;
    }

    function validateAndSyncDate(displayId, hiddenId, errorId) {
        var display = document.getElementById(displayId);
        var hidden  = document.getElementById(hiddenId);
        var errorEl = document.getElementById(errorId);
        var formGroup = errorEl ? errorEl.closest('.govuk-form-group') : null;
        var val = display.value.trim();

        function showDateError(message) {
            hidden.value = '';
            errorEl.textContent = message;
            errorEl.style.display = 'block';
            if (formGroup) {
                formGroup.classList.add('govuk-form-group--error');
            }
            if (display) {
                display.classList.add('govuk-input--error');
            }
        }

        function clearDateError() {
            errorEl.style.display = 'none';
            errorEl.textContent = '';
            if (formGroup) {
                formGroup.classList.remove('govuk-form-group--error');
            }
            if (display) {
                display.classList.remove('govuk-input--error');
            }
        }

        if (!val) {
            hidden.value = '';
            clearDateError();
            return;
        }

        if (/^\d{4}[\/\-]\d{2}[\/\-]\d{2}$/.test(val)) {
            showDateError('Enter the date in dd/mm/yyyy format, not yyyy/mm/dd');
            return;
        }

        var usMatch = val.match(/^(\d{2})\/(\d{2})\/(\d{4})$/);
        if (usMatch && parseInt(usMatch[2], 10) > 12) {
            showDateError('Enter the date in dd/mm/yyyy format, not mm/dd/yyyy');
            return;
        }

        var match = val.match(/^(\d{2})\/(\d{2})\/(\d{4})$/);
        if (!match) {
            showDateError('Enter the date in dd/mm/yyyy format');
            return;
        }

        var day   = parseInt(match[1], 10);
        var month = parseInt(match[2], 10);
        var year  = parseInt(match[3], 10);
        var date  = new Date(year, month - 1, day);

        if (date.getFullYear() !== year || date.getMonth() !== (month - 1) || date.getDate() !== day) {
            showDateError('Enter a valid date in dd/mm/yyyy format');
            return;
        }

        var mm = String(month).padStart(2, '0');
        var dd = String(day).padStart(2, '0');
        hidden.value = year + '-' + mm + '-' + dd;
        clearDateError();
    }

    function calculateStartFYear() {
        var binding = document.getElementById('StartdateBinding');
        var startFYearInput = document.getElementById('StartFYear');
        var financialYearsSelect = document.getElementById('FinancialYears');

        if (!binding || !startFYearInput || !financialYearsSelect) return;

        if (!binding.value) {
            startFYearInput.value = '';
            return;
        }

        var parts = binding.value.split('-');
        var year = parseInt(parts[0], 10);
        var month = parseInt(parts[1], 10);
        var financialYears = financialYearsSelect.value;

        // Mirrors MS Access SetStartDate / C# CalculateStartFinancialYear logic
        if (financialYears === '0') {
            startFYearInput.value = year;
        } else if (month <= 3) {
            startFYearInput.value = year - 1;
        } else {
            startFYearInput.value = year;
        }
    }
</script>


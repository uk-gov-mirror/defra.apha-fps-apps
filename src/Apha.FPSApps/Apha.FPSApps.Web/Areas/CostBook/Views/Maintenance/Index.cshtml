        // -----------------------------
        // INFATION SETTINGS
        // -----------------------------
        (function () {
        var $form = $('#formInflation');

        var cancelBtn = document.getElementById('btnInflationCancel');
        if (cancelBtn) {
        cancelBtn.addEventListener('click', function () {
        clearValidationErrors($form);
        document.getElementById('formInflation').reset();
        });
        }

        var form = document.getElementById('formInflation');
        if (form) {
        form.addEventListener('submit', function (e) {
        e.preventDefault();
        clearValidationErrors($form);

        if (!isFormValid($form)) {
        displayClientValidationErrors($form, $form);
        return;
        }

        // Validate inflation percentage fields: positive decimals only, max 999.99
        var inflFieldErrors = [];
        var inflFields = [
        { id: 'inflAnimals',           errorId: 'inflAnimals-error',           wrapId: 'fg-inflAnimals',           label: 'Animals' },
        { id: 'inflExceptionalCosts',  errorId: 'inflExceptionalCosts-error',  wrapId: 'fg-inflExceptionalCosts',  label: 'Exceptional Costs' },
        { id: 'inflStaff',             errorId: 'inflStaff-error',             wrapId: 'fg-inflStaff',             label: 'Staff' },
        { id: 'inflTests',             errorId: 'inflTests-error',             wrapId: 'fg-inflTests',             label: 'Tests' },
        { id: 'inflWorkingHoursInDay', errorId: 'inflWorkingHoursInDay-error', wrapId: 'fg-inflWorkingHoursInDay', label: 'Working Hours in Day' },
        { id: 'inflWorkingDaysInYear', errorId: 'inflWorkingDaysInYear-error', wrapId: 'fg-inflWorkingDaysInYear', label: 'Working Days in Year' }
        ];
        inflFields.forEach(function (f) {
        var val = document.getElementById(f.id) ? document.getElementById(f.id).value : '';
        var msg = validatePositiveDecimalField(val, f.label, 999.99);
        if (msg) {
        inflFieldErrors.push({ field: f.id, message: msg });
        var errEl = document.getElementById(f.errorId);
        var wrapEl = document.getElementById(f.wrapId);
        var inputEl = document.getElementById(f.id);
        if (errEl) { errEl.textContent = 'Error: ' + msg; errEl.style.display = ''; }
        if (wrapEl) { wrapEl.classList.add('govuk-form-group--error'); }
        if (inputEl) { inputEl.classList.add('govuk-input--error'); }
        }
        });
        if (inflFieldErrors.length > 0) { return; }

        var yearVal = (document.getElementById('inflCurrentFinancialYear').value || '').trim();
        var yearNum = parseInt(yearVal, 10);
        if (!/^\d{4}$/.test(yearVal) || yearNum < 2001 || yearNum > 2100) {
        displayServerValidationErrors(
        [{ field: 'inflCurrentFinancialYear', message: 'Enter a valid 4-digit year between 2001 and 2100' }],
        'There is a problem', $form);
        return;
        }

        var dto = {
        inflationAnimals: parseFloat(document.getElementById('inflAnimals').value),
        inflationExceptionalCosts: parseFloat(document.getElementById('inflExceptionalCosts').value),
        inflationStaff: parseFloat(document.getElementById('inflStaff').value),
        inflationTests: parseFloat(document.getElementById('inflTests').value),
        currentFinancialYear: yearNum,
        workingHoursInDay: parseFloat(document.getElementById('inflWorkingHoursInDay').value),
        workingDaysInYear: parseFloat(document.getElementById('inflWorkingDaysInYear').value)
        };

        $.ajax({
        url: '@Url.Action("SaveInflationSettings", "Maintenance", new { area = "CostBook" })',
        type: 'POST',
        contentType: 'application/json; charset=utf-8',
        data: JSON.stringify(dto),
        headers: { 'RequestVerificationToken': getAntiForgeryToken() },

        success: function (data) {
        if (data.success) {
        showAlertMessage(data.message || 'Inflation values saved successfully.', AlertType.SUCCESS);
        } else {
        displayServerValidationErrors(data.errors, data.message || 'Save failed.', $form);
        }
        },
        error: function () {
        showAlertMessage('An error occurred while saving inflation values.', AlertType.ERROR);
        }
        });
        });
        }
        })();


@model Apha.FPSApps.Web.Areas.CostBook.Models.YearlyDetailsViewModel
@{
    ViewData["Title"] = "Project Requirements";
    var projectId = Model.ProjectHeaderDto.ProjectId;
    var selectedYear = Model.SelectedYear;
    var isDefra = Model.ProjectHeaderDto.IsDefraProject == -1;
    var programme = (Model.ProjectHeaderDto.Programme ?? "").ToLower() == "comm";
}
<div class="govuk-template__body govuk-frontend-supported project-requirement-page">
    <div class="govuk-grid-row sup_margin_left_right_0 govuk-!-margin-top-2">
        <div class="govuk-grid-column-full">
            <h1 class="govuk-grid-row govuk-heading-s sup_border-bottom" style="padding:10px 0 0px 10px">
                Project Requirements
                <a asp-area="CostBook" asp-controller="Projects" asp-action="Index" class="govuk-back-link sup_align_right">Back</a>
            </h1>
        </div>
    </div>

    <div class="govuk-grid-row sup_margin_left_right_0 govuk-!-margin-top-2">
        <div class="govuk-grid-column-full">
            <div class="row">
                <div class="container project-layout-container">
                    <div class="project-layout-row">

                        <!-- Side navigation -->
                        @await Html.PartialAsync("_SideNav", @Model)

                        <!-- Main content -->
                        <div class="project-main-column">

                            <!-- Header summary bar (read-only) -->
                            <footer class="financial-summary project-financial-summary">
                                <div class="summary-row project-summary-row">
                                    <div class="summary-item d-flex">
                                        <label class="text-AlignRight govuk-label" for="summary-code">Code:</label>
                                        <input asp-for="ProjectHeaderDto.ProjectId" id="summary-code" type="text" readonly tabindex="-1" class="govuk-input">
                                    </div>
                                    <div class="summary-item d-flex">
                                        <label class="text-AlignRight govuk-label" asp-for="ProjectHeaderDto.FinancialYears" for="summary-year-type">Year Type:</label>
                                        <select asp-for="ProjectHeaderDto.FinancialYears" id="summary-year-type" class="govuk-select" disabled>
                                            <option value="-1">Financial Years</option>
                                            <option value="0">Project Years</option>
                                        </select>
                                    </div>
                                    <div class="summary-item d-flex">
                                        <label class="govuk-label text-AlignRight" for="summary-start-date">Start Date:</label>
                                        <input value="@Model.ProjectHeaderDto.StartDate?.ToString("dd/MM/yyyy")" id="summary-start-date" type="text" readonly tabindex="-1" class="govuk-input">
                                    </div>
                                    <div class="summary-item d-flex ms-3">
                                        <div class="govuk-checkboxes govuk-checkboxes--small" data-module="govuk-checkboxes">
                                            <div class="govuk-checkboxes__item">
                                                <input id="summary-inflation" type="checkbox" class="govuk-checkboxes__input" disabled @(Model.ProjectHeaderDto.Inflation == -1 ? "checked" : null)>
                                                <label class="govuk-label govuk-checkboxes__label" for="summary-inflation">Inflation?</label>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="summary-item d-flex project-summary-flag">
                                        <div class="govuk-checkboxes govuk-checkboxes--small" data-module="govuk-checkboxes">
                                            <div class="govuk-checkboxes__item">
                                                <input id="summary-defra" type="checkbox" class="govuk-checkboxes__input" disabled @(Model.ProjectHeaderDto.IsDefraProject == -1 ? "checked" : null)>
                                                <label class="govuk-label govuk-checkboxes__label" for="summary-defra">Defra?</label>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="summary-row project-summary-row">
                                    <div class="summary-item d-flex">
                                        <label class="text-AlignRight govuk-label" for="summary-title">Title:</label>
                                        <input asp-for="ProjectHeaderDto.ProjectTitle" id="summary-title" type="text" readonly tabindex="-1" class="govuk-input">
                                    </div>
                                    <div class="summary-item d-flex">
                                        <label class="govuk-label text-AlignRight" for="summary-year">Year:</label>
                                        <input value="@Model.ProjectHeaderDto.StartFYear" id="summary-year" type="text" readonly tabindex="-1" class="govuk-input">
                                    </div>
                                    <div class="summary-item d-flex">
                                                <label class="govuk-label text-AlignRight" for="summary-rate-used">Rate Used (&pound;):</label>
                                        <input asp-for="ProjectHeaderDto.EuroConvRate" id="summary-rate-used" type="text" readonly tabindex="-1" class="govuk-input">
                                    </div>
                                </div>
                            </footer>

                            <!-- Year costs shell -->
                            <div class="project-year-costs-shell">
                                <div class="form-header project-year-costs-header">
                                    <h3 class="govuk-heading-s">@selectedYear Year Costs</h3>
                                </div>

                                <div class="content-area">
                                    <div class="user-grid-section project-year-grid tab-grid-scroll">

                                        <!-- Year list (fsubProjectYear navigation) -->
                                        <div class="user-grid-section project-year-grid">
                                            <div class="grid-container">
                                                <div class="project-year-actions">
                                                    <button class="govuk-button sup_margin_0 project-year-add-button"
                                                            id="add_year">
                                                        + Add New Year
                                                    </button>
                                                </div>
                                                <table class="user-table project-year-table">
                                                    <thead>
                                                        <tr>
                                                            <th>Project Years</th>
                                                            <th>Action</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody id="userTableBody">
                                                        @foreach (var year in Model.ProjectYears)
                                                        {
                                                            <tr class="project-year-row @(year == Model.SelectedYear ? "selected-table-rowbg" : "")" data-year="@year" style="cursor:pointer;">
                                                                    <td>@year</td>
                                                                    <td>
                                                                        <button type="button" class="btn btn-sm delete-row-btn" data-year="@year" onclick="deletetblProjectYear(this)">
                                                                            <img src="/images/delete_gridicon.svg" alt="Delete icon" width="20" height="20" title="Delete Project Year">
                                                                        </button>
                                                                    </td>
                                                                </tr>
                                                        }
                                                    </tbody>
                                                </table>

                                            </div>
                                        </div>

                                    </div>
                                    
                                    <!-- Tab panels -->
                                    <div class="permissions-section">

                                        <div class="govuk-tabs">
                                            <ul class="govuk-tabs__list">
                                                <li class="govuk-tabs__list-item govuk-tabs__list-item--selected">
                                                    <a class="govuk-tabs__tab" href="#Staff-tab">
                                                        Staff
                                                    </a>
                                                </li>
                                                <li class="govuk-tabs__list-item">
                                                    <a class="govuk-tabs__tab" href="#Tests-tab">
                                                        Tests
                                                    </a>
                                                </li>
                                                <li class="govuk-tabs__list-item">
                                                    <a class="govuk-tabs__tab" href="#Animals-tab">
                                                        Animals
                                                    </a>
                                                </li>
                                                <li class="govuk-tabs__list-item">
                                                    <a class="govuk-tabs__tab" href="#AdditionalCosts-tab">
                                                        Additional Costs
                                                    </a>
                                                </li>
                                                @if (programme)
                                                {
                                                    
                                                    <li class="govuk-tabs__list-item">
                                                        <a class="govuk-tabs__tab" href="#MarkupAndProfit-tab">
                                                            Markup and Profit
                                                        </a>
                                                    </li>
                                                }

                                            </ul>
                                            <div class="govuk-tabs__panel sup_border_0 isYearlyDetailsTabs" id="Staff-tab">
                                                <div id="gridContainer_staffGrid" class="fps-sr-fixedheader-wrap"></div>
                                                <div class="project-total-bar">
                                                    <span class="project-total-label-wrap">
                                                        <span class="govuk-label me-2">Total Staff Cost:</span>
                                                    </span>
                                                    <span class="project-total-value-wrap">
                                                        <span class="total-amount">
                                                            <input type="text" id="staffTotalAmount" aria-label="Total Staff Cost" class="govuk-input project-total-input" readonly="" tabindex="-1">
                                                        </span>
                                                    </span>
                                                </div>
                                            </div>

                                            <div class="govuk-tabs__panel govuk-tabs__panel--hidden sup_border_0 isYearlyDetailsTabs" id="Tests-tab">
                                                <div id="gridContainer_testGrid" class="fps-sr-fixedheader-wrap"></div>
                                                <div class="project-total-bar">
                                                    <span class="project-total-label-wrap">
                                                        <span class="govuk-label me-2">Total Test Cost:</span>
                                                    </span>
                                                    <span class="project-total-value-wrap">
                                                        <span class="total-amount">
                                                            <input type="text" id="testTotalAmount" aria-label="Total Test Cost" class="govuk-input project-total-input" readonly="" tabindex="-1">
                                                        </span>
                                                    </span>
                                                </div>
                                            </div>

                                            <div class="govuk-tabs__panel govuk-tabs__panel--hidden sup_border_0 isYearlyDetailsTabs" id="Animals-tab">
                                                <div id="gridContainer_animalGrid" class="fps-sr-fixedheader-wrap"></div>
                                                <div class="project-total-bar"> 
                                                    <span class="project-total-label-wrap">
                                                        <span class="govuk-label me-2">Total Animal Cost:</span>
                                                    </span>
                                                    <span class="project-total-value-wrap">
                                                        <span class="total-amount">
                                                            <input type="text" id="animalTotalAmount" aria-label="Total Animal Cost" class="govuk-input project-total-input" readonly="" tabindex="-1">
                                                        </span>
                                                    </span>
                                                </div>
                                            </div>

                                            <div class="govuk-tabs__panel govuk-tabs__panel--hidden sup_border_0 isYearlyDetailsTabs" id="AdditionalCosts-tab">
                                                <div id="gridContainer_additionalCostGrid" class="fps-sr-fixedheader-wrap"></div>
                                                <div class="project-total-bar">
                                                    <span class="project-total-label-wrap">
                                                        <span class="govuk-label me-2">Total Additional Cost:</span>
                                                    </span>
                                                    <span class="project-total-value-wrap">
                                                        <span class="total-amount">
                                                            <input type="text" id="additionalTotalAmount" aria-label="Total Animal Cost" class="govuk-input project-total-input" readonly="" tabindex="-1">
                                                        </span>
                                                    </span>
                                                </div>
                                            </div>
                                             
                                                        <div class="govuk-tabs__panel govuk-tabs__panel--hidden sup_border_0 " id="MarkupAndProfit-tab">
                                                <div id="gridContainer_markupAndProfitGrid" class="fps-sr-fixedheader-wrap"></div>
                                            </div>

                                        </div>

                                    </div>

                                    <!-- Year totals panel -->
                                    <div class="total-grid-section project-totals-panel">
                                        <div class="grid-container">

                                            <div class="right-panel">
                                                <div class="year-totals">
                                                    <div class="project-year-totals-title">@selectedYear Year Totals:</div>
                                                    <div class="project-year-totals-body">
                                                        <div class="totals-list">
                                                            <div class="total-item">
                                                                <label class="govuk-label--s"
                                                                       for="year-total-staff">Staff Costs:</label>

                                                                <input type="text"
                                                                       class="govuk-input project-year-total-input"
                                                                       id="year-total-staff" value="@Model.StaffCostTotal.ToString("£#,##0.00")"
                                                                       readonly="" tabindex="-1">
                                                            </div>
                                                            <div class="total-item">
                                                                <label class="govuk-label--s"
                                                                       for="year-total-test">Test Costs:</label>

                                                                <input type="text" value="@Model.TestCostTotal.ToString("£#,##0.00")" readonly=""
                                                                       class="govuk-input project-year-total-input"
                                                                       id="year-total-test" tabindex="-1">
                                                            </div>
                                                            <div class="total-item">
                                                                <label class="govuk-label--s"
                                                                       for="year-total-animal">Animal Costs:</label>
                                                                <input type="text" value="@Model.AnimalCostTotal.ToString("£#,##0.00")" readonly=""
                                                                       class="govuk-input project-year-total-input"
                                                                       id="year-total-animal" tabindex="-1">
                                                            </div>
                                                            <div class="total-item">
                                                                <label class="govuk-label--s"
                                                                       for="year-total-additional">
                                                                    Additional
                                                                    Costs:
                                                                </label>
                                                                <input type="text" value="@Model.AdditionalCostTotal.ToString("£#,##0.00")" readonly=""
                                                                       class="govuk-input project-year-total-input"
                                                                       id="year-total-additional" tabindex="-1">
                                                            </div>
                                                            <div class="total-item grand-total">
                                                                <label class="govuk-label--s"
                                                                       for="year-total-grand">Grand Totals:</label>
                                                                <input type="text" value="@Model.GrandTotal.ToString("£#,##0.00")" readonly=""
                                                                       class="govuk-input project-year-total-input"
                                                                       id="year-total-grand" tabindex="-1">
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>

                                        </div>
                                    </div>
                                </div>
                            </div>

                        </div><!-- /.project-main-column -->
                    </div><!-- /.project-layout-row -->
                </div><!-- /.container -->
            </div><!-- /.row -->
        </div>
    </div>

    <!-- Modal container for Add/Edit partials -->
                <div id="project1ModalContainer" class="modal project-modal-hidden sup_overflow_hidden" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content" id="project1ModalContent">
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <script src="~/js/costbook_js/cosbook_common.js"></script>
    <script src="~/js/ajax-form-validation.js"></script>
    <script>
        // -- Page-level globals (Razor-resolved values for yearly-details.js) --
        const projectId   = '@projectId';
        let   selectedYear = @selectedYear;
        const programme   = '@Model.ProjectHeaderDto.Programme';
        const isDefra     = @(isDefra ? "true" : "false");

        // All controller URLs resolved here so yearly-details.js stays plain JS
        const yearlyDetailsUrls = {
            index:                   '@Url.Action("Index",                "YearlyDetails",  new { area = "CostBook" })',
            addProjectYear:          '@Url.Action("AddProjectYear",       "YearlyDetails",  new { area = "CostBook" })',
            deleteProjectYear:       '@Url.Action("DeleteProjectYear",    "YearlyDetails",  new { area = "CostBook" })',
            createStaff:             '@Url.Action("CreateStaff",          "YearlyDetails",  new { area = "CostBook" })',
            editStaff:               '@Url.Action("EditStaff",            "YearlyDetails",  new { area = "CostBook" })',
            deleteStaff:             '@Url.Action("DeleteStaff",          "YearlyDetails",  new { area = "CostBook" })',
            createTest:              '@Url.Action("CreateTest",           "YearlyDetails",  new { area = "CostBook" })',
            editTest:                '@Url.Action("EditTest",             "YearlyDetails",  new { area = "CostBook" })',
            deleteTest:              '@Url.Action("DeleteTest",           "YearlyDetails",  new { area = "CostBook" })',
            createAnimal:            '@Url.Action("CreateAnimal",         "YearlyDetails",  new { area = "CostBook" })',
            editAnimal:              '@Url.Action("EditAnimal",           "YearlyDetails",  new { area = "CostBook" })',
            deleteAnimal:            '@Url.Action("DeleteAnimal",         "YearlyDetails",  new { area = "CostBook" })',
            createAdditionalCost:    '@Url.Action("CreateAdditionalCost", "YearlyDetails",  new { area = "CostBook" })',
            editAdditionalCost:      '@Url.Action("EditAdditionalCost",   "YearlyDetails",  new { area = "CostBook" })',
            deleteAdditionalCost:    '@Url.Action("DeleteAdditionalCost", "YearlyDetails",  new { area = "CostBook" })',
            editMarkupAndProfit:     '@Url.Action("EditMarkupAndProfit",  "YearlyDetails",  new { area = "CostBook" })',
            updateProjectYearRate:   '@Url.Action("UpdateProjectYearRate","YearlyDetails",  new { area = "CostBook" })',
            loadStaffGrid:           '@Url.Action("LoadStaffGrid",        "YearlyDetails",  new { area = "CostBook" })',
            loadTestGrid:            '@Url.Action("LoadTestGrid",         "YearlyDetails",  new { area = "CostBook" })',
            loadAnimalGrid:          '@Url.Action("LoadAnimalGrid",       "YearlyDetails",  new { area = "CostBook" })',
            loadAdditionalCostGrid:  '@Url.Action("LoadAdditionalCostGrid","YearlyDetails", new { area = "CostBook" })',
            loadMarkupAndProfitGrid: '@Url.Action("LoadMarkupAndProfitGrid","YearlyDetails",new { area = "CostBook" })',
            getYearTotals:           '@Url.Action("GetYearTotals",        "YearlyDetails",  new { area = "CostBook" })',
            getHoursInDay:           '@Url.Action("GetSettingValueById",  "Settings",       new { area = "CostBook" })?id=HoursInDay'
        };
    </script>
    <script src="~/js/costbook_js/yearly-details.js"></script>
}

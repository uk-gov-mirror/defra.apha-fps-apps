@using Apha.FPSApps.Web.Models.Components.DataGrid
@model Apha.FPSApps.Web.Areas.FPS.Models.WorkGroupStaffMaintenanceViewModel

@{
    ViewData["Title"] = "2025-2026 : WG Staff Maintenance";
}

<main id="main-content">
    <div class="container-fluid">
        <div class="govuk-grid-row sup_border-bottom govuk-!-margin-bottom-3">
            <div class="govuk-grid-column-one-full govuk-!-margin-bottom-3">
                <h1 class="govuk-grid-row govuk-heading-s govuk-!-margin-bottom-0 govuk-!-margin-top-3 govuk-!-margin-left-3 isCustomPageHeadings">
                    Work Group Staff
                </h1>
            </div>
        </div>

        <div class="row">
            <div class="col-lg-12">
                <main class="main-content" style="padding:0;">
                    <div class="container-fluid" style="padding:0;">
                        <div class="row">
                            <div class="container-fluid" style="padding-left:0px;">
                                <div class="wgg-container-fluid">
                                    <div class="wgg-layout-row">
                                        @await Html.PartialAsync("_MaintenanceSideNav", "WorkGroupStaffMaintenance")

                                        <div style="display:flex; flex-direction:column; flex:1 1 auto; min-width:0; margin:0 0px 5px 8px;">
                                            <div class="govuk-grid-row">
                                                <div class="govuk-grid-column-full mt-2">
                                                    <div id="gridContainer_@Model.WGStaffGrid.GridId">
                                                        @await Html.PartialAsync("_DataGrid", Model.WGStaffGrid)
                                                    </div>
                                                </div>
                                            </div>

                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </main>
            </div>
        </div>

    </div>
</main>

@section Scripts {
    <script src="~/js/ajax-form-validation.js"></script>
    <script>
        var WorkGroupStaffConfig = {
            gridId: '@System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Model.WGStaffGrid.GridId)',
            createUrl: '/FPS/WorkGroupStaffMaintenance/Create',
            editUrl: '/FPS/WorkGroupStaffMaintenance/Edit',
            updateUrl: '/FPS/WorkGroupStaffMaintenance/Edit',
            deleteUrl: '/FPS/WorkGroupStaffMaintenance/Delete'
        };
    </script>
    <script src="~/js/fps_js/WorkGroupStaffMaintenance.js"></script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
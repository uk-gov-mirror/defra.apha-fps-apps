@using Apha.FPSApps.Web.Models.Components.DataGrid
@model Apha.FPSApps.Web.Areas.FPS.Models.ProjectAdditionalPlanActualViewModel
@{
    ViewData["Title"] = "Plan vs Actual - Additional Costs";
}

@{
    ViewData["SelectedProjectCode"] = Model.SelectedProjectCode;
}
<div class="container-fluid">
    <!-- Project selector -->
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-one-full isClearFix sup_border-bottom">
            <div class="govuk-grid-column-one-half isFloatLeft">
                <h1 class="govuk-grid-row govuk-heading-s govuk-!-margin-bottom-0 govuk-!-margin-top-2 govuk-!-margin-left-0 isCustomPageHeadings">Plan All Staff Cost for Programme</h1>
            </div>

            <div class="govuk-grid-column-one-half isFloatRight">
                <table class="govuk-table govuk-!-margin-bottom-0 isFloatRight isHalfGrid isCompareFPSPlan govuk-!-margin-top-2">
                    <tbody class="govuk-table__body">
                        <tr class="govuk-table__row">
                            <td class="govuk-table__cell govuk-!-padding-bottom-0 govuk-!-padding-top-0 govuk-!-padding-right-1 isNoBottomBorder govuk-!-text-align-right">
                                @await Html.PartialAsync("_ProjectDropdownSelector")
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Summary card -->
    @{
        ViewData["SummaryProjectCodeValue"]  = Model.SelectedProjectCode;
        ViewData["SummaryProjectTitleValue"] = Model.ProjectTitle;
        ViewData["SummaryProgramValue"]      = Model.Program;
        ViewData["SummaryContractValue"]     = Model.Contract;
    }
    @await Html.PartialAsync("_PvaSummaryCard")

                <!-- Two-column grid area -->
                <div class="govuk-grid-row">
                    <!-- Left: Planned Additional Costs (FPS) -->
                    <div class="govuk-grid-column-one-half mt-2">
                        <div class="govuk-grid-row">
                            <div class="govuk-grid-column-full mt-2">
                                <div id="gridContainer_@Model.AdditionalCostPlanGrid.GridId">
                                    @await Html.PartialAsync("_DataGrid", Model.AdditionalCostPlanGrid)
                                </div>
                            </div>
                           
                            <div class="govuk-grid-column-full mt-2">
                                <div class="financial-summary mt-1">
                                    <div class="pva-inline-summary">
                                        <label class="govuk-label--s govuk-!-margin-bottom-0 pva-nowrap-label" for="planned-total-cost">Total Planned Cost:</label>
                                        <div class="govuk-input__wrapper">
                                            <div class="govuk-input__prefix" aria-hidden="true">£</div>
                                            <input type="text" id="planned-total-cost" asp-for="TotalPlannedCost" readonly
                                                   class="govuk-input text-AlignRight pva-input-140"
                                                   value="@(Model.TotalPlannedCost.ToString("N0"))"
                                                   aria-label="Total Planned Cost">
                                        </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Right: Actual Additional Costs (PACT) -->
                        <div class="govuk-grid-column-one-half mt-2">
                            <div class="govuk-grid-row">                                
                                <div class="govuk-grid-column-full mt-2">
                                    <div id="gridContainer_@Model.ActualAdditionalCostGrid.GridId">
                                        @await Html.PartialAsync("_DataGrid", Model.ActualAdditionalCostGrid)
                                    </div>
                                </div>                               
                                <div class="govuk-grid-column-full mt-2">
                                    <div class="financial-summary mt-1">
                                        <div class="summary-row govuk-!-margin-0 pva-inline-summary">
                                            <label class="govuk-label--s govuk-!-margin-bottom-0 pva-nowrap-label" for="project-total-cost">Totals:</label>
                                            <div class="govuk-input__wrapper">
                                                <div class="govuk-input__prefix" aria-hidden="true">£</div>
                                                <input type="text" id="project-total-cost" asp-for="TotalActualCost" readonly
                                                       class="govuk-input text-AlignRight pva-input-160"
                                                       value="@(Model.TotalActualCost.ToString("N0"))"
                                                       aria-label="Total Actual Cost">
                                            </div>
                                                <label class="govuk-label--s govuk-!-margin-bottom-0 govuk-!-margin-left-3 pva-nowrap-label" for="project-percent-plan">Percent of Plan:</label>
                                                <input type="text" id="project-percent-plan" asp-for="PercentOfPlan" readonly
                                                       class="govuk-input text-AlignRight pva-input-95"
                                                       value="@(Model.PercentOfPlan.ToString("F0"))%"
                                                       aria-label="Percent of Plan">
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        @section Scripts {
                            <script src="~/js/fps_js/ajax-form-validation.js"></script>
                            <script src="~/js/ajax-form-validation.js"></script>
                            <script src="~/js/fps_js/AdditionalCost.js" asp-append-version="true"></script>
                            <script src="~/js/fps_js/project-dropdown.js" asp-append-version="true"></script>
                            <script>
                                AdditionalCostConfig.getJobCode = function () { return currentProjectCode; };
                                AdditionalCostConfig.requireJobCodeForAdd = true;
                                AdditionalCostConfig.onSaved = function () {
                                    window['gridManager_@Model.AdditionalCostPlanGrid.GridId'].reloadGrid({ page: 1 });
                                    refreshPlannedCost();
                                };
                                AdditionalCostConfig.onUpdated = function () {
                                    window['gridManager_@Model.AdditionalCostPlanGrid.GridId'].reloadGrid({ page: 1 });
                                    refreshPlannedCost();
                                };
                                AdditionalCostConfig.onDeleted = function () {
                                    window['gridManager_@Model.AdditionalCostPlanGrid.GridId'].reloadGrid({ page: 1 });
                                    refreshPlannedCost();
                                };
                            </script>
                            <script>
                                var currentProjectCode = '@Html.Raw(Model.SelectedProjectCode)';
                                var _loaderPendingGrids = 0;

                                $(document).ready(function () {
                                    if (currentProjectCode) {
                                        showLoader();
                                        _loaderPendingGrids = 2;
                                        setTimeout(function () {
                                            window['gridManager_@Model.AdditionalCostPlanGrid.GridId'].reloadGrid({ page: 1 });
                                            window['gridManager_@Model.ActualAdditionalCostGrid.GridId'].reloadGrid({ page: 1 });
                                            refreshPlannedCost();
                                            refreshActualCost();
                                        }, 0);
                                    }
                                    document.addEventListener('gridReloaded', function (e) {
                                        var tracked = ['@Model.AdditionalCostPlanGrid.GridId', '@Model.ActualAdditionalCostGrid.GridId'];
                                        if (tracked.indexOf(e.detail.gridId) !== -1 && _loaderPendingGrids > 0) {
                                            _loaderPendingGrids--;
                                            if (_loaderPendingGrids === 0) hideLoader();
                                        }
                                    });
                                });

                                function onProjectSelected(projectCode, projectTitle) {
                                    currentProjectCode = projectCode;
                                    document.getElementById('projectNameInput').value = projectCode;
                                    // Persist selection to session so the Back link retains the selected project.
                                    $.ajax({
                                        url: '@Url.Action("SaveProjectSession", "ProgramProject", new { area = "FPS" })',
                                        type: 'POST',
                                        contentType: 'application/json',
                                        data: JSON.stringify(projectCode || '')
                                    });
                                    $('#summary-project-code').val(currentProjectCode);
                                    $('#summary-project-description').val(projectTitle || '');
                                    $('#summary-program').val('');
                                    $('#summary-contract').val('');
                                    $('#planned-total-cost').val('0');
                                    $('#project-total-cost').val('0');
                                    $('#project-percent-plan').val('0.00%');
                                    if (currentProjectCode) {
                                        $.get('@Url.Action("GetProjectInfo", "ProjectAdditionalPlanActual", new { area = "FPS" })',
                                            { projectCode: currentProjectCode },
                                            function (result) {
                                                if (result.success) {
                                                    $('#summary-project-description').val(result.projectTitle);
                                                    $('#summary-program').val(result.program);
                                                    $('#summary-contract').val(result.contract);
                                                }
                                            }
                                        );
                                        showLoader();
                                        _loaderPendingGrids = 2;
                                        setTimeout(function () {
                                            window['gridManager_@Model.AdditionalCostPlanGrid.GridId'].reloadGrid({ page: 1 });
                                            window['gridManager_@Model.ActualAdditionalCostGrid.GridId'].reloadGrid({ page: 1 });
                                            refreshPlannedCost();
                                            refreshActualCost();
                                        }, 0);
                                    }
                                }

                                $(document).ready(function () {
                                    initProjectDropdown(
                                        '@Url.Action("GetProjectLookup", "ProjectAdditionalPlanActual", new { area = "FPS" })',
                                        onProjectSelected
                                    );
                                });

                                function getAdditionalCostPlanExtraFilters() { return { jobCode: currentProjectCode }; }

                                function getActualAdditionalCostExtraFilters() {
                                    return { projectCode: currentProjectCode };
                                }

                                function refreshPlannedCost() {
                                    if (!currentProjectCode) return;
                                    $.get('@Url.Action("GetTotalPlannedCost", "ProjectAdditionalPlanActual", new { area = "FPS" })',
                                        { jobCode: currentProjectCode },
                                        function (result) {
                                            if (result.success) {
                                                $('#planned-total-cost').val(formatCurrency(result.totalPlannedCost));
                                                calculatePercentOfPlan();
                                            }
                                        }
                                    );
                                }

                                function refreshActualCost() {
                                    if (!currentProjectCode) return;
                                    $.get('@Url.Action("GetTotalActualCost", "ProjectAdditionalPlanActual", new { area = "FPS" })',
                                        { projectCode: currentProjectCode },
                                        function (result) {
                                            if (result.success) {
                                                $('#project-total-cost').val(formatCurrency(result.totalActualCost));
                                                calculatePercentOfPlan();
                                            }
                                        }
                                    );
                                }

                                function formatCurrency(value) {
                                    return Math.round(parseFloat(value || 0)).toLocaleString('en-GB');
                                }

                                function deleteActualAdditionalCost(btn) {
                                    var subContCounter = $(btn).data('id');
                                    if (!subContCounter) return;
                                    showGovukConfirm('Are you sure you want to delete this record?').then(function (confirmed) {
                                        if (!confirmed) return;
                                        $.ajax({
                                            url: '@Url.Action("Delete", "ProjectAdditionalPlanActual", new { area = "FPS" })',
                                            type: 'DELETE',
                                            data: { subContCounter: subContCounter },
                                            success: function (result) {
                                                if (result.success) {
                                                    window['gridManager_@Model.ActualAdditionalCostGrid.GridId'].reloadGrid({ page: 1 });
                                                    refreshActualCost();
                                                    showAlertMessage('Record deleted successfully.', AlertType.SUCCESS);
                                                } else {
                                                    showAlertMessage('Delete failed: ' + (result.message || 'Unknown error'), AlertType.ERROR);
                                                }
                                            },
                                            error: function () {
                                                showAlertMessage('An error occurred while deleting the record.', AlertType.ERROR);
                                            }
                                        });
                                    });
                                }

                                function calculatePercentOfPlan() {
                                    var plannedRaw = parseFloat($('#planned-total-cost').val().replace(/[£,\s]/g, '')) || 0;
                                    var actualRaw = parseFloat($('#project-total-cost').val().replace(/[£,\s]/g, '')) || 0;
                                    var pct = plannedRaw > 0 ? (actualRaw / plannedRaw) * 100 : 0;
                                    $('#project-percent-plan').val(Math.round(pct) + '%');
                                }
                            </script>
                        }

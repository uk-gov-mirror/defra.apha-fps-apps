@using Apha.FPSApps.Web.Models.Components.DataGrid
@model Apha.FPSApps.Web.Areas.FPS.Models.StaffMaintenanceViewModel

@{
    ViewData["Title"] = "Staff Maintenance";
}

<main id="main-content">
    <div class="container-fluid">
        <!-- Title section -->
        <div class="govuk-grid-row">
            <div class="govuk-grid-column-full">
                <h1 class="govuk-heading-s sup_border-bottom govuk-!-margin-top-2 govuk-!-padding-bottom-2">Staff Maintenance</h1>
            </div>
        </div>

        <div class="row">
            <div class="col-lg-12">
                <main class="main-content" style="padding:0;">
                    <div class="container-fluid " style="padding: 0;">
                        <div class="row">
                            <div class="container-fluid" style="padding-left:0px;">
                                <div style="display: flex; flex-direction: row; align-items: flex-start;">
                                    <!-- Side nav -->
                                    @await Html.PartialAsync("_MaintenanceSideNav", "StaffMaintenance")
                                    <div style="display: flex; flex-direction: column; flex: 1 1 auto; min-width: 0; margin: 0 0px 5px 8px;">                         
                                        <!-- Filter and Grid section -->
                                        <div class="govuk-grid-row">
                                            <div class="govuk-grid-column-full mt-2">
                                                <div class="" style="border-radius: 5px; justify-content: flex-start; margin-bottom: 10px; padding: 4px;">
                                                    <div class="row">
                                                        <div class="col-lg-7 align-items-center">
                                                            <div class="row">
                                                                <div class="col-lg-2">
                                                                    <div class="govuk-radios govuk-radios--small" data-module="govuk-radios">
                                                                        <div class="govuk-radios__item">
                                                                            <input class="govuk-radios__input govuk-radios--small"
                                                                                   id="staff-filter-all"
                                                                                   name="staffFilter"
                                                                                   type="radio"
                                                                                   value="1"
                                                                            @(Model.FilterOption == 1 ? "checked" : "")
                                                                                   onchange="filterStaffs(this)">
                                                                            <label class="govuk-label govuk-radios__label" for="staff-filter-all">
                                                                                All
                                                                            </label>
                                                                        </div>
                                                                    </div>
                                                                </div>

                                                                <div class="col-lg-4">
                                                                    <div class="govuk-radios govuk-radios--small" data-module="govuk-radios">
                                                                        <div class="govuk-radios__item">
                                                                            <input class="govuk-radios__input"
                                                                                   id="staff-filter-temp"
                                                                                   name="staffFilter"
                                                                                   type="radio"
                                                                                   value="2"
                                                                            @(Model.FilterOption == 2 ? "checked" : "")
                                                                                   onchange="filterStaffs(this)">
                                                                            <label class="govuk-label govuk-radios__label" for="staff-filter-temp">
                                                                                Temp SP No.s only
                                                                            </label>
                                                                        </div>
                                                                    </div>
                                                                </div>

                                                                <div class="col-lg-5 text-AlignRight">
                                                                    <div class="govuk-radios govuk-radios--small" data-module="govuk-radios">
                                                                        <div class="govuk-radios__item">
                                                                            <input class="govuk-radios__input"
                                                                                   id="staff-filter-grades"
                                                                                   name="staffFilter"
                                                                                   type="radio"
                                                                                   value="3"
                                                                            @(Model.FilterOption == 3 ? "checked" : "")
                                                                                   onchange="filterStaffs(this)">
                                                                            <label class="govuk-label govuk-radios__label" for="staff-filter-grades">
                                                                                Generic Grades Only
                                                                            </label>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="col-lg-5" style="text-align: right;">
                                                        </div>
                                                    </div>
                                                </div>

                                                <!-- Grid Container -->
                                                <div id="@($"gridContainer_{Model.StaffGrid.GridId}")">
                                                    @await Html.PartialAsync("_DataGrid", Model.StaffGrid)
                                                </div>

                                                <div class="govuk-grid-row">
                                                    <div class="govuk-grid-column-full">
                                                        <div class="govuk-!-margin-top-1 govuk-!-padding-2 isInfoSec">
                                                            Use this to add/edit staff names and SP numbers as per Paris printout.
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </main>
            </div>
        </div>       

    </div>
</main>

@section Scripts {
    <script src="~/js/ajax-form-validation.js"></script>
    <script>
        var staffGridId = '@Model.StaffGrid.GridId';

        // Get reference to the grid manager
        function getGridManager() {
            return window['gridManager_' + staffGridId];
        }

        // Filter employees when radio button changes
        function filterStaffs(filterOption) {
            // Get the grid manager and call reloadGrid
            var gridManager = getGridManager();
            if (gridManager) {
                gridManager.reloadGrid({ page: 1 });
            } else {
                console.error('Grid manager not found for grid:', staffGridId);
            }
        }

        // Get extra filters including radio button selection
        function getStaffExtraFilters() {
            const radios = document.querySelectorAll('input[name="staffFilter"]');
            let filterOption = 1; // Default
            radios.forEach(radio => {
                if (radio.checked) {
                    filterOption = parseInt(radio.value);
                }
            });
            return {
                filterOption: filterOption
            };
        }

        function addStaff() {
            $.get('/FPS/StaffMaintenance/Create', function(html) {
                $('#modaPopupBody').html(html);
                $('#modalPopup').addClass("show");
                // Re-parse unobtrusive validation for the new content
                var form = $('#staffForm');
                $.validator.unobtrusive.parse(form);
            });
        }

        function editStaff(btn) {
            var spNumber = $(btn).data('id');
            $.get('/FPS/StaffMaintenance/Edit', { spNumber: spNumber }, function(html) {
                $('#modaPopupBody').html(html);
                $('#modalPopup').addClass("show");
                // Re-parse unobtrusive validation for the new content
                var form = $('#staffForm');
                $.validator.unobtrusive.parse(form);
            });
        }

        function deleteStaff(btn) {
            var spNumber = $(btn).data('id');
            showGovukConfirm('Are you sure you want to delete this employee?').then(function (result) {
                if (!result) return;
                $.ajax({
                    url: '/FPS/StaffMaintenance/Delete',
                    type: 'DELETE',
                    data: { spNumber: spNumber },
                    success: function (response) {
                        if (response.success) {
                            showAlertMessage('Employee deleted successfully', AlertType.SUCCESS).then(function () {
                                getGridManager().reloadGrid({ page: 1 });
                            });
                        } else {
                            showAlertMessage('Error: ' + response.message, AlertType.ERROR);
                        }
                    },
                    error: function () {
                        showAlertMessage('An error occurred while deleting', AlertType.ERROR);
                    }
                });
            });
        }

        // Save staff plan (from modal)
        function savestaffplan() {
            clearValidationErrors('#modaPopupBody');
            var form = $('#staffForm');

            // Validate form
             if (!isFormValid(form)) {
                 displayClientValidationErrors(form, '#modaPopupBody');
                return;
             }

            var employeeData = {
                SPNumber: $('#SPNumber').val(),
                LastName: $('#LastName').val(),
                FirstName: $('#FirstName').val(),
                Title: $('#Title').val()
            };

            // Check if it's edit mode using the hidden field
            var isEdit = $('#isEditMode').val() === 'true';
            var url = isEdit ? '/FPS/StaffMaintenance/Edit' : '/FPS/StaffMaintenance/Create';

            $.ajax({
                url: url,
                type: 'POST',
                data: JSON.stringify(employeeData),
                contentType: 'application/json',
                success: function(response) {
                    if (response.success) {
                        showAlertMessage(response.message, AlertType.SUCCESS);
                        closeModal();
                        getGridManager().reloadGrid({ page: 1 });
                    } else {
                        // Show validation errors from server
                        displayServerValidationErrors(response.errors, response.message, '#modaPopupBody')
                    }
                },
                error: function(xhr) {
                    if (xhr.status === 400 && xhr.responseJSON) {
                        displayServerValidationErrors(xhr.responseJSON.errors, xhr.responseJSON.message, '#modaPopupBody');
                    } else {
                        showAlertMessage('An error occurred while saving.', AlertType.ERROR);
                    }
                }
            });
        }
        
          // Returns true if all required fields in the form have values
        function isFormValid(form) {
            var isValid = true;
            form.find('[required]').each(function () {
                if (!$(this).val() || $(this).val().trim() === '') {
                    isValid = false;
                    return false; // break
                }
            });
            return isValid;
        }
        
         // Close modal
        function closeModal() {
            clearValidationErrors();
            $('#modaPopupBody').html("");
            $('#modalPopup').removeClass("show");
        }
    </script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

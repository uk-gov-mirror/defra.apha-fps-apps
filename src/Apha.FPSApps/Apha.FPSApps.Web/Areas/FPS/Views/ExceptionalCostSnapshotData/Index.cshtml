@using Apha.FPSApps.Web.Models.Components.DataGrid
@model Apha.FPSApps.Web.Areas.FPS.Models.ExceptionalCostSnapshotViewModel

@{
    ViewData["Title"] = "FPS : Snapshot Exceptional Costs";
}

<main class="govuk-main-wrapper govuk-!-padding-top-0 asu-main-content" id="main-content" role="main">
    <div class="container-fluid">

        @* ── Page title ──────────────────────────────────────────────────────── *@
        <div class="govuk-grid-row">
            <div class="govuk-grid-column-full">
                <h1 class="govuk-grid-row govuk-heading-s sup_border-bottom govuk-!-margin-top-2 govuk-!-padding-bottom-2 govuk-!-padding-left-4">
                    SnapshotExceptionalCosts
                </h1>
            </div>
        </div>

        @* ── Sidenav + content layout ───────────────────────────────────────── *@
        <div class="govuk-grid-row">
            <div class="cc-container-fluid">
                <div class="cc-layout-row">

                    @* Side navigation — Snapshot queries (reusable partial) *@
                    @await Html.PartialAsync("_SnapshotSideNav")

                    <div class="cc-content-column">
                        <div class="govuk-grid-row">
                            <div class="govuk-grid-column-full">

                                @* ── DataGrid ──────────────────────────────────── *@
                                <div class="govuk-grid-row sup_margin_left_right_10 sup_margin_bottom_10">
                                    <div class="govuk-grid-column-full sup_p_0">
                                        <div id="gridContainer_exceptionalCostSnapshotGrid">
                                            @await Html.PartialAsync("_DataGrid", Model.ExceptionalCostSnapshotGrid)
                                        </div>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>

    </div>
</main>

@section Scripts {
    <script>
        // ── Sidebar toggle ───────────────────────────────────────────────────────
        function toggleSidebar() {
            document.querySelector('.sidenav')?.classList.toggle('collapsed');
        }

        // ── Grid reload ──────────────────────────────────────────────────────────
        //   GridId = "exceptionalCostSnapshotGrid" (matches controller DataGridConfig).
        function reloadExceptionalCostSnapshotGrid() {
            var gm = window['gridManager_exceptionalCostSnapshotGrid'];
            if (gm) {
                gm.reloadGrid({ page: 1 });
            }
        }

        // ── Initialise on page load ──────────────────────────────────────────────
        //   Index() returns empty Data; the grid fetches its first page through the
        //   LoadExceptionalCostDataGrid endpoint (server-side pagination/filter/sort).
        $(document).ready(function () {
            $(document).ajaxStart(showLoader).ajaxStop(hideLoader);
            reloadExceptionalCostSnapshotGrid();
        });
    </script>
}

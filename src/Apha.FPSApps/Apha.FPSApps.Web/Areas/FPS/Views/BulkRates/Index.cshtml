@using Apha.FPSApps.Web.Areas.FPS.Models
@model BulkRatesQueueViewModel
@{
    ViewData["Title"] = "Bulk Rates Update — Queue";

    var jobOptions = new[]
    {
        ("", "All job types"),
        ("BulkTestRatesUpdate",  "FEC Test Rates"),
        ("BulkStaffRatesUpdate", "Staff Rates"),
        ("BulkAnimalRatesUpdate","Animal Rates")
    };

    var statusOptions = new[]
    {
        ("", "All statuses"),
        ("Initiated",       "Initiated"),
        ("PendingApproval", "Pending Approval"),
        ("Approved",        "Approved"),
        ("Running",         "Running"),
        ("Completed",       "Completed"),
        ("Failed",          "Failed"),
        ("Rejected",        "Rejected"),
        ("Cancelled",       "Cancelled")
    };

    string StatusBadgeClass(string s) => s switch
    {
        "Initiated"       => "govuk-tag govuk-tag--blue",
        "PendingApproval" => "govuk-tag govuk-tag--yellow",
        "Approved"        => "govuk-tag govuk-tag--green",
        "Running"         => "govuk-tag govuk-tag--purple",
        "Completed"       => "govuk-tag",
        "Failed"          => "govuk-tag govuk-tag--red",
        "Rejected"        => "govuk-tag govuk-tag--orange",
        "Cancelled"       => "govuk-tag govuk-tag--grey",
        _                 => "govuk-tag govuk-tag--grey"
    };

    string FriendlyJobName(string j) => j switch
    {
        "BulkTestRatesUpdate"  => "FEC Test Rates",
        "BulkStaffRatesUpdate" => "Staff Rates",
        "BulkAnimalRatesUpdate"=> "Animal Rates",
        _                      => j
    };
}

<main class="govuk-main-wrapper govuk-!-padding-top-0" id="main-content" role="main">
    <div class="container-fluid">

        <div class="govuk-grid-row">
            <div class="govuk-grid-column-full">
                <h1 class="govuk-grid-row govuk-heading-s sup_border-bottom govuk-!-margin-top-2 govuk-!-padding-bottom-2 govuk-!-padding-left-4">
                    Bulk Rates Update
                </h1>
            </div>
        </div>

        <div class="govuk-grid-row">
            <div class="cc-container-fluid">
                <div class="cc-layout-row">

                    @await Html.PartialAsync("_BulkRatesSideNav", "BulkRates")

                    <div class="cc-content-column">

                        {{! Filter bar }}
                        <form method="get" asp-area="FPS" asp-controller="BulkRates" asp-action="Index"
                              class="govuk-grid-row sup_margin_left_right_10 govuk-!-margin-bottom-4">

                            <div class="govuk-grid-column-one-quarter govuk-!-padding-left-0">
                                <label class="govuk-label govuk-!-font-size-16 govuk-!-font-weight-bold" for="jobNameFilter">Job type</label>
                                <select class="govuk-select govuk-!-font-size-16 govuk-!-width-full" id="jobNameFilter" name="jobName">
                                    @foreach (var (val, label) in jobOptions)
                                    {
                                        <option value="@val" selected="@(Model.JobNameFilter == val ? "selected" : null)">@label</option>
                                    }
                                </select>
                            </div>

                            <div class="govuk-grid-column-one-quarter">
                                <label class="govuk-label govuk-!-font-size-16 govuk-!-font-weight-bold" for="fpsYearFilter">FPS year</label>
                                <input class="govuk-input govuk-input--width-5 govuk-!-font-size-16"
                                       id="fpsYearFilter" name="fpsYear" type="number" min="2000" max="2100"
                                       value="@(Model.FpsYearFilter?.ToString() ?? "")">
                            </div>

                            <div class="govuk-grid-column-one-quarter">
                                <label class="govuk-label govuk-!-font-size-16 govuk-!-font-weight-bold" for="statusFilter">Status</label>
                                <select class="govuk-select govuk-!-font-size-16 govuk-!-width-full" id="statusFilter" name="status">
                                    @foreach (var (val, label) in statusOptions)
                                    {
                                        <option value="@val" selected="@(Model.StatusFilter == val ? "selected" : null)">@label</option>
                                    }
                                </select>
                            </div>

                            <div class="govuk-grid-column-one-quarter govuk-!-padding-right-0 govuk-!-display-flex" style="align-items:flex-end;">
                                <div class="govuk-button-group govuk-!-margin-bottom-0">
                                    <button type="submit" class="govuk-button govuk-!-margin-bottom-0" data-module="govuk-button">Filter</button>
                                    <a asp-area="FPS" asp-controller="BulkRates" asp-action="Create"
                                       class="govuk-button govuk-button--secondary govuk-!-margin-bottom-0 govuk-!-margin-left-2">
                                        New Request
                                    </a>
                                </div>
                            </div>

                        </form>

                        {{! Results table }}
                        @if (!Model.Entries.Any())
                        {
                            <p class="govuk-body govuk-!-margin-left-3">No requests match the selected filters.</p>
                        }
                        else
                        {
                            <div class="govuk-grid-row sup_margin_left_right_10">
                                <div class="govuk-grid-column-full sup_p_0">
                                    <table class="govuk-table govuk-!-font-size-16 custom-table govuk-!-margin-bottom-0">
                                        <thead class="govuk-table__head">
                                            <tr class="govuk-table__row">
                                                <th scope="col" class="govuk-table__header">Request ID</th>
                                                <th scope="col" class="govuk-table__header">Job Type</th>
                                                <th scope="col" class="govuk-table__header">FPS Year</th>
                                                <th scope="col" class="govuk-table__header">Status</th>
                                                <th scope="col" class="govuk-table__header">Requested By</th>
                                                <th scope="col" class="govuk-table__header">Requested At (UTC)</th>
                                                <th scope="col" class="govuk-table__header">Action</th>
                                            </tr>
                                        </thead>
                                        <tbody class="govuk-table__body">
                                            @foreach (var e in Model.Entries)
                                            {
                                                <tr class="govuk-table__row">
                                                    <td class="govuk-table__cell govuk-!-font-size-14" style="font-family:monospace;">
                                                        @e.JobQueueId.ToString()[..8]&hellip;
                                                    </td>
                                                    <td class="govuk-table__cell">@FriendlyJobName(e.JobName)</td>
                                                    <td class="govuk-table__cell">@e.FpsYear</td>
                                                    <td class="govuk-table__cell">
                                                        <strong class="@StatusBadgeClass(e.Status)">@e.Status</strong>
                                                    </td>
                                                    <td class="govuk-table__cell">@e.RequestedBy</td>
                                                    <td class="govuk-table__cell">@e.RequestedAtUtc.ToString("dd MMM yyyy HH:mm")</td>
                                                    <td class="govuk-table__cell">
                                                        <a asp-area="FPS" asp-controller="BulkRates" asp-action="Detail"
                                                           asp-route-id="@e.JobQueueId"
                                                           class="govuk-link govuk-!-font-size-16">View</a>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        }

                    </div>
                </div>
            </div>
        </div>

    </div>
</main>


<main class="govuk-main-wrapper govuk-!-padding-top-0" id="main-content" role="main">
    <div class="container-fluid">

        <div class="govuk-grid-row">
            <div class="govuk-grid-column-full">
                <h1 class="govuk-grid-row govuk-heading-s sup_border-bottom govuk-!-margin-top-2 govuk-!-padding-bottom-2 govuk-!-padding-left-4">
                    FEC Data Upload and Approval Process
                </h1>
            </div>
        </div>

        <div class="govuk-grid-row">
            <div class="cc-container-fluid">
                <div class="cc-layout-row">

                    @await Html.PartialAsync("_BulkRatesSideNav", "BulkRates")

                    <div class="cc-content-column">
                        <div class="govuk-grid-row">
                            <div class="govuk-grid-column-full">

                                <div class="govuk-grid-row sup_margin_left_right_10 sup_margin_bottom_10">

                                    <div class="govuk-grid-column-full sup_p_0">
                                        <section class="sup_border govuk-!-padding-3" aria-labelledby="process-rules-title">
                                            <h2 class="govuk-heading-s govuk-!-margin-bottom-2" id="process-rules-title">Process Rules</h2>
                                            <ul class="govuk-list govuk-list--bullet govuk-!-font-size-16 govuk-!-margin-bottom-0">
                                                <li>Only FPS Admin can perform FEC process.</li>
                                                <li>Only uploader can edit or release data.</li>
                                                <li>Second Admin must approve changes.</li>
                                            </ul>
                                        </section>
                                    </div>

                                    <div class="govuk-grid-column-full sup_p_0">
                                        <section class="sup_border govuk-!-padding-3" aria-labelledby="fec-process-tracker-title">
                                            <h2 class="govuk-heading-s govuk-!-margin-bottom-2" id="fec-process-tracker-title">FEC Process Tracker</h2>

                                            <div class="govuk-button-group sup_margin_0 govuk-!-margin-bottom-2">
                                                <span class="govuk-body-s govuk-!-margin-bottom-0 govuk-!-margin-right-2">
                                                    Note : Data will be downloaded for current year.
                                                </span>
                                                <button type="button" class="govuk-button govuk-!-margin-bottom-0 govuk-!-margin-left-1"
                                                        data-module="govuk-button" id="btnDownloadTestData">
                                                    Download Test Data (Excel)
                                                </button>
                                                <button type="button" class="govuk-button govuk-!-margin-left-2 govuk-!-margin-bottom-0"
                                                        data-module="govuk-button" id="btnUploadUpdatedData">
                                                    Upload Updated Data
                                                </button>
                                            </div>

                                            <table class="editable-grid-table govuk-table custom-table govuk-!-margin-bottom-0 govuk-!-margin-top-3 govuk-!-width-one-half">
                                                <colgroup>
                                                    <col class="tracker-table-col-1">
                                                    <col class="tracker-table-col-2">
                                                    <col class="tracker-table-col-1">
                                                </colgroup>
                                                <thead class="govuk-table__head">
                                                    <tr class="govuk-table__row">
                                                        <th scope="col" class="govuk-table__header govuk-!-font-size-16 govuk-!-text-align-left">Status</th>
                                                        <th scope="col" class="govuk-table__header govuk-!-font-size-16 govuk-!-text-align-left">Upload Time</th>
                                                        <th scope="col" class="govuk-table__header govuk-!-font-size-16 govuk-!-text-align-left">Uploaded By</th>
                                                    </tr>
                                                </thead>
                                                <tbody class="govuk-table__body">
                                                    <tr class="govuk-table__row">
                                                        <td class="govuk-table__cell govuk-!-font-size-16" id="tracker-status"></td>
                                                        <td class="govuk-table__cell govuk-!-font-size-16" id="tracker-upload-time"></td>
                                                        <td class="govuk-table__cell govuk-!-font-size-16" id="tracker-uploaded-by"></td>
                                                    </tr>
                                                </tbody>
                                            </table>
                                        </section>
                                    </div>

                                </div>

                                <div class="govuk-grid-row sup_margin_left_right_10 sup_margin_bottom_10 govuk-!-margin-top-2">
                                    <div class="govuk-grid-column-one-half govuk-!-padding-left-0">
                                        <div class="govuk-form-group sup_margin_bottom_10 fps-inline-search-row">
                                            <label class="govuk-label govuk-!-font-weight-bold govuk-!-font-size-16 fps-inline-search-label"
                                                   for="searchTestCode">
                                                Search TestCode
                                            </label>
                                            <input class="govuk-input govuk-input--width-10 govuk-!-font-size-16"
                                                   id="searchTestCode" name="searchTestCode" type="text" autocomplete="off">
                                        </div>
                                    </div>
                                </div>

                                <div class="govuk-grid-row sup_margin_left_right_10 sup_margin_bottom_10">
                                    <div class="govuk-grid-column-full sup_p_0">
                                        <div id="gridContainer_fecStaging"></div>
                                    </div>
                                </div>

                                <div class="govuk-grid-row sup_margin_left_right_10">
                                    <div class="govuk-grid-column-full govuk-!-padding-left-0 govuk-!-padding-right-0 govuk-!-margin-top-2">
                                        <p class="govuk-body-s govuk-!-margin-bottom-4">Note: Only records which are New, Updated, Deleted are shown.</p>
                                    </div>
                                </div>

                                <div class="govuk-grid-row sup_margin_left_right_10 sup_margin_bottom_10">
                                    <div class="govuk-grid-column-full sup_p_0">
                                        <div id="gridContainer_fecAgrup"></div>
                                    </div>
                                </div>

                                <div class="govuk-grid-row sup_margin_left_right_10 govuk-!-margin-top-2">
                                    <div class="govuk-grid-column-full govuk-!-padding-left-0 govuk-!-padding-right-0">
                                        <div class="govuk-form-group govuk-!-margin-bottom-4 govuk-grid-column-one-third govuk-!-padding-left-0">
                                            <label class="govuk-label" for="approvalComments">Comments</label>
                                            <textarea class="govuk-textarea approval-comments-textarea"
                                                      id="approvalComments" name="approvalComments" rows="3"></textarea>
                                        </div>
                                        <div class="approval-buttons-row">
                                            <div class="govuk-button-group sup_flex_end_center approval-buttons-group">
                                                <button type="button" class="govuk-button" data-module="govuk-button" id="btnReleaseForApproval">
                                                    Release for Approval
                                                </button>
                                                <button type="button" class="govuk-button govuk-button--warning" data-module="govuk-button" id="btnCancelProcess">
                                                    Cancel Process
                                                </button>
                                                <button type="button" class="govuk-button" data-module="govuk-button" id="btnApprove">
                                                    Approve
                                                </button>
                                                <button type="button" class="govuk-button govuk-button--warning" data-module="govuk-button" id="btnReject">
                                                    Reject
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>

    </div>
</main>

<div id="govuk-popup-overlay">
    <div id="govuk-popup"></div>
</div>

@section Scripts {
    <script src="~/js/fps_js/fec_testmanagement.js"></script>
}

@using Apha.FPSApps.Web.Areas.FPS.Models
@model BulkRatesQueueViewModel
@{
    ViewData["Title"] = "Bulk Rates Update — Queue";

    var jobOptions = new[]
    {
        ("", "All job types"),
        ("BulkTestRatesUpdate",  "FEC Test Rates"),
        ("BulkStaffRatesUpdate", "Staff Rates"),
        ("BulkAnimalRatesUpdate","Animal Rates")
    };

    var statusOptions = new[]
    {
        ("", "All statuses"),
        ("Initiated",          "Initiated"),
        ("ReleasedForApproval","Released for Approval"),
        ("Approved",           "Approved"),
        ("Running",         "Running"),
        ("Completed",       "Completed"),
        ("Failed",          "Failed"),
        ("Rejected",        "Rejected"),
        ("Cancelled",       "Cancelled")
    };

    string StatusBadgeClass(string s) => s switch
    {
        "Initiated"           => "govuk-tag govuk-tag--blue",
        "ReleasedForApproval" => "govuk-tag govuk-tag--yellow",
        "Approved"            => "govuk-tag govuk-tag--green",
        "Running"         => "govuk-tag govuk-tag--purple",
        "Completed"       => "govuk-tag",
        "Failed"          => "govuk-tag govuk-tag--red",
        "Rejected"        => "govuk-tag govuk-tag--orange",
        "Cancelled"       => "govuk-tag govuk-tag--grey",
        _                 => "govuk-tag govuk-tag--grey"
    };

    string FriendlyJobName(string j) => j switch
    {
        "BulkTestRatesUpdate"  => "FEC Test Rates",
        "BulkStaffRatesUpdate" => "Staff Rates",
        "BulkAnimalRatesUpdate"=> "Animal Rates",
        _                      => j
    };

    string SideNavItem(string? j) => j switch
    {
        "BulkStaffRatesUpdate"  => "BulkRatesStaff",
        "BulkAnimalRatesUpdate" => "BulkRatesAnimal",
        _                       => "BulkRates"
    };

    string PageHeading(string? j) => j switch
    {
        "BulkTestRatesUpdate"   => "FEC Data Upload and Approval Process",
        "BulkStaffRatesUpdate"  => "Staff Rates Upload and Approval Process",
        "BulkAnimalRatesUpdate" => "Animal Rates Upload and Approval Process",
        _                       => "Bulk Rates Upload and Approval Process"
    };

    // Matches the original design mockups (fec_testmanagement.html, update_staff_rates.html,
    // update_animal_rates.html) — each job type has its own button wording, not a generic label.
    string DownloadButtonLabel(string? j) => j switch
    {
        "BulkStaffRatesUpdate"  => "Download Staff Data (Excel)",
        "BulkAnimalRatesUpdate" => "Download Animal Data (Excel)",
        _                       => "Download Test Data (Excel)"
    };
}

<main class="govuk-main-wrapper govuk-!-padding-top-0" id="main-content" role="main">
    <div class="container-fluid">

        @* Anti-forgery token — referenced by the AJAX upload call on this page *@
        @Html.AntiForgeryToken()

        <div class="govuk-grid-row">
            <div class="govuk-grid-column-full">
                <h1 class="govuk-grid-row govuk-heading-s sup_border-bottom govuk-!-margin-top-2 govuk-!-padding-bottom-2 govuk-!-padding-left-4">
                    Bulk Rates Update
                </h1>
            </div>
        </div>

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="govuk-grid-row govuk-!-margin-top-2 govuk-!-margin-bottom-2">
                <div class="govuk-grid-column-full">
                    <div class="govuk-error-summary" role="alert">
                        <h2 class="govuk-error-summary__title">There is a problem</h2>
                        <div class="govuk-error-summary__body">
                            <p class="govuk-body">@TempData["ErrorMessage"]</p>
                        </div>
                    </div>
                </div>
            </div>
        }

        @if (Model.ActiveRequest != null)
        {
            <div class="govuk-grid-row govuk-!-margin-top-2 govuk-!-margin-bottom-2">
                <div class="govuk-grid-column-full">
                    <div class="govuk-warning-text">
                        <span class="govuk-warning-text__icon" aria-hidden="true">!</span>
                        <strong class="govuk-warning-text__text">
                            <span class="govuk-visually-hidden">Warning</span>
                            A @FriendlyJobName(Model.ActiveRequest.JobName) request is already in progress
                            (Status: @Model.ActiveRequest.Status, requested by @Model.ActiveRequest.RequestedBy).
                            A new request cannot be created until it is completed, rejected, or cancelled.
                            <a asp-area="FPS" asp-controller="BulkRates" asp-action="Detail"
                               asp-route-id="@Model.ActiveRequest.JobExecutionId" class="govuk-link">View Active Request</a>
                        </strong>
                    </div>
                </div>
            </div>
        }

        <div class="govuk-grid-row">
            <div class="cc-container-fluid">
                <div class="cc-layout-row">

                    @await Html.PartialAsync("_BulkRatesSideNav", SideNavItem(Model.JobNameFilter))

                    <div class="cc-content-column">

                        @* Action buttons row *@
                        <div class="govuk-grid-row sup_margin_left_right_10 govuk-!-margin-bottom-4">
                            <div class="govuk-grid-column-one-half">
                                <h2 class="sup_text_color govuk-heading-s sup_align_flexheading sup_p_0">
                                    @PageHeading(Model.JobNameFilter)
                                </h2>
                            </div>
                            <div class="govuk-grid-column-one-half">
                                <div class="action-buttons">
                                    @if (Model.ActiveRequest != null)
                                    {
                                        <span class="govuk-button govuk-button--secondary govuk-button--disabled sup_margin_0"
                                              aria-disabled="true" title="An active request already exists for this job type.">
                                            New Request
                                        </span>
                                    }
                                    else
                                    {
                                        <a asp-area="FPS" asp-controller="BulkRates" asp-action="Create"
                                           asp-route-jobName="@Model.JobNameFilter"
                                           class="govuk-button govuk-button--secondary sup_margin_0">
                                            New Request
                                        </a>
                                    }
                                    @if (!string.IsNullOrEmpty(Model.JobNameFilter))
                                    {
                                        <button type="button" class="govuk-button sup_margin_0"
                                                data-module="govuk-button" id="btnDownloadTestData"
                                                data-job-name="@Model.JobNameFilter">
                                            @DownloadButtonLabel(Model.JobNameFilter)
                                        </button>
                                    }
                                    @if (Model.UploadTargetId != null)
                                    {
                                        <button type="button" class="govuk-button sup_margin_0"
                                                data-module="govuk-button" id="btnUploadUpdatedData"
                                                data-request-id="@Model.UploadTargetId">
                                            Upload Updated Data
                                        </button>
                                    }
                                </div>
                                @if (!string.IsNullOrEmpty(Model.JobNameFilter))
                                {
                                    <p class="govuk-body-s govuk-!-margin-bottom-0 govuk-!-margin-top-1 govuk-!-text-align-right">
                                        Note: Data will be downloaded for current year.
                                    </p>
                                }
                            </div>
                        </div>

                        @if (!Model.IsJobNameLocked)
                        {
                            <form method="get" asp-area="FPS" asp-controller="BulkRates" asp-action="Index"
                                  class="govuk-grid-row sup_margin_left_right_10 govuk-!-margin-bottom-4">

                                <div class="govuk-grid-column-one-quarter govuk-!-padding-left-0">
                                    <label class="govuk-label govuk-!-font-size-16 govuk-!-font-weight-bold" for="jobNameFilter">Job type</label>
                                    <select class="govuk-select govuk-!-font-size-16 govuk-!-width-full" id="jobNameFilter" name="jobName">
                                        @foreach (var (val, label) in jobOptions)
                                        {
                                            <option value="@val" selected="@(Model.JobNameFilter == val ? "selected" : null)">@label</option>
                                        }
                                    </select>
                                </div>

                                <div class="govuk-grid-column-one-quarter">
                                    <label class="govuk-label govuk-!-font-size-16 govuk-!-font-weight-bold" for="fpsYearFilter">FPS year</label>
                                    <input class="govuk-input govuk-input--width-5 govuk-!-font-size-16"
                                           id="fpsYearFilter" name="fpsYear" type="number" min="2000" max="2100"
                                           value="@(Model.FpsYearFilter?.ToString() ?? "")">
                                </div>

                                <div class="govuk-grid-column-one-quarter">
                                    <label class="govuk-label govuk-!-font-size-16 govuk-!-font-weight-bold" for="statusFilter">Status</label>
                                    <select class="govuk-select govuk-!-font-size-16 govuk-!-width-full" id="statusFilter" name="status">
                                        @foreach (var (val, label) in statusOptions)
                                        {
                                            <option value="@val" selected="@(Model.StatusFilter == val ? "selected" : null)">@label</option>
                                        }
                                    </select>
                                </div>

                                <div class="govuk-grid-column-one-quarter govuk-!-padding-right-0 govuk-!-display-flex" style="align-items:flex-end;">
                                    <div class="govuk-button-group govuk-!-margin-bottom-0">
                                        <button type="submit" class="govuk-button govuk-!-margin-bottom-0" data-module="govuk-button">Filter</button>
                                    </div>
                                </div>

                            </form>
                        }

                        @if (!Model.Entries.Any())
                        {
                            <p class="govuk-body govuk-!-margin-left-3">
                                @(Model.IsJobNameLocked
                                    ? $"No {FriendlyJobName(Model.JobNameFilter ?? "")} requests for FPS year {Model.FpsYearFilter}."
                                    : "No requests match the selected filters.")
                            </p>
                        }
                        else
                        {
                            <div class="govuk-grid-row sup_margin_left_right_10">
                                <div class="govuk-grid-column-full sup_p_0">
                                    <table class="govuk-table govuk-!-font-size-16 custom-table govuk-!-margin-bottom-0">
                                        <thead class="govuk-table__head">
                                            <tr class="govuk-table__row">
                                                <th scope="col" class="govuk-table__header">Request ID</th>
                                                <th scope="col" class="govuk-table__header">Job Type</th>
                                                <th scope="col" class="govuk-table__header">FPS Year</th>
                                                <th scope="col" class="govuk-table__header">Status</th>
                                                <th scope="col" class="govuk-table__header">Requested By</th>
                                                <th scope="col" class="govuk-table__header">Requested At (UTC)</th>
                                                <th scope="col" class="govuk-table__header">Action</th>
                                            </tr>
                                        </thead>
                                        <tbody class="govuk-table__body">
                                            @foreach (var e in Model.Entries)
                                            {
                                                <tr class="govuk-table__row">
                                                    <td class="govuk-table__cell govuk-!-font-size-14" style="font-family:monospace;">
                                                        @e.JobExecutionId.ToString()[..8]&hellip;
                                                    </td>
                                                    <td class="govuk-table__cell">@FriendlyJobName(e.JobName)</td>
                                                    <td class="govuk-table__cell">@e.FpsYear</td>
                                                    <td class="govuk-table__cell">
                                                        <strong class="@StatusBadgeClass(e.Status)">@e.Status</strong>
                                                    </td>
                                                    <td class="govuk-table__cell">@e.RequestedBy</td>
                                                    <td class="govuk-table__cell">@e.RequestedAtUtc.ToString("dd MMM yyyy HH:mm")</td>
                                                    <td class="govuk-table__cell">
                                                        <a asp-area="FPS" asp-controller="BulkRates" asp-action="Detail"
                                                           asp-route-id="@e.JobExecutionId"
                                                           class="govuk-link govuk-!-font-size-16">View</a>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        }


                        <div class="govuk-grid-row">
                            <div class="govuk-grid-column-full">

                                <div class="govuk-grid-row sup_margin_left_right_10 sup_margin_bottom_10">

                                    <div class="govuk-grid-column-full sup_p_0">
                                        <section class="sup_border govuk-!-padding-3" aria-labelledby="process-rules-title">
                                            <h2 class="govuk-heading-s govuk-!-margin-bottom-2" id="process-rules-title">Process Rules</h2>
                                            <ul class="govuk-list govuk-list--bullet govuk-!-font-size-16 govuk-!-margin-bottom-0">
                                                <li>Only FPS Admin can perform this process.</li>
                                                <li>Only uploader can edit or release data.</li>
                                                <li>Second Admin must approve changes.</li>
                                            </ul>
                                        </section>
                                    </div>

                                </div>

                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>

    </div>
</main>

@await Html.PartialAsync("_UploadTrackerModal")

@section Scripts {
    <script src="~/js/fps_js/fec_testmanagement.js" asp-append-version="true"></script>
}

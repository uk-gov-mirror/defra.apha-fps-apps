@using Apha.FPSApps.Web.Areas.FPS.Models
@model BulkRatesDetailViewModel
@{
    var entry = Model.Request.Entry;
    var uploadResult = Model.UploadResult;

    ViewData["Title"] = $"Bulk Rates — {entry.JobName} {entry.FpsYear}";

    string StatusBadgeClass(string s) => s switch
    {
        "Initiated"           => "govuk-tag govuk-tag--blue",
        "ReleasedForApproval" => "govuk-tag govuk-tag--yellow",
        "Approved"            => "govuk-tag govuk-tag--green",
        "Running"         => "govuk-tag govuk-tag--purple",
        "Completed"       => "govuk-tag",
        "Failed"          => "govuk-tag govuk-tag--red",
        "Rejected"        => "govuk-tag govuk-tag--orange",
        "Cancelled"       => "govuk-tag govuk-tag--grey",
        _                 => "govuk-tag govuk-tag--grey"
    };

    string FriendlyJobName(string j) => j switch
    {
        "BulkTestRatesUpdate"   => "FEC Test Rates",
        "BulkStaffRatesUpdate"  => "Staff Rates",
        "BulkAnimalRatesUpdate" => "Animal Rates",
        _                       => j
    };

    string QueueAction(string j) => j switch
    {
        "BulkTestRatesUpdate"   => "Fec",
        "BulkStaffRatesUpdate"  => "Staff",
        "BulkAnimalRatesUpdate" => "Animal",
        _                       => "Index"
    };

    string SideNavItem(string j) => j switch
    {
        "BulkStaffRatesUpdate"  => "BulkRatesStaff",
        "BulkAnimalRatesUpdate" => "BulkRatesAnimal",
        _                       => "BulkRates"
    };
}

<main class="govuk-main-wrapper govuk-!-padding-top-0" id="main-content" role="main">
    <div class="container-fluid">

        <div class="govuk-grid-row">
            <div class="govuk-grid-column-full">
                <h1 class="govuk-grid-row govuk-heading-s sup_border-bottom govuk-!-margin-top-2 govuk-!-padding-bottom-2 govuk-!-padding-left-4">
                    Bulk Rates Update
                </h1>
            </div>
        </div>

        <div class="govuk-grid-row">
            <div class="cc-container-fluid">
                <div class="cc-layout-row">

                    @await Html.PartialAsync("_BulkRatesSideNav", SideNavItem(entry.JobName))

                    <div class="cc-content-column">

                        <div class="govuk-grid-row sup_margin_left_right_10">
                            <div class="govuk-grid-column-full govuk-!-padding-left-0 govuk-!-padding-right-0">

                                <a asp-area="FPS" asp-controller="BulkRates" asp-action="@QueueAction(entry.JobName)"
                                   class="govuk-back-link govuk-!-font-size-16">Back to queue</a>

                                @* Anti-forgery token — referenced by all AJAX calls on this page *@
                                @Html.AntiForgeryToken()

                                @if (TempData["ErrorMessage"] != null)
                                {
                                    <div class="govuk-error-summary" role="alert">
                                        <h2 class="govuk-error-summary__title">There is a problem</h2>
                                        <div class="govuk-error-summary__body">
                                            <p class="govuk-body">@TempData["ErrorMessage"]</p>
                                        </div>
                                    </div>
                                }

                                @* Action/upload error banner — rendered unconditionally (not gated behind the
                                   action-button flags below) so it's available to showActionError() regardless of
                                   which actions are currently permitted, and shown at the top of the page rather
                                   than buried below the staging grids. *@
                                <div id="actionErrorBanner" class="govuk-error-summary" style="display:none;" aria-labelledby="action-error-title" role="alert">
                                    <h2 class="govuk-error-summary__title" id="action-error-title">There is a problem</h2>
                                    <div class="govuk-error-summary__body">
                                        <ul class="govuk-list govuk-error-summary__list"><li id="actionErrorText"></li></ul>
                                    </div>
                                </div>

                                @* ── Request header ── *@
                                <div class="govuk-grid-row govuk-!-margin-top-4 govuk-!-margin-bottom-4">
                                    <div class="govuk-grid-column-full">
                                        <h2 class="govuk-heading-m govuk-!-margin-bottom-2">
                                            @FriendlyJobName(entry.JobName) — FPS Year @entry.FpsYear
                                            <strong class="@StatusBadgeClass(entry.Status) govuk-!-margin-left-2">@entry.Status</strong>
                                        </h2>
                                        <dl class="govuk-summary-list govuk-summary-list--no-border govuk-!-font-size-16 govuk-!-margin-bottom-0">
                                            <div class="govuk-summary-list__row">
                                                <dt class="govuk-summary-list__key">Request ID</dt>
                                                <dd class="govuk-summary-list__value" style="font-family:monospace; font-size:13px;">@entry.JobExecutionId</dd>
                                            </div>
                                            <div class="govuk-summary-list__row">
                                                <dt class="govuk-summary-list__key">Requested by</dt>
                                                <dd class="govuk-summary-list__value">@entry.RequestedBy</dd>
                                            </div>
                                            <div class="govuk-summary-list__row">
                                                <dt class="govuk-summary-list__key">Requested at (UTC)</dt>
                                                <dd class="govuk-summary-list__value">@entry.RequestedAtUtc.ToString("dd MMM yyyy HH:mm:ss")</dd>
                                            </div>
                                            @if (!string.IsNullOrEmpty(entry.ApprovedBy))
                                            {
                                                <div class="govuk-summary-list__row">
                                                    <dt class="govuk-summary-list__key">Approved by</dt>
                                                    <dd class="govuk-summary-list__value">@entry.ApprovedBy at @entry.ApprovedAtUtc?.ToString("dd MMM yyyy HH:mm")</dd>
                                                </div>
                                            }
                                            @if (!string.IsNullOrEmpty(entry.RejectedBy))
                                            {
                                                <div class="govuk-summary-list__row">
                                                    <dt class="govuk-summary-list__key">Rejected by</dt>
                                                    <dd class="govuk-summary-list__value">@entry.RejectedBy at @entry.RejectedAtUtc?.ToString("dd MMM yyyy HH:mm")</dd>
                                                </div>
                                                <div class="govuk-summary-list__row">
                                                    <dt class="govuk-summary-list__key">Rejection reason</dt>
                                                    <dd class="govuk-summary-list__value govuk-!-color-red">@entry.RejectionReason</dd>
                                                </div>
                                            }
                                            @if (!string.IsNullOrEmpty(entry.CancelledBy))
                                            {
                                                <div class="govuk-summary-list__row">
                                                    <dt class="govuk-summary-list__key">Cancelled by</dt>
                                                    <dd class="govuk-summary-list__value">@entry.CancelledBy at @entry.CancelledAtUtc?.ToString("dd MMM yyyy HH:mm")</dd>
                                                </div>
                                            }
                                            @if (!string.IsNullOrEmpty(entry.ErrorMessage))
                                            {
                                                <div class="govuk-summary-list__row">
                                                    <dt class="govuk-summary-list__key">Error</dt>
                                                    <dd class="govuk-summary-list__value govuk-!-color-red">@entry.ErrorMessage</dd>
                                                </div>
                                            }
                                        </dl>
                                    </div>
                                </div>

                                @* ── Upload section — shown only to initiator on Initiated/Rejected ── *@
                                @if (Model.CanUpload)
                                {
                                    <section class="sup_border govuk-!-padding-3 govuk-!-margin-bottom-4" aria-labelledby="upload-section-title">
                                        <h3 class="govuk-heading-s govuk-!-margin-bottom-2" id="upload-section-title">Upload rates file</h3>
                                        <div class="govuk-hint govuk-!-font-size-16 govuk-!-margin-bottom-2">
                                            Select an Excel (.xlsx) file. Uploading a new file replaces any previously uploaded data and re-runs validation.
                                        </div>
                                        @{
                                            var (testDataDownloadUrl, testDataDownloadLabel) = entry.JobName switch
                                            {
                                                "BulkStaffRatesUpdate"  => ($"/FPS/BulkRates/DownloadStaffTestData?fpsYear={entry.FpsYear}", "Download Staff Data (Excel)"),
                                                "BulkAnimalRatesUpdate" => ($"/FPS/BulkRates/DownloadAnimalTestData?fpsYear={entry.FpsYear}", "Download Animal Data (Excel)"),
                                                _                       => ($"/FPS/BulkRates/DownloadTestDataForRequest?id={entry.JobExecutionId}", "Download Test Data (Excel)")
                                            };
                                        }
                                        <div class="govuk-button-group govuk-!-margin-bottom-2">
                                            <a href="@testDataDownloadUrl"
                                               class="govuk-button govuk-button--secondary govuk-!-margin-bottom-0">
                                                @testDataDownloadLabel
                                            </a>
                                        </div>
                                        <div class="govuk-form-group govuk-!-margin-bottom-2">
                                            <label class="govuk-label govuk-!-font-weight-bold govuk-!-font-size-16" for="ratesFile">File</label>
                                            <input class="govuk-file-upload" id="ratesFile" name="ratesFile" type="file" accept=".xlsx">
                                        </div>
                                        <div class="govuk-button-group govuk-!-margin-bottom-0">
                                            <button type="button" class="govuk-button govuk-!-margin-bottom-0" id="btnUpload"
                                                    onclick="BulkRates.uploadFile('@entry.JobExecutionId')">
                                                Upload and Validate
                                            </button>
                                        </div>
                                        <div id="uploadProgress" style="display:none;" class="govuk-!-margin-top-2">
                                            <p class="govuk-body-s govuk-!-margin-bottom-0">Uploading and validating&hellip;</p>
                                        </div>
                                    </section>
                                }

                                @* ── Upload metadata + validation results ── *@
                                @* GetValidationResultsAsync always returns a DTO, even with nothing uploaded —
                                   Filename is the only field that distinguishes "not yet uploaded" from
                                   "uploaded with zero errors", so gate the panel on it rather than null. *@
                                @if (uploadResult != null && !string.IsNullOrEmpty(uploadResult.Filename))
                                {
                                    var rc = uploadResult.RowCounts;
                                    var errors = uploadResult.ValidationErrors.Where(e => e.Severity == "Error").ToList();
                                    var warnings = uploadResult.ValidationErrors.Where(e => e.Severity == "Warning").ToList();

                                    // FEC/AGRUP rows with a TestCode are shown inline against the matching row
                                    // in the staging grids below. Everything else — file-parse errors, request-level
                                    // findings with no single row to attach to, and all Staff/Animal findings —
                                    // has nowhere else to appear, so it's listed here.
                                    var isFec = entry.JobName == "BulkTestRatesUpdate";
                                    var unmatchedErrors = (isFec
                                        ? uploadResult.ValidationErrors.Where(e => string.IsNullOrEmpty(e.TestCode))
                                        : uploadResult.ValidationErrors)
                                        .OrderBy(e => e.Severity == "Error" ? 0 : 1)
                                        .ThenBy(e => e.SourceRowNumber)
                                        .ToList();

                                    <section class="sup_border govuk-!-padding-3 govuk-!-margin-bottom-4" aria-labelledby="validation-section-title">
                                        <h3 class="govuk-heading-s govuk-!-margin-bottom-2" id="validation-section-title">
                                            Validation results
                                            @if (errors.Count == 0)
                                            {
                                                <strong class="govuk-tag govuk-tag--green govuk-!-margin-left-2">Passed</strong>
                                            }
                                            else
                                            {
                                                <strong class="govuk-tag govuk-tag--red govuk-!-margin-left-2">@errors.Count error(s)</strong>
                                            }
                                        </h3>

                                        <p class="govuk-body-s govuk-!-margin-bottom-2">
                                            File: <strong>@uploadResult.Filename</strong> &mdash;
                                            Upload v@(uploadResult.UploadVersion) &mdash;
                                            Total rows: @rc.Total, Valid: @rc.Valid, Invalid: @rc.Invalid,
                                            Insert: @rc.Insert, Update: @rc.Update, Unchanged: @rc.Unchanged
                                        </p>

                                        @if (isFec && unmatchedErrors.Count < uploadResult.ValidationErrors.Count)
                                        {
                                            <p class="govuk-body-s govuk-!-margin-bottom-2">
                                                Row-level findings for staged rows are shown in the Validation column of the tables below.
                                            </p>
                                        }

                                        @if (!uploadResult.ValidationErrors.Any())
                                        {
                                            <p class="govuk-body-s govuk-!-margin-bottom-0">All rows passed validation.</p>
                                        }
                                        else if (unmatchedErrors.Any())
                                        {
                                            <div class="govuk-!-margin-top-2" style="max-height:320px; overflow-y:auto;">
                                                <table class="govuk-table govuk-!-font-size-14 govuk-!-margin-bottom-0">
                                                    <thead class="govuk-table__head">
                                                        <tr class="govuk-table__row">
                                                            <th scope="col" class="govuk-table__header govuk-!-width-one-eighth">Row</th>
                                                            <th scope="col" class="govuk-table__header">Field</th>
                                                            <th scope="col" class="govuk-table__header govuk-!-width-one-eighth">Severity</th>
                                                            <th scope="col" class="govuk-table__header">Message</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody class="govuk-table__body">
                                                        @foreach (var ve in unmatchedErrors)
                                                        {
                                                            <tr class="govuk-table__row">
                                                                <td class="govuk-table__cell">@(ve.SourceRowNumber > 0 ? ve.SourceRowNumber.ToString() : "—")</td>
                                                                <td class="govuk-table__cell">@(ve.FieldName ?? "—")</td>
                                                                <td class="govuk-table__cell">
                                                                    <strong class="govuk-tag @(ve.Severity == "Error" ? "govuk-tag--red" : "govuk-tag--yellow")">@ve.Severity</strong>
                                                                </td>
                                                                <td class="govuk-table__cell">@ve.ValidationMessage</td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                        }
                                    </section>
                                }

                                @* ── Action buttons — placed right after the validation summary, before the
                                   staging grids below, so approving/rejecting/cancelling a request never
                                   requires scrolling past a potentially long grid to reach them. ── *@
                                @if (Model.CanRelease || Model.CanApprove || Model.CanReject || Model.CanCancel)
                                {
                                    <div class="govuk-button-group govuk-!-margin-bottom-4">

                                        @* Release — initiator + Initiated + no blocking errors *@
                                        @if (Model.CanRelease)
                                        {
                                            <button type="button" class="govuk-button" data-module="govuk-button" id="btnRelease"
                                                    onclick="BulkRates.release('@entry.JobExecutionId')">
                                                Release for Approval
                                            </button>
                                        }

                                        @* Approve — approver + ReleasedForApproval *@
                                        @if (Model.CanApprove)
                                        {
                                            <button type="button" class="govuk-button" data-module="govuk-button" id="btnApprove"
                                                    onclick="BulkRates.approve('@entry.JobExecutionId')">
                                                Approve
                                            </button>
                                        }

                                        @* Reject — approver + ReleasedForApproval *@
                                        @if (Model.CanReject)
                                        {
                                            <button type="button" class="govuk-button govuk-button--warning" data-module="govuk-button" id="btnReject"
                                                    onclick="BulkRates.showRejectModal('@entry.JobExecutionId')">
                                                Reject
                                            </button>
                                        }

                                        @* Cancel — initiator + Initiated/Rejected *@
                                        @if (Model.CanCancel)
                                        {
                                            <button type="button" class="govuk-button govuk-button--warning" data-module="govuk-button" id="btnCancel"
                                                    onclick="BulkRates.showCancelModal('@entry.JobExecutionId')">
                                                Cancel Request
                                            </button>
                                        }

                                    </div>
                                }

                                @* ── FEC Data (Staging) / Agrup Details — staged rows for this request vs. live data ── *@
                                @if (entry.JobName == "BulkTestRatesUpdate")
                                {
                                    <section class="sup_border govuk-!-padding-3 govuk-!-margin-bottom-4" aria-labelledby="fec-staging-section-title">
                                        <div class="govuk-grid-row govuk-!-margin-bottom-2">
                                            <div class="govuk-grid-column-one-half">
                                                <h3 class="govuk-heading-s govuk-!-margin-bottom-0" id="fec-staging-section-title">FEC Data (Staging)</h3>
                                            </div>
                                            <div class="govuk-grid-column-one-half govuk-!-text-align-right">
                                                <button type="button" class="govuk-button govuk-button--secondary sup_margin_0"
                                                        data-module="govuk-button" onclick="BulkRates.downloadStagingData('@entry.JobExecutionId')">
                                                    Download Staging Data
                                                </button>
                                            </div>
                                        </div>

                                        @if (entry.Status == "Completed")
                                        {
                                            <p class="govuk-body-s govuk-!-margin-bottom-0">
                                                Staging data was cleared after this request completed. See the row counts in
                                                Validation results above, and Status history below, for what was applied.
                                            </p>
                                        }
                                        else
                                        {
                                            <div id="gridContainer_@Model.FecStagingGrid.GridId">
                                                @await Html.PartialAsync("_DataGrid", Model.FecStagingGrid)
                                            </div>

                                            <p class="govuk-body-s govuk-!-margin-bottom-0 govuk-!-margin-top-2">
                                                Note: Status shows the calculated action for this row (No Change / Insert / Update / Zero-Rate Withdrawal), or Deleted for a live record this upload did not include at all.
                                            </p>
                                        }
                                    </section>

                                    <section class="sup_border govuk-!-padding-3 govuk-!-margin-bottom-4" aria-labelledby="agrup-details-section-title">
                                        <h3 class="govuk-heading-s govuk-!-margin-bottom-2" id="agrup-details-section-title">Agrup Details</h3>

                                        @if (entry.Status == "Completed")
                                        {
                                            <p class="govuk-body-s govuk-!-margin-bottom-0">
                                                Staging data was cleared after this request completed. See the row counts in
                                                Validation results above, and Status history below, for what was applied.
                                            </p>
                                        }
                                        else
                                        {
                                            <div id="gridContainer_@Model.AgrupStagingGrid.GridId">
                                                @await Html.PartialAsync("_DataGrid", Model.AgrupStagingGrid)
                                            </div>

                                            <p class="govuk-body-s govuk-!-margin-bottom-0 govuk-!-margin-top-2">
                                                Note: Status shows the calculated action for this row (No Change / Insert / Update / Zero-Rate Withdrawal), or Deleted for a live record this upload did not include at all.
                                            </p>
                                        }
                                    </section>
                                }

                                @* ── Staff Data (Staging) — staged rows for this request vs. live data ── *@
                                @if (entry.JobName == "BulkStaffRatesUpdate")
                                {
                                    <section class="sup_border govuk-!-padding-3 govuk-!-margin-bottom-4" aria-labelledby="staff-staging-section-title">
                                        <div class="govuk-grid-row govuk-!-margin-bottom-2">
                                            <div class="govuk-grid-column-one-half">
                                                <h3 class="govuk-heading-s govuk-!-margin-bottom-0" id="staff-staging-section-title">Staff Data (Staging)</h3>
                                            </div>
                                            <div class="govuk-grid-column-one-half govuk-!-text-align-right">
                                                <button type="button" class="govuk-button govuk-button--secondary sup_margin_0"
                                                        data-module="govuk-button" onclick="BulkRates.downloadStagingData('@entry.JobExecutionId')">
                                                    Download Staging Data
                                                </button>
                                            </div>
                                        </div>

                                        <div id="gridContainer_@Model.StaffStagingGrid.GridId">
                                            @await Html.PartialAsync("_DataGrid", Model.StaffStagingGrid)
                                        </div>

                                        <p class="govuk-body-s govuk-!-margin-bottom-0 govuk-!-margin-top-2">
                                            Note: Only records which are Updated or Not Found are shown. "Not Found"
                                            means the PcGrade doesn't exist for this FPS year — it will be skipped, not created.
                                        </p>
                                    </section>
                                }

                                @* ── Animal Data (Staging) — staged rows for this request vs. live data ── *@
                                @if (entry.JobName == "BulkAnimalRatesUpdate")
                                {
                                    <section class="sup_border govuk-!-padding-3 govuk-!-margin-bottom-4" aria-labelledby="animal-staging-section-title">
                                        <div class="govuk-grid-row govuk-!-margin-bottom-2">
                                            <div class="govuk-grid-column-one-half">
                                                <h3 class="govuk-heading-s govuk-!-margin-bottom-0" id="animal-staging-section-title">Animal Data (Staging)</h3>
                                            </div>
                                            <div class="govuk-grid-column-one-half govuk-!-text-align-right">
                                                <button type="button" class="govuk-button govuk-button--secondary sup_margin_0"
                                                        data-module="govuk-button" onclick="BulkRates.downloadStagingData('@entry.JobExecutionId')">
                                                    Download Staging Data
                                                </button>
                                            </div>
                                        </div>

                                        <div id="gridContainer_@Model.AnimalStagingGrid.GridId">
                                            @await Html.PartialAsync("_DataGrid", Model.AnimalStagingGrid)
                                        </div>

                                        <p class="govuk-body-s govuk-!-margin-bottom-0 govuk-!-margin-top-2">
                                            Note: Only records which are Updated or Not Found are shown. "Not Found"
                                            means the Animal Type doesn't exist for this FPS year — it will be skipped, not created.
                                        </p>
                                    </section>
                                }

                                @* ── Status history ── *@
                                @if (Model.Request.Log.Any())
                                {
                                    <section class="sup_border govuk-!-padding-3 govuk-!-margin-bottom-4" aria-labelledby="history-section-title">
                                        <h3 class="govuk-heading-s govuk-!-margin-bottom-2" id="history-section-title">Status history</h3>
                                        <table class="govuk-table govuk-!-font-size-14 govuk-!-margin-bottom-0">
                                            <thead class="govuk-table__head">
                                                <tr class="govuk-table__row">
                                                    <th scope="col" class="govuk-table__header">Timestamp (UTC)</th>
                                                    <th scope="col" class="govuk-table__header">Actor</th>
                                                    <th scope="col" class="govuk-table__header">Note</th>
                                                </tr>
                                            </thead>
                                            <tbody class="govuk-table__body">
                                                @foreach (var log in Model.Request.Log.OrderByDescending(l => l.CreatedAtUtc))
                                                {
                                                    <tr class="govuk-table__row">
                                                        <td class="govuk-table__cell">@log.CreatedAtUtc.ToString("dd MMM yyyy HH:mm:ss")</td>
                                                        <td class="govuk-table__cell">@(log.Actor ?? "—")</td>
                                                        <td class="govuk-table__cell">@log.Note</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </section>
                                }

                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>

    </div>
</main>

@await Html.PartialAsync("_RejectModal")
@await Html.PartialAsync("_CancelModal")

@section Scripts {
    <script src="~/js/fps_js/fec_testmanagement.js" asp-append-version="true"></script>
}

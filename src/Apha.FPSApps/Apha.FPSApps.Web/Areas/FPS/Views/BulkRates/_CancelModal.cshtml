@*
    _CancelModal.cshtml — US-UI-08: Cancellation modal with optional reason.
    Toggled by BulkRates.showCancelModal() / BulkRates.closeCancelModal().
    BulkRates.confirmCancel() POSTs to /FPS/BulkRates/Cancel.
    Mirrors _RejectModal.cshtml's structure for a standardized modal pattern.
*@
<div id="cancelModalOverlay" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,.45); z-index:9999;"
     role="dialog" aria-modal="true" aria-labelledby="cancelModalTitle">
    <div style="background:#fff; max-width:480px; margin:10vh auto; padding:2rem; border:2px solid #0b0c0c;">
        <h2 class="govuk-heading-m" id="cancelModalTitle">Cancel request</h2>
        <p class="govuk-body-s">You may optionally enter a reason for cancelling this request.</p>

        <div class="govuk-form-group govuk-!-margin-bottom-4" id="cancelReasonGroup">
            <label class="govuk-label govuk-!-font-weight-bold" for="cancelReason">Cancellation reason (optional)</label>
            <textarea class="govuk-textarea" id="cancelReason" name="cancelReason" rows="4" maxlength="500"></textarea>
        </div>

        <div class="govuk-button-group govuk-!-margin-bottom-0">
            <button type="button" class="govuk-button govuk-button--warning govuk-!-margin-bottom-0"
                    id="btnConfirmCancel" onclick="BulkRates.confirmCancel()">
                Confirm Cancellation
            </button>
            <button type="button" class="govuk-button govuk-button--secondary govuk-!-margin-bottom-0 govuk-!-margin-left-2"
                    onclick="BulkRates.closeCancelModal()">
                Keep Request
            </button>
        </div>
    </div>
</div>

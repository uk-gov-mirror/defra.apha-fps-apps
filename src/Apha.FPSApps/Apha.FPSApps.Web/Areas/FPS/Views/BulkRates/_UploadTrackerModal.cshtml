@*
    _UploadTrackerModal.cshtml — Upload dialog for the "Upload Updated Data" tracker button on Index.
    Toggled by BulkRates.showUploadTrackerModal() / BulkRates.closeUploadTrackerModal().
    BulkRates.confirmTrackerUpload() posts the selected file to /FPS/BulkRates/Upload for the
    request resolved server-side into btnUploadUpdatedData's data-request-id attribute.
*@
<div id="uploadTrackerModalOverlay" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,.45); z-index:9999;"
     role="dialog" aria-modal="true" aria-labelledby="uploadTrackerModalTitle">
    <div style="background:#fff; max-width:480px; margin:10vh auto; padding:2rem; border:2px solid #0b0c0c;">
        <h2 class="govuk-heading-m" id="uploadTrackerModalTitle">Upload updated data</h2>
        <p class="govuk-body-s">
            Select an Excel (.xlsx) file. Uploading a new file replaces any previously uploaded data and re-runs validation.
        </p>

        <div class="govuk-form-group govuk-!-margin-bottom-4" id="uploadTrackerFileGroup">
            <label class="govuk-label govuk-!-font-weight-bold" for="uploadTrackerFile">File</label>
            <div id="uploadTrackerFileError" class="govuk-error-message" style="display:none;">
                <span class="govuk-visually-hidden">Error:</span> Select a file before uploading.
            </div>
            <input class="govuk-file-upload" id="uploadTrackerFile" name="uploadTrackerFile" type="file" accept=".xlsx">
        </div>

        <div id="uploadTrackerProgress" style="display:none;" class="govuk-!-margin-bottom-4">
            <p class="govuk-body-s govuk-!-margin-bottom-0">Uploading and validating&hellip;</p>
        </div>

        <div class="govuk-button-group govuk-!-margin-bottom-0">
            <button type="button" class="govuk-button govuk-!-margin-bottom-0"
                    id="btnConfirmTrackerUpload" onclick="BulkRates.confirmTrackerUpload()">
                Upload and Validate
            </button>
            <button type="button" class="govuk-button govuk-button--secondary govuk-!-margin-bottom-0 govuk-!-margin-left-2"
                    onclick="BulkRates.closeUploadTrackerModal()">
                Cancel
            </button>
        </div>
    </div>
</div>

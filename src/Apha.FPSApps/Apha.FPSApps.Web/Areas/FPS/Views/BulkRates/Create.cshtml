@using Apha.FPSApps.Web.Areas.FPS.Models
@model BulkRatesCreateViewModel
@{
    ViewData["Title"] = "New Bulk Rates Request";

    string FriendlyJobName(string j) => j switch
    {
        "BulkTestRatesUpdate"   => "FEC Test Rates",
        "BulkStaffRatesUpdate"  => "Staff Rates",
        "BulkAnimalRatesUpdate" => "Animal Rates",
        _                       => j
    };

    string QueueAction(string j) => j switch
    {
        "BulkTestRatesUpdate"   => "Fec",
        "BulkStaffRatesUpdate"  => "Staff",
        "BulkAnimalRatesUpdate" => "Animal",
        _                       => "Index"
    };

    string SideNavItem(string j) => j switch
    {
        "BulkStaffRatesUpdate"  => "BulkRatesStaff",
        "BulkAnimalRatesUpdate" => "BulkRatesAnimal",
        _                       => "BulkRates"
    };
}

<main class="govuk-main-wrapper govuk-!-padding-top-0" id="main-content" role="main">
    <div class="container-fluid">

        <div class="govuk-grid-row">
            <div class="govuk-grid-column-full">
                <h1 class="govuk-grid-row govuk-heading-s sup_border-bottom govuk-!-margin-top-2 govuk-!-padding-bottom-2 govuk-!-padding-left-4">
                    Bulk Rates Update
                </h1>
            </div>
        </div>

        <div class="govuk-grid-row">
            <div class="cc-container-fluid">
                <div class="cc-layout-row">

                    @await Html.PartialAsync("_BulkRatesSideNav", SideNavItem(Model.JobName))

                    <div class="cc-content-column">

                        <div class="govuk-grid-row sup_margin_left_right_10 sup_margin_bottom_10">
                            <div class="govuk-grid-column-two-thirds govuk-!-padding-left-0">

                                <a asp-area="FPS" asp-controller="BulkRates" asp-action="@QueueAction(Model.JobName)"
                                   class="govuk-back-link govuk-!-font-size-16">Back to queue</a>

                                <h2 class="govuk-heading-m govuk-!-margin-top-4">New Bulk Rates Request</h2>

                                <div id="createErrorSummary" class="govuk-error-summary" style="display:none;" aria-labelledby="error-summary-title" role="alert" data-module="govuk-error-summary">
                                    <h2 class="govuk-error-summary__title" id="error-summary-title">There is a problem</h2>
                                    <div class="govuk-error-summary__body">
                                        <ul class="govuk-list govuk-error-summary__list">
                                            <li id="createErrorText"></li>
                                        </ul>
                                    </div>
                                </div>

                                @Html.AntiForgeryToken()

                                <div class="govuk-form-group govuk-!-margin-bottom-4">
                                    <label class="govuk-label govuk-!-font-weight-bold">Job type</label>
                                    <p class="govuk-body govuk-!-margin-bottom-0">@FriendlyJobName(Model.JobName)</p>
                                    <input type="hidden" id="jobName" name="jobName" value="@Model.JobName">
                                </div>

                                <div class="govuk-form-group govuk-!-margin-bottom-6">
                                    <label class="govuk-label govuk-!-font-weight-bold">FPS year</label>
                                    <p class="govuk-body govuk-!-margin-bottom-0">@Model.FpsYear</p>
                                    <input type="hidden" id="fpsYear" name="fpsYear" value="@Model.FpsYear">
                                </div>

                                <div class="govuk-button-group">
                                    <button type="button" class="govuk-button" data-module="govuk-button" id="btnCreateRequest"
                                            onclick="BulkRates.submitCreate()">
                                        Create Request
                                    </button>
                                    <a asp-area="FPS" asp-controller="BulkRates" asp-action="@QueueAction(Model.JobName)"
                                       class="govuk-link govuk-!-font-size-16">Cancel</a>
                                </div>

                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>

    </div>
</main>

@section Scripts {
    <script src="~/js/fps_js/fec_testmanagement.js" asp-append-version="true"></script>
}

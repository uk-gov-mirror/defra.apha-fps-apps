@model Apha.FPSApps.Web.Areas.FPS.Models.ProfitCentreGradeMaintItem
@{
    var isEditMode = !string.IsNullOrWhiteSpace(Model?.PcGrade);
    var title = isEditMode ? "Edit RC Grade" : "Add RC Grade";
    var formId = isEditMode ? "editMaintPCGradeForm" : "addMaintPCGradeForm";
    var saveLabel = isEditMode ? "Update" : "Save";
    var saveAction = isEditMode ? "updateMaintPCGrade()" : "saveMaintPCGrade()";
}

<div class="modal-header">
    <h5 class="modal-title">@title</h5>
    <button type="button" class="btn-close btn-red" onclick="closeModal()" data-bs-dismiss="modal">X</button>
</div>
<div class="modal-body">
    <div class="govuk-error-summary" role="alert"
         aria-labelledby="error-summary-title" tabindex="-1" style="display:none;">
        <h2 class="govuk-error-summary__title" id="error-summary-title">
            There is a problem
        </h2>
        <div class="govuk-error-summary__body">
            <ul class="govuk-list govuk-error-summary__list">
            </ul>
        </div>
    </div>
    <div class="row g-3">
        <form id="@formId">
            <input type="hidden" id="hdnIsEdit" value="@(isEditMode ? "true" : "false")" />
            <input type="hidden" id="hdnOriginalPcGrade" value="@(Model?.PcGrade ?? string.Empty)" />

            <div class="govuk-grid-row sup_padding_right_left_10">
                <div class="govuk-grid-column-one-half">
                    @if (!isEditMode)
                    {
                        <div class="govuk-form-group sup_margin_0">
                            <label class="govuk-label" for="PcGrade">RC Grade <span class="sup_color_red">*</span></label>
                            <input type="text" id="PcGrade" name="PcGrade"
                                   class="govuk-input" required maxlength="20">
                            <span data-valmsg-for="PcGrade" class="govuk-error-message field-validation-valid" style="display:none;"></span>
                        </div>
                    }
                    else
                    {
                        <div class="govuk-form-group sup_margin_0">
                            <label class="govuk-label" for="PcGrade">RC Grade</label>
                            <input type="text" id="PcGrade" name="PcGrade"
                                   class="govuk-input govuk-input--disabled" readonly
                                   value="@Model!.PcGrade">
                        </div>
                    }
                </div>
                <div class="govuk-grid-column-one-half">
                    <div class="govuk-form-group sup_margin_0">
                        <label class="govuk-label" for="DivisionGrade">Division Grade <span class="sup_color_red">*</span></label>
                        <select id="DivisionGrade" name="DivisionGrade" required
                                class="govuk-select govuk-!-font-size-16 sup_select_option_width_100"
                                aria-label="Select division grade">
                            <option value="">-- Select --</option>
                        </select>
                        <span data-valmsg-for="DivisionGrade" class="govuk-error-message field-validation-valid" style="display:none;"></span>
                    </div>
                </div>
            </div>

            <div class="govuk-grid-row sup_padding_right_left_10">
                <div class="govuk-grid-column-one-half">
                    <div class="govuk-form-group sup_margin_0">
                        <label class="govuk-label" for="GradeCode">Grade <span class="sup_color_red">*</span></label>
                        <select id="GradeCode" name="GradeCode" required
                                class="govuk-select govuk-!-font-size-16 sup_select_option_width_100"
                                aria-label="Select grade code">
                            <option value="">-- Select --</option>
                        </select>
                        <span data-valmsg-for="GradeCode" class="govuk-error-message field-validation-valid" style="display:none;"></span>
                    </div>
                </div>
                <div class="govuk-grid-column-one-half">
                    <div class="govuk-form-group sup_margin_0">
                        <label class="govuk-label" for="ProfitCentre">RC <span class="sup_color_red">*</span></label>
                        <select id="ProfitCentre" name="ProfitCentre" required
                                class="govuk-select govuk-!-font-size-16 sup_select_option_width_100"
                                aria-label="Select profit centre">
                            <option value="">-- Select --</option>
                        </select>
                        <span data-valmsg-for="ProfitCentre" class="govuk-error-message field-validation-valid" style="display:none;"></span>
                    </div>
                </div>
            </div>

            <div class="govuk-grid-row sup_padding_right_left_10">
                <div class="govuk-grid-column-one-half">
                    <div class="govuk-form-group sup_margin_0">
                        <label class="govuk-label" for="ChargeRate">Charge Rate</label>
                        <div class="govuk-input__wrapper">
                            <div class="govuk-input__prefix" aria-hidden="true">&pound;</div>
                            <input type="number" step="0.01" id="ChargeRate" name="ChargeRate" asp-for="ChargeRate" class="govuk-input govuk-input--disabled" min="0" readonly tabindex="-1">
                        </div>
                        <span data-valmsg-for="ChargeRate" class="govuk-error-message field-validation-valid" style="display:none;"></span>
                    </div>
                </div>
                <div class="govuk-grid-column-one-half">
                    <div class="govuk-form-group sup_margin_0">
                        <label class="govuk-label" for="DirectRate">Direct Rate</label>
                        <div class="govuk-input__wrapper">
                            <div class="govuk-input__prefix" aria-hidden="true">&pound;</div>
                            <input type="text" id="DirectRate" name="DirectRate" asp-for="DirectRate" class="govuk-input js-numeric-decimal" maxlength="20">
                        </div>
                        <span data-valmsg-for="DirectRate" class="govuk-error-message field-validation-valid" style="display:none;"></span>
                    </div>
                </div>
            </div>

            <div class="govuk-grid-row sup_padding_right_left_10">
                <div class="govuk-grid-column-one-half">
                    <div class="govuk-form-group sup_margin_0">
                        <label class="govuk-label" for="PayRate">Pay Rate</label>
                        <div class="govuk-input__wrapper">
                            <div class="govuk-input__prefix" aria-hidden="true">&pound;</div>
                            <input type="text" id="PayRate" name="PayRate" asp-for="PayRate" class="govuk-input js-numeric-decimal" maxlength="20" oninput="enforceNumeric(this); computeChargeRate();">
                        </div>
                        <span data-valmsg-for="PayRate" class="govuk-error-message field-validation-valid" style="display:none;"></span>
                    </div>
                </div>
                <div class="govuk-grid-column-one-half">
                    <div class="govuk-form-group sup_margin_0">
                        <label class="govuk-label" for="NPR">NPR</label>
                        <div class="govuk-input__wrapper">
                            <div class="govuk-input__prefix" aria-hidden="true">&pound;</div>
                            <input type="text" id="NPR" name="NPR" asp-for="NPR" class="govuk-input js-numeric-decimal" maxlength="20" oninput="enforceNumeric(this); computeChargeRate();">
                        </div>
                        <span data-valmsg-for="NPR" class="govuk-error-message field-validation-valid" style="display:none;"></span>
                    </div>
                </div>
            </div>

            <div class="govuk-grid-row sup_padding_right_left_10">
                <div class="govuk-grid-column-one-half">
                    <div class="govuk-form-group sup_margin_0">
                        <label class="govuk-label" for="OHR">OHR</label>
                        <div class="govuk-input__wrapper">
                            <div class="govuk-input__prefix" aria-hidden="true">&pound;</div>
                            <input type="text" id="OHR" name="OHR" asp-for="OHR" class="govuk-input js-numeric-decimal" maxlength="20" oninput="enforceNumeric(this); computeChargeRate();">
                        </div>
                        <span data-valmsg-for="OHR" class="govuk-error-message field-validation-valid" style="display:none;"></span>
                    </div>
                </div>
                <div class="govuk-grid-column-one-half">
                    <div class="govuk-form-group sup_margin_0">
                        <label class="govuk-label" for="HrsAvailable">Hours Available</label>
                        <input type="number" step="0.01" id="HrsAvailable" name="HrsAvailable" asp-for="HrsAvailable"
                               class="govuk-input" min="0">
                        <span data-valmsg-for="HrsAvailable" class="govuk-error-message field-validation-valid" style="display:none;"></span>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>
<div class="modal-footer sup_flex_space_center">
    <button class="govuk-button govuk-button--secondary sup_margin_0" data-module="govuk-button"
            data-bs-dismiss="modal" onclick="closeModal()">Cancel</button>
    <button class="govuk-button sup_margin_0" data-module="govuk-button"
            type="button" onclick="@saveAction">@saveLabel</button>
</div>

<script>
    var _currentDivisionGrade = '@Html.Raw(Model?.DivisionGrade ?? string.Empty)';
    var _currentGradeCode = '@Html.Raw(Model?.GradeCode ?? string.Empty)';
    var _currentProfitCentre = '@Html.Raw(Model?.ProfitCentre ?? string.Empty)';

    $(document).ready(function () {
        loadMaintPCGradeDropdowns();
        computeChargeRate();
    });

    function enforceNumeric(input) {
        var val = input.value.replace(/[^0-9.]/g, '');
        var parts = val.split('.');
        if (parts.length > 2) val = parts[0] + '.' + parts.slice(1).join('');
        input.value = val;
    }

    function computeChargeRate() {
        var payRate = $('#PayRate').val();
        var npr = $('#NPR').val();
        var ohr = $('#OHR').val();
        if (payRate === '' || npr === '' || ohr === '') {
            $('#ChargeRate').val('');
            return;
        }
        var total = parseFloat(payRate) + parseFloat(npr) + parseFloat(ohr);
        $('#ChargeRate').val(isNaN(total) ? '' : total.toFixed(2));
    }

    function loadMaintPCGradeDropdowns() {
        $.ajax({
            url: '@Url.Action("GetDistinctDivisionGrades", "ProfitCentreGradeMaint", new { area = "FPS" })',
            type: 'GET',
            success: function (response) {
                if (response.success && response.data) {
                    var $select = $('#DivisionGrade');
                    $.each(response.data, function (index, item) {
                        var isSelected = _currentDivisionGrade && _currentDivisionGrade === item.divisionGrade;
                        $select.append($('<option></option>')
                            .attr('value', item.divisionGrade)
                            .prop('selected', isSelected)
                            .text(item.divisionGrade));
                    });
                }
            },
            error: function () {
                $('#DivisionGrade').append($('<option></option>').text('Error loading division grades'));
            }
        });

        $.ajax({
            url: '@Url.Action("GetDistinctGradeCodes", "ProfitCentreGradeMaint", new { area = "FPS" })',
            type: 'GET',
            success: function (response) {
                if (response.success && response.data) {
                    var $select = $('#GradeCode');
                    $.each(response.data, function (index, item) {
                        var isSelected = _currentGradeCode && _currentGradeCode === item.gradeCode;
                        $select.append($('<option></option>')
                            .attr('value', item.gradeCode)
                            .prop('selected', isSelected)
                            .text(item.gradeCode));
                    });
                }
            },
            error: function () {
                $('#GradeCode').append($('<option></option>').text('Error loading grade codes'));
            }
        });

        $.ajax({
            url: '@Url.Action("GetDistinctProfitCentres", "ProfitCentreGradeMaint", new { area = "FPS" })',
            type: 'GET',
            success: function (response) {
                if (response.success && response.data) {
                    var $select = $('#ProfitCentre');
                    $.each(response.data, function (index, item) {
                        var isSelected = _currentProfitCentre && _currentProfitCentre === item.profitCentre;
                        $select.append($('<option></option>')
                            .attr('value', item.profitCentre)
                            .prop('selected', isSelected)
                            .text(item.profitCentre));
                    });
                }
            },
            error: function () {
                $('#ProfitCentre').append($('<option></option>').text('Error loading profit centres'));
            }
        });
    }
</script>

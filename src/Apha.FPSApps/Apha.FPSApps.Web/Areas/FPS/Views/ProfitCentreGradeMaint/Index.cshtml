@using Apha.FPSApps.Web.Models.Components.DataGrid
@model Apha.FPSApps.Web.Areas.FPS.Models.ProfitCentreGradeMaintViewModel

@{
    ViewData["Title"] = "Resource Centre Grade Maintenance";
}

<main id="main-content">
    <div class="container-fluid">
        <!-- Title section -->
        <div class="govuk-grid-row">
            <div class="govuk-grid-column-full">
                <h1 class="govuk-heading-s sup_border-bottom govuk-!-margin-top-2 govuk-!-padding-bottom-2">Resource Centre Grade Maintenance</h1>
            </div>
        </div>

        <div class="row">
            <div class="col-lg-12">
                <main class="main-content" style="padding:0;">
                    <div class="container-fluid" style="padding: 0;">
                        <div class="row">
                            <div class="container-fluid" style="padding-left:0px;">
                                <div style="display: flex; flex-direction: row; align-items: flex-start;">
                                    <!-- Side nav -->
                                    @await Html.PartialAsync("_MaintenanceSideNav", "ProfitCentreGradeMaint")
                                    <div style="display: flex; flex-direction: column; flex: 1 1 auto; min-width: 0; margin: 0 0px 5px 8px;">
                                        <!-- DataGrid section -->
                                        <div class="govuk-grid-row">
                                            <div class="govuk-grid-column-full mt-2">
                                                <!-- Grid Container -->
                                                <div id="@($"gridContainer_{Model.RcGradeMaintenanceGrid.GridId}")">
                                                    @await Html.PartialAsync("_DataGrid", Model.RcGradeMaintenanceGrid)
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </main>
            </div>
        </div>
    </div>
</main>

@section Scripts {
    <script src="~/js/ajax-form-validation.js"></script>
    <script>

        function reloadMaintPCGradeGrid() {
            var gm = window['gridManager_rcGradeMaintenanceGrid'];
            if (gm) { gm.reloadGrid({ page: 1 }); }
        }

        function addMaintPCGrade() {
            $.get('/FPS/ProfitCentreGradeMaint/Create', function (html) {
                $('#modaPopupBody').html(html);
                $('#modalPopup').addClass('show');
            }).fail(function () {
                showAlertMessage('An error occurred while loading the form', AlertType.ERROR);
            });
        }

        function editMaintPCGrade(btn) {
            var id = $(btn).data('id');
            $.get('/FPS/ProfitCentreGradeMaint/Edit', { id: id }, function (html) {
                $('#modaPopupBody').html(html);
                $('#modalPopup').addClass('show');
            }).fail(function () {
                showAlertMessage('An error occurred while loading the edit form', AlertType.ERROR);
            });
        }

        function deleteMaintPCGrade(btn) {
            var id = $(btn).data('id');
            showGovukConfirm('Are you sure you want to delete this record?').then(function (result) {
                if (!result) return;
                $.ajax({
                    url: '/FPS/ProfitCentreGradeMaint/Delete?id=' + encodeURIComponent(id),
                    type: 'DELETE',
                    success: function (response) {
                        if (response.success) {
                            showAlertMessage('RC grade deleted successfully', AlertType.SUCCESS).then(function () {
                                reloadMaintPCGradeGrid();
                            });
                        } else {
                            showAlertMessage('Error: ' + (response.message || 'Delete failed.'), AlertType.ERROR);
                        }
                    },
                    error: function () {
                        showAlertMessage('An error occurred while deleting.', AlertType.ERROR);
                    }
                });
            });
        }

        function buildMaintPCGradeDto(pcGrade) {
            return {
                PcGrade: pcGrade,
                DivisionGrade: $('#DivisionGrade').val() || null,
                GradeCode: $('#GradeCode').val() || null,
                ProfitCentre: $('#ProfitCentre').val() || null,
                ChargeRate: parseDecimalOrNull($('#ChargeRate').val()),
                DirectRate: parseDecimalOrNull($('#DirectRate').val()),
                PayRate: parseDecimalOrNull($('#PayRate').val()),
                NPR: parseDecimalOrNull($('#NPR').val()),
                OHR: parseDecimalOrNull($('#OHR').val()),
                HrsAvailable: parseDecimalOrNull($('#HrsAvailable').val())
            };
        }

        function handleMaintPCGradeSaveError(xhr) {
            if (xhr.status === 400 && xhr.responseJSON) {
                displayServerValidationErrors(xhr.responseJSON.errors, xhr.responseJSON.message, '#modaPopupBody');
            } else {
                showAlertMessage('An error occurred while saving.', AlertType.ERROR);
            }
        }

        function saveMaintPCGrade() {
            clearValidationErrors('#modaPopupBody');
            var form = $('#addMaintPCGradeForm');

            if (!isFormValid(form)) {
                displayClientValidationErrors(form, '#modaPopupBody');
                return;
            }

            $.ajax({
                url: '/FPS/ProfitCentreGradeMaint/Create',
                type: 'POST',
                data: JSON.stringify(buildMaintPCGradeDto($('#PcGrade').val())),
                contentType: 'application/json; charset=utf-8',
                success: function (data) {
                    if (data.success) {
                        closeModal();
                        showAlertMessage(data.message || 'RC grade created successfully.', AlertType.SUCCESS);
                        reloadMaintPCGradeGrid();
                    } else {
                        displayServerValidationErrors(data.errors, data.message, '#modaPopupBody');
                    }
                },
                error: handleMaintPCGradeSaveError
            });
        }

        function updateMaintPCGrade() {
            clearValidationErrors('#modaPopupBody');
            var form = $('#editMaintPCGradeForm');

            if (!isFormValid(form)) {
                displayClientValidationErrors(form, '#modaPopupBody');
                return;
            }

            var originalPcGrade = $('#hdnOriginalPcGrade').val();

            $.ajax({
                url: '/FPS/ProfitCentreGradeMaint/Edit?id=' + encodeURIComponent(originalPcGrade),
                type: 'POST',
                data: JSON.stringify(buildMaintPCGradeDto(originalPcGrade)),
                contentType: 'application/json; charset=utf-8',
                success: function (data) {
                    if (data.success) {
                        showAlertMessage(data.message || 'RC grade updated successfully.', AlertType.SUCCESS);
                        closeModal();
                        reloadMaintPCGradeGrid();
                    } else {
                        displayServerValidationErrors(data.errors, data.message, '#modaPopupBody');
                    }
                },
                error: handleMaintPCGradeSaveError
            });
        }

        function closeModal() {
            $('#modaPopupBody').html('');
            $('#modalPopup').removeClass('show');
        }

        function parseDecimalOrNull(val) {
            if (val === null || val === undefined || val.toString().trim() === '') return null;
            var parsed = parseFloat(val);
            return isNaN(parsed) ? null : parsed;
        }

    </script>
}

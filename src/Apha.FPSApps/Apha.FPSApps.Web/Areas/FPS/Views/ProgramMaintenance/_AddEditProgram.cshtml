@model Apha.FPSApps.Web.Areas.FPS.Models.ProgramViewModel
@{
    var isEditMode = !string.IsNullOrEmpty(Model.ProgramNo);
    var title      = isEditMode ? "Edit Program"    : "Add Program";
    var formId     = isEditMode ? "editProgramForm" : "addProgramForm";
    var saveLabel  = isEditMode ? "Update"          : "Save";
    var saveAction = isEditMode ? "updateProgram()" : "saveProgram()";
}

<div class="modal-header">
    <h5 class="modal-title" id="programModalTitle">@title</h5>
    <button type="button" class="btn-close btn-red" onclick="closeModal()" data-bs-dismiss="modal">X</button>
</div>
<div class="modal-body" style="overflow-y: auto; max-height: calc(80vh - 120px);">
    <div class="govuk-error-summary" role="alert"
         aria-labelledby="error-summary-title" tabindex="-1" style="display:none;">
        <h2 class="govuk-error-summary__title" id="error-summary-title">
            There is a problem
        </h2>
        <div class="govuk-error-summary__body">
            <ul class="govuk-list govuk-error-summary__list">
            </ul>
        </div>
    </div>
    <div class="row g-3">
        <form id="@formId">
            <div class="govuk-form-group sup_margin_0">
                <label class="govuk-label" asp-for="ProgramNo">Program <span class="sup_color_red">*</span> </label>
                <input type="text" asp-for="ProgramNo" required class="govuk-input" readonly="@isEditMode">
                    <span asp-validation-for="ProgramNo" class="govuk-error-message" style="display:none;"></span>
            </div>
            <div class="govuk-form-group sup_margin_0">
                <label class="govuk-label" asp-for="ProgramName">Program Name</label>
                <input type="text" asp-for="ProgramName" class="govuk-input">
                        <span asp-validation-for="ProgramName" class="govuk-error-message" style="display:none;"></span>
            </div>
            <div class="govuk-form-group sup_margin_0">
                <label class="govuk-label" asp-for="Directorate">Directorate</label>
                        <select id="Directorate" asp-for="Directorate" asp-items="@Model.DirectorateOptions" class="govuk-select govuk-!-font-size-16 sup_width_100">
                </select>
                        <span asp-validation-for="Directorate" class="govuk-error-message" style="display:none;"></span>
            </div>
            <div class="govuk-form-group sup_margin_0">
                <label class="govuk-label" asp-for="Target">Target</label> 
                 <div class="govuk-input__wrapper">
                        <div class="govuk-input__prefix" aria-hidden="true">£</div>
                            <input type="text" asp-for="Target" class="govuk-input js-numeric-decimal" maxlength="20" value="@Model.Target">
                         </div> 
                            <span asp-validation-for="Target" class="govuk-error-message" style="display:none;"></span>
            </div>
            <div class="govuk-form-group sup_margin_0">
                <label class="govuk-label" asp-for="Manager">Manager</label>
                @await Html.PartialAsync("_ManagerPicker", new Apha.FPSApps.Web.Areas.FPS.Models.ManagerPickerViewModel
                {
                    ManagerList = Model.ManagerList,
                    FieldName = "Manager",
                    ShowGrade = true,
                    Required = false,
                    SelectCssClass = "govuk-select govuk-!-font-size-16 sup_width_100"
                })
            </div>
        </form>
    </div>
</div>
            <div class="modal-footer sup_flex_space_center">
    <button class="govuk-button govuk-button--secondary sup_margin_0" data-module="govuk-button" data-bs-dismiss="modal" onclick="closeModal()">Cancel</button>
    <button class="govuk-button sup_margin_0" data-module="govuk-button" type="button" onclick="@saveAction">@saveLabel</button>
</div>


@using Apha.FPSApps.Web.Areas.FPS.Models
@using Apha.FPSApps.Web.Models.Components.DataGrid
@model DataGridConfig<ProgramViewModel>
@{
    ViewData["Title"] = "Program Maintenance";
}
<main id="main-content">
    <div class="container-fluid">
        <!-- Title section -->
        <div class="govuk-grid-row">
            <div class="govuk-grid-column-full">
                <h1 class="govuk-heading-s sup_border-bottom govuk-!-margin-top-2 govuk-!-padding-bottom-2 govuk-!-padding-left-4">Program Maintenance</h1>
            </div>
        </div>

        <div class="row">
            <div class="col-lg-12">
                <main class="main-content" style="padding:0;">
                    <div class="container-fluid " style="padding: 0;">
                        <div class="row">
                            <div class="container-fluid" style="padding-left:0px;">
                                <div style="display: flex; flex-direction: row; align-items: flex-start;">
                                    <!-- Side nav -->
                                    @await Html.PartialAsync("_MaintenanceSideNav", "ProgramMaintenance")
                                    <div style="display: flex; flex-direction: column; flex: 1 1 auto; min-width: 0; margin: 0 0px 5px 8px;">
                                        <!-- Filter and Grid section -->
                                        <div class="govuk-grid-row">
                                            <div class="govuk-grid-column-full mt-2">
                                                <!-- Grid Container -->
                                                <div id="@($"gridContainer_{Model.GridId}")">
                                                    @await Html.PartialAsync("_DataGrid", Model)
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </main>
            </div>
        </div>


    </div>
</main>


@section Scripts {
    <script src="~/js/ajax-form-validation.js"></script>
    <script>
        function addProgram(btn) {
            $.ajax({
                url: '/FPS/ProgramMaintenance/Create',
                type: 'GET',
                success: function (html) {
                    $('#modaPopupBody').html(html);
                    $('#modalPopup').addClass("show");
                },
                error: function () {
                    showAlertMessage('An error occurred while loading the form', AlertType.ERROR);
                }
            });
        }

        function saveProgram() {
            clearValidationErrors('#modaPopupBody');
            var form = $('#addProgramForm');

            if (!isFormValid(form)) {
                displayClientValidationErrors(form, '#modaPopupBody');
                return;
            }

            var rawTarget = form.find('[name="Target"]').val().replace(/[�,]/g, '').trim();

            var data = {
                ProgramNo: form.find('[name="ProgramNo"]').val(),
                ProgramName: form.find('[name="ProgramName"]').val(),
                Directorate: form.find('[name="Directorate"]').val(),
                // Parse to number so decimal? model binding succeeds
                Target: rawTarget !== '' ? parseFloat(rawTarget) : null,
                Manager: form.find('[name="Manager"]').val()
            };

            $.ajax({
                url: '@Url.Action("Create", "ProgramMaintenance", new { area = "FPS" })',
                type: 'POST',
                data: JSON.stringify(data),
                contentType: 'application/json; charset=utf-8',
                success: function (result) {
                    if (result.success) {
                        showAlertMessage(result.message, AlertType.SUCCESS);
                        closeModal();
                        window['gridManager_programGrid'].reloadGrid({ page: 1 });
                    } else {
                        displayServerValidationErrors(result.errors, result.message, '#modaPopupBody')
                    }
                },
                error: function (xhr) {
                    if (xhr.status === 400 && xhr.responseJSON) {
                        displayServerValidationErrors(xhr.responseJSON.errors, xhr.responseJSON.message, '#modaPopupBody');
                    } else {
                        showAlertMessage('An error occurred while saving', AlertType.ERROR);
                    }
                }
            });
        }

        function updateProgram(){
            clearValidationErrors('#modaPopupBody');
            var form = $('#editProgramForm');

            if (!isFormValid(form)) {
                displayClientValidationErrors(form, '#modaPopupBody');
                return;
            }

            var rawTarget = form.find('[name="Target"]').val().replace(/[�,]/g, '').trim();

            var data = {
                ProgramNo: form.find('[name="ProgramNo"]').val(),
                ProgramName: form.find('[name="ProgramName"]').val(),
                Directorate: form.find('[name="Directorate"]').val(),
                // Parse to number so decimal? model binding succeeds
                Target: rawTarget !== '' ? parseFloat(rawTarget) : null,
                Manager: form.find('[name="Manager"]').val()
            };

            $.ajax({
                url: '@Url.Action("Edit", "ProgramMaintenance", new { area = "FPS" })',
                type: 'POST',
                data: JSON.stringify(data),
                contentType: 'application/json; charset=utf-8',
                success: function (result) {
                    if (result.success) {
                        showAlertMessage(result.message, AlertType.SUCCESS);
                        closeModal();
                        window['gridManager_programGrid'].reloadGrid({ page: 1 });
                    } else {
                        displayServerValidationErrors(result.errors, result.message, '#modaPopupBody')
                    }
                },
                error: function (xhr) {
                    if (xhr.status === 400 && xhr.responseJSON) {
                        displayServerValidationErrors(xhr.responseJSON.errors, xhr.responseJSON.message, '#modaPopupBody');
                    } else {
                        showAlertMessage('An error occurred while saving.', AlertType.ERROR);
                    }
                }
            });
        }

        function editProgram(btn){
            var ProgramNo = $(btn).data('id');
            $.ajax({
                url: '/FPS/ProgramMaintenance/Edit',
                type: 'GET',
                data: { programNo: ProgramNo },
                success: function (html) {
                    $('#modaPopupBody').html(html);
                    $('#modalPopup').addClass("show");
                },
                error: function () {
                    showAlertMessage('An error occurred while editing record', AlertType.ERROR);
                }
            });
        }

        function deleteProgram(btn) {
            var ProgramNo = $(btn).data('id');
            showGovukConfirm('Are you sure you want to delete this record?').then(function (result) {
                if (!result) return;
                $.ajax({
                    url: '/FPS/ProgramMaintenance/Delete',
                    type: 'DELETE',
                    data: { programNo: ProgramNo },
                    success: function (response) {
                        if (response.success) {
                                showAlertMessage('Deleted successfully', AlertType.SUCCESS).then(function () {
                                    window['gridManager_programGrid'].reloadGrid({ page: 1 });
                                });
                        } else {
                           
                            showAlertMessage('Error: ' + response.message, AlertType.ERROR);
                        }
                    },
                    error: function () {
                        showAlertMessage('An error occurred while deleting', AlertType.ERROR);
                    }
                });
            });
        }

        function closeModal() {
            clearValidationErrors('#modaPopupBody');
            $('#modaPopupBody').html("");
            $('#modalPopup').removeClass("show");
        }

          // Returns true if all required fields in the form have values
        function isFormValid(form) {
            var isValid = true;
            form.find('[required]').each(function () {
                if (!$(this).val() || $(this).val().trim() === '') {
                    isValid = false;
                    return false; // break
                }
            });
            return isValid;
        }
    </script>

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

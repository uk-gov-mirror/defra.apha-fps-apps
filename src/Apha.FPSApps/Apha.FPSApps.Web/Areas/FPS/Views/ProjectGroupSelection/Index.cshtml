@using Apha.FPSApps.Web.Models.Components.DataGrid
@model Apha.FPSApps.Web.Areas.FPS.Models.ProjectGroupSelectionViewModel
@{
    ViewData["Title"] = "Project Group Management";
}

<main id="main-content">
    <div class="container-fluid">
        <!-- Title -->
        <div class="govuk-grid-row sup_border-bottom">
            <div class="govuk-grid-column-one-half isFloatLeft">
                <h1 class="govuk-heading-s sup_margin_bottom_0 govuk-!-margin-top-3">
                    Project Group Management
                </h1>
            </div>
            <div class="govuk-grid-column-one-half isFloatRight isProjectGroupManagement">
                <table class="govuk-table govuk-!-margin-bottom-2">
                    <tbody class="govuk-table__body">
                        <tr class="govuk-table__row">
                            <th scope="row" class="govuk-table__header govuk-!-padding-bottom-0 govuk-!-padding-right-0 isNoBottomBorder">
                                <label id="projectGroupDropdownLabel" class="govuk-label govuk-!-font-size-16 govuk-!-font-weight-bold govuk-!-margin-bottom-0" for="projectGroupDropdown">
                                    Select a Project Group:
                                </label>
                            </th>
                            <td class="govuk-table__cell govuk-!-padding-bottom-0 govuk-!-padding-right-1 isNoBottomBorder">
                                <select id="projectGroupDropdown"
                                        asp-items="Model.ProjectGroupList"
                                        asp-for="SelectedProjectGroup"
                                        onchange="filterProjectGroup()"
                                        class="govuk-select"
                                        style="width:auto; min-width:200px;"
                                        aria-label="Select a Project Group">
                                    <option value="">-- Select Project Group --</option>
                                </select>
                            </td>

                            <th scope="row" class="govuk-table__header govuk-!-padding-bottom-0 govuk-!-padding-right-0 isNoBottomBorder">
                                <label id="projectSearchInputLabel" class="govuk-label govuk-!-font-size-16 govuk-!-font-weight-bold govuk-!-margin-bottom-0" for="projectSearchInput">
                                    Project:
                                </label>
                            </th>
                            <td class="govuk-table__cell govuk-!-padding-bottom-0 govuk-!-padding-right-1 isNoBottomBorder">
                                <div style="position:relative;">
                                    <input type="text" id="projectSearchInput" placeholder="Select Project" autocomplete="off"
                                           class="govuk-input down-arrow-img" style="width:220px; cursor:pointer;"
                                           value="@Model.ProjectSearch" aria-label="Filter project" readonly />
                                    <div id="ProjectDropdownPanel" style="display:none;">
                                        <label for="ProjectSearchBox" class="govuk-label govuk-visually-hidden">Search projects</label>
                                        <input type="text" id="ProjectSearchBox" placeholder="Type to search project" aria-label="Search projects" />
                                        <table>
                                            <thead>
                                                <tr>
                                                    <th>Project</th>
                                                    <th>Project Group</th>
                                                </tr>
                                            </thead>
                                            <tbody id="ProjectDropdownBody" role="listbox" aria-label="Project results"></tbody>
                                        </table>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

        <div class="govuk-grid-row">
            <div class="govuk-grid-column-full">
            <div id="divprojectcode" class="pmg-projectcode-wrap govuk-!-padding-bottom-5 govuk-\!-margin-left-3 govuk-!-margin-right-3">
                    <div id="@($"gridContainer_{Model.ProjectsGrid!.GridId}")">
                        @await Html.PartialAsync("_DataGrid", Model.ProjectsGrid)
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>

@section Scripts {
    <script>
        var allProjectLookup = [];

        function filterProjectGroup() {
            var projectGroup = document.getElementById('projectGroupDropdown').value;
            // Clear the project field when project group changes
            var projectSearchInput = document.getElementById('projectSearchInput');
            if (projectSearchInput) projectSearchInput.value = '';
            if (projectGroup) {
                fpsNavigateTo('@Url.Action("Index", "ProjectGroupSelection", new { area = "FPS" })?projectGroup=' + encodeURIComponent(projectGroup));
            } else {
                fetch('@Url.Action("SaveProjectGroupSession", "ProjectGroupSelection", new { area = "FPS" })', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '' },
                    body: JSON.stringify('')
                }).finally(function () {
                    fpsNavigateTo('@Url.Action("Index", "ProjectGroupSelection", new { area = "FPS" })');
                });
            }
        }

        function getProjectsExtraFilters() {
            return {
                projectSearch: document.getElementById('projectSearchInput')?.value ?? ''
            };
        }

        var reloadDebounce;
        function reloadProjectsGrid() {
            clearTimeout(reloadDebounce);
            reloadDebounce = setTimeout(function () {
                if (window['gridManager_projectsGrid']) {
                    window['gridManager_projectsGrid'].reloadGrid({ page: 1 });
                }
            }, 300);
        }

        function planProject(btn) {
            var projectCode = $(btn).data('id');
            fpsNavigateTo('@Url.Action("Index", "ProjectPlanning", new { area = "FPS" })' + '?projectCode=' + encodeURIComponent(projectCode));
        }

        function editProject(btn) {
            var parentProject = $(btn).data('id');
            var projectGroup = document.getElementById('projectGroupDropdown')?.value ?? '';
            var projectSearch = document.getElementById('projectSearchInput')?.value ?? '';

            var returnUrl = '@Url.Action("Index", "ProjectGroupSelection", new { area = "FPS" })'
                + '?projectGroup=' + encodeURIComponent(projectGroup)
                + '&projectSearch=' + encodeURIComponent(projectSearch);

            fpsNavigateTo('@Url.Action("Edit", "Project", new { area = "FPS" })'
                + '?parentProject=' + encodeURIComponent(parentProject)
                + '&returnUrl=' + encodeURIComponent(returnUrl));
        }

        document.addEventListener('DOMContentLoaded', function () {
            function applyButtonTitles() {
                document.querySelectorAll('#gridContainer_projectsGrid .edit-row-btn:not([data-titled])').forEach(function (btn) {
                    btn.title = 'Edit';
                    var img = btn.querySelector('img');
                    if (img) img.title = 'Edit';
                    btn.setAttribute('data-titled', '1');
                });
                document.querySelectorAll('#gridContainer_projectsGrid .delete-row-btn[data-delete-function="planProject"]:not([data-titled])').forEach(function (btn) {
                    btn.title = 'Plan';
                    var img = btn.querySelector('img');
                    if (img) img.title = 'Plan';
                    btn.setAttribute('data-titled', '1');
                });
            }

            applyButtonTitles();

            // ── Project multi-column dropdown ──────────────────────────────────
            var projectDisplay = document.getElementById('projectSearchInput');
            var projectPanel   = document.getElementById('ProjectDropdownPanel');
            var projectSearch  = document.getElementById('ProjectSearchBox');
            var projectBody    = document.getElementById('ProjectDropdownBody');

            function getFilteredProjectRows() {
                var q = (projectSearch ? projectSearch.value : '').toLowerCase();
                var filtered = allProjectLookup;
                if (q) {
                    filtered = filtered.filter(function (p) {
                        return p.parentProject.toLowerCase().indexOf(q) !== -1
                            || (p.projectGroup || '').toLowerCase().indexOf(q) !== -1;
                    });
                }
                return filtered;
            }

            function renderProjectRows(data) {
                projectBody.innerHTML = '';
                data.forEach(function (item) {
                    var tr = document.createElement('tr');
                    tr.style.cursor = 'pointer';
                    tr.setAttribute('data-value', item.parentProject);
                    tr.innerHTML = '<td style="padding:6px 8px; border-bottom:1px solid #f3f2f1;">' + item.parentProject + '</td>'
                                 + '<td style="padding:6px 8px; border-bottom:1px solid #f3f2f1;">' + (item.projectGroup || '') + '</td>';
                    tr.addEventListener('click', function () {
                        projectDisplay.value = item.parentProject;
                        projectPanel.style.display = 'none';

                        var projectGroupDropdown = document.getElementById('projectGroupDropdown');
                        var currentProjectGroup = projectGroupDropdown ? projectGroupDropdown.value : '';

                        if (item.projectGroup && item.projectGroup !== currentProjectGroup) {
                            // Project belongs to a different group — switch group and navigate
                            if (projectGroupDropdown) {
                                Array.from(projectGroupDropdown.options).forEach(function (o) {
                                    o.selected = o.value === item.projectGroup;
                                });
                            }
                            fpsNavigateTo('@Url.Action("Index", "ProjectGroupSelection", new { area = "FPS" })?projectGroup='
                                + encodeURIComponent(item.projectGroup)
                                + '&projectSearch=' + encodeURIComponent(item.parentProject));
                        } else {
                            reloadProjectsGrid();
                        }
                    });
                    tr.addEventListener('mouseenter', function () { this.style.backgroundColor = '#f3f2f1'; });
                    tr.addEventListener('mouseleave', function () { this.style.backgroundColor = ''; });
                    projectBody.appendChild(tr);
                });
            }

            function refreshProjectDropdown() {
                renderProjectRows(getFilteredProjectRows());
            }

            if (projectDisplay && projectPanel && projectSearch && projectBody) {
                projectDisplay.addEventListener('click', function (e) {
                    e.stopPropagation();
                    if (projectPanel.style.display !== 'none') {
                        projectPanel.style.display = 'none';
                        return;
                    }
                    if (allProjectLookup.length === 0) {
                        fetch('@Url.Action("GetProjectLookup", "ProjectGroupSelection", new { area = "FPS" })')
                            .then(function (r) { return r.json(); })
                            .then(function (data) {
                                allProjectLookup = data;
                                projectSearch.value = '';
                                refreshProjectDropdown();
                                projectPanel.style.display = 'block';
                                projectSearch.focus();
                            });
                    } else {
                        projectSearch.value = '';
                        refreshProjectDropdown();
                        projectPanel.style.display = 'block';
                        projectSearch.focus();
                    }
                });

                projectSearch.addEventListener('input', refreshProjectDropdown);

                document.addEventListener('click', function (e) {
                    if (!projectDisplay.contains(e.target) && !projectPanel.contains(e.target)) {
                        projectPanel.style.display = 'none';
                    }
                });
            }

            var observer = new MutationObserver(function (mutations) {
                var hasNewNodes = mutations.some(function (m) {
                    return Array.from(m.addedNodes).some(function (n) { return n.nodeType === 1; });
                });
                if (hasNewNodes) applyButtonTitles();
            });

            var container = document.getElementById('gridContainer_projectsGrid');
            if (container) {
                observer.observe(container, { childList: true, subtree: true });
            }
        });
    </script>
}

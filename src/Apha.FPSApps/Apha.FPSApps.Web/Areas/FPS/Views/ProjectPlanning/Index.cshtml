@using Apha.FPSApps.Web.Models.Components.DataGrid
@model Apha.FPSApps.Web.Areas.FPS.Models.ProjectPlanningViewModel
@{
    ViewData["Title"] = $"{Model.SelectedYear} : Project Planning";   
}

<div class="container-fluid">

    <div class="govuk-grid-row">       
        <div class="govuk-grid-column-full govuk-!-padding-0">
            <h1 class="govuk-heading-s sup_border-bottom govuk-!-margin-top-2 govuk-!-padding-bottom-2 govuk-!-padding-left-4">
                Project Planning : <span class="projectcode_color">@Model.ProjectCode</span>
                <input id="hdnProjectCode" type="hidden" value="@Model.ProjectCode" />
                <a href="@(Context.Request.Query.ContainsKey("returnUrl") ? Context.Request.Query["returnUrl"].ToString() : "javascript:history.back()")" class="govuk-back-link sup_align_right">Back</a>
            </h1>
        </div>
    </div>

    <div class="project-code-section govuk-!-margin-bottom-2 govuk-!-padding-left-0">
        <textarea class="govuk-textarea pp-project-description" id="projectDescription" aria-label="Project description" rows="2" asp-for="ProjectDescription">@Model.ProjectDescription</textarea>
        <a href="@Url.Action("ExportToExcel", "ProjectPlanning", new { area = "FPS", projectCode = Model.ProjectCode })"
           class="govuk-button sup_margin_0" aria-label="Export to Excel">Export to Excel</a>
    </div>

    <div class="main-grid">
        <div class="left-column">
            <!-- Staff Booked Section -->
            <section class="data-section sup_border govuk-!-padding-0">
                <div id="@($"gridContainer_{Model.StaffBookedGrid.GridId}")">
                    @await Html.PartialAsync("_DataGrid", Model.StaffBookedGrid)
                </div>
                <div class="pva-inline-summary govuk-!-padding-1 sup_top_border_1">
                    <span class="govuk-body govuk-!-font-size-16 govuk-!-margin-bottom-0">Total Staff Cost:</span>
                    <input type="text" id="TotalStaffCost" value="@Model.TotalStaffCost.ToString("C0")" aria-label="Total Staff Cost" class="govuk-input text-AlignRight pva-input-160" asp-for="TotalStaffCost" readonly>
                </div>
            </section>
            <!-- Animals Booked Section -->
            <section class="data-section sup_border govuk-!-padding-0">
                <div id="@($"gridContainer_{Model.AnimalsBookedGrid.GridId}")">
                    @await Html.PartialAsync("_DataGrid", Model.AnimalsBookedGrid)
                </div>
                <div class="pva-inline-summary govuk-!-padding-1 sup_top_border_1">
                    <span class="govuk-body govuk-!-font-size-16 govuk-!-margin-bottom-0">Total Animal Cost:</span>
                    <input type="text" id="TotalAnimalCost" value="@Model.TotalAnimalCost.ToString("C0")" aria-label="Total Animal Cost" class="govuk-input text-AlignRight pva-input-160" asp-for="TotalAnimalCost" readonly>
                </div>
            </section>
        </div>
        <div class="right-column">
            <!-- Tests Booked Section -->
            <section class="data-section sup_border govuk-!-padding-0">
                <div id="@($"gridContainer_{Model.TestsBookedGrid.GridId}")">
                    @await Html.PartialAsync("_DataGrid", Model.TestsBookedGrid)
                </div>
                <div class="pva-inline-summary govuk-!-padding-1 sup_top_border_1">
                    <span class="govuk-body govuk-!-font-size-16 govuk-!-margin-bottom-0">Total Test Cost:</span>
                    <input type="text" id="TotalTestCost" value="@Model.TotalTestCost.ToString("C0")" aria-label="Total Test Cost" class="govuk-input text-AlignRight pva-input-160" asp-for="TotalTestCost" readonly>
                </div>
            </section>
            <!-- Exceptional Costs Section -->
            <section class="data-section sup_border govuk-!-padding-0">
                <div id="@($"gridContainer_{Model.ExceptionalCostsGrid.GridId}")">
                    @await Html.PartialAsync("_DataGrid", Model.ExceptionalCostsGrid)
                </div>
                <div class="pva-inline-summary govuk-!-padding-1 sup_top_border_1">
                    <span class="govuk-body govuk-!-font-size-16 govuk-!-margin-bottom-0">Total Additional Cost:</span>
                    <input type="text" id="TotalAdditionalCost" value="@Model.TotalAdditionalCost.ToString("C0")" aria-label="Total Additional Cost" class="govuk-input text-AlignRight pva-input-160" asp-for="TotalAdditionalCost" readonly>
                </div>
            </section>
        </div>
    </div>

    <footer class="financial-summary pp-summary-4-3">
        <div class="summary-row">
            <div class="summary-item">
                <label class="govuk-label--s govuk-!-font-size-16" for="TransferIncome">Transfer Income:</label>
                <input type="text" value="@Model.TransferIncome.ToString("C0")" aria-label="Transfer Income" id="TransferIncome" class="govuk-input govuk-!-font-size-16 govuk-input--width-10 text-AlignRight" name="TransferIncome" asp-for="TransferIncome">
            </div>
            <div class="summary-item">
                <label class="govuk-label--s govuk-!-font-size-16" for="ExternalIncome">External Income:</label>
                <input type="text" value="@Model.ExternalIncome.ToString("C0")" aria-label="External Income" id="ExternalIncome" class="govuk-input govuk-!-font-size-16 govuk-input--width-10 text-AlignRight" name="ExternalIncome" asp-for="ExternalIncome">
            </div>
            <div class="summary-item">
                <label class="govuk-label--s govuk-!-font-size-16" for="BudgetCVL">Budget CVL:</label>
                <input type="text" value="@Model.BudgetCVL.ToString("C0")" aria-label="Budget CVL" id="BudgetCVL" class="govuk-input govuk-!-font-size-16 govuk-input--width-10 text-AlignRight" name="BudgetCVL" asp-for="BudgetCVL">
            </div>
            <div class="summary-item">
                <label class="govuk-label--s govuk-!-font-size-16" for="TotalCosts">Total Costs:</label>
                <input type="text" value="@Model.TotalCosts.ToString("C0")" aria-label="Total Costs" id="TotalCosts" class="govuk-input govuk-!-font-size-16 govuk-input--width-10 text-AlignRight" name="TotalCosts" asp-for="TotalCosts">
            </div>
            <div class="summary-item">
                <label class="govuk-label--s govuk-!-font-size-16" for="ProfitLoss">Profit/(Loss):</label>
                <input type="text" value="@(Model.ProfitLoss < 0 ? $"(£{Math.Abs(Model.ProfitLoss):N0})" : Model.ProfitLoss.ToString("C0"))" aria-label="Profit/(Loss)" id="ProfitLoss" class="govuk-input govuk-!-font-size-16 govuk-input--width-10 text-AlignRight @(Model.ProfitLoss < 0 ? "text-danger" : "text-primary")" name="ProfitLoss" asp-for="ProfitLoss">
            </div>
            <div class="summary-item">
                <label class="govuk-label--s govuk-!-font-size-16" for="TargetProfit">Target Profit:</label>
                <input type="text" value="@Model.TargetProfit.ToString("C0")" aria-label="Target Profit" id="TargetProfit" class="govuk-input govuk-!-font-size-16 govuk-input--width-10 text-AlignRight" name="TargetProfit" asp-for="TargetProfit">
            </div>
            <div class="summary-item">
                <label class="govuk-label--s govuk-!-font-size-16" for="OffTarget">Off - Target:</label>
                <input type="text" value="@(Model.OffTarget < 0 ? $"(£{Math.Abs(Model.OffTarget):N0})" : Model.OffTarget.ToString("C0"))" aria-label="Off - Target" id="OffTarget" class="govuk-input govuk-!-font-size-16 govuk-input--width-10 text-AlignRight" name="OffTarget" asp-for="OffTarget" style="color:#1d70b8;font-weight:400;">
            </div>
        </div>
    </footer>

</div>

@section Scripts{
    <script src="~/js/ajax-form-validation.js"></script>
    <script src="~/js/fps_js/StaffJob.js"></script>
    <script src="~/js/fps_js/AnimalJob.js"></script>
    <script src="~/js/fps_js/TestPlanJob.js"></script>
    <script src="~/js/fps_js/AdditionalCost.js" asp-append-version="true"></script>
    <script>
        // ---- Currency helpers ----

        function formatGBP(value) {
            var formatted = new Intl.NumberFormat('en-GB', { style: 'currency', currency: 'GBP', minimumFractionDigits: 0, maximumFractionDigits: 0 }).format(Math.abs(value));
            return value < 0 ? '-(' + formatted + ')' : formatted;
        }

        function parseCurrency(str) {
            if (!str) return 0;
            str = str.toString().replace(/[£,]/g, '').trim();
            if (str.startsWith('(') && str.endsWith(')')) {
                str = '-' + str.slice(1, -1);
            }
            return parseFloat(str) || 0;
        }

        function applyValueColour(selector, value) {
            $(selector).removeClass('text-danger text-primary')
                       .addClass(value < 0 ? 'text-danger' : 'text-primary');
        }

        // ---- Financial summary ----

        function refreshFinancialSummary() {
            var totalCosts = parseCurrency($('#TotalStaffCost').val())
                           + parseCurrency($('#TotalAnimalCost').val())
                           + parseCurrency($('#TotalTestCost').val())
                           + parseCurrency($('#TotalAdditionalCost').val());
            $('#TotalCosts').val(formatGBP(totalCosts));

            var income = parseCurrency($('#TransferIncome').val())
                       + parseCurrency($('#ExternalIncome').val())
                       + parseCurrency($('#BudgetCVL').val());
            var profitLoss = income - totalCosts;
            $('#ProfitLoss').val(formatGBP(profitLoss));
            applyValueColour('#ProfitLoss', profitLoss);

            var offTarget = profitLoss - parseCurrency($('#TargetProfit').val());
            $('#OffTarget').val(formatGBP(offTarget));
            $('#OffTarget').css({ 'color': '#1d70b8', 'font-weight': '400' });
        }

        // ---- Total cost refreshers ----

        function refreshStaffTotal() {
            return $.get('/FPS/StaffJob/GetTotalStaffCost', { jobCode: $('#hdnProjectCode').val() }, function (result) {
                if (result.success) { $('#TotalStaffCost').val(formatGBP(result.totalStaffCost)); }
            });
        }

        function refreshAnimalTotal() {
            return $.get('/FPS/AnimalJob/GetTotalAnimalCost', { jobCode: $('#hdnProjectCode').val() }, function (result) {
                if (result.success) { $('#TotalAnimalCost').val(formatGBP(result.totalAnimalCost)); }
            });
        }

        function refreshTestTotal() {
            return $.get('/FPS/TestPlanJob/GetTotalTestCost', { jobCode: $('#hdnProjectCode').val() }, function (result) {
                if (result.success) { $('#TotalTestCost').val(formatGBP(result.totalTestCost)); }
            });
        }

        function refreshAdditionalTotal() {
            return $.get('/FPS/AdditionalCostJob/GetTotalItemCost', { jobCode: $('#hdnProjectCode').val() }, function (result) {
                if (result.success) { $('#TotalAdditionalCost').val(formatGBP(result.totalItemCost)); }
            });
        }

        // ---- Config: job code ----

        StaffJobConfig.getJobCode      = function () { return $('#hdnProjectCode').val(); };
        AnimalJobConfig.getJobCode     = function () { return $('#hdnProjectCode').val(); };
        TestPlanJobConfig.getJobCode   = function () { return $('#hdnProjectCode').val(); };
        AdditionalCostConfig.getJobCode = function () { return $('#hdnProjectCode').val(); };

        // ---- Config: CRUD callbacks ----

        StaffJobConfig.onSaved = StaffJobConfig.onUpdated = StaffJobConfig.onDeleted = function () {
            window['gridManager_staffBookedGrid'].reloadGrid({ page: 1 });
            refreshStaffTotal().done(refreshFinancialSummary);
        };

        AnimalJobConfig.onSaved = AnimalJobConfig.onUpdated = AnimalJobConfig.onDeleted = function () {
            window['gridManager_animalBookedGrid'].reloadGrid({ page: 1 });
            refreshAnimalTotal().done(refreshFinancialSummary);
        };

        TestPlanJobConfig.onSaved = TestPlanJobConfig.onUpdated = TestPlanJobConfig.onDeleted = function () {
            window['gridManager_testPlanGrid'].reloadGrid({ page: 1 });
            refreshTestTotal().done(refreshFinancialSummary);
        };

        AdditionalCostConfig.onSaved = AdditionalCostConfig.onUpdated = AdditionalCostConfig.onDeleted = function () {
            window['gridManager_additionalCostGrid'].reloadGrid({ page: 1 });
            refreshAdditionalTotal().done(refreshFinancialSummary);
        };

        // ---- On page load: fetch all totals then compute summary ----

        $(document).ready(function () {
            var jobCode = $('#hdnProjectCode').val();
            if (jobCode) {
                $.when(
                    refreshStaffTotal(),
                    refreshAnimalTotal(),
                    refreshTestTotal(),
                    refreshAdditionalTotal()
                ).done(refreshFinancialSummary);
            }
        });
    </script>
}


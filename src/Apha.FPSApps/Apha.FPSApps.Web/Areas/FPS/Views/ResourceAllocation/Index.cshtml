@model Apha.FPSApps.Web.Areas.FPS.Models.ResourceAllocationViewModel
@{
    ViewData["Title"] = "Stage 2 Check Resource Allocation";
}

<main class="govuk-main-wrapper govuk-!-padding-top-0" id="main-content" role="main">
    <div class="container-fluid">
        <div class="govuk-grid-row">
            <div class="govuk-grid-column-full">
                <div class="ssr-heading-row">
                    <h1 class="govuk-heading-s sup_border-bottom ssr-main-title">
                        Set Up Staff Resources
                    </h1>
                    <div class="ssr-heading-controls">
                        <label for="resourceCentreSelect" class="govuk-label govuk-!-font-weight-bold">Select a Resource Center: </label>
                        <select class="govuk-select ssr-resource-select"
                                id="resourceCentreSelect"
                                aria-label="Select a Resource Center"
                                asp-for="SelectedResourceCentre"
                                asp-items="Model.ResourceCentres"
                                onchange="LoadGroupsByResourceCentre()">
                            <option value="">-- Select a Resource Center --</option>
                        </select>
                    </div>
                    <div class="govuk-form-group ssr-wg-input-group">
                        <label for="ssrSelectedWorkgroup" class="govuk-label govuk-!-font-weight-bold">Select WorkGroup: </label>
                        <select class="govuk-select ssr-resource-select"
                                id="workGroupSelect"
                                aria-label="Select a Work Group"
                                onchange="LoadGradeByGroup()">
                            <option value="">-- Select a Work Group --</option>
                        </select>
                    </div>
                    <div class="govuk-form-group ssr-wg-input-group">
                        <label for="ssrSelectedWorkgroup" class="govuk-label govuk-!-font-weight-bold">Select WorkGroup Grade: </label>
                        <select class="govuk-select ssr-resource-select"
                                id="workGroupGradeSelect"
                                aria-label="Select a Work Group Grade"
                                onchange="WorkgroupGradeChange()">
                            <option value="">-- Select a Work Group --</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>

       

        <div class="govuk-grid-row">
            <div class="cc-container-fluid">
                <div class="cc-layout-row">

                    @await Html.PartialAsync("_SetUpStaffResourcesSideNav")

                    <div class="cc-content-column">
                        <div class="govuk-grid-row">
                            <div class="govuk-grid-column-full">
                                <div class="govuk-grid-row sup_margin_left_right_10 sup_margin_bottom_10">
                                    <div class="govuk-grid-column-full sup_p_0">

                                        <section class="s2cra-section sup_border" aria-labelledby="s2craSectionHeading">
                                            <h2 class="govuk-heading-s s2cra-section-heading" id="s2craSectionHeading">
                                                Resource Allocation / Utilisation for: <span id="stage2SelectedWorkGroup">@Model.SelectedResourceCentre</span>
                                            </h2>

                                            <div class="s2cra-main-layout">
                                                <div class="s2cra-grids-column">

                                                    <h3 class="govuk-heading-s s2cra-staff-title">
                                                        Staff of this Grade: <span id="stage2SelectedWorkGroupGrade">@Model.SelectedResourceCentre</span>
                                                    </h3>
                                                    <div id="gridContainer_StaffAllocationGrid" class="s2cra-grid-host">
                                                        @await Html.PartialAsync("_DataGrid", Model.StaffAllocationGrid)
                                                    </div>

                                                    <h3 class="govuk-heading-s s2cra-jobs-title">
                                                        Jobs for staff — <span id="stage2SelectedStaffName">@Model.SelectedPersonName</span>
                                                    </h3>
                                                    <div id="gridContainer_StaffJobsGrid" class="s2cra-grid-host s2cra-jobs-grid-host">
                                                        @await Html.PartialAsync("_DataGrid", Model.StaffJobsGrid)
                                                    </div>
                                                    <div class="s2cra-jobs-footer-highlight" aria-label="Selected staff hours highlight">
                                                        <input class="govuk-input s2cra-selected-hours-input"
                                                               id="stage2SelectedStaffHoursInput"
                                                               type="text"
                                                               readonly
                                                               aria-label="Selected staff planned hours" />
                                                    </div>

                                                </div>

                                                <aside class="s2cra-summary-panel" aria-label="Overall position for the grade">
                                                    <h3 class="govuk-heading-s s2cra-summary-title">Overall Position for the Grade</h3>

                                                    <div class="govuk-form-group s2cra-summary-field">
                                                        <label class="govuk-label" for="stage2HoursAvailInput">Hours Avail</label>
                                                        <input class="govuk-input" id="stage2HoursAvailInput" type="text" readonly aria-label="Hours available" />
                                                    </div>
                                                    <div class="govuk-form-group s2cra-summary-field">
                                                        <label class="govuk-label" for="stage2PlannedHrsInput">Planned Hrs</label>
                                                        <input class="govuk-input" id="stage2PlannedHrsInput" type="text" readonly aria-label="Planned hours" />
                                                    </div>
                                                    <div class="govuk-form-group s2cra-summary-field">
                                                        <label class="govuk-label" for="stage2AllocationPctInput">Allocation %</label>
                                                        <input class="govuk-input" id="stage2AllocationPctInput" type="text" readonly aria-label="Allocation percentage" />
                                                    </div>
                                                    <div class="govuk-form-group s2cra-summary-field">
                                                        <label class="govuk-label" for="stage2AssuredChargeInput">Assured Charge Hrs</label>
                                                        <input class="govuk-input" id="stage2AssuredChargeInput" type="text" readonly aria-label="Assured charge hours" />
                                                    </div>
                                                    <div class="govuk-form-group s2cra-summary-field">
                                                        <label class="govuk-label" for="stage2AssuredUtilInput">Assured Utilisation %</label>
                                                        <input class="govuk-input" id="stage2AssuredUtilInput" type="text" readonly aria-label="Assured utilisation percentage" />
                                                    </div>
                                                    <div class="govuk-form-group s2cra-summary-field">
                                                        <label class="govuk-label" for="stage2TotalChargeInput">Total Charge Hrs</label>
                                                        <input class="govuk-input" id="stage2TotalChargeInput" type="text" readonly aria-label="Total charge hours" />
                                                    </div>
                                                    <div class="govuk-form-group s2cra-summary-field govuk-!-margin-bottom-0">
                                                        <label class="govuk-label" for="stage2TotalUtilInput">Total Utilisation %</label>
                                                        <input class="govuk-input" id="stage2TotalUtilInput" type="text" readonly aria-label="Total utilisation percentage" />
                                                    </div>

                                                    <div class="s2cra-person-highlight" aria-label="Person selected highlight">
                                                        <div class="s2cra-person-box">
                                                            <h3 class="govuk-heading-s govuk-!-margin-bottom-2">Person Selected</h3>
                                                            <input class="govuk-input s2cra-person-input"
                                                                   id="stage2PersonSelectedInput"
                                                                   type="text"
                                                                   readonly
                                                                   value="@Model.SelectedPersonName"
                                                                   aria-label="Selected person name" />
                                                            
                                                            <button type="submit"
                                                                id="planPersontoZTCodes"
                                                                class="govuk-button govuk-button--start govuk-!-margin-top-2"
                                                                data-module="govuk-button"
                                                                onclick="ssrPlanPersonOntoZT()">
                                                                Plan Person onto ZT Codes
                                                            </button>
                                                        </div>
                                                    </div>
                                                </aside>
                                            </div>
                                        </section>

                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>

    </div>
</main>
@section Scripts {
    <script>
        // Initialise the SetUpStaffResources module with server-side values.
        window.ssrConfig = {
            currentCentre: '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Model.SelectedResourceCentre))',
            ztCodeUrl:     '@Url.Action("Index", "PlanStaffZTCode", new { area = "FPS" })'
        };

        // Initialise the Resource Allocation (Stage 2) module with Razor-generated URLs.
        window.raConfig = {
            gradesUrl:    '@Url.Action("GetGradesByResourceCentre", "ResourceAllocation", new { area = "FPS" })',
            staffGridUrl: '@Url.Action("LoadStaffAllocationGrid",   "ResourceAllocation", new { area = "FPS" })',
            jobsGridUrl:  '@Url.Action("LoadStaffJobsGrid",         "ResourceAllocation", new { area = "FPS" })',
            totalsUrl:    '@Url.Action("GetStaffAllocationTotals",  "ResourceAllocation", new { area = "FPS" })',
            ztCodeUrl:    '@Url.Action("Index", "PlanStaffZTCode",  new { area = "FPS" })'
        };
    </script>
    <script src="~/js/fps_js/ResourceAllocation.js"></script>
}
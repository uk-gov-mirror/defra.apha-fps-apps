@model Apha.FPSApps.Web.Areas.FPS.Models.ResourceAllocationViewModel
@{
    ViewData["Title"] = "Stage 2 Check Resource Allocation";
}

@section Styles {
    <link rel="stylesheet" href="~/css/staff-resource.css" asp-append-version="true" />
}

<main class="govuk-main-wrapper govuk-!-padding-top-0" id="main-content" role="main">
    <div class="container-fluid">
       
        <div class="govuk-grid-row sup_border-bottom">
            <div class="govuk-grid-column-one-third isFloatLeft">
                <h1 class="govuk-grid-row govuk-heading-s govuk-!-margin-bottom-0 govuk-!-margin-top-3 govuk-!-margin-left-0 isCustomPageHeadings">
                    Set Up Staff Resources
                </h1>
            </div>
            <div class="govuk-grid-column-two-thirds isFloatRight govuk-!-margin-bottom-2 isSetUpStaffResources">
                <table class="govuk-table govuk-!-margin-bottom-2">
                    <tbody class="govuk-table__body">
                        <tr class="govuk-table__row">
                            <th scope="row" class="govuk-table__header govuk-!-padding-bottom-0 govuk-!-padding-right-0 isNoBottomBorder">
                                <label class="govuk-label govuk-!-margin-bottom-0 govuk-!-padding-right-0 govuk-!-font-weight-bold isNoWrap" for="programmeDropdown">Select a Resource Center:</label>
                            </th>
                            <td class="govuk-table__cell govuk-!-padding-bottom-0 govuk-!-padding-right-1 isNoBottomBorder">
                                <select class="govuk-select"
                                        id="resourceCentreSelect"
                                        aria-label="Select a Resource Center"
                                        asp-for="SelectedResourceCentre"
                                        asp-items="Model.ResourceCentres"
                                        onchange="LoadGroupsByResourceCentre()">
                                    <option value="">-- Select a Resource Center --</option>
                                </select>
                            </td>

                            <th scope="row" class="govuk-table__header  govuk-!-padding-right-1 govuk-!-padding-bottom-0 isNoBottomBorder">
                                <label for="ssrSelectedWorkgroup" class="govuk-label govuk-!-margin-bottom-0 govuk-!-font-weight-bold isNoWrap">Select WorkGroup: </label>
                            </th>
                            <td class="govuk-table__cell govuk-!-padding-bottom-0 isNoBottomBorder">
                                <select class="govuk-select"
                                        id="workGroupSelect"
                                        aria-label="Select a Work Group"
                                        asp-for="SelectedWorkGroup"
                                        asp-items="Model.WorkGroupList"
                                        onchange="LoadGradeByGroup()">
                                    <option value="">-- Select a Work Group --</option>
                                </select>
                            </td>

                            <th scope="row" class="govuk-table__header  govuk-!-padding-right-1 govuk-!-padding-bottom-0 isNoBottomBorder">
                                <label for="ssrSelectedWorkgroup" class="govuk-label govuk-!-margin-bottom-0 govuk-!-font-weight-bold isNoWrap">Select WorkGroup Grade: </label>
                            </th>
                            <td class="govuk-table__cell govuk-!-padding-bottom-0 isNoBottomBorder">
                                <select class="govuk-select"
                                        id="workGroupGradeSelect"
                                        aria-label="Select a Work Group Grade"
                                        onchange="WorkgroupGradeChange()">
                                    <option value="">-- Select a Work Group --</option>
                                </select>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <div class="govuk-grid-row">
            <div class="cc-container-fluid">
                <div class="cc-layout-row">

                    @await Html.PartialAsync("_SetUpStaffResourcesSideNav", "ResourceAllocation")

                    <div class="cc-content-column">
                        <div class="govuk-grid-row">
                            <div class="govuk-grid-column-full">
                                <div class="govuk-grid-row sup_margin_left_right_10 sup_margin_bottom_10">
                                    <div class="govuk-grid-column-full sup_p_0">

                                        <section class="s2cra-section sup_border" aria-labelledby="s2craSectionHeading">
                                            <h2 class="govuk-heading-s s2cra-section-heading" id="s2craSectionHeading">
                                                Resource Allocation / Utilisation for: <span id="stage2SelectedWorkGroup">@Model.SelectedResourceCentre</span>
                                            </h2>

                                            <div class="s2cra-main-layout">
                                                <div class="s2cra-grids-column">

                                                    <h3 class="govuk-heading-s s2cra-staff-title">
                                                        Staff of this Grade: <span id="stage2SelectedWorkGroupGrade">@Model.SelectedResourceCentre</span>
                                                    </h3>
                                                    <div id="gridContainer_StaffAllocationGrid" class="s2cra-grid-host">
                                                        @await Html.PartialAsync("_DataGrid", Model.StaffAllocationGrid)
                                                    </div>

                                                    <h3 class="govuk-heading-s s2cra-jobs-title">
                                                        Jobs for staff — <span id="stage2SelectedStaffName">@Model.SelectedPersonName</span>
                                                    </h3>
                                                    <div id="gridContainer_StaffJobsGrid" class="s2cra-grid-host s2cra-jobs-grid-host">
                                                        @await Html.PartialAsync("_DataGrid", Model.StaffJobsGrid)
                                                    </div>
                                                    <div class="s2cra-jobs-footer-highlight" aria-label="Selected staff hours highlight">
                                                        <input class="govuk-input s2cra-selected-hours-input"
                                                               id="stage2SelectedStaffHoursInput"
                                                               type="text"
                                                               readonly
                                                               aria-label="Selected staff planned hours" />
                                                    </div>

                                                </div>

                                                <aside class="s2cra-summary-panel" aria-label="Overall position for the grade">
                                                    <h3 class="govuk-heading-s s2cra-summary-title">Overall Position for the Grade</h3>

                                                    <div class="govuk-form-group s2cra-summary-field">
                                                        <label class="govuk-label" for="stage2HoursAvailInput">Hours Avail</label>
                                                        <input class="govuk-input" id="stage2HoursAvailInput" type="text" readonly aria-label="Hours available" />
                                                    </div>
                                                    <div class="govuk-form-group s2cra-summary-field">
                                                        <label class="govuk-label" for="stage2PlannedHrsInput">Planned Hrs</label>
                                                        <input class="govuk-input" id="stage2PlannedHrsInput" type="text" readonly aria-label="Planned hours" />
                                                    </div>
                                                    <div class="govuk-form-group s2cra-summary-field">
                                                        <label class="govuk-label" for="stage2AllocationPctInput">Allocation %</label>
                                                        <input class="govuk-input" id="stage2AllocationPctInput" type="text" readonly aria-label="Allocation percentage" />
                                                    </div>
                                                    <div class="govuk-form-group s2cra-summary-field">
                                                        <label class="govuk-label" for="stage2AssuredChargeInput">Assured Charge Hrs</label>
                                                        <input class="govuk-input" id="stage2AssuredChargeInput" type="text" readonly aria-label="Assured charge hours" />
                                                    </div>
                                                    <div class="govuk-form-group s2cra-summary-field">
                                                        <label class="govuk-label" for="stage2AssuredUtilInput">Assured Utilisation %</label>
                                                        <input class="govuk-input" id="stage2AssuredUtilInput" type="text" readonly aria-label="Assured utilisation percentage" />
                                                    </div>
                                                    <div class="govuk-form-group s2cra-summary-field">
                                                        <label class="govuk-label" for="stage2TotalChargeInput">Total Charge Hrs</label>
                                                        <input class="govuk-input" id="stage2TotalChargeInput" type="text" readonly aria-label="Total charge hours" />
                                                    </div>
                                                    <div class="govuk-form-group s2cra-summary-field govuk-!-margin-bottom-0">
                                                        <label class="govuk-label" for="stage2TotalUtilInput">Total Utilisation %</label>
                                                        <input class="govuk-input" id="stage2TotalUtilInput" type="text" readonly aria-label="Total utilisation percentage" />
                                                    </div>

                                                    <div class="s2cra-person-highlight" aria-label="Person selected highlight">
                                                        <div class="s2cra-person-box">
                                                            <h3 class="govuk-heading-s govuk-!-margin-bottom-2">Person Selected</h3>
                                                            <input class="govuk-input s2cra-person-input"
                                                                   id="stage2PersonSelectedInput"
                                                                   type="text"
                                                                   readonly
                                                                   value="@Model.SelectedPersonName"
                                                                   aria-label="Selected person name" />
                                                            
                                                            <button type="submit"
                                                                id="planPersontoZTCodes"
                                                                class="govuk-button govuk-button--start govuk-!-margin-top-2"
                                                                data-module="govuk-button"
                                                                onclick="ssrPlanPersonOntoZT()">
                                                                Plan Person onto ZT Codes
                                                            </button>
                                                        </div>
                                                    </div>
                                                </aside>
                                            </div>
                                        </section>

                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>

    </div>
</main>
@section Scripts {
    <script>
        // Initialise the SetUpStaffResources module with server-side values.
        window.ssrConfig = {
            currentCentre: '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Model.SelectedResourceCentre))',
            ztCodeUrl:     '@Url.Action("Index", "PlanStaffZTCode", new { area = "FPS" })'
        };

        // Initialise side nav state from server-selected values.
        window.sideNavState = {
            resourceCentre: '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Model.SelectedResourceCentre))',
            workGroup:      '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Model.SelectedWorkGroup))',
            fpsYear:        '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(ViewBag.FpsYear?.ToString() ?? string.Empty))'
        };

        // Keep sideNavState in sync when dropdowns change.
        (function() {
            function attachDropdownListeners() {
                const rcSelect = document.getElementById('resourceCentreSelect');
                const wgSelect = document.getElementById('workGroupSelect');

                if (rcSelect) {
                    rcSelect.addEventListener('change', function () {
                        window.sideNavState.resourceCentre = this.value;
                        window.sideNavState.workGroup = '';
                        sideNavUpdateLinks();
                    });
                }

                if (wgSelect) {
                    wgSelect.addEventListener('change', function () {
                        window.sideNavState.workGroup = this.value;
                        sideNavUpdateLinks();
                    });
                }
            }

            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', attachDropdownListeners);
            } else {
                attachDropdownListeners();
            }
        })();

        // Initialise the Resource Allocation (Stage 2) module with Razor-generated URLs.
        window.raConfig = {
            currentCentre:  '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Model.SelectedResourceCentre))',
            currentWorkGroup: '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Model.SelectedWorkGroup))',
            gradesUrl:    '@Url.Action("GetGradesByResourceCentre", "ResourceAllocation", new { area = "FPS" })',
            staffGridUrl: '@Url.Action("LoadStaffAllocationGrid",   "ResourceAllocation", new { area = "FPS" })',
            jobsGridUrl:  '@Url.Action("LoadStaffJobsGrid",         "ResourceAllocation", new { area = "FPS" })',
            totalsUrl:    '@Url.Action("GetStaffAllocationTotals",  "ResourceAllocation", new { area = "FPS" })',
            ztCodeUrl:    '@Url.Action("Index", "PlanStaffZTCode",  new { area = "FPS" })'
        };

            // ─── Totals row for the "Staff of this Grade" grid ──────────────────
            // Rendered as a <tfoot> inside the grid table so the browser's own
            // table layout keeps every total aligned under its column. Mirrors the
            // totals row shown on the Staff Resource Utilisation page.
            function buildRaStaffTotalsRow() {
                var table = document.getElementById('tbl_@Model.StaffAllocationGrid.GridId');
                if (!table) return;

                // Clear any previously rendered totals tfoot before rebuilding it.
                var existingFoot = table.querySelector('tfoot');
                if (existingFoot) existingFoot.remove();

                var rows = table.querySelectorAll('tbody tr');
                if (!rows.length) return;

                // Visible column layout (0-based):
                //  0:Name(text)
                //  1:HrsAvail  2:PlanHrs
                //  3:Allocation(%)
                //  4:AppChargeHrs
                //  5:AppUtilization(%)
                //  6:ChargeHrs
                //  7:Utilization(%)
                var refCells = rows[0].querySelectorAll('td');
                var colCount = refCells.length;
                var sumCols  = [1, 2, 4, 6];           // Sum these: HrsAvail, PlanHrs, AppChargeHrs, ChargeHrs
                var derivedPercentageCols = [3, 5, 7]; // Derive from sums: Allocation, AppUtilization, Utilization
                var sums = {};

                sumCols.forEach(function (i) { sums[i] = 0; });

                rows.forEach(function (row) {
                    var cells = row.querySelectorAll('td');
                    sumCols.forEach(function (i) {
                        if (!cells[i]) return;
                        var val = parseFloat(cells[i].textContent.trim().replace(/,/g, ''));
                        if (!isNaN(val)) sums[i] += val;
                    });
                });

                // Build totals table row (rendered outside the main grid)
                var totalsHtml = '<table class="govuk-table custom-table ra-totals-table" style="width: 100%; margin-top: 0;">';
                totalsHtml += '<tbody class="govuk-table__body">';
                totalsHtml += '<tr class="ruv-totals-row govuk-table__row">';

                for (var i = 0; i < colCount; i++) {
                    var cellContent = '';
                    var cellClass = 'govuk-table__cell';

                    if (i === 0) {
                        cellContent = 'Staff Totals:';
                        cellClass += ' ruv-totals-label';
                    } else if (sums.hasOwnProperty(i)) {
                        // Sum columns: just display the total
                        cellContent = (Math.round(sums[i] * 100) / 100).toFixed(2);
                        cellClass += ' govuk-table__cell--numeric';
                    } else if (derivedPercentageCols.indexOf(i) !== -1) {
                        // Derived percentage columns: calculate from component sums
                        var numerator = 0, denominator = 0;

                        if (i === 3) {
                            // Allocation = PlanHrs / HrsAvail
                            numerator = sums[2];
                            denominator = sums[1];
                        } else if (i === 5) {
                            // AppUtilization = AppChargeHrs / HrsAvail
                            numerator = sums[4];
                            denominator = sums[1];
                        } else if (i === 7) {
                            // Utilization = ChargeHrs / HrsAvail
                            numerator = sums[6];
                            denominator = sums[1];
                        }

                        if (denominator !== 0) {
                            var pct = (numerator / denominator) * 100;
                            cellContent = pct.toFixed(2) + '%';
                        } else {
                            cellContent = '0.00%';
                        }
                        cellClass += ' govuk-table__cell--numeric';
                    }

                    totalsHtml += '<td class="' + cellClass + '">' + cellContent + '</td>';
                }

                totalsHtml += '</tr>';
                totalsHtml += '</tbody>';
                totalsHtml += '</table>';

                // Insert the totals table after the grid container
                var gridContainer = document.getElementById('gridContainer_@Model.StaffAllocationGrid.GridId');
                if (gridContainer) {
                    var totalsDiv = document.createElement('div');
                    totalsDiv.id = 'ra-staff-totals-container';
                    totalsDiv.innerHTML = totalsHtml;
                    gridContainer.parentNode.insertBefore(totalsDiv, gridContainer.nextSibling);
                }
            }

            // Expose so ResourceAllocation.js can rebuild totals after it replaces
            // the staff grid markup directly (grade change / state restore).
            window.buildRaStaffTotalsRow = buildRaStaffTotalsRow;

            // Rebuild totals whenever the staff grid reloads (paging / filtering).
            document.addEventListener('gridReloaded', function (e) {
                if (e.detail && e.detail.gridId === '@Model.StaffAllocationGrid.GridId') {
                    buildRaStaffTotalsRow();
                }
            });
        </script>
        <script src="~/js/fps_js/ResourceAllocation.js"></script>
    }
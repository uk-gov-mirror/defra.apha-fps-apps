@using Apha.FPSApps.Web.Models.Components.DataGrid
@model Apha.FPSApps.Web.Areas.FPS.Models.DivisionGradeViewModel

@{
    ViewData["Title"] = "Division Grade Maintenance";
}

<main id="main-content">
    <div class="container-fluid">
        <!-- Title section -->
        <div class="govuk-grid-row">
            <div class="govuk-grid-column-full">
                <h1 class="govuk-heading-s sup_border-bottom govuk-!-margin-top-2 govuk-!-padding-bottom-2">Division Grade Maintenance</h1>
            </div>
        </div>

        <div class="row">
            <div class="col-lg-12">
                <main class="main-content" style="padding:0;">
                    <div class="container-fluid" style="padding: 0;">
                        <div class="row">
                            <div class="container-fluid" style="padding-left:0px;">
                                <div style="display: flex; flex-direction: row; align-items: flex-start;">
                                    <!-- Side nav -->
                                    @await Html.PartialAsync("_MaintenanceSideNav", "DivisionGradeMaintenance")
                                    <div style="display: flex; flex-direction: column; flex: 1 1 auto; min-width: 0; margin: 0 0px 5px 8px;">
                                        <!-- DataGrid section -->
                                        <div class="govuk-grid-row">
                                            <div class="govuk-grid-column-full mt-2">
                                                <!-- Grid Container -->
                                                <div id="@($"gridContainer_{Model.DivisionGradeGrid.GridId}")">
                                                    @await Html.PartialAsync("_DataGrid", Model.DivisionGradeGrid)
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </main>
            </div>
        </div>
    </div>
</main>

@section Scripts {
    <script src="~/js/ajax-form-validation.js"></script>
    <script>
    

        function reloadDivisionGradeGrid() {
            var gm = window['gridManager_divisionGradeGrid'];
            if (gm) { gm.reloadGrid({ page: 1 }); }
        }

        function addDivisionGrade() {
            $.get('/FPS/DivisionGradeMaintenance/Create', function (html) {
                $('#modaPopupBody').html(html);
                $('#modalPopup').addClass('show');
            }).fail(function () {
                showAlertMessage('An error occurred while loading the form', AlertType.ERROR);
            });
        }

        function editDivisionGrade(btn) {
            var id = $(btn).data('id');
            $.get('/FPS/DivisionGradeMaintenance/Edit', { id: id }, function (html) {
                $('#modaPopupBody').html(html);
                $('#modalPopup').addClass('show');
            }).fail(function () {
                showAlertMessage('An error occurred while loading the edit form', AlertType.ERROR);
            });
        }

        function deleteDivisionGrade(btn) {
            var id = $(btn).data('id');
            showGovukConfirm('Are you sure you want to delete this record?').then(function (result) {
                if (!result) return;
                $.ajax({
                    url: '/FPS/DivisionGradeMaintenance/Delete?id=' + encodeURIComponent(id),
                    type: 'DELETE',
                    success: function (response) {
                        if (response.success) {
                            showAlertMessage('Division grade deleted successfully', AlertType.SUCCESS).then(function () {
                                reloadDivisionGradeGrid();
                            });
                        } else {
                            showAlertMessage('Error: ' + (response.message || 'Delete failed.'), AlertType.ERROR);
                        }
                    },
                    error: function () {
                        showAlertMessage('An error occurred while deleting.', AlertType.ERROR);
                    }
                });
            });
        }

        function saveDivisionGrade() {
            clearValidationErrors('#modaPopupBody');
            var form = $('#addDivisionGradeForm');

            if (!isFormValid(form)) {
                displayClientValidationErrors(form, '#modaPopupBody');
                return;
            }

            var dto = {
                DivisionGradeCode: $('#DivisionGradeCode').val(),
                GradeCode: $('#GradeCode').val() || null,
                Division: $('#Division').val() || null,
                ChargeRate: parseDecimalOrNull($('#ChargeRate').val()),
                DirectRate: parseDecimalOrNull($('#DirectRate').val()),
                PayRate: parseDecimalOrNull($('#PayRate').val()),
                Npr: parseDecimalOrNull($('#Npr').val()),
                Ohr: parseDecimalOrNull($('#Ohr').val())
            };

            $.ajax({
                url: '/FPS/DivisionGradeMaintenance/Create',
                type: 'POST',
                data: JSON.stringify(dto),
                contentType: 'application/json; charset=utf-8',
                success: function (data) {
                    if (data.success) {
                        showAlertMessage(data.message || 'Division grade created successfully.', AlertType.SUCCESS);
                        closeModal();
                        reloadDivisionGradeGrid();
                    } else {
                        displayServerValidationErrors(data.errors, data.message, '#modaPopupBody');
                    }
                },
                error: function (xhr) {
                    if (xhr.status === 400 && xhr.responseJSON) {
                        displayServerValidationErrors(xhr.responseJSON.errors, xhr.responseJSON.message, '#modaPopupBody');
                    } else {
                        showAlertMessage('An error occurred while saving.', AlertType.ERROR);
                    }
                }
            });
        }

        function updateDivisionGrade() {
            clearValidationErrors('#modaPopupBody');
            var form = $('#editDivisionGradeForm');

            if (!isFormValid(form)) {
                displayClientValidationErrors(form, '#modaPopupBody');
                return;
            }

            var originalCode = $('#hdnOriginalCode').val();

            var dto = {
                DivisionGradeCode: originalCode,
                GradeCode: $('#GradeCode').val() || null,
                Division: $('#Division').val() || null,
                ChargeRate: parseDecimalOrNull($('#ChargeRate').val()),
                DirectRate: parseDecimalOrNull($('#DirectRate').val()),
                PayRate: parseDecimalOrNull($('#PayRate').val()),
                Npr: parseDecimalOrNull($('#Npr').val()),
                Ohr: parseDecimalOrNull($('#Ohr').val())
            };

            $.ajax({
                url: '/FPS/DivisionGradeMaintenance/Edit?id=' + encodeURIComponent(originalCode),
                type: 'POST',
                data: JSON.stringify(dto),
                contentType: 'application/json; charset=utf-8',
                success: function (data) {
                    if (data.success) {
                        showAlertMessage(data.message || 'Division grade updated successfully.', AlertType.SUCCESS);
                        closeModal();
                        reloadDivisionGradeGrid();
                    } else {
                        displayServerValidationErrors(data.errors, data.message, '#modaPopupBody');
                    }
                },
                error: function (xhr) {
                    if (xhr.status === 400 && xhr.responseJSON) {
                        displayServerValidationErrors(xhr.responseJSON.errors, xhr.responseJSON.message, '#modaPopupBody');
                    } else {
                        showAlertMessage('An error occurred while saving.', AlertType.ERROR);
                    }
                }
            });
        }

        function closeModal() {
            $('#modaPopupBody').html('');
            $('#modalPopup').removeClass('show');
        }

        function parseDecimalOrNull(val) {
            if (val === null || val === undefined || val.toString().trim() === '') return null;
            var parsed = parseFloat(val);
            return isNaN(parsed) ? null : parsed;
        }

    </script>
}

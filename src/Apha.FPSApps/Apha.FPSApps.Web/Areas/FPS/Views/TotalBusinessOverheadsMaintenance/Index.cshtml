@model Apha.FPSApps.Web.Areas.FPS.Models.TotalBusinessOverheadsViewModel

@{
    ViewData["Title"] = "Maintain Total Business Overheads";
}

<main id="main-content">
    <div class="container-fluid">

        <div class="govuk-grid-row">
            <div class="govuk-grid-column-full">
                <h1 class="govuk-heading-s sup_border-bottom govuk-!-margin-top-2 govuk-!-padding-bottom-2">
                    Total Business Overheads
                </h1>
            </div>
        </div>

        <div class="row">
            <div class="col-lg-12">
                <main class="main-content" style="padding:0;">
                    <div class="container-fluid" style="padding: 0;">
                        <div class="row">
                            <div class="container-fluid" style="padding-left:0px;">
                                <div style="display: flex; flex-direction: row; align-items: flex-start;">

                                    @await Html.PartialAsync("_MaintenanceSideNav", "TotalBusinessOverheadsMaintenance")

                                    <div style="display: flex; flex-direction: column; flex: 1 1 auto; min-width: 0; margin: 0 0px 5px 8px;">

                                        <form id="totalBusinessOverheadsForm">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" asp-for="FpsYear" />

                                            <div class="govuk-!-margin-left-2 govuk-form-group sup_margin_bottom_10 ac-filter-panel govuk-!-padding-bottom-0">
                                                <div class="trl-filter-row govuk-!-margin-top-0 govuk-!-margin-bottom-0">

                                                    <div class="govuk-form-group sup_margin_bottom_10">
                                                        <label class="govuk-label govuk-!-font-weight-bold govuk-!-font-size-16 pva-nowrap-label govuk-!-margin-bottom-2" for="TotalBusinessOverheads">Total Business Overheads:</label>
                                                    </div>
                                                    <div class="govuk-form-group sup_margin_bottom_10">
                                                        <div class="govuk-input__wrapper">
                                                            <div class="govuk-input__prefix" aria-hidden="true">£</div>
                                                            <input type="text" asp-for="TotalBusinessOverheads" class="govuk-input text-AlignRight pva-input-185 js-numeric-decimal" maxlength="20" id="TotalBusinessOverheads" />
                                                        </div>
                                                    </div>

                                                    <div class="govuk-form-group sup_margin_bottom_10">
                                                        <div class="govuk-button-group sup_margin_0 trl-filter-actions-buttons">
                                                            <button type="button" class="govuk-button govuk-!-margin-bottom-2" id="btnSaveBusinessOverheads" data-module="govuk-button" onclick="saveBusinessOverheads()">Save</button>
                                                        </div>
                                                    </div>

                                                </div>
                                            </div>

                                        </form>

                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </main>
            </div>
        </div>

    </div>
</main>

@section Scripts {
    <script>
        function saveBusinessOverheads() {
            var form = $('#totalBusinessOverheadsForm');
            var overheadsValue = form.find('[name="TotalBusinessOverheads"]').val().trim();
            var data = {
                FpsYear: form.find('[name="FpsYear"]').val(),
                TotalBusinessOverheads: overheadsValue === '' ? null : overheadsValue
            };

            $.ajax({
                url: '@Url.Action("Save", "TotalBusinessOverheadsMaintenance", new { area = "FPS" })',
                type: 'POST',
                data: JSON.stringify(data),
                contentType: 'application/json; charset=utf-8',
                headers: {
                    'RequestVerificationToken': form.find('[name="__RequestVerificationToken"]').val()
                },
                success: function (result) {
                    if (result.success) {
                        showAlertMessage(result.message || 'Total Business Overheads saved successfully.', AlertType.SUCCESS);
                    } else {
                        showAlertMessage(result.message || 'Failed to save Total Business Overheads.', AlertType.ERROR);
                    }
                },
                error: function () {
                    showAlertMessage('An error occurred while saving.', AlertType.ERROR);
                }
            });
        }

        $(document).ready(function () {
            $(document).ajaxStart(showLoader).ajaxStop(hideLoader);
        });
    </script>
}

@model Apha.FPSApps.Web.Areas.FPS.Models.YearEndEditConfigValueModel

<div class="modal-header flex-space-center">
    <h3 class="modal-title govuk-heading-s" style="margin:0;">Edit Config Value</h3>
    <button type="button" class="btn-close btn-red" onclick="closeYeiModal()" aria-label="Close">X</button>
</div>

<div class="modal-body cc-modal-body">
    <div class="govuk-error-summary" aria-labelledby="yei-modal-error-title" tabindex="-1" style="display:none;">
        <h2 class="govuk-error-summary__title" id="yei-modal-error-title">There is a problem</h2>
        <div class="govuk-error-summary__body">
            <ul class="govuk-list govuk-error-summary__list"></ul>
        </div>
    </div>

    <form id="configValueForm" novalidate>
        @Html.AntiForgeryToken()
        <input type="hidden" id="configModalId" value="@Model.Id" />
        <input type="hidden" id="configModalFpsYear" value="@Model.FpsYear" />

        <div class="govuk-form-group">
            <label class="govuk-label govuk-!-font-weight-bold"
                   for="@(Model.IsYesNo ? "configModalSelect" : "configModalInput")">
                @Model.Id
            </label>

            @if (Model.IsYesNo)
            {
                <select class="govuk-select govuk-!-font-size-16" id="configModalSelect" name="Value" for="configModalSelect">
                    @Html.Raw("<option value=\"Yes\"" + (Model.Value == "Yes" ? " selected" : "") + ">Yes</option>")
                    @Html.Raw("<option value=\"No\""  + (Model.Value == "No"  ? " selected" : "") + ">No</option>")
                </select>
            }
            else
            {
                <input class="govuk-input govuk-input--width-10 govuk-!-font-size-16"
                       id="configModalInput" name="Value" type="text"
                       value="@Model.Value" autocomplete="off" for="configModalInput" />
            }
        </div>
    </form>
</div>

<div class="modal-footer" style="display:flex; gap:8px; justify-content:flex-end; padding:12px 16px;">
    <button class="govuk-button govuk-!-margin-bottom-0" onclick="saveConfigValue()">Confirm</button>
    <button class="govuk-button govuk-button--secondary govuk-!-margin-bottom-0" onclick="closeYeiModal()">Cancel</button>
</div>

@model Apha.FPSApps.Web.Areas.FPS.Models.DivisionViewModel
@{
    var isEditMode = !string.IsNullOrWhiteSpace(Model?.DivName);
    var title = isEditMode ? "Edit Division" : "Add Division";
    var formId = isEditMode ? "editDivisionForm" : "addDivisionForm";
    var saveLabel = isEditMode ? "Update" : "Save";
    var saveAction = isEditMode ? "updateDivision()" : "saveDivision()";
}

<div class="modal-header">
    <h5 class="modal-title" id="divisionModalTitle">@title</h5>
    <button type="button" class="btn-close btn-red" onclick="closeModal()" data-bs-dismiss="modal">X</button>
</div>
<div class="modal-body">
    <div class="govuk-error-summary" role="alert"
         aria-labelledby="error-summary-title" tabindex="-1" style="display:none;">
        <h2 class="govuk-error-summary__title" id="error-summary-title">
            There is a problem
        </h2>
        <div class="govuk-error-summary__body">
            <ul class="govuk-list govuk-error-summary__list">
            </ul>
        </div>
    </div>
    <div class="row g-3">
        <form id="@formId">
                    @if (isEditMode && Model != null)
                    {
                        <!-- Hidden field to store original DivName for update operations -->
                        <input type="hidden" id="originalDivName" value="@Model.DivName" />
                    }

                    <div class="govuk-form-group sup_margin_0">
                        <label class="govuk-label" asp-for="DivisionId">Division ID <span class="sup_color_red">*</span></label>
                        <input type="number" asp-for="DivisionId" class="govuk-input" required min="1">
                        <span asp-validation-for="DivisionId" class="govuk-error-message" style="display:none;"></span>
                    </div>

                    <div class="govuk-form-group sup_margin_0">
                        <label class="govuk-label" asp-for="AgencyId">Agency ID <span class="sup_color_red">*</span></label>
                    <select asp-for="AgencyId" required class="govuk-select sup_width_100">
                            <option value="">-- Select Agency --</option>
                        </select>
                        <span asp-validation-for="AgencyId" class="govuk-error-message" style="display:none;"></span>
                    </div>

                    <div class="govuk-form-group sup_margin_0">
                        <label class="govuk-label" asp-for="DivName">Division Name <span class="sup_color_red">*</span></label>
                        <input type="text" asp-for="DivName" required class="govuk-input" maxlength="255">
                        <span asp-validation-for="DivName" class="govuk-error-message" style="display:none;"></span>
                    </div>

                    <div class="govuk-form-group sup_margin_0">
                        <label class="govuk-label" asp-for="CentOverhead">Central Overhead</label>
                        <div class="govuk-input__wrapper">
                            <div class="govuk-input__prefix" aria-hidden="true">£</div>
                            <input type="text" asp-for="CentOverhead" class="govuk-input js-numeric-decimal" maxlength="20">
                        </div>
                        <span asp-validation-for="CentOverhead" class="govuk-error-message" style="display:none;"></span>
                    </div>
                </form>
            </div>
        </div>
<div class="modal-footer sup_flex_space_center">
    <button class="govuk-button govuk-button--secondary sup_margin_0" data-module="govuk-button" data-bs-dismiss="modal" onclick="closeModal()">Cancel</button>
    <button class="govuk-button sup_margin_0" data-module="govuk-button" type="button" onclick="@saveAction">@saveLabel</button>
</div>

<script>
    // Load agencies dropdown when modal opens
    $(document).ready(function () {
        loadAgencies();
    });

    function loadAgencies() {
        var $select = $('#AgencyId');
        var currentAgencyId = '@(Model?.AgencyId ?? 0)';

        // Load agencies from API
        $.ajax({
            url: '@Url.Action("GetDistinctAgencies", "DivisionMaintenance", new { area = "FPS" })',
            type: 'GET',
            success: function (response) {
                if (response.success && response.data) {
                    $.each(response.data, function (index, agency) {
                        var isSelected = currentAgencyId && currentAgencyId == agency.agencyId;
                        $select.append($('<option></option>')
                            .attr('value', agency.agencyId)
                            .attr('selected', isSelected)
                            .text(agency.agencyId)); // Display AgencyId since we don't have Agency Name yet
                    });
                }
            },
            error: function (xhr, status, error) {
                // Fallback to showing at least one option
                $select.append($('<option value=""></option>').text('Error loading agencies'));
            }
        });
    }
</script>


@using Apha.FPSApps.Web.Models.Components.DataGrid
@model Apha.FPSApps.Web.Areas.FPS.Models.WgStaffPlanViewModel
@{
    ViewData["Title"] = "Workgroup Staff Plan";
}

<main class="govuk-main-wrapper govuk-!-padding-top-0" id="main-content" role="main">
    <div class="container-fluid">
        <div class="govuk-grid-row">
            <div class="govuk-grid-column-full">
                <div class="ssr-heading-row">
                    <h1 class="govuk-heading-s sup_border-bottom ssr-main-title">
                        Workgroup Staff Plan
                    </h1>
                    <div class="ssr-heading-controls">
                        <label for="resourceCentreDropdown" class="govuk-label govuk-!-font-weight-bold">Select a Resource Centre: </label>
                        <select class="govuk-select ssr-resource-select"
                                id="resourceCentreDropdown"
                                aria-label="Select a Resource Centre"
                                asp-for="SelectedResourceCentre"
                                asp-items="Model.ResourceCentreList"
                                onchange="onResourceCentreChange()">
                            <option value="">-- Select a Resource Centre --</option>
                        </select>
                    </div>
                    <div class="govuk-form-group ssr-wg-input-group">
                        <label for="workGroupDropdown" class="govuk-label govuk-!-font-weight-bold">Select a Work Group: </label>
                        <select class="govuk-select ssr-resource-select"
                                id="workGroupDropdown"
                                aria-label="Select a Work Group"
                                asp-for="SelectedWorkGroup"
                                asp-items="Model.WorkGroupList"
                                onchange="onWorkGroupChange()"
                                data-disabled="@(string.IsNullOrEmpty(Model.SelectedResourceCentre) ? "true" : "false")">
                            <option value="">-- Select Work Group --</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>

        <div class="govuk-grid-row">
            <div class="cc-container-fluid">
                <div class="cc-layout-row">

                    @await Html.PartialAsync("_SetUpStaffResourcesSideNav", "WgStaffPlan")

                    <div class="cc-content-column">
                        <div class="govuk-grid-row">
                            <div class="govuk-grid-column-full">
                                <div class="govuk-grid-row sup_margin_left_right_10 sup_margin_bottom_10">
                                    <div class="govuk-grid-column-full sup_p_0">
                                        <div id="gridContainer_wgStaffPlanGrid">
                                            @await Html.PartialAsync("_DataGrid", Model.Grid)
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>

    </div>
</main>

@section Scripts {
    <script>
        // Initialise side nav state from server-selected values.
        window.sideNavState = {
            resourceCentre: '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Model.SelectedResourceCentre ?? string.Empty))',
            workGroup:      '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Model.SelectedWorkGroup ?? string.Empty))',
            fpsYear:        '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(ViewBag.FpsYear?.ToString() ?? string.Empty))'
        };

        function onResourceCentreChange() {
            var resourceCentre = document.getElementById('resourceCentreDropdown').value;
            var wgDropdown = document.getElementById('workGroupDropdown');

            wgDropdown.innerHTML = '<option value="">-- Select Work Group --</option>';
            wgDropdown.disabled = true;

            window.sideNavState.resourceCentre = resourceCentre;
            window.sideNavState.workGroup = '';
            sideNavUpdateLinks();

            if (!resourceCentre) return;

            showLoader();
            $.get('@Url.Action("GetWorkGroupsByResourceCentre", "WgStaffPlan", new { area = "FPS" })',
                { resourceCentre: resourceCentre },
                function (response) {
                    hideLoader();
                    if (response && response.success) {
                        (response.data || []).forEach(function (wg) {
                            var opt = document.createElement('option');
                            opt.value = wg;
                            opt.text  = wg;
                            wgDropdown.appendChild(opt);
                        });
                        wgDropdown.disabled = false;
                    } else {
                        showAlertMessage('Could not load work groups: ' + (response && response.message || 'Unknown error.'), AlertType.WARNING);
                    }
                }
            ).fail(function () {
                hideLoader();
                showAlertMessage('Could not load work groups. Please try selecting the Resource Centre again.', AlertType.WARNING);
            });
        }

        function onWorkGroupChange() {
            var resourceCentre = document.getElementById('resourceCentreDropdown').value;
            var workGroup      = document.getElementById('workGroupDropdown').value;

            window.sideNavState.workGroup = workGroup;
            sideNavUpdateLinks();

            if (!workGroup) return;

            fpsNavigateTo('@Url.Action("Index", "WgStaffPlan", new { area = "FPS" })?resourceCentre='
                + encodeURIComponent(resourceCentre)
                + '&workGroup=' + encodeURIComponent(workGroup));
        }

        function getWgStaffPlanExtraFilters() {
            var resourceCentre = document.getElementById('resourceCentreDropdown')?.value || '';
            var workGroup = document.getElementById('workGroupDropdown')?.value || '';

            return {
                resourceCentre: resourceCentre,
                workGroup: workGroup
            };
        }

        document.addEventListener('DOMContentLoaded', function () {
            var wgDropdown = document.getElementById('workGroupDropdown');
            if (wgDropdown && wgDropdown.getAttribute('data-disabled') === 'true') {
                wgDropdown.disabled = true;
            }
        });
    </script>
}

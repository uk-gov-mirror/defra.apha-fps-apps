    <div class="govuk-grid-row">
        <div class="govuk-grid-column-one-half isFloatLeft">
            <h1 class="govuk-grid-row govuk-heading-s govuk-!-margin-bottom-0 govuk-!-margin-left-0 isCustomPageHeadings">Compare FPS Plan with PACT Actuals</h1>
        </div>

        <div class="govuk-grid-column-one-third isFloatRight">
            <table class="govuk-table govuk-!-margin-bottom-0 isFloatRight isHalfGrid">
                <tbody class="govuk-table__body">
                    <tr class="govuk-table__row">
                        <th scope="row" class="govuk-table__header govuk-!-padding-bottom-0 govuk-!-padding-top-0 govuk-!-padding-right-0 isNoBottomBorder govuk-!-text-align-right">
                            <label class="fw-bold mt-2 me-2" for="projectSelect">Project:</label>
                        </th>
                        <td class="govuk-table__cell govuk-!-padding-bottom-0 govuk-!-padding-top-0 govuk-!-padding-right-1 isNoBottomBorder govuk-!-text-align-right">
                            <select id="projectSelect" asp-items="Model.ProjectList" asp-for="SelectedProjectCode"
                                    class="govuk-select govuk-!-font-size-16 govuk-input--width-10">
                                <option value="">-- Select Project --</option>
                            </select>                            
                        </td>
                        <td class="govuk-table__cell govuk-!-padding-bottom-0 govuk-!-padding-top-0 govuk-!-padding-right-1 isNoBottomBorder govuk-!-text-align-right">
                            <a asp-area="FPS" asp-controller="ProgramProject" asp-action="Index" class="govuk-back-link">Back</a>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Summary card -->
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-full mt-2">
            <div class="pva-summary-card" style="background-color:#edf4ff; border:1px solid #1d70b8; border-radius:5px; padding:8px;">
                <div class="row">
                    <div class="col-lg-6">
                        <div class="row">
                            <div class="col-lg-5">
                                <label class="govuk-label--s" for="summary-project-code">Project</label>
                                <input type="text" id="summary-project-code" asp-for="SelectedProjectCode"
                                       class="govuk-input" readonly>
                            </div>
                            <div class="col-lg-7">
                                <label class="govuk-label--s" for="summary-project-description">Project Description</label>
                                <input type="text" id="summary-project-description" asp-for="ProjectTitle"
                                       class="govuk-input" readonly>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-6">
                        <div class="row">
                            <div class="col-lg-5">
                                <label class="govuk-label--s" for="summary-program">Program</label>
                                <input type="text" id="summary-program" asp-for="Program"
                                       class="govuk-input" readonly>
                            </div>
                            <div class="col-lg-7">
                                <label class="govuk-label--s" for="summary-contract">Contract</label>
                                <input type="text" id="summary-contract" asp-for="Contract"
                                       class="govuk-input" readonly>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Two-column grid area -->
    <div class="govuk-grid-row">
        <!-- Left: Planned Time -->
        <div class="govuk-grid-column-one-half mt-2">
            <div class="govuk-grid-row">
                <div class="govuk-grid-column-full mt-2">
                    <div id="gridContainer_@Model.StaffPlanGrid.GridId" style="padding: 5px;">
                        @await Html.PartialAsync("_DataGrid", Model.StaffPlanGrid)
                    </div>
                </div>
                <div class="govuk-grid-column-full mt-2">
                    <div class="financial-summary mt-1" style="padding: 0 5px;">
                        <div style="display:flex; align-items:center;">
                            <span class="govuk-label--s" style="margin-left:auto; margin-right:8px; white-space:nowrap;">Total Planned Cost:</span>
                            <div class="govuk-input__wrapper" style="margin-right:75px;">
                                <div class="govuk-input__prefix" aria-hidden="true">£</div>
                                <input type="text" id="planned-total-cost" readonly
                                       class="govuk-input text-AlignRight"
                                       value="@(Model.TotalPlannedCost.ToString("N2"))" style="width:140px;">
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right: Actual Time -->
        <div class="govuk-grid-column-one-half mt-2">
            <div class="govuk-grid-row">
                <div class="govuk-grid-column-full mt-2">
                    <div id="gridContainer_@Model.CompareStaff2Grid.GridId" style="padding: 5px;">
                        @await Html.PartialAsync("_DataGrid", Model.CompareStaff2Grid)
                    </div>
                </div>
                <div class="govuk-grid-column-full mt-2">
                    <div class="financial-summary mt-1" style="padding: 0 5px;">
                        <div style="display:flex; align-items:center; margin-bottom:4px;">
                            <span class="govuk-label--s" style="margin-left:auto; margin-right:8px; white-space:nowrap;">Totals:</span>
                            <input type="text" id="project-total-hrs" readonly
                                   class="govuk-input text-AlignRight"
                                   value="@(Model.TotalActualHrs.ToString("F2"))" style="width:90px; margin-right:4px;"
                                   aria-label="Total Hrs">
                            <div class="govuk-input__wrapper">
                                <div class="govuk-input__prefix" aria-hidden="true">£</div>
                                <input type="text" id="project-total-cost" readonly
                                       class="govuk-input text-AlignRight"
                                       value="@(Model.TotalActualCost.ToString("N0"))" style="width:110px;"
                                       aria-label="Total Actual Cost">
                            </div>
                        </div>
                        <div style="display:flex; align-items:center;">
                            <span class="govuk-label--s" style="margin-left:auto; margin-right:8px; white-space:nowrap;">Percent of Plan:</span>
                            <input type="text" id="project-percent-plan" readonly
                                   class="govuk-input text-AlignRight"
                                   value="@(Model.PercentOfPlan.ToString("F0"))%" style="width:110px;"
                                   aria-label="Percent of Plan">
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/ajax-form-validation.js"></script>
    <script src="~/js/fps_js/StaffJob.js"></script>
    <script>
        var currentProjectCode = '@Html.Raw(Model.SelectedProjectCode)';

        StaffJobConfig.getJobCode = function () { return currentProjectCode; };
        StaffJobConfig.requireJobCodeForAdd = true;
        StaffJobConfig.onSaved = function () {
            window['gridManager_@Model.StaffPlanGrid.GridId'].reloadGrid({ page: 1 });
            refreshPlannedCost();
        };
        StaffJobConfig.onUpdated = function () {
            window['gridManager_@Model.StaffPlanGrid.GridId'].reloadGrid({ page: 1 });
            refreshPlannedCost();
        };
        StaffJobConfig.onDeleted = function () {
            window['gridManager_@Model.StaffPlanGrid.GridId'].reloadGrid({ page: 1 });
            refreshPlannedCost();
        };

        $(document).ready(function () {
            if (currentProjectCode) {
                window['gridManager_@Model.StaffPlanGrid.GridId'].reloadGrid({ page: 1 });
                window['gridManager_@Model.CompareStaff2Grid.GridId'].reloadGrid({ page: 1 });
                refreshPlannedCost();
                refreshActualTotals();
            }

            var actualGridContainer = document.getElementById('gridContainer_@Model.CompareStaff2Grid.GridId');
            if (actualGridContainer) {
                new MutationObserver(function () {
                    refreshActualTotals();
                }).observe(actualGridContainer, { childList: true, subtree: true });
            }
        });

        $('#projectSelect').on('change', function () {
            currentProjectCode = $(this).val();
            // Persist project code to session
            $.ajax({
                url: '@Url.Action("SaveProjectSession", "ProgramProject", new { area = "FPS" })',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(currentProjectCode)
            });
            $('#summary-project-code').val(currentProjectCode);
            $('#summary-project-description').val('');
            $('#summary-program').val('');
            $('#summary-contract').val('');
            $('#planned-total-cost').val('0.00');
            $('#project-total-hrs').val('0.00');
            $('#project-total-cost').val('0');
            $('#project-percent-plan').val('0%');

            if (currentProjectCode) {
                $.get('@Url.Action("GetProjectInfo", "ProjectStaffPlanActual", new { area = "FPS" })',
                    { projectCode: currentProjectCode },
                    function (result) {
                        if (result.success) {
                            $('#summary-project-description').val(result.projectTitle);
                            $('#summary-program').val(result.program);
                            $('#summary-contract').val(result.contract);
                        }
                    }
                );

                window['gridManager_@Model.StaffPlanGrid.GridId'].reloadGrid({ page: 1 });
                window['gridManager_@Model.CompareStaff2Grid.GridId'].reloadGrid({ page: 1 });
                refreshPlannedCost();
                refreshActualTotals();
            }
        });

        function getStaffPlanExtraFilters() {
            return { jobCode: currentProjectCode };
        }

        function getCompareStaff2ExtraFilters() {
            return { projectCode: currentProjectCode };
        }

        function refreshPlannedCost() {
            if (!currentProjectCode) return;
            $.get('@Url.Action("GetTotalPlannedCost", "ProjectStaffPlanActual", new { area = "FPS" })',
                { projectCode: currentProjectCode },
                function (result) {
                    if (result.success) {
                        $('#planned-total-cost').val(formatCurrency(result.totalPlannedCost));
                        calculatePercentOfPlan();
                    }
                }
            );
        }

        function refreshActualTotals() {
            if (!currentProjectCode) return;
            $.get('@Url.Action("GetTotalActualCost", "ProjectStaffPlanActual", new { area = "FPS" })',
                { projectCode: currentProjectCode },
                function (result) {
                    if (result.success) {
                        $('#project-total-hrs').val(parseFloat(result.totalHours || 0).toFixed(2));
                        $('#project-total-cost').val(formatCurrency(result.totalCost));
                        calculatePercentOfPlan();
                    }
                }
            );
        }

        function formatCurrency(value) {
            return parseFloat(value || 0).toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ',');
        }

        function calculatePercentOfPlan() {
            var plannedRaw = parseFloat($('#planned-total-cost').val().replace(/[£,\s]/g, '')) || 0;
            var actualRaw = parseFloat($('#project-total-cost').val().replace(/[£,\s]/g, '')) || 0;
            var pct = plannedRaw > 0 ? (actualRaw / plannedRaw) * 100 : 0;
            $('#project-percent-plan').val(Math.round(pct) + '%');
        }

        function deleteCompareStaff2(btn) {
            var rowKey = $(btn).data('id');
            if (!rowKey) return;
            showGovukConfirm('Are you sure you want to delete this record?').then(function (confirmed) {
                if (!confirmed) return;
                $.ajax({
                    url: '@Url.Action("DeleteTimeCostCalcs", "ProjectStaffPlanActual", new { area = "FPS" })',
                    type: 'DELETE',
                    data: { rowKey: rowKey },
                    success: function (result) {
                        if (result.success) {
                            window['gridManager_@Model.CompareStaff2Grid.GridId'].reloadGrid({ page: 1 });
                            refreshActualTotals();
                            showAlertMessage('Record deleted successfully.', AlertType.SUCCESS);
                        } else {
                            showAlertMessage('Delete failed: ' + (result.message || 'Unknown error'), AlertType.ERROR);
                        }
                    },
                    error: function () {
                        showAlertMessage('An error occurred while deleting the record.', AlertType.ERROR);
                    }
                });
            });
        }
    </script>
}

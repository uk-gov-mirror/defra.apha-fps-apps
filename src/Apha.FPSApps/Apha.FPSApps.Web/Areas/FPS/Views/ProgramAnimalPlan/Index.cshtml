    <!-- Title section -->
    @* <div class="govuk-grid-row">
        <div class="govuk-grid-column-full">
            <h1 class="govuk-heading-s sup_border-bottom govuk-!-margin-top-2 govuk-!-padding-bottom-2 govuk-!-padding-left-4">Plan All Animal Costs for Programme</h1>
        </div>
    </div> *@

    <div class="govuk-grid-row">
        <div class="govuk-grid-column-one-full isClearFix sup_border-bottom">
            <div class="govuk-grid-column-one-half isFloatLeft">
                <h1 class="govuk-grid-row govuk-heading-s govuk-!-margin-bottom-0 govuk-!-margin-left-0 isCustomPageHeadings">Plan All Animal Costs for Programme</h1>
            </div>

            <div class="govuk-grid-column-one-half isFloatRight">
                <table class="govuk-table govuk-!-margin-bottom-0 govuk-!-margin-top-2 isFloatRight isHalfGrid isPlanAllAnimalCosts">
                    <tbody class="govuk-table__body">
                        <tr class="govuk-table__row">
                            <th scope="row" class="govuk-table__header govuk-!-padding-bottom-0 govuk-!-padding-top-0 govuk-!-padding-right-0 isNoBottomBorder govuk-!-text-align-right">
                                <label class="fw-bold me-2" for="programmeSelect">Programme:</label>
                            </th>
                            <td class="govuk-table__cell govuk-!-padding-bottom-0 govuk-!-padding-top-0 govuk-!-padding-right-1 isNoBottomBorder govuk-!-text-align-right">
                                <select id="programmeSelect" asp-items="Model.ProgrammeList" asp-for="SelectedProgramNo" class="govuk-select govuk-!-font-size-16 govuk-input--width-20">
                                    <option value="">-- Select Project --</option>
                                </select>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="govuk-grid-row">
        <div class="govuk-grid-column-one-half mt-2">
            <div class="" style="border-radius: 5px; justify-content: flex-start; margin-bottom:10px; background-color: #edf4ff; border: 1px solid #1d70b8; padding: 4px;">
                <div class="row">
                    <div class="col-lg-7">
                        <label class="govuk-label--s" for="managerName" style="color:#3e3e3e">Programme Manager</label>
                        <input type="text" value="@Model.Manager" id="managerName" class="projectplan-code govuk-input" readonly>
                    </div>
                    <div class="col-lg-5">
                        <label class="govuk-label--s" for="Target" style="color:#3e3e3e">Target</label>
                        <div class="govuk-input__wrapper">
                            <div class="govuk-input__prefix" aria-hidden="true">£</div>
                            <input type="text" value="@Model.Target.ToString("N2")" id="Target" readonly class="projectplan-code govuk-input">
                        </div>
                    </div>
                </div>
            </div>
            <div class="govuk-grid-row">
                <div class="govuk-grid-column-full mt-2">
                    <div id="gridContainer_@Model.ProjectsGrid.GridId" style="padding: 5px;">
                        @await Html.PartialAsync("_DataGrid", Model.ProjectsGrid)
                    </div>
                </div>
            </div>
        </div>
        <div class="govuk-grid-column-one-half mt-2">
            <div class="" style="border-radius: 5px; justify-content: flex-start; margin-bottom: 10px; background-color: #edf4ff; border: 1px solid #1d70b8; padding: 4px;">
                <div class="row">
                    <div class="col-lg-12">
                        <label class="govuk-label--s" for="txtSelectedProject" style="color:#3e3e3e">Animal Plan for</label>
                        <input type="text" id="txtSelectedProject" value="" readonly class="projectplan-code govuk-input">
                        <input type="hidden" id="hdnJobCode" value="" />
                    </div>
                </div>
            </div>
            <div class="govuk-grid-row">
                <div class="govuk-grid-column-full mt-2">
                    <div id="gridContainer_@Model.AnimalCostGrid.GridId" style="padding: 5px;">
                        @await Html.PartialAsync("_DataGrid", Model.AnimalCostGrid)
                    </div>
                </div>
                <div class="govuk-grid-column-full mt-2">
                    <div class="financial-summary mt-2">
                        <div class="summary-row">
                            <div class="summary-item">
                                <label class="govuk-label--s" for="for_project">For Project:</label>
                                <input type="text" aria-label="for_project" id="for_project" readonly class="govuk-input">
                            </div>
                            <div class="summary-item">
                                <label class="govuk-label--s" for="Animal_Cost">Animal Cost:</label>
                                <div class="govuk-input__wrapper">
                                    <div class="govuk-input__prefix" aria-hidden="true">£</div>
                                    <input type="text" aria-label="Animal_Cost" id="Animal_Cost" readonly class="govuk-input text-AlignRight" value="@Model.AnimalCost.ToString("N2")">
                                </div>
                            </div>
                            <div class="summary-item">
                                <label class="govuk-label--s" for="BudgetCVL">Predicted Income:</label>
                                <div class="govuk-input__wrapper">
                                    <div class="govuk-input__prefix" aria-hidden="true">£</div>
                                    <input type="text" value="0" aria-label="BudgetCVL" id="BudgetCVL" readonly class="govuk-input text-AlignRight">
                                </div>
                            </div>
                            <div class="summary-item">
                                <label class="govuk-label--s" for="Remainder">Remainder:</label>
                                <div class="govuk-input__wrapper">
                                    <div class="govuk-input__prefix" aria-hidden="true">£</div>
                                    <input type="text" value="0" aria-label="Remainder" id="Remainder" readonly class="govuk-input text-AlignRight">
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script src="~/js/ajax-form-validation.js"></script>
    <script src="~/js/fps_js/AnimalJob.js"></script>
    <script>
        var currentProgramNo = '@Html.Raw(Model.SelectedProgramNo)';
        var currentJobCode = '';

        AnimalJobConfig.getJobCode = function () { return currentJobCode; };
        AnimalJobConfig.requireJobCodeForAdd = true;
        AnimalJobConfig.onSaved = function () { window['gridManager_@Model.AnimalCostGrid.GridId'].reloadGrid({ page: 1 }); };
        AnimalJobConfig.onUpdated = function () { window['gridManager_@Model.AnimalCostGrid.GridId'].reloadGrid({ page: 1 }); };
        AnimalJobConfig.onDeleted = function () { window['gridManager_@Model.AnimalCostGrid.GridId'].reloadGrid({ page: 1 }); };

        $(document).ready(function () {
            if (currentProgramNo) {
                window['gridManager_@Model.ProjectsGrid.GridId'].reloadGrid({ page: 1 });
            }

            var animalGridContainer = document.getElementById('gridContainer_@Model.AnimalCostGrid.GridId');
            if (animalGridContainer) {
                new MutationObserver(function () {
                    calculateAnimalCostTotal();
                }).observe(animalGridContainer, { childList: true });
            }

            document.addEventListener('gridReloaded', function (e) {
                if (e.detail.gridId === '@Model.ProjectsGrid.GridId') {
                    var firstRow = $('#tbl_@Model.ProjectsGrid.GridId tbody tr.selectable-row:first');
                    if (firstRow.length) {
                        firstRow.trigger('click');
                    }
                }
            });

            var animalGridEl = document.getElementById('gridContainer_@Model.AnimalCostGrid.GridId');
            if (animalGridEl) {
                animalGridEl.addEventListener('click', function (e) {
                    if (!currentJobCode && (e.target.closest('.sortable-header') || e.target.closest('.pagination a'))) {
                        e.stopImmediatePropagation();
                        e.preventDefault();
                    }
                }, true);
            }
        });

        $('#programmeSelect').on('change', function () {
            const val = $(this).val();
            if (!val) return;
            currentProgramNo = val;
            // Persist selection to session for other pages
            $.ajax({
                url: '@Url.Action("SaveProgrammeSession", "ProgrammeSelect", new { area = "FPS" })',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(val)
            });
            currentJobCode = '';
            $('#hdnJobCode').val('');
            $('#txtSelectedProject').val('');
            $('#for_project').val('');
            $('#Animal_Cost').val('');
            $('#BudgetCVL').val('0');
            $('#Remainder').val('0');

            if (currentProgramNo) {
                $.get('@Url.Action("GetProgramInfo", "ProgramAnimalPlan", new { area = "FPS" })',
                    { programNo: currentProgramNo },
                    function (result) {
                        if (result.success) {
                            $('#managerName').val(result.manager);
                            $('#Target').val(formatCurrency(result.target));
                        }
                    }
                );
            }

            window['gridManager_@Model.ProjectsGrid.GridId'].reloadGrid({ page: 1 });
        });

        function selectProject(btn) {
            var jobCode = $(btn).data('id');
            var row = $(btn).closest('tr');
            var budgetText = row.find('td[data-property="BudgetCvl"] span').text().replace(/[£,\s]/g, '');
            var budget = parseFloat(budgetText) || 0;

            currentJobCode = jobCode;
            $('#hdnJobCode').val(jobCode);
            $('#txtSelectedProject').val(jobCode);
            $('#for_project').val(jobCode);
            $('#BudgetCVL').val(formatCurrency(budget));
            $('#Animal_Cost').val(formatCurrency(0));
            setRemainder(budget);

            $('#tbl_@Model.ProjectsGrid.GridId tbody tr').removeClass('selected-row');
            row.addClass('selected-row');

            $.get('@Url.Action("GetTotalAnimalCost", "AnimalJob", new { area = "FPS" })',
                { jobCode: jobCode },
                function (result) {
                    if (result.success) {
                        var total = parseFloat(result.totalAnimalCost) || 0;
                        $('#Animal_Cost').val(formatCurrency(total));
                        setRemainder(budget - total);
                    }
                }
            );

            window['gridManager_@Model.AnimalCostGrid.GridId'].reloadGrid({ page: 1 });
        }

        function getProjectExtraFilters() {
            return { programNo: currentProgramNo };
        }

        function calculateAnimalCostTotal() {
            if (!currentJobCode) { return; }

            var total = 0;
            $('#gridContainer_@Model.AnimalCostGrid.GridId td[data-property="AnimalCost"] span').each(function () {
                var value = parseFloat($(this).text().replace(/[£,\s]/g, '')) || 0;
                total += value;
            });

            $('#Animal_Cost').val(formatCurrency(total));

            var budget = parseFloat($('#BudgetCVL').val().replace(/[£,\s]/g, '')) || 0;
            setRemainder(budget - total);
        }

        function formatCurrency(value) {
            return parseFloat(value || 0).toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ',');
        }

        function setRemainder(value) {
            var num = parseFloat(value) || 0;
            var el = document.getElementById('Remainder');
            if (num < 0) {
                el.value = '-(' + formatCurrency(Math.abs(num)) + ')';
                el.style.color = 'red';
            } else {
                el.value = formatCurrency(num);
                el.style.color = 'blue';
            }
        }
    </script>
}

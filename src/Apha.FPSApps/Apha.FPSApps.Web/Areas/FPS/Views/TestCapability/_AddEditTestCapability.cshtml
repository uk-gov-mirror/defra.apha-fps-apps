@model Apha.FPSApps.Web.Areas.FPS.Models.TestCapabilityItem
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    var isEdit = !string.IsNullOrEmpty(Model.TestCode) && !string.IsNullOrEmpty(Model.WorkGroup);
    var workGroupOptions = ViewBag.WorkGroupOptions as List<SelectListItem> ?? new List<SelectListItem>();
    var testorProductOptions = ViewBag.TestorProductOptions as List<SelectListItem> ?? new List<SelectListItem>();
    var testorProductUnitCosts = ViewBag.TestorProductUnitCosts as Dictionary<string, decimal?> ?? new Dictionary<string, decimal?>();
}

<div class="modal-header flex-space-center">
    <h3 class="govuk-heading-s" style="margin:0;">@(isEdit ? "Edit Portfolio Component" : "Add Portfolio Component")</h3>
    <button type="button" class="btn-close" onclick="$('#modalPopup').removeClass('show')">×</button>
</div>

<div class="modal-body" style="overflow:hidden; padding:8px 8px 0 8px;">
    <form id="testCapabilityForm" class="govuk-grid-column-full" data-mode="@(isEdit ? "edit" : "add")">

        <input type="hidden" name="PlanPortfolio" value="@Model.PlanPortfolio" />
        <input type="hidden" name="FpsYear" value="@Model.FpsYear" />
        @if (isEdit)
        {
            <input type="hidden" name="OriginalWorkGroup" value="@Model.WorkGroup" />
        }

        <!-- Validation error summary -->
        <div class="govuk-error-summary" role="alert"
             aria-labelledby="tc-error-title" tabindex="-1" style="display:none;">
            <h2 class="govuk-error-summary__title" id="tc-error-title">There is a problem</h2>
            <div class="govuk-error-summary__body">
                <ul class="govuk-list govuk-error-summary__list"></ul>
            </div>
        </div>

        <!-- Row 1: Test Code | Work Group -->
        <div class="govuk-grid-row">
            <div class="govuk-grid-column-one-half">
                <div class="govuk-form-group sup_margin_bottom_10">
                    <label class="govuk-label govuk-!-font-weight-bold" for="TestCode">Test Code <span class="sup_color_red">*</span></label>
                    @if (isEdit)
                    {
                        <input type="hidden" name="TestCode" value="@Model.TestCode" />
                        <input class="govuk-input govuk-!-font-size-16" id="TestCode"
                               value="@Model.TestCode" readonly
                               style="width:100%; background-color:#f3f2f1; cursor:default;" />
                    }
                    else
                    {
                        <select class="govuk-select govuk-!-font-size-16" id="TestCode" name="TestCode"
                                style="width:100%;" required onchange="onTestCodeSelected(this.value)">
                            <option value="">-- Select Test Code --</option>
                            @foreach (var opt in testorProductOptions)
                            {
                                var sepIdx = opt.Text.IndexOf(" \u2013 ");
                                var optDesc = sepIdx >= 0 ? opt.Text.Substring(sepIdx + 3) : "";
                                var optUnitCost = testorProductUnitCosts.TryGetValue(opt.Value, out var uc) && uc.HasValue
                                    ? uc.Value.ToString("F2")
                                    : "";
                                if (opt.Value == Model.TestCode)
                                {
                                    <option value="@opt.Value" data-description="@optDesc" data-unitcost="@optUnitCost" selected>@opt.Value</option>
                                }
                                else
                                {
                                    <option value="@opt.Value" data-description="@optDesc" data-unitcost="@optUnitCost">@opt.Value</option>
                                }
                            }
                        </select>
                        <span data-valmsg-for="TestCode"
                              class="govuk-error-message field-validation-valid" style="display:none;"></span>
                    }
                </div>
            </div>
            <div class="govuk-grid-column-one-half">
                <div class="govuk-form-group sup_margin_bottom_10">
                    <label class="govuk-label govuk-!-font-weight-bold" for="WorkGroup">Work Group <span class="sup_color_red">*</span></label>
                    @if (isEdit)
                    {
                        var selectedWorkGroupText = workGroupOptions
                            .FirstOrDefault(o => o.Value == Model.WorkGroup)?.Text ?? Model.WorkGroup;
                        <input type="hidden" name="WorkGroup" value="@Model.WorkGroup" />
                        <input class="govuk-input govuk-!-font-size-16" id="WorkGroup"
                               value="@selectedWorkGroupText" readonly
                               style="width:100%; background-color:#f3f2f1; cursor:default;" />
                    }
                    else
                    {
                        <select class="govuk-select govuk-!-font-size-16" id="WorkGroup" name="WorkGroup"
                                style="width:100%;" required>
                            <option value="">-- Select Work Group --</option>
                            @foreach (var opt in workGroupOptions)
                            {
                                if (opt.Value == Model.WorkGroup)
                                {
                                    <option value="@opt.Value" selected>@opt.Text</option>
                                }
                                else
                                {
                                    <option value="@opt.Value">@opt.Text</option>
                                }
                            }
                        </select>
                        <span data-valmsg-for="WorkGroup"
                              class="govuk-error-message field-validation-valid" style="display:none;"></span>
                    }
                </div>
            </div>
        </div>

        <!-- Row 2: Description (readonly) -->
        <div class="govuk-grid-row">
            <div class="govuk-grid-column-full">
                <div class="govuk-form-group sup_margin_bottom_10">
                    <label class="govuk-label govuk-!-font-weight-bold" for="ItemDescriptionDisplay">Description</label>
                    <input class="govuk-input govuk-!-font-size-16" id="ItemDescriptionDisplay"
                           value="@(Model.ItemDescription ?? "")" readonly
                           style="background-color:#f3f2f1; cursor:default;" />
                </div>
            </div>
        </div>

        <!-- Row 3: Unit Cost -->
        <div class="govuk-grid-row">
            <div class="govuk-grid-column-one-half">
                <div class="govuk-form-group sup_margin_bottom_10">
                    <label class="govuk-label govuk-!-font-weight-bold" for="UnitCost">Unit Cost</label>
                    <div class="govuk-input__wrapper">
                        <div class="govuk-input__prefix" aria-hidden="true">£</div>
                        @if (isEdit)
                        {
                            <input class="govuk-input govuk-!-font-size-16 js-numeric-decimal" id="UnitCost" name="UnitCost"
                                   type="text" maxlength="20"
                                   value="@(Model.UnitCost.HasValue ? Model.UnitCost.Value.ToString() : "")" />
                        }
                        else
                        {
                            <input class="govuk-input govuk-!-font-size-16" id="UnitCost" name="UnitCost"
                                   type="number" step="0.01" min="0" readonly
                                   style="background-color:#f3f2f1; cursor:default;"
                                   value="@(Model.UnitCost.HasValue ? Model.UnitCost.Value.ToString() : "")" />
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Row 4: SOP | SMS Code -->
        <div class="govuk-grid-row">
            <div class="govuk-grid-column-one-half">
                <div class="govuk-form-group sup_margin_bottom_10">
                    <label class="govuk-label govuk-!-font-weight-bold" for="Sop">SOP</label>
                    <input class="govuk-input govuk-!-font-size-16" id="Sop" name="Sop"
                           value="@(Model.Sop ?? "")" maxlength="50" />
                </div>
            </div>
            <div class="govuk-grid-column-one-half">
                <div class="govuk-form-group sup_margin_bottom_10">
                    <label class="govuk-label govuk-!-font-weight-bold" for="SmsCode">SMS Code</label>
                    <input class="govuk-input govuk-!-font-size-16" id="SmsCode" name="SmsCode"
                           value="@(Model.SmsCode ?? "")" maxlength="50" />
                </div>
            </div>
        </div>

    </form>
</div>

<div class="modal-footer" style="display:flex; justify-content:space-between; align-items:center;">
    <button type="button" class="govuk-button govuk-button--secondary sup_margin_0"
            onclick="$('#modalPopup').removeClass('show')">Cancel</button>
    <button type="button" class="govuk-button sup_margin_0" onclick="saveTestCapability()" allow-edit="true">
        @(isEdit ? "Update" : "Save")
    </button>
</div>

<script>
    function onTestCodeSelected(value) {
        if (!value) {
            $('#ItemDescriptionDisplay').val('');
            $('#UnitCost').val('');
            return;
        }
        var selectedOption = $('#TestCode option:selected');
        $('#ItemDescriptionDisplay').val(selectedOption.data('description') || '');
        $('#UnitCost').val(selectedOption.data('unitcost') || '');
    }
</script>

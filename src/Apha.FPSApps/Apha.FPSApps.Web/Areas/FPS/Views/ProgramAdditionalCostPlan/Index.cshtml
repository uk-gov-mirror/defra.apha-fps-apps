@using Apha.FPSApps.Web.Models.Components.DataGrid
@model Apha.FPSApps.Web.Areas.FPS.Models.ProgramAddCostPlanViewModel
@{
    ViewData["Title"] = "Programme Additional Cost Plan";
}

<style type="text/css">
    #gridContainer_@Model.AdditionalCostGrid.GridId .grid-scroll-container {
        height: 255px;
        max-height: 255px;
    }   
</style>

<div class="container-fluid">
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-full">
            <div style="padding: 5px 5px; border-bottom: 1px solid #b4b4b4" class="row">
                <div style="display: flex; font-size: 14px; align-items: center; justify-content: space-between;">
                    <div class="col-md-6">
                        
                    </div>
                    <div style="display: flex; justify-content: flex-end;" class="col-md-6">
                        <label class="fw-bold mt-2" for="programmeSelect">Programme:</label>
                        <select id="programmeSelect" asp-items="Model.ProgrammeList" asp-for="SelectedProgramNo"
                                class="govuk-select govuk-!-font-size-16" style="width: auto; min-width: 260px;">
                            <option value="">-- Select Programme --</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="govuk-grid-row">
        <div class="govuk-grid-column-full">
            <h1 class="govuk-heading-s sup_border-bottom govuk-!-margin-top-2 govuk-!-padding-bottom-2 govuk-!-padding-left-4">Plan All Additional Costs for Programme</h1>
        </div>
    </div>

    <div class="govuk-grid-row">
        <div class="govuk-grid-column-one-half mt-2">
            <div class="" style="border-radius: 5px; justify-content: flex-start; margin-bottom: 10px; background-color: #edf4ff; border: 1px solid #1d70b8; padding: 4px;">
                <div class="row">
                    <div class="col-lg-7">
                        <label class="govuk-label--s" for="managerName" style="color:#3e3e3e">Programme Manager</label>
                        <input type="text" value="@Model.Manager" id="managerName" readonly class="projectplan-code govuk-input" readonly>
                    </div>
                    <div class="col-lg-5">
                        <label class="govuk-label--s" for="Target" style="color:#3e3e3e">Target</label>
                        <div class="govuk-input__wrapper">
                            <div class="govuk-input__prefix" aria-hidden="true">£</div>
                            <input type="text" value="@Model.Target.ToString("N2")" id="Target" readonly class="projectplan-code govuk-input">
                        </div>
                    </div>

                   
                </div>
            </div>
            <div class="govuk-grid-row">
                <div class="govuk-grid-column-full mt-2">
                    <div id="gridContainer_@Model.ProjectsGrid.GridId" style="padding: 5px;">
                        @await Html.PartialAsync("_DataGrid", Model.ProjectsGrid)
                    </div>
                </div>
            </div>
        </div>

        <div class="govuk-grid-column-one-half mt-2">
            <div class="" style="border-radius: 5px; justify-content: flex-start; margin-bottom: 10px; background-color: #edf4ff; border: 1px solid #1d70b8; padding: 4px;">
                <div class="row">
                    <div class="col-lg-12">
                        <label class="govuk-label--s" for="txtSelectedProject" style="color:#3e3e3e">Additional Cost Plan for</label>
                        <input type="text" id="txtSelectedProject" value="" readonly class="projectplan-code govuk-input">
                        <input type="hidden" id="hdnJobCode" value="" />
                        <input type="hidden" id="hdnAccount" value="" />
                    </div>
                </div>
            </div>
            <div class="govuk-grid-row">
                <div class="govuk-grid-column-full mt-2">
                    <div id="gridContainer_@Model.AdditionalCostGrid.GridId" style="padding: 5px;">
                        @await Html.PartialAsync("_DataGrid", Model.AdditionalCostGrid)
                    </div>
                </div>
                <div class="govuk-grid-column-full mt-2">
                    <div class="financial-summary mt-2">
                        <div class="summary-row">
                            <div class="summary-item">
                                <label class="govuk-label--s" for="for_project">For Project:</label>
                                <input type="text" aria-label="for_project" id="for_project" readonly class="govuk-input">
                            </div>
                            <div class="summary-item">
                                <label class="govuk-label--s" for="Additional_Cost">Additional Cost:</label>
                                <div class="govuk-input__wrapper">
                                    <div class="govuk-input__prefix" aria-hidden="true">£</div>
                                    <input type="text" aria-label="Additional_Cost" id="Additional_Cost" readonly class="govuk-input text-AlignRight" value="@Model.AddCosts.ToString("N2")">
                                </div>
                            </div>
                            <div class="summary-item">
                                <label class="govuk-label--s" for="BudgetCVL">Budget:</label>
                                <div class="govuk-input__wrapper">
                                    <div class="govuk-input__prefix" aria-hidden="true">£</div>
                                    <input type="text" value="0" aria-label="BudgetCVL" id="BudgetCVL" readonly class="govuk-input text-AlignRight">
                                </div>
                            </div>
                            <div class="summary-item">
                                <label class="govuk-label--s" for="Remainder">Remainder:</label>
                                <div class="govuk-input__wrapper">
                                    <div class="govuk-input__prefix" aria-hidden="true">£</div>
                                    <input type="text" value="0" aria-label="Remainder" id="Remainder" readonly class="govuk-input text-AlignRight">
                                </div>
                            </div>
                        </div>                      
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/ajax-form-validation.js"></script>
    <script src="~/js/fps_js/AdditionalCost.js" asp-append-version="true"></script>
    <script>
        var currentProgramNo = '@Html.Raw(Model.SelectedProgramNo)';
        var currentJobCode = '';

        AdditionalCostConfig.getJobCode = function () { return currentJobCode; };
        AdditionalCostConfig.requireJobCodeForAdd = true;
        AdditionalCostConfig.onSaved   = function () { window['gridManager_@Model.AdditionalCostGrid.GridId'].reloadGrid({ page: 1 }); };
        AdditionalCostConfig.onUpdated = function () { window['gridManager_@Model.AdditionalCostGrid.GridId'].reloadGrid({ page: 1 }); };
        AdditionalCostConfig.onDeleted = function () { window['gridManager_@Model.AdditionalCostGrid.GridId'].reloadGrid({ page: 1 }); };

        $(document).ready(function () {
            if (currentProgramNo) {
                showLoader();
                setTimeout(function () {
                    window['gridManager_@Model.ProjectsGrid.GridId'].reloadGrid({ page: 1 });
                }, 0);
            }

            var costGridContainer = document.getElementById('gridContainer_@Model.AdditionalCostGrid.GridId');
            if (costGridContainer) {
                new MutationObserver(function () {
                    calculateAdditionalCost();
                }).observe(costGridContainer, { childList: true });
            }

            document.addEventListener('gridReloaded', function (e) {
                if (e.detail.gridId === '@Model.ProjectsGrid.GridId') {
                    var firstRow = $('#tbl_@Model.ProjectsGrid.GridId tbody tr.selectable-row:first');
                    if (firstRow.length) {
                        firstRow.trigger('click');
                    } else {
                        hideLoader();
                    }
                }
                if (e.detail.gridId === '@Model.AdditionalCostGrid.GridId') {
                    hideLoader();
                }
            });

            var costGridEl = document.getElementById('gridContainer_@Model.AdditionalCostGrid.GridId');
            if (costGridEl) {
                costGridEl.addEventListener('click', function (e) {
                    if (!currentJobCode && (e.target.closest('.sortable-header') || e.target.closest('.pagination a'))) {
                        e.stopImmediatePropagation();
                        e.preventDefault();
                    }
                }, true);
            }
        });

        $('#programmeSelect').on('change', function () {
            const val = $(this).val();
            if (!val) return;
            currentProgramNo = val;
            // Persist selection to session for other pages
            $.ajax({
                url: '@Url.Action("SaveProgrammeSession", "ProgrammeSelect", new { area = "FPS" })',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(val)
            });
            currentJobCode = '';
            $('#hdnJobCode').val('');
            $('#txtSelectedProject').val('');
            $('#for_project').val('');
            $('#Additional_Cost').val('');
            $('#BudgetCVL').val('');
            $('#Remainder').val('');

            if (currentProgramNo) {
                $.get('@Url.Action("GetProgramInfo", "ProgramAdditionalCostPlan", new { area = "FPS" })',
                    { programNo: currentProgramNo },
                    function (result) {
                        if (result.success) {
                            $('#managerName').val(result.manager);
                            $('#Target').val(formatCurrency(result.target));
                        }
                    }
                );
            }

            showLoader();
            setTimeout(function () {
                window['gridManager_@Model.ProjectsGrid.GridId'].reloadGrid({ page: 1 });
            }, 0);
        });

        function selectProject(btn) {
            var jobCode = $(btn).data('id');
            var row = $(btn).closest('tr');
            var budgetText = row.find('td[data-property="BudgetCvl"] span').text().replace(/[£,\s]/g, '');
            var budget = parseFloat(budgetText) || 0;

            currentJobCode = jobCode;
            $('#hdnJobCode').val(jobCode);
            $('#txtSelectedProject').val(jobCode);
            $('#for_project').val(jobCode);
            $('#BudgetCVL').val(formatCurrency(budget));
            $('#Additional_Cost').val(formatCurrency(0));
            setRemainder(budget);

            $('#tbl_@Model.ProjectsGrid.GridId tbody tr').removeClass('selected-row');
            row.addClass('selected-row');

            $.get('@Url.Action("GetTotalItemCost", "AdditionalCostJob", new { area = "FPS" })',
                { jobCode: jobCode },
                function (result) {
                    if (result.success) {
                        var total = parseFloat(result.totalItemCost) || 0;
                        $('#Additional_Cost').val(formatCurrency(total));
                        setRemainder(budget - total);
                    }
                }
            );

            showLoader();
            setTimeout(function () {
                window['gridManager_@Model.AdditionalCostGrid.GridId'].reloadGrid({ page: 1 });
            }, 0);
        }

        function getProjectExtraFilters() {
            return { programNo: currentProgramNo };
        }

        function calculateAdditionalCost() {
            if (!currentJobCode) { return; }

            var total = 0;
            $('#gridContainer_@Model.AdditionalCostGrid.GridId td[data-property="ItemCost"] span').each(function () {
                var value = parseFloat($(this).text().replace(/[£,\s]/g, '')) || 0;
                total += value;
            });

            $('#Additional_Cost').val(formatCurrency(total));
            var budget = parseFloat($('#BudgetCVL').val().replace(/[£,\s]/g, '')) || 0;
            setRemainder(budget - total);
        }

        function formatCurrency(value) {
            return parseFloat(value || 0).toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ',');
        }

        function setRemainder(value) {
            var num = parseFloat(value) || 0;
            var el = document.getElementById('Remainder');
            if (num < 0) {
                el.value = '-(' + formatCurrency(Math.abs(num)) + ')';
                el.style.color = 'red';
            } else {
                el.value = formatCurrency(num);
                el.style.color = 'blue';
            }
        }
    </script>
}

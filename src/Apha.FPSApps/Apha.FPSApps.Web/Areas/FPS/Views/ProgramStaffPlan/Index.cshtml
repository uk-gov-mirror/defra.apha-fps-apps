@using Apha.FPSApps.Web.Models.Components.DataGrid
@model Apha.FPSApps.Web.Areas.FPS.Models.ProgramStaffPlanViewModel
@{
    ViewData["Title"] = "Programme Staff Plan";
}


<div class="container-fluid">
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-one-half">
            <h1 class="govuk-heading-s govuk-!-margin-bottom-0 govuk-!-margin-top-3">Plan All Staff Cost for Programme</h1>
        </div>

        <div class="govuk-grid-column-one-third isFloatRight">
            <table class="govuk-table govuk-!-margin-bottom-0 isFloatRight isHalfGrid isPlanAllStaff">
                <tbody class="govuk-table__body">
                    <tr class="govuk-table__row">
                        <th scope="row" class="govuk-table__header govuk-!-padding-bottom-0 govuk-!-padding-right-0 isNoBottomBorder">
                            <label class="govuk-label govuk-!-margin-bottom-0 govuk-!-padding-right-1 govuk-!-font-weight-bold isNoWrap" for="programmeSelect">Programme: </label>
                        </th>
                        <td class="govuk-table__cell govuk-!-padding-bottom-0 govuk-!-padding-right-1 isNoBottomBorder">
                            <select id="programmeSelect" asp-items="Model.ProgrammeList" asp-for="SelectedProgramNo" class="govuk-select govuk-input--width-20">
                                <option value="">-- Select Programme --</option>
                            </select>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <div class="govuk-grid-row">
        <div class="govuk-grid-column-one-half mt-2">
            <div class="" style=" border-radius: 5px;justify-content: flex-start; margin-bottom:10px;background-color: #edf4ff;border: 1px solid #1d70b8;padding: 4px;">
                <div class="row">
                    <div class="col-lg-7">
                        <label class="govuk-label--s" for="managerName" style="color:#3e3e3e">Programme Manager </label>
                        <input type="text" value="@Model.Manager" id="managerName" class="projectplan-code govuk-input" readonly>
			
                    </div>
                    <div class="col-lg-5">
                        <label class="govuk-label--s" for="Target" style="color:#3e3e3e">Target </label>
                        <div class="govuk-input__wrapper">
                            <div class="govuk-input__prefix" aria-hidden="true">£</div>
                            <input type="text" value="@Model.Target.ToString("N2")" id="Target" readonly class="projectplan-code govuk-input">
                        </div>
                    </div>
                </div>
            </div>
            <div class="govuk-grid-row">
                <div class="govuk-grid-column-full mt-2">
                    <div id="gridContainer_@Model.ProjectsGrid.GridId" style="padding: 5px;">
                        @await Html.PartialAsync("_DataGrid", Model.ProjectsGrid)
                    </div>
                </div>
            </div>
        </div>
        <div class="govuk-grid-column-one-half mt-2">
            <div class="" style=" border-radius: 5px;justify-content: flex-start;margin-bottom: 10px;background-color: #edf4ff;border: 1px solid #1d70b8;padding: 4px;">
                <div class="row">
                    <div class="col-lg-12">
                        <label class="govuk-label--s" for="txtSelectedProject" style="color:#3e3e3e">Staff Resource Plan for </label>
                        <input type="text" id="txtSelectedProject" value="" readonly class="projectplan-code govuk-input">
                        <input type="hidden" id="hdnJobCode" value="" />
                    </div>
                </div>
            </div>
            <div class="govuk-grid-row">
                <div class="govuk-grid-column-full mt-2">
                    <div id="gridContainer_@Model.StaffCostGrid.GridId" style="padding: 5px;">
                        @await Html.PartialAsync("_DataGrid", Model.StaffCostGrid)
                    </div>
                </div>
                <div class="govuk-grid-column-full mt-2">
                    <div class="financial-summary mt-2">
                        <div class="summary-row">
                            <div class="summary-item">
                                <label class="govuk-label--s" for="for_project">For Project:</label>
                                <input type="text" aria-label="for_project" id="for_project" readonly class="govuk-input ">
                            </div>
                            <div class="summary-item">
                                <label class="govuk-label--s" for="External_Income">Staff Cost:</label>
                                <div class="govuk-input__wrapper">
                                    <div class="govuk-input__prefix" aria-hidden="true">£</div>
                                    <input type="text" aria-label="External_Income" id="External_Income" readonly class="govuk-input text-AlignRight" value="@Model.StaffCost.ToString("N2")">
                                </div>
                            </div>
                            <div class="summary-item">
                                <label class="govuk-label--s" for="BudgetCVL">Budget:</label>
                                <div class="govuk-input__wrapper">
                                    <div class="govuk-input__prefix" aria-hidden="true">£</div>
                                    <input type="text" value="0" aria-label="BudgetCVL" id="BudgetCVL" readonly class="govuk-input text-AlignRight">
                                </div>
                            </div>
                            <div class="summary-item">
                                <label class="govuk-label--s" for="Total_Costs">Remainder:</label>
                                <div class="govuk-input__wrapper">
                                    <div class="govuk-input__prefix" aria-hidden="true">£</div>
                                    <input type="text" value="0" aria-label="Total_Costs" id="Total_Costs" readonly class="govuk-input text-AlignRight">
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script src="~/js/ajax-form-validation.js"></script>
    <script src="~/js/fps_js/StaffJob.js"></script>
    <script>
        var currentProgramNo = '@Html.Raw(Model.SelectedProgramNo)';
        var currentJobCode = '';

        StaffJobConfig.getJobCode = function () { return currentJobCode; };
        StaffJobConfig.requireJobCodeForAdd = true;
        StaffJobConfig.onSaved = function () { window['gridManager_@Model.StaffCostGrid.GridId'].reloadGrid({ page: 1 }); };
        StaffJobConfig.onUpdated = function () { window['gridManager_@Model.StaffCostGrid.GridId'].reloadGrid({ page: 1 }); };
        StaffJobConfig.onDeleted = function () { window['gridManager_@Model.StaffCostGrid.GridId'].reloadGrid({ page: 1 }); };

        $(document).ready(function () {
            if (currentProgramNo) {
                window['gridManager_@Model.ProjectsGrid.GridId'].reloadGrid({ page: 1 });
            }

            var staffGridContainer = document.getElementById('gridContainer_@Model.StaffCostGrid.GridId');
            if (staffGridContainer) {
                new MutationObserver(function () {
                    calculateExternalIncome();
                }).observe(staffGridContainer, { childList: true });
            }

            document.addEventListener('gridReloaded', function (e) {
                if (e.detail.gridId === '@Model.ProjectsGrid.GridId') {
                    var firstRow = $('#tbl_@Model.ProjectsGrid.GridId tbody tr.selectable-row:first');
                    if (firstRow.length) {
                        firstRow.trigger('click');
                    }
                }
            });

            var staffGridEl = document.getElementById('gridContainer_@Model.StaffCostGrid.GridId');
            if (staffGridEl) {
                staffGridEl.addEventListener('click', function (e) {
                    if (!currentJobCode && (e.target.closest('.sortable-header') || e.target.closest('.pagination a'))) {
                        e.stopImmediatePropagation();
                        e.preventDefault();
                    }
                }, true);
            }
        });

        $('#programmeSelect').on('change', function () {
            const val = $(this).val();
            if (!val) return;
            currentProgramNo = val;
            // Persist selection to session for other pages
            $.ajax({
                url: '@Url.Action("SaveProgrammeSession", "ProgrammeSelect", new { area = "FPS" })',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(val)
            });
            currentJobCode = '';
            $('#hdnJobCode').val('');
            $('#txtSelectedProject').val('');
            $('#for_project').val('');
            $('#External_Income').val('');
            $('#BudgetCVL').val('');
            $('#Total_Costs').val('');

            if (currentProgramNo) {
                $.get('@Url.Action("GetProgramInfo", "ProgramStaffPlan", new { area = "FPS" })',
                    { programNo: currentProgramNo },
                    function (result) {
                        if (result.success) {
                                $('#managerName').val(result.manager);
                                $('#Target').val(formatCurrency(result.target));
                            }
                    }
                );
            }

            window['gridManager_@Model.ProjectsGrid.GridId'].reloadGrid({ page: 1 });
        });

        function selectProject(btn) {
            var jobCode = $(btn).data('id');
            var row = $(btn).closest('tr');
            var budgetText = row.find('td[data-property="BudgetCvl"] span').text().replace(/[£,\s]/g, '');
            var budget = parseFloat(budgetText) || 0;

            currentJobCode = jobCode;
            $('#hdnJobCode').val(jobCode);
            $('#txtSelectedProject').val(jobCode);
            $('#for_project').val(jobCode);
            $('#BudgetCVL').val(formatCurrency(budget));
            $('#External_Income').val(formatCurrency(0));
            setTotalCosts(budget);

            $('#tbl_@Model.ProjectsGrid.GridId tbody tr').removeClass('selected-row');
            row.addClass('selected-row');

            $.get('@Url.Action("GetTotalStaffCost", "StaffJob", new { area = "FPS" })',
                { jobCode: jobCode },
                function (result) {
                    if (result.success) {
                        var total = parseFloat(result.totalStaffCost) || 0;
                        $('#External_Income').val(formatCurrency(total));
                        setTotalCosts(budget - total);
                    }
                }
            );

            window['gridManager_@Model.StaffCostGrid.GridId'].reloadGrid({ page: 1 });
        }

        function getProjectExtraFilters() {
            return { programNo: currentProgramNo };
        }

        function calculateExternalIncome() {
            if (!currentJobCode) { return; }

            var total = 0;
            $('#gridContainer_@Model.StaffCostGrid.GridId td[data-property="StaffCost"] span').each(function () {
                var value = parseFloat($(this).text().replace(/[£,\s]/g, '')) || 0;
                total += value;
            });

            $('#External_Income').val(formatCurrency(total));

            var budget = parseFloat($('#BudgetCVL').val().replace(/[£,\s]/g, '')) || 0;
            setTotalCosts(budget - total);
        }

        function formatCurrency(value) {
            return parseFloat(value || 0).toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ',');
        }

        function setTotalCosts(value) {
            var num = parseFloat(value) || 0;
            var el = document.getElementById('Total_Costs');
            if (num < 0) {
                el.value = '-(' + formatCurrency(Math.abs(num)) + ')';
                el.style.color = 'red';
            } else {
                el.value = formatCurrency(num);
                el.style.color = 'blue';
            }
        }
    </script>
}

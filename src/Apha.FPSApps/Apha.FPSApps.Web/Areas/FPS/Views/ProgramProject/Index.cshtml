@using Apha.FPSApps.Web.Areas.FPS.Models
@using Apha.FPSApps.Web.Models.Components.DataGrid
@model Apha.FPSApps.Web.Areas.FPS.Models.ProgramProjectViewModel
@{
    ViewData["Title"] = Model.IsProjectGroupMode ? "Plan Project Group Individually" : "Plan Projects Individually";
}

<main id="main-content">
    <div class="container-fluid">
        <div class="">
            <div class="govuk-grid-column-one-full sup_border-bottom isClearFix">
                <div class="govuk-grid-column-one-half govuk-!-padding-left-0">
                    <h1 class="govuk-heading-s govuk-!-margin-top-3 govuk-!-margin-bottom-2 govuk-!-padding-bottom-0 govuk-!-padding-left-0">
                        @(Model.IsProjectGroupMode ? "Plan Project Group Individually" : "Plan Projects Individually")
                    </h1>
                </div>

                <div class="govuk-grid-column-one-third isFloatRight govuk-!-padding-right-0">
                    <table class="govuk-table govuk-!-margin-bottom-0">
                        <tbody class="govuk-table__body">
                            <tr class="govuk-table__row">
                                <td class="govuk-table__cell govuk-!-padding-bottom-2 govuk-!-padding-right-1 isNoBottomBorder govuk-!-text-align-right">
                                    @if (Model.IsProjectGroupMode)
                                    {
                                        <label class="govuk-label govuk-!-margin-bottom-0 govuk-!-padding-right-0 govuk-!-font-weight-bold isNoWrap" for="projectGroupSelect">Project Group: </label>
                                        <select id="projectGroupSelect" asp-items="Model.ProjectGroupList" asp-for="SelectedProjectGroup"
                                                class="govuk-select govuk-!-font-size-16 govuk-input--width-10">
                                            <option value="">-- Select Project Group --</option>
                                        </select>
                                    }
                                    else
                                    {
                                        <label class="fw-bold mt-2" for="programmeSelect">Programme: </label>
                                        <select id="programmeSelect" asp-items="Model.ProgrammeList" asp-for="SelectedProgramNo"
                                                class="govuk-select govuk-!-font-size-16 govuk-input--width-10">
                                            <option value="">-- Select Programme --</option>
                                        </select>
                                    }
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-lg-12">
                <main class="main-content" style="padding:0;">
                    <div class="container-fluid" style="padding: 0;">
                        <div class="row">
                            <div class="container-fluid" style="padding-left:0px;">
                                <div style="display: flex; flex-direction: row; align-items: flex-start;">

                                    <!-- Side navigation: Plan vs Actuals -->
                                    @if (!Model.IsProjectGroupMode)
                                    {
                                    <nav class="sidenav flex-column flex-shrink-0" id="shortnav" aria-label="Plan vs Actuals side navigation">
                                        <button class="toggle-btn ppi-toggle-btn-position" onclick="toggleSidebar()" aria-label="Toggle side navigation">
                                            <img src="~/images/chevron-left-solid-full.svg" alt="Toggle navigation" width="24">
                                        </button>
                                        <ul>
                                            <li><a class="dropdown-item sidenav-title">Plan vs Actuals</a></li>
                                            <li><a class="dropdown-item nav-updatable"
                                                   asp-area="FPS" asp-controller="ProjectStaffPlanActual" asp-action="Index">Staff</a>
                                            </li>
                                            <li><a class="dropdown-item nav-updatable"
                                                   asp-area="FPS" asp-controller="ProjectTestPlanActual" asp-action="Index">Tests</a>
                                            </li>
                                            <li><a class="dropdown-item nav-updatable"
                                                   asp-area="FPS" asp-controller="ProjectAnimalPlanActual" asp-action="Index">Animals</a>
                                            </li>
                                            <li><a class="dropdown-item nav-updatable"
                                                   asp-area="FPS" asp-controller="ProjectAdditionalPlanActual" asp-action="Index">Additional</a>
                                            </li>
                                        </ul>
                                    </nav>
                                    }

                                    <div style="display: flex; flex-direction: column; flex: 1 1 auto; min-width: 0; margin: 0 0 5px 8px;">

                                        <!-- Selected project bar -->
                                        <div class="govuk-grid-row">
                                            <div class="govuk-grid-column-full mt-2">
                                                <div class="project-code-section" style="display:flex; align-items:center; gap:8px; margin-bottom:8px;">
                                                    <label class="govuk-label--s" for="selected-project-input">Selected project</label>
                                                    <input type="text" id="selected-project-input" value="@Model.SelectedProjectCode"
                                                           placeholder="Project" readonly
                                                           class="govuk-input govuk-!-font-size-16"
                                                           style="width:160px;">
                                                    <input type="hidden" id="hdnSelectedProject" value="@Model.SelectedProjectCode" />
                                                        <button type="button" id="btnPlan" class="govuk-button sup_margin_0" style="@(string.IsNullOrWhiteSpace(Model.SelectedProjectCode) ? "display:none;" : "")" onclick="planThisProject()">
                                                        <i class="fa fa-cogs" aria-hidden="true"></i> Plan
                                                    </button>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Projects DataGrid -->
                                        <div class="govuk-grid-row">
                                            <div class="govuk-grid-column-full mt-2">
                                                <div id="gridContainer_@Model.ProjectsGrid.GridId" style="padding: 5px;">
                                                    @await Html.PartialAsync("_DataGrid", Model.ProjectsGrid)
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Financial summary footer -->
                                        <div class="govuk-grid-column-full mt-2">
                                            <footer class="financial-summary">
                                                <div class="summary-row govuk-!-margin-top-0 govuk-!-margin-bottom-0">
                                                    <div class="summary-item">
                                                        <label class="govuk-label--s" for="summary-total-budget">Total Budget:</label>
                                                        <div class="govuk-input__wrapper">
                                                            <div class="govuk-input__prefix" aria-hidden="true">£</div>
                                                            <input type="text" id="summary-total-budget" readonly
                                                                   class="govuk-input govuk-!-font-size-16 text-AlignRight" value="0">
                                                        </div>
                                                    </div>
                                                    <div class="summary-item">
                                                        <label class="govuk-label--s" for="summary-total-cost-inc">Total Cust Inc:</label>
                                                        <div class="govuk-input__wrapper">
                                                            <div class="govuk-input__prefix" aria-hidden="true">£</div>
                                                            <input type="text" id="summary-total-cost-inc" readonly
                                                                   class="govuk-input govuk-!-font-size-16 text-AlignRight" value="0">
                                                        </div>
                                                    </div>
                                                    <div class="summary-item">
                                                        <label class="govuk-label--s" for="summary-total-trans-inc">Total Trans Inc:</label>
                                                        <div class="govuk-input__wrapper">
                                                            <div class="govuk-input__prefix" aria-hidden="true">£</div>
                                                            <input type="text" id="summary-total-trans-inc" readonly
                                                                   class="govuk-input govuk-!-font-size-16 text-AlignRight" value="0">
                                                        </div>
                                                    </div>
                                                    <div class="summary-item">
                                                        <label class="govuk-label--s" for="summary-total-cw-debit">Total CW Debit:</label>
                                                        <div class="govuk-input__wrapper">
                                                            <div class="govuk-input__prefix" aria-hidden="true">£</div>
                                                            <input type="text" id="summary-total-cw-debit" readonly
                                                                   class="govuk-input govuk-!-font-size-16 text-AlignRight" value="0">
                                                        </div>
                                                    </div>
                                                </div>
                                            </footer>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </main>
            </div>
        </div>
    </div>
</main>

@section Scripts {
    <script src="~/js/ajax-form-validation.js"></script>
    <script>
        var isProjectGroupMode = @Html.Raw(Model.IsProjectGroupMode ? "true" : "false");
        var currentProgramNo = '@Html.Raw(Model.SelectedProgramNo)';
        var currentProjectGroup = '@Html.Raw(Model.SelectedProjectGroup)';
        var currentProjectCode = '@Html.Raw(Model.SelectedProjectCode)';
        var fpsYear = '@FyContext.Year';

        // Disable nav links until a project is selected
        document.querySelectorAll('a.nav-updatable').forEach(function (link) {
            link.classList.add('nav-disabled');
        });

        // If a project was already selected (restored from session), enable the nav links immediately.
        if (currentProjectCode) {
            updateNavLinks(currentProgramNo);
            document.querySelectorAll('a.nav-updatable').forEach(function (link) {
                link.classList.remove('nav-disabled');
            });
        }

        function toggleSidebar() {
            const sidebar = document.querySelector('.sidenav');
            if (sidebar) sidebar.classList.toggle('collapsed');
        }

        function updateNavLinks(programNo) {
            document.querySelectorAll('a.nav-updatable').forEach(function (link) {
                var qs = programNo
                    ? '?programNo=' + encodeURIComponent(programNo) + '&year=' + encodeURIComponent(fpsYear)
                    : '?year=' + encodeURIComponent(fpsYear);
                link.href = link.pathname + qs;
            });
        }

        $('#programmeSelect').on('change', function () {
            const val = $(this).val();
            currentProgramNo = val;
            showLoader();
            // Persist selection to session for other pages
            $.ajax({
                url: '@Url.Action("SaveProgrammeSession", "ProgrammeSelect", new { area = "FPS" })',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(val),
                success: function () {
                    try {
                        updateNavLinks(val);
                        resetSelectedProject();
                        window['gridManager_@Model.ProjectsGrid.GridId'].reloadGrid({ page: 1 });
                        if (val) loadProjectTotals();
                    } catch (e) {
                        showAlertMessage('An error occurred while loading the projects.', AlertType.ERROR);
                    } finally {
                        hideLoader();
                    }
                },
                error: function () {
                    hideLoader();
                    showAlertMessage('An error occurred while saving the programme selection.', AlertType.ERROR);
                }
            });
        });

        $('#projectGroupSelect').on('change', function () {
            const val = $(this).val();
            currentProjectGroup = val;
            showLoader();
            $.ajax({
                url: '@Url.Action("SaveProjectGroupSession", "ProgramProject", new { area = "FPS" })',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(val),
                success: function () {
                    try {
                        resetSelectedProject();
                        window['gridManager_@Model.ProjectsGrid.GridId'].reloadGrid({ page: 1 });
                        if (val) loadProjectTotals();
                    } catch (e) {
                        showAlertMessage('An error occurred while loading the projects.', AlertType.ERROR);
                    } finally {
                        hideLoader();
                    }
                },
                error: function () {
                    hideLoader();
                    showAlertMessage('An error occurred while saving the project group selection.', AlertType.ERROR);
                }
            });
        });

        function getProgramProjectExtraFilters() {
            if (isProjectGroupMode) {
                return { projectGroup: currentProjectGroup };
            }
            return { programNo: currentProgramNo };
        }

        function selectProgramProject(btn) {
            const id = $(btn).data('id');
            document.getElementById('selected-project-input').value = id;
            document.getElementById('hdnSelectedProject').value     = id;
            currentProjectCode = id;
            updateNavLinks(currentProgramNo);
            document.querySelectorAll('a.nav-updatable').forEach(function (link) {
                link.classList.remove('nav-disabled');
            });
            // Persist project code to session for target pages
            $.ajax({
                url: '@Url.Action("SaveProjectSession", "ProgramProject", new { area = "FPS" })',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(id)
            });

            const planBtn = document.getElementById('btnPlan');
            if (planBtn) {
                 planBtn.style.display = '';
            }
        }

        function resetSelectedProject() {
            document.getElementById('selected-project-input').value = '';
            document.getElementById('hdnSelectedProject').value     = '';
            currentProjectCode = '';
            updateNavLinks(currentProgramNo);
            const planBtn = document.getElementById('btnPlan');
            if (planBtn) planBtn.style.display = 'none';
            document.querySelectorAll('a.nav-updatable').forEach(function (link) {
                link.classList.add('nav-disabled');
            });
            // Clear project code from session
            $.ajax({
                url: '@Url.Action("SaveProjectSession", "ProgramProject", new { area = "FPS" })',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify('')
            });
        }

        function planThisProject() {                           
            if (!currentProjectCode) { window.showAlertMessage('Please select a project first.', AlertType.INFO); return; }
            var returnUrl = isProjectGroupMode
                ? '/FPS/ProgramProject?source=projectgroup'
                : '/FPS/ProgramProject?programNo=' + encodeURIComponent(currentProgramNo);
            window.fpsNavigateTo('/FPS/ProjectPlanning?projectCode=' + encodeURIComponent(currentProjectCode) + '&returnUrl=' + encodeURIComponent(returnUrl));
        }

        function editProgramProject(btn) {
            const id = $(btn).data('id');
            $.ajax({
                url: '/FPS/ProgramProject/Edit',
                type: 'GET',
                data: { parentProject: id },
                success: function (html) {
                    $('#modaPopupBody').html(html);
                    $('#modalPopup').addClass('show');
                },
                error: function () {
                    showAlertMessage('An error occurred while loading the edit form.', AlertType.ERROR);
                }
            });
        }

        function updateProgramProject() {
            clearValidationErrors('#modaPopupBody');
            var form = $('#editProgramProjectForm');

            if (!isFormValid(form)) {
                displayClientValidationErrors(form, '#modaPopupBody');
                return;
            }

            var data = {
                ParentProject:     form.find('[name="ParentProject"]').val(),
                ProjectTitle:      form.find('[name="ProjectTitle"]').val(),
                Manager:           form.find('[name="Manager"]').val(),
                Program:           form.find('[name="Program"]').val(),
                Customer:          form.find('[name="Customer"]').val(),
                ProjectGroup:      form.find('[name="ProjectGroup"]').val(),
                Contract:          form.find('[name="Contract"]').val(),
                Disease:           form.find('[name="Disease"]').val(),
                ProjectStatus:     form.find('[name="ProjectStatus"]').val(),
                BudgetCvl:         emptyToNull(form.find('[name="BudgetCvl"]').val()),
                BudgetExt:         emptyToNull(form.find('[name="BudgetExt"]').val()),
                TransferIncome:    emptyToNull(form.find('[name="TransferIncome"]').val()),
                PlanCaseWorkDebit: emptyToNull(form.find('[name="PlanCaseWorkDebit"]').val()),
                IsDefraProject:    form.find('[name="IsDefraProject"]').val()
            };

            $.ajax({
                url: '@Url.Action("Edit", "ProgramProject", new { area = "FPS" })',
                type: 'POST',
                data: JSON.stringify(data),
                contentType: 'application/json; charset=utf-8',
                success: function (result) {
                    if (result.success) {
                        showAlertMessage(result.message, AlertType.SUCCESS).then(function () {
                            closeModal();
                            window['gridManager_@Model.ProjectsGrid.GridId'].reloadGrid({ page: 1 });
                            loadProjectTotals();
                        });
                    } else {
                        displayServerValidationErrors(result.errors, result.message, '#modaPopupBody');
                    }
                },
                error: function (xhr) {
                    if (xhr.status === 400 && xhr.responseJSON) {
                        displayServerValidationErrors(xhr.responseJSON.errors, xhr.responseJSON.message, '#modaPopupBody');
                    } else {
                        showAlertMessage('An error occurred while saving.', AlertType.ERROR);
                    }
                }
            });
        }

        function deleteProgramProject(btn) {
            const id = $(btn).data('id');
            showGovukConfirm('Are you sure you want to delete this project?').then(function (confirmed) {
                if (!confirmed) return;
                $.ajax({
                    url: '/FPS/ProgramProject/Delete',
                    type: 'DELETE',
                    data: { parentProject: id },
                    success: function (response) {
                        if (response.success) {
                            showAlertMessage('Deleted successfully', AlertType.SUCCESS).then(function () {
                                window['gridManager_@Model.ProjectsGrid.GridId'].reloadGrid({ page: 1 });
                                loadProjectTotals();
                            });
                        } else {
                            showAlertMessage('Error: ' + response.message, AlertType.ERROR);
                        }
                    },
                    error: function () {
                        showAlertMessage('An error occurred while deleting.', AlertType.ERROR);
                    }
                });
            });
        }

        function closeModal() {
            clearValidationErrors('#modaPopupBody');
            $('#modaPopupBody').html("");
            $('#modalPopup').removeClass("show");
        }

        function emptyToNull(val) {
            var trimmed = (val || '').toString().trim();
            return trimmed === '' ? null : trimmed;
        }

        function formatGbp(value) {
            return '£' + Math.round(value || 0).toLocaleString('en-GB', { minimumFractionDigits: 0, maximumFractionDigits: 0 });
        }

        function loadProjectTotals() {
            var params = isProjectGroupMode
                ? { projectGroup: currentProjectGroup }
                : { programNo: currentProgramNo };

            if (isProjectGroupMode ? !currentProjectGroup : !currentProgramNo) return;

            $.get('@Url.Action("GetProjectTotals", "ProgramProject", new { area = "FPS" })', params)
                .done(function (data) {
                    document.getElementById('summary-total-budget').value    = formatGbp(data.budgetCvl);
                    document.getElementById('summary-total-cost-inc').value  = formatGbp(data.budgetExt);
                    document.getElementById('summary-total-trans-inc').value = formatGbp(data.transferIncome);
                    document.getElementById('summary-total-cw-debit').value  = formatGbp(data.planCaseWorkDebit);
                })
                .fail(function () {
                    showAlertMessage('An error occurred while loading project totals.', AlertType.ERROR);
                });
        }

        document.addEventListener('DOMContentLoaded', function () {
            // Auto-select first project whenever the grid content changes
            var autoSelectDebounce;
            var observer = new MutationObserver(function (mutations) {
                var hasNewNodes = mutations.some(function (m) {
                    return Array.from(m.addedNodes).some(function (n) { return n.nodeType === 1; });
                });
                if (hasNewNodes) {
                    clearTimeout(autoSelectDebounce);
                    autoSelectDebounce = setTimeout(autoSelectFirstProject, 50);
                }
            });
            var container = document.getElementById('gridContainer_@Model.ProjectsGrid.GridId');
            if (container) observer.observe(container, { childList: true, subtree: true });

            if (isProjectGroupMode) {
                if (currentProjectGroup) {
                    window['gridManager_@Model.ProjectsGrid.GridId'].reloadGrid({ page: 1 });
                    loadProjectTotals();
                }
            } else {
                if (currentProgramNo) {
                    updateNavLinks(currentProgramNo);
                    window['gridManager_@Model.ProjectsGrid.GridId'].reloadGrid({ page: 1 });
                    loadProjectTotals();
                }
            }
        });

        function autoSelectFirstProject() {
            // If session has a project code, try to select that row first
            var targetRow = null;
            if (currentProjectCode) {
                targetRow = document.querySelector(
                    '#gridContainer_@Model.ProjectsGrid.GridId .selectable-row[data-id="' + currentProjectCode + '"]'
                );
                // Restored project is not on the loaded grid page: keep the current
                // selection rather than overriding it with the first project.
                if (!targetRow) {
                    return;
                }
            }
            var rowToSelect = targetRow
                || document.querySelector('#gridContainer_@Model.ProjectsGrid.GridId .selectable-row');
            if (rowToSelect) {
                selectProgramProject(rowToSelect);
            } else {
                resetSelectedProject();
            }
        }
    </script>
}

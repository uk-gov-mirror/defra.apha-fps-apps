@using Apha.FPSApps.Web.Models.Components.DataGrid
@model Apha.FPSApps.Web.Areas.FPS.Models.ProjectAnimalPlanActualViewModel
@{
    ViewData["Title"] = "Plan vs Actual - Animals";
    ViewData["SelectedProjectCode"] = Model.SelectedProjectCode;
}
<div class="cgovuk-grid-column-one-full">
    <div class="">
        <div class="">
            <div class="govuk-grid-column-one-half isFloatLeft">
                <h1 class="govuk-grid-row govuk-heading-s govuk-!-margin-bottom-0 govuk-!-margin-top-2 govuk-!-margin-left-0 isCustomPageHeadings">Compare FPS Plan with PACT Actuals</h1>
            </div>

            <div class="govuk-grid-column-one-third isFloatRight">
                <table class="govuk-table govuk-!-margin-bottom-0 isFloatRight isHalfGrid isCompareFPSPlanAnimal govuk-!-margin-top-2">
                    <tbody class="govuk-table__body">
                        <tr class="govuk-table__row">
                            <td class="govuk-table__cell govuk-!-padding-bottom-0 govuk-!-padding-top-0 govuk-!-padding-right-1 isNoBottomBorder govuk-!-text-align-right">
                                @await Html.PartialAsync("_ProjectDropdownSelector")
                            </td>
                            <td class="govuk-table__cell govuk-!-padding-bottom-0 govuk-!-padding-top-0 govuk-!-padding-right-1 isNoBottomBorder govuk-!-text-align-right">
                                <a asp-area="FPS" asp-controller="ProgramProject" asp-action="Index" class="govuk-back-link sup_align_right govuk-!-margin-bottom-0 govuk-!-margin-top-0">Back</a>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Summary card -->
    @{
        ViewData["SummaryProjectCodeValue"]  = Model.SelectedProjectCode;
        ViewData["SummaryProjectTitleValue"] = Model.ProjectTitle;
        ViewData["SummaryProgramValue"]      = Model.Program;
        ViewData["SummaryContractValue"]     = Model.Contract;
    }
    @await Html.PartialAsync("_PvaSummaryCard")

    <!-- Two-column grid area -->
    <div class="govuk-grid-row">
        <!-- Left: Planned Animals (FPS) -->
        <div class="govuk-grid-column-one-half mt-2">
            <div class="govuk-grid-row">
                <div class="govuk-grid-column-full mt-2">
                    <div id="gridContainer_@Model.AnimalPlanGrid.GridId" style="padding: 5px;">
                        @await Html.PartialAsync("_DataGrid", Model.AnimalPlanGrid)
                    </div>
                </div>
                <div class="govuk-grid-column-full mt-2">
                    <div class="financial-summary mt-1" style="padding: 0 5px;">
                        <div style="display:flex; align-items:center;">
                            <span class="govuk-label--s" style="margin-left:auto; margin-right:8px; white-space:nowrap;">Total Planned Cost:</span>
                            <div class="govuk-input__wrapper" style="margin-right:75px;">
                                <div class="govuk-input__prefix" aria-hidden="true">£</div>
                                <input type="text" id="planned-total-cost" asp-for="TotalPlannedCost" readonly
                                       class="govuk-input text-AlignRight"
                                       value="@(Model.TotalPlannedCost.ToString("N2"))" style="width:140px;"
                                       aria-label="Total Planned Cost">
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right: Actual Animal Costs (PACT) -->
        <div class="govuk-grid-column-one-half mt-2">
            <div class="govuk-grid-row">
                <div class="govuk-grid-column-full mt-2">
                    <div id="gridContainer_@Model.ActualAnimalCostGrid.GridId" style="padding: 5px;">
                        @await Html.PartialAsync("_DataGrid", Model.ActualAnimalCostGrid)
                    </div>
                </div>
                <div class="govuk-grid-column-full mt-2">
                    <div class="financial-summary mt-1" style="padding: 0 5px;">
                        <div style="display:flex; align-items:center; margin-bottom:4px;">
                            <span class="govuk-label--s" style="margin-left:auto; margin-right:8px; white-space:nowrap;">Totals:</span>
                            <div class="govuk-input__wrapper">
                                <div class="govuk-input__prefix" aria-hidden="true">£</div>
                                <input type="text" id="project-total-cost" asp-for="TotalActualCost" readonly
                                       class="govuk-input text-AlignRight"
                                       value="@(Model.TotalActualCost.ToString("N2"))" style="width:160px;"
                                       aria-label="Total Actual Cost">
                            </div>
                        </div>
                        <div style="display:flex; align-items:center;">
                            <span class="govuk-label--s" style="margin-left:auto; margin-right:8px; white-space:nowrap;">Percent of Plan:</span>
                            <input type="text" id="project-percent-plan" asp-for="PercentOfPlan" readonly
                                   class="govuk-input text-AlignRight"
                                   value="@(Model.PercentOfPlan.ToString("F2"))%" style="width:95px;"
                                   aria-label="Percent of Plan">
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/fps_js/ajax-form-validation.js" asp-append-version="true"></script>
    <script src="~/js/ajax-form-validation.js" asp-append-version="true"></script>
    <script src="~/js/fps_js/AnimalJob.js" asp-append-version="true"></script>
    <script src="~/js/fps_js/project-dropdown.js" asp-append-version="true"></script>
    <script>
        AnimalJobConfig.getJobCode = function () { return currentProjectCode; };
        AnimalJobConfig.requireJobCodeForAdd = true;
        AnimalJobConfig.onSaved = function () {
            window['gridManager_@Model.AnimalPlanGrid.GridId'].reloadGrid({ page: 1 });
            refreshPlannedCost();
        };
        AnimalJobConfig.onUpdated = function () {
            window['gridManager_@Model.AnimalPlanGrid.GridId'].reloadGrid({ page: 1 });
            refreshPlannedCost();
        };
        AnimalJobConfig.onDeleted = function () {
            window['gridManager_@Model.AnimalPlanGrid.GridId'].reloadGrid({ page: 1 });
            refreshPlannedCost();
        };
    </script>
    <script>
        var currentProjectCode = '@Html.Raw(Model.SelectedProjectCode)';
        var _loaderPendingGrids = 0;

        $(document).ready(function () {
            if (currentProjectCode) {
                showLoader();
                _loaderPendingGrids = 2;
                setTimeout(function () {
                    window['gridManager_@Model.AnimalPlanGrid.GridId'].reloadGrid({ page: 1 });
                    window['gridManager_@Model.ActualAnimalCostGrid.GridId'].reloadGrid({ page: 1 });
                    refreshPlannedCost();
                    refreshActualCost();
                }, 0);
            }
            document.addEventListener('gridReloaded', function (e) {
                var tracked = ['@Model.AnimalPlanGrid.GridId', '@Model.ActualAnimalCostGrid.GridId'];
                if (tracked.indexOf(e.detail.gridId) !== -1 && _loaderPendingGrids > 0) {
                    _loaderPendingGrids--;
                    if (_loaderPendingGrids === 0) hideLoader();
                }
            });
        });

        function onProjectSelected(projectCode, projectTitle) {
            currentProjectCode = projectCode;
            document.getElementById('projectNameInput').value = projectCode;
            // Persist selection to session so the Back link retains the selected project.
            $.ajax({
                url: '@Url.Action("SaveProjectSession", "ProgramProject", new { area = "FPS" })',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(projectCode || '')
            });
            $('#summary-project-code').val(currentProjectCode);
            $('#summary-project-description').val(projectTitle || '');
            $('#summary-program').val('');
            $('#summary-contract').val('');
            $('#planned-total-cost').val('0.00');
            $('#project-total-cost').val('0.00');
            $('#project-percent-plan').val('0.00%');
            if (currentProjectCode) {
                $.get('@Url.Action("GetProjectInfo", "ActualAnimalCost", new { area = "FPS" })',
                    { projectCode: currentProjectCode },
                    function (result) {
                        if (result.success) {
                            $('#summary-project-description').val(result.projectTitle);
                            $('#summary-program').val(result.program);
                            $('#summary-contract').val(result.contract);
                        }
                    }
                );
                showLoader();
                _loaderPendingGrids = 2;
                setTimeout(function () {
                    window['gridManager_@Model.AnimalPlanGrid.GridId'].reloadGrid({ page: 1 });
                    window['gridManager_@Model.ActualAnimalCostGrid.GridId'].reloadGrid({ page: 1 });
                    refreshPlannedCost();
                    refreshActualCost();
                }, 0);
            }
        }

        $(document).ready(function () {
            initProjectDropdown(
                '@Url.Action("GetProjectLookup", "ProjectAnimalPlanActual", new { area = "FPS" })',
                onProjectSelected
            );
        });

        function getAnimalPlanExtraFilters() { return { jobCode: currentProjectCode }; }

        function getActualAnimalExtraFilters() {
            return { projectCode: currentProjectCode };
        }

        function refreshPlannedCost() {
            if (!currentProjectCode) return;
            $.get('@Url.Action("GetTotalPlannedCost", "ProjectAnimalPlanActual", new { area = "FPS" })',
                { jobCode: currentProjectCode },
                function (result) {
                    if (result.success) {
                        $('#planned-total-cost').val(formatCurrency(result.totalPlannedCost));
                        calculatePercentOfPlan();
                    }
                }
            );
        }

        function refreshActualCost() {
            if (!currentProjectCode) return;
            $.get('@Url.Action("GetTotalActualCost", "ActualAnimalCost", new { area = "FPS" })',
                { projectCode: currentProjectCode },
                function (result) {
                    if (result.success) {
                        $('#project-total-cost').val(formatCurrency(result.totalActualCost));
                        calculatePercentOfPlan();
                    }
                }
            );
        }

        function formatCurrency(value) {
            return parseFloat(value || 0).toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ',');
        }

        function calculatePercentOfPlan() {
            var plannedRaw = parseFloat($('#planned-total-cost').val().replace(/[£,\s]/g, '')) || 0;
            var actualRaw = parseFloat($('#project-total-cost').val().replace(/[£,\s]/g, '')) || 0;
            var pct = plannedRaw > 0 ? (actualRaw / plannedRaw) * 100 : 0;
            $('#project-percent-plan').val(pct.toFixed(2) + '%');
        }

        function deleteActualAnimalCost(btn) {
            var subContCounter = $(btn).data('id');
            if (!subContCounter) return;
            showGovukConfirm('Are you sure you want to delete this record?').then(function (confirmed) {
                if (!confirmed) return;
                $.ajax({
                    url: '@Url.Action("Delete", "ActualAnimalCost", new { area = "FPS" })',
                    type: 'DELETE',
                    data: { subContCounter: subContCounter },
                    success: function (result) {
                        if (result.success) {
                            window['gridManager_@Model.ActualAnimalCostGrid.GridId'].reloadGrid({ page: 1 });
                            refreshActualCost();
                            showAlertMessage('Record deleted successfully.', AlertType.SUCCESS);
                        } else {
                            showAlertMessage('Delete failed: ' + (result.message || 'Unknown error'), AlertType.ERROR);
                        }
                    },
                    error: function () {
                        showAlertMessage('An error occurred while deleting the record.', AlertType.ERROR);
                    }
                });
            });
        }
    </script>
}

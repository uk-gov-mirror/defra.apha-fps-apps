    <div class="govuk-grid-row">
        <div class="govuk-grid-column-one-half isFloatLeft">
            <h1 class="govuk-grid-row govuk-heading-s govuk-!-margin-bottom-0 govuk-!-margin-left-0 isCustomPageHeadings">FPS Plan v. PACT Actuals - TESTS Bought</h1>
        </div>

        <div class="govuk-grid-column-one-third isFloatRight">
            <table class="govuk-table govuk-!-margin-bottom-0 isFloatRight isHalfGrid">
                <tbody class="govuk-table__body">
                    <tr class="govuk-table__row">
                        <th scope="row" class="govuk-table__header govuk-!-padding-bottom-0 govuk-!-padding-top-0 govuk-!-padding-right-0 isNoBottomBorder govuk-!-text-align-right">
                            <label class="fw-bold mt-2 me-2" for="projectSelect">Project:</label>
                        </th>
                        <td class="govuk-table__cell govuk-!-padding-bottom-0 govuk-!-padding-top-0 govuk-!-padding-right-1 isNoBottomBorder govuk-!-text-align-right">
                            <select id="projectSelect" asp-items="Model.ProjectList" asp-for="SelectedProjectCode"
                                    class="govuk-select govuk-!-font-size-16 govuk-input--width-10">
                                <option value="">-- Select Project --</option>
                            </select>
                        </td>
                        <td class="govuk-table__cell govuk-!-padding-bottom-0 govuk-!-padding-top-0 govuk-!-padding-right-1 isNoBottomBorder govuk-!-text-align-right">
                            <a asp-area="FPS" asp-controller="ProgramProject" asp-action="Index" class="govuk-back-link">Back</a>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <div class="govuk-grid-row">
        <div class="govuk-grid-column-full mt-2">
            <div style="background-color:#edf4ff; border:1px solid #1d70b8; border-radius:5px; padding:8px;">
                <div class="row">
                    <div class="col-lg-6">
                        <div class="row">
                            <div class="col-lg-5"><label class="govuk-label--s">Project</label><input type="text" id="summary-project-code" asp-for="SelectedProjectCode" class="govuk-input" readonly></div>
                            <div class="col-lg-7"><label class="govuk-label--s">Project Description</label><input type="text" id="summary-project-description" asp-for="ProjectTitle" class="govuk-input" readonly></div>
                        </div>
                    </div>
                    <div class="col-lg-6">
                        <div class="row">
                            <div class="col-lg-5"><label class="govuk-label--s">Program</label><input type="text" id="summary-program" asp-for="Program" class="govuk-input" readonly></div>
                            <div class="col-lg-7"><label class="govuk-label--s">Contract</label><input type="text" id="summary-contract" asp-for="Contract" class="govuk-input" readonly></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-one-half mt-2">
            <div id="gridContainer_@Model.TestPlanGrid.GridId" style="padding:5px;">@await Html.PartialAsync("_DataGrid", Model.TestPlanGrid)</div>
            <div class="financial-summary mt-1" style="padding:0 5px;">
                <div style="display:flex; align-items:center;">
                    <span class="govuk-label--s" style="margin-left:auto; margin-right:8px; white-space:nowrap;">Total Planned Cost:</span>
                    <div class="govuk-input__wrapper" style="margin-right:75px;">
                        <div class="govuk-input__prefix" aria-hidden="true">&pound;</div>
                        <input type="text" id="planned-total-cost" readonly class="govuk-input text-AlignRight" value="@(Model.TotalPlannedCost.ToString("N2"))" style="width:140px;">
                    </div>
                </div>
            </div>
        </div>
        <div class="govuk-grid-column-one-half mt-2">
            <div id="gridContainer_@Model.CompareTests2Grid.GridId" style="padding:5px;">@await Html.PartialAsync("_DataGrid", Model.CompareTests2Grid)</div>
            <div class="financial-summary mt-1" style="padding:0 5px;">
                <div style="display:flex; align-items:center; margin-bottom:4px;">
                    <span class="govuk-label--s" style="margin-left:auto; margin-right:8px; white-space:nowrap;">Totals:</span>
                    <div class="govuk-input__wrapper">
                        <div class="govuk-input__prefix" aria-hidden="true">&pound;</div>
                        <input type="text" id="project-total-cost" readonly class="govuk-input text-AlignRight" value="@(Model.TotalActualCost.ToString("N0"))" style="width:110px;" aria-label="Total Actual Cost">
                    </div>
                </div>
                <div style="display:flex; align-items:center;">
                    <span class="govuk-label--s" style="margin-left:auto; margin-right:8px; white-space:nowrap;">Percent of Plan:</span>
                    <input type="text" id="project-percent-plan" readonly class="govuk-input text-AlignRight" value="@(Model.PercentOfPlan.ToString("F0"))%" style="width:110px;" aria-label="Percent of Plan">
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
<script src="~/js/ajax-form-validation.js"></script>
<script src="~/js/fps_js/TestPlanJob.js"></script>
<script>
    var currentProjectCode = '@Html.Raw(Model.SelectedProjectCode)';
    TestPlanJobConfig.getJobCode = function () { return currentProjectCode; };
    TestPlanJobConfig.requireJobCodeForAdd = true;
    TestPlanJobConfig.onDeleted = function () { window['gridManager_@Model.TestPlanGrid.GridId'].reloadGrid({ page: 1 }); refreshPlannedCost(); };
    $(document).ready(function () {
        if (currentProjectCode) {
            window['gridManager_@Model.TestPlanGrid.GridId'].reloadGrid({ page: 1 });
            window['gridManager_@Model.CompareTests2Grid.GridId'].reloadGrid({ page: 1 });
            refreshPlannedCost(); refreshActualTotals();
        }
        var el = document.getElementById('gridContainer_@Model.CompareTests2Grid.GridId');
        if (el) new MutationObserver(function () { refreshActualTotals(); }).observe(el, { childList: true, subtree: true });
    });
    $('#projectSelect').on('change', function () {
        currentProjectCode = $(this).val();
        $('#summary-project-code').val(currentProjectCode);
        ['summary-project-description','summary-program','summary-contract'].forEach(function(id){ $('#'+id).val(''); });
        $('#planned-total-cost').val('0.00'); $('#project-total-cost').val('0'); $('#project-percent-plan').val('0%');
        if (currentProjectCode) {
            $.get('@Url.Action("GetProjectInfo","ProjectTestPlanActual",new{area="FPS"})', { projectCode: currentProjectCode }, function (r) { if (r.success) { $('#summary-project-description').val(r.projectTitle); $('#summary-program').val(r.program); $('#summary-contract').val(r.contract); } });
            window['gridManager_@Model.TestPlanGrid.GridId'].reloadGrid({ page: 1 });
            window['gridManager_@Model.CompareTests2Grid.GridId'].reloadGrid({ page: 1 });
            refreshPlannedCost(); refreshActualTotals();
        }
    });
    function getTestPlanExtraFilters()    { return { jobCode: currentProjectCode }; }
    function getCompareTests2ExtraFilters(){ return { projectCode: currentProjectCode }; }
    function refreshPlannedCost() {
        if (!currentProjectCode) return;
        $.get('@Url.Action("GetTotalPlannedCost","ProjectTestPlanActual",new{area="FPS"})', { projectCode: currentProjectCode }, function (r) { if (r.success) { $('#planned-total-cost').val(formatCurrency(r.totalPlannedCost)); calculatePercentOfPlan(); } });
    }
    function refreshActualTotals() {
        if (!currentProjectCode) return;
        $.get('@Url.Action("GetTotalActualCost","ProjectTestPlanActual",new{area="FPS"})', { projectCode: currentProjectCode }, function (r) { if (r.success) { $('#project-total-cost').val(formatCurrency(r.totalCost)); calculatePercentOfPlan(); } });
    }
    function formatCurrency(v) { return parseFloat(v||0).toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g,','); }
    function calculatePercentOfPlan() {
        var p = parseFloat($('#planned-total-cost').val().replace(/[£,\s]/g,''))||0;
        var a = parseFloat($('#project-total-cost').val().replace(/[£,\s]/g,''))||0;
        $('#project-percent-plan').val((p>0?Math.round((a/p)*100):0)+'%');
    }
    function deleteCompareTests2(btn) {
        var rowKey = $(btn).data('id'); if (!rowKey) return;
        showGovukConfirm('Are you sure you want to delete this record?').then(function (ok) {
            if (!ok) return;
            $.ajax({ url: '@Url.Action("DeleteMonthlyOutput","ProjectTestPlanActual",new{area="FPS"})', type: 'DELETE', data: { rowKey: rowKey },
                success: function (r) { if (r.success) { window['gridManager_@Model.CompareTests2Grid.GridId'].reloadGrid({ page: 1 }); refreshActualTotals(); showAlertMessage('Record deleted successfully.', AlertType.SUCCESS); } else { showAlertMessage('Delete failed: '+(r.message||'Unknown error'), AlertType.ERROR); } },
                error: function () { showAlertMessage('An error occurred while deleting the record.', AlertType.ERROR); }
            });
        });
    }
</script>
}

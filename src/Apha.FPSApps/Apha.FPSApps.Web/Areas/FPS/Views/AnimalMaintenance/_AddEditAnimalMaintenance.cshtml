@model Apha.FPSApps.Web.Areas.FPS.Models.AnimalMaintenanceViewModel
@{
    var isEditMode  = !string.IsNullOrEmpty(Model.AnimalType);
    var title       = isEditMode ? "Edit Animal"     : "Add Animal";
    var formId      = isEditMode ? "editAnimalMasterForm" : "addAnimalMasterForm";
    var saveLabel   = isEditMode ? "Update"          : "Save";
    var saveAction  = isEditMode ? "updateAnimalMaster()" : "saveAnimalMaster()";
}

<div class="modal-header">
    <h5 class="modal-title" id="animalMasterModalTitle">@title</h5>
    <button type="button" class="btn-close btn-red" onclick="closeModal()" data-bs-dismiss="modal">X</button>
</div>
<div class="modal-body" style="overflow-y: auto; max-height: calc(80vh - 120px);">
    <div class="govuk-error-summary" role="alert"
         aria-labelledby="error-summary-title" tabindex="-1" style="display:none;">
        <h2 class="govuk-error-summary__title" id="error-summary-title">
            There is a problem
        </h2>
        <div class="govuk-error-summary__body">
            <ul class="govuk-list govuk-error-summary__list"></ul>
        </div>
    </div>
    <div class="row g-3">
        <form id="@formId">
            <div class="govuk-form-group sup_margin_0">
                <label class="govuk-label" asp-for="AnimalType">Animal Type <span class="sup_color_red">*</span></label>
                @if (isEditMode)
                {
                    <input type="text" asp-for="AnimalType" class="govuk-input" readonly />
                }
                else
                {
                    <input type="text" asp-for="AnimalType" required class="govuk-input" />
                }
                <span asp-validation-for="AnimalType" class="govuk-error-message" style="display:none;"></span>
            </div>
            <div class="govuk-form-group sup_margin_0">
                <label class="govuk-label" asp-for="Species">Species</label>
                <input type="text" asp-for="Species" class="govuk-input" />
                <span asp-validation-for="Species" class="govuk-error-message" style="display:none;"></span>
            </div>
            <div class="govuk-form-group sup_margin_0">
                <label class="govuk-label" asp-for="SecurityLevel">Security Level</label>
                <input type="text" asp-for="SecurityLevel" class="govuk-input" />
                <span asp-validation-for="SecurityLevel" class="govuk-error-message" style="display:none;"></span>
            </div>
            <div class="govuk-form-group sup_margin_0">
                <label class="govuk-label" asp-for="DailyRate">Daily Rate</label>
                <div class="govuk-input__wrapper">
                    <div class="govuk-input__prefix" aria-hidden="true">£</div>
                    <input type="text" asp-for="DailyRate" maxlength="20" class="govuk-input js-numeric-decimal" value="@Model.DailyRate" />
                </div>
                <span asp-validation-for="DailyRate" class="govuk-error-message" style="display:none;"></span>
            </div>
            <div class="govuk-form-group sup_margin_0">
                <label class="govuk-label" asp-for="DefraDailyRate">Defra Daily Rate</label>
                <div class="govuk-input__wrapper">
                    <div class="govuk-input__prefix" aria-hidden="true">£</div>
                    <input type="text" asp-for="DefraDailyRate" maxlength="20" class="govuk-input js-numeric-decimal" value="@Model.DefraDailyRate" />
                </div>
                <span asp-validation-for="DefraDailyRate" class="govuk-error-message" style="display:none;"></span>
            </div>
            <div class="govuk-form-group sup_margin_0">
                <div class="govuk-checkboxes govuk-checkboxes--small">
                    <div class="govuk-checkboxes__item">
                        <input type="checkbox" asp-for="PlanByWeek" class="govuk-checkboxes__input" id="PlanByWeek" />
                        <label class="govuk-label govuk-checkboxes__label govuk-!-font-size-16 govuk-!-margin-top-0" for="PlanByWeek">Plan Full Weeks</label>
                    </div>
                </div>
                <span asp-validation-for="PlanByWeek" class="govuk-error-message" style="display:none;"></span>
            </div>
        </form>
    </div>
</div>
<div class="modal-footer sup_flex_space_center">
    <button class="govuk-button govuk-button--secondary sup_margin_0" data-module="govuk-button" data-bs-dismiss="modal" onclick="closeModal()">Cancel</button>
    <button class="govuk-button sup_margin_0" data-module="govuk-button" type="button" onclick="@saveAction">@saveLabel</button>
</div>

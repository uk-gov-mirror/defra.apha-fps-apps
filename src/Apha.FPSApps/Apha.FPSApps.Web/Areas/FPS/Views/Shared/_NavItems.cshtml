@inject IConfiguration Configuration
@{
    var fpsPowerBiReportUrl = Configuration["PowerBiReports:FPS"];
}

@* FPS navigation items — referenced by Views/Shared/Components/AppNav/Default.cshtml *@

<!-- Programme Management -->
<div class="nav-item dropdown">
    <button class="nav-button dropdown-toggle" data-dropdown="programme-management" allow-edit="true">
        <div class="align-menu-text"><span>Programme Management</span></div>
        <span class="arrow"><img src="~/images/arrow-down.svg" alt="down arrow" width="12" /></span>
    </button>
    <div class="dropdown-menu" id="programme-management">
        <a class="dropdown-item" asp-area="FPS" asp-controller="ProgrammeSelect" asp-action="Index">Select Programme</a>
        <div class="sub-dropdown">
            <button class="sub-dropdown-toggle" data-subdropdown="plan-projects">
                Plan Projects
                <img src="~/images/right-arrow.png" class="sub-right-arrow" alt="expand" width="14" />
            </button>
            <div class="sub-dropdown-menu" id="plan-projects">
                <a class="dropdown-item" asp-area="FPS" asp-controller="Project" asp-action="Add">Set Up A New Project</a>
                <a class="dropdown-item" asp-area="FPS" asp-controller="ProgramProject" asp-action="Index">Plan Project Individually</a>
                <a class="dropdown-item" asp-area="FPS" asp-controller="ProgramStaffPlan" asp-action="Index">Plan Staff for Entire Programme</a>
                <a class="dropdown-item" asp-area="FPS" asp-controller="ProgramAnimalPlan" asp-action="Index">Plan Animals for Entire Programme</a>
                <a class="dropdown-item" asp-area="FPS" asp-controller="ProgramTestPlan" asp-action="Index">Plan Test Purchases for Entire Programme</a>
                <a class="dropdown-item" asp-area="FPS" asp-controller="ProgramAdditionalCostPlan" asp-action="Index">Plan Additional Cost for Entire Programme</a>
            </div>
        </div>
        <div class="sub-dropdown">
            <button class="sub-dropdown-toggle" data-subdropdown="pm-review-plans">
                Review Plans
                <img src="~/images/right-arrow.png" class="sub-right-arrow" alt="expand" width="14" />
            </button>
            <div class="sub-dropdown-menu" id="pm-review-plans">
                <a class="dropdown-item" asp-area="FPS" asp-controller="ProjectProfitability" asp-action="Index">Project Profitability</a>
                            <a class="dropdown-item" asp-area="FPS" asp-controller="StaffPlan" asp-action="Index">Staff Plan Pivot</a>
                        </div>
                    </div>
                </div>
            </div>

<!-- Resource Management -->
<div class="nav-item dropdown">

<!-- Project Plan Viewer -->
<div class="nav-item">
    <a class="nav-button" asp-area="FPS" asp-controller="ProjectPlanViewer" asp-action="Index" allow-edit="true">
        <div class="align-menu-text"><span>Project Plan Viewer</span></div>
    </a>
</div>


<!-- Project Management -->
<div class="nav-item dropdown">
    <button class="nav-button dropdown-toggle" data-dropdown="Project-Group" allow-edit="true">
        <div class="align-menu-text"><span>Project Group</span></div>
        <span class="arrow"><img src="~/images/arrow-down.svg" alt="down arrow" width="12" /></span>
    </button>
    <div class="dropdown-menu" id="Project-Group">
        <a class="dropdown-item" asp-area="FPS" asp-controller="ProjectGroupSelection" asp-action="Index">Select Project Group</a>
        <div class="sub-dropdown">
            <button class="sub-dropdown-toggle" data-subdropdown="plan-projects-group">
                Plan Projects Group
                <img src="~/images/right-arrow.png" class="sub-right-arrow" alt="expand" width="14" />
            </button>
            <div class="sub-dropdown-menu" id="plan-projects-group">
                <a class="dropdown-item" asp-area="FPS" asp-controller="Project" asp-action="Add">Set Up A New Project</a>
                <a class="dropdown-item" asp-area="FPS" asp-controller="ProgramProject" asp-action="Index" asp-route-source="projectgroup">Plan Project Group Individually</a>
            </div>
        </div>
        <div class="sub-dropdown">
            <button class="sub-dropdown-toggle" data-subdropdown="pm-review-plans-group">
                Review Plans
                <img src="~/images/right-arrow.png" class="sub-right-arrow" alt="expand" width="14" />
            </button>
            <div class="sub-dropdown-menu" id="pm-review-plans-group">
                <a class="dropdown-item" asp-area="FPS" asp-controller="ProjectProfitability" asp-action="Index" asp-route-source="projectgroup">Project Group Profitability</a>
                <a class="dropdown-item" asp-area="FPS" asp-controller="ProjectGroupStaffPlan" asp-action="Index">Staff Plan Pivot</a>
            </div>
        </div>        
    </div>
</div>


<!-- FPS Power Bi Report -->
<div class="nav-item dropdown">
    <button class="nav-button dropdown-toggle" data-dropdown="Report" allow-edit="true">
        <div class="align-menu-text"><span>Reports</span></div>
        <span class="arrow"><img src="~/images/arrow-down.svg" alt="down arrow" width="12" /></span>
    </button>
    <div class="dropdown-menu" id="Report">
        @if (!string.IsNullOrWhiteSpace(fpsPowerBiReportUrl))
        {
            <a href="@fpsPowerBiReportUrl"
               class="dropdown-item"
               target="_blank"
               rel="noopener noreferrer">
                FPS Power BI Report
            </a>
        }
    </div>
</div>
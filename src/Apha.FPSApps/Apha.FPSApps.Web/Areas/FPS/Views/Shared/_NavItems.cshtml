            <button class="sub-dropdown-toggle" data-subdropdown="setup-resource">
                Setup Resource
                <img src="~/images/right-arrow.png" class="sub-right-arrow" alt="expand" width="14" />
            </button>
            <div class="sub-dropdown-menu" id="setup-resource">
                <a class="dropdown-item" asp-area="FPS" asp-controller="ResourceSetUp" asp-action="Index">Enter Staff Resources (by Resource Centre)</a>
                <a class="dropdown-item" asp-area="FPS" asp-controller="SetUpStaffResources" asp-action="Index">WorkGroup Resources</a>
            </div>
        </div>
        <div class="sub-dropdown">
            <button class="sub-dropdown-toggle" data-subdropdown="rm-review-plans">
                Review Plans
                <img src="~/images/right-arrow.png" class="sub-right-arrow" alt="expand" width="14" />

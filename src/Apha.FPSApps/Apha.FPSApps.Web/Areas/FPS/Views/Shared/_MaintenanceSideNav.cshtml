@model string
@* activeItem: controller name of the currently active page (e.g. "StaffMaintenance", "ProgramMaintenance") *@
<style>
    .sidenav {
        margin-bottom: 0;
        align-self: flex-start;
    }
</style>
<script>
    function toggleSidebar() {
        const sidebar = document.querySelector('.sidenav');
        sidebar.classList.toggle('collapsed');
    }
</script>
<nav class="sidenav flex-column flex-shrink-0" id="shortnav">
    <button class="toggle-btn" onclick="toggleSidebar()" style="right: -8px; top: 30px;" allow-edit="true">
        <img src="../images/chevron-left-solid-full.svg" alt="side nav menu arrow" width="24">
    </button>
    <ul>
        <li>
          
                <a class="dropdown-item@(Model == "DivisionMaintenance" ? " sidenav-title" : "")"
                       asp-area="FPS" asp-controller="DivisionMaintenance" asp-action="Index">
                    Maintain Divisions
                </a>
           
            
        </li>
        <li>
            
                <a class="dropdown-item@(Model == "ResourceCentreMaintenance" ? " sidenav-title" : "")"
                       asp-area="FPS" asp-controller="ResourceCentreMaintenance" asp-action="Index">
                     Maintain Resource Centres
                </a>
           
        </li>
        <li>
            @* TRANSFORMENGINE: Maintain Workgroups — wired to WorkgroupMaintenanceController (Phase 12) *@
            <a class="dropdown-item@(Model == "WorkgroupMaintenance" ? " sidenav-title" : "")"
               asp-area="FPS" asp-controller="WorkgroupMaintenance" asp-action="Index">
                Maintain Workgroups
            </a>
        </li>
        <li>
            <a class="dropdown-item@(Model == "GradeMaintenance" ? " sidenav-title" : "")"
               asp-area="FPS" asp-controller="GradeMaintenance" asp-action="Index">
                Maintain Grades
            </a>
        </li>
        <li>
             <a class="dropdown-item@(Model == "TotalBusinessOverheadsMaintenance" ? " sidenav-title" : "")"
               asp-area="FPS" asp-controller="TotalBusinessOverheadsMaintenance" asp-action="Index">
                Maintain Total Buisness Overheads
            </a>
        </li>
        
        <li>
            <a class="dropdown-item@(Model == "DivisionGradeMaintenance" ? " sidenav-title" : "")"
               asp-area="FPS" asp-controller="DivisionGradeMaintenance" asp-action="Index">
                Maintain Division Grades
            </a>
        </li>
      
        <li>
            <a class="dropdown-item@(Model == "ProfitCentreGradeMaint" ? " sidenav-title" : "")"
               asp-area="FPS" asp-controller="ProfitCentreGradeMaint" asp-action="Index">
                Maintain RC Grades (Defra)
            </a>
        </li>
        <li>
            <a class="dropdown-item@(Model == "WorkGroupGradeMaintenance" ? " sidenav-title" : "")"
               asp-area="FPS" asp-controller="WorkGroupGradeMaintenance" asp-action="Index">
                Maintain WG Grades
            </a>
        </li>
        <li>
            <a class="dropdown-item@(Model == "WorkGroupStaffMaintenance" ? " sidenav-title" : "")"
               asp-area="FPS" asp-controller="WorkGroupStaffMaintenance" asp-action="Index">
                Maintain WG Staff
            </a>
          
        </li>
        <li>
            <a class="dropdown-item@(Model == "StaffMaintenance" ? " sidenav-title" : "")"
               asp-area="FPS" asp-controller="StaffMaintenance" asp-action="Index">
                Maintain Staff
            </a>
        </li>
        <li>
            <a class="dropdown-item@(Model == "ProgramMaintenance" ? " sidenav-title" : "")"
               asp-area="FPS" asp-controller="ProgramMaintenance" asp-action="Index">
                Maintain Programs
            </a>
        </li>
        <li>
            <a class="dropdown-item@(Model == "CostCentreMaintenance" ? " sidenav-title" : "")"
               asp-area="FPS" asp-controller="CostCentreMaintenance" asp-action="Index">
                Maintain Cost Centres
            </a>
        </li>
        <li>
            <a class="dropdown-item@(Model == "AccountCategory" ? " sidenav-title" : "")"
               asp-area="FPS" asp-controller="AccountCategoryMaintenance" asp-action="Index">
                Maintain Account Cats
            </a>
        </li>
        <li>
            <a class="dropdown-item@(Model == "AnimalMaintenance" ? " sidenav-title" : "")"
               asp-area="FPS" asp-controller="AnimalMaintenance" asp-action="Index">
                Maintain Animals
            </a>
        </li>
        <li>
            <a class="dropdown-item@(Model == "UserPermission" ? " sidenav-title" : "")"
               asp-area="FPS" asp-controller="UserPermission" asp-action="Index">
                Maintain User Permissions
            </a>
        </li>
    </ul>
</nav>

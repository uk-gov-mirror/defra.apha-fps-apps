@model Apha.FPSApps.Web.Areas.FPS.Models.ResourceCentreMaintenanceItem
@{
    var isEditMode = !string.IsNullOrWhiteSpace(Model?.ProfitCentreId);
    var title = isEditMode ? "Edit Resource Centre" : "Add Resource Centre";
    var formId = isEditMode ? "editResourceCentreForm" : "addResourceCentreForm";
    var saveLabel = isEditMode ? "Update" : "Save";
    var saveAction = isEditMode ? "updateResourceCentre()" : "saveResourceCentre()";
}

<div class="modal-header">
    <h5 class="modal-title" id="resourceCentreModalTitle">@title</h5>
    <button type="button" class="btn-close btn-red" onclick="closeModal()" data-bs-dismiss="modal">X</button>
</div>
<div class="modal-body">
    <div class="govuk-error-summary" role="alert"
         aria-labelledby="error-summary-title" tabindex="-1" style="display:none;">
        <h2 class="govuk-error-summary__title" id="error-summary-title">
            There is a problem
        </h2>
        <div class="govuk-error-summary__body">
            <ul class="govuk-list govuk-error-summary__list">
            </ul>
        </div>
    </div>
    <div class="row g-3">
        <form id="@formId">
            @if (isEditMode && Model != null)
            {
                <!-- Hidden field to store original ProfitCentreId for update operations -->
                <input type="hidden" id="originalProfitCentreId" value="@Model.ProfitCentreId" />
            }

            <div class="govuk-form-group sup_margin_0">
                <label class="govuk-label" asp-for="ProfitCentreId">Centre <span class="sup_color_red">*</span></label>
                @if (isEditMode)
                {
                    <input type="text" asp-for="ProfitCentreId" class="govuk-input" required maxlength="50" readonly disabled>
                }
                else
                {
                    <input type="text" asp-for="ProfitCentreId" class="govuk-input" required maxlength="50">
                }
                <span asp-validation-for="ProfitCentreId" class="govuk-error-message field-validation-valid" style="display:none;"></span>
            </div>

            <div class="govuk-form-group sup_margin_0">
                <label class="govuk-label" asp-for="ProfitCentreName">RC Name <span class="sup_color_red">*</span></label>
                <input type="text" asp-for="ProfitCentreName" class="govuk-input" required maxlength="40">
                <span asp-validation-for="ProfitCentreName" class="govuk-error-message field-validation-valid" style="display:none;"></span>
            </div>

            <div class="govuk-form-group sup_margin_0">
                <label class="govuk-label" asp-for="Division">Division <span class="sup_color_red">*</span></label>
                <select asp-for="Division" required class="govuk-select sup_width_100">
                    <option value="">-- Select Division --</option>
                </select>
                <input type="hidden" name="DivisionId" id="DivisionId" value="@(Model?.DivisionId)" />
                <span asp-validation-for="Division" class="govuk-error-message field-validation-valid" style="display:none;"></span>
            </div>

            <div class="govuk-form-group sup_margin_0">
                <label class="govuk-label" asp-for="ContTarget">Contribution Target</label>
                <div class="govuk-input__wrapper">
                    <div class="govuk-input__prefix" aria-hidden="true">&pound;</div>
                    <input type="text" maxlength="20" asp-for="ContTarget" class="govuk-input js-numeric-decimal">
                </div>
                <span asp-validation-for="ContTarget" class="govuk-error-message field-validation-valid" style="display:none;"></span>
            </div>

            <div class="govuk-form-group sup_margin_0">
                <label class="govuk-label" asp-for="ProfitCentreHead">RC Head</label>
                <select asp-for="ProfitCentreHead" class="govuk-select sup_width_100">
                    <option value="">-- Select RC Head --</option>
                </select>
                <span asp-validation-for="ProfitCentreHead" class="govuk-error-message field-validation-valid" style="display:none;"></span>
            </div>

            <div class="govuk-form-group sup_margin_0">
                <label class="govuk-label" asp-for="EmailRecipient">Email Recipient</label>
                <input type="email" asp-for="EmailRecipient" class="govuk-input" maxlength="50">
                <span asp-validation-for="EmailRecipient" class="govuk-error-message field-validation-valid" style="display:none;"></span>
            </div>
        </form>
    </div>
</div>
<div class="modal-footer sup_flex_space_center">
    <button class="govuk-button govuk-button--secondary sup_margin_0" data-module="govuk-button" data-bs-dismiss="modal" onclick="closeModal()">Cancel</button>
    <button class="govuk-button sup_margin_0" data-module="govuk-button" type="button" onclick="@saveAction">@saveLabel</button>
</div>

<script>
    $(document).ready(function () {
        loadDivisions();
        loadManagers();
    });

    function loadDivisions() {
        var $select = $('#Division');
        var currentDivision = '@(Model?.Division ?? string.Empty)';

        $.ajax({
            url: '@Url.Action("GetDistinctDivisions", "ResourceCentreMaintenance", new { area = "FPS" })',
            type: 'GET',
            success: function (response) {
                if (response.success && response.data) {
                    $select.find('option:not(:first)').remove();
                    $.each(response.data, function (index, div) {
                        $select.append($('<option></option>')
                            .attr('value', div.divisionName)
                            .text(div.divisionName));
                    });

                    // Set the selected value after all options are appended
                    if (currentDivision) {
                        $select.val(currentDivision);
                        var selectedOption = response.data.find(function (d) { return d.divisionName === currentDivision; });
                        if (selectedOption && selectedOption.divisionId) {
                            $('#DivisionId').val(selectedOption.divisionId);
                        }
                    } else {
                        $select.val('');
                    }

                    // Update DivisionId when Division selection changes
                    $select.on('change', function () {
                        var selectedOption = response.data.find(d => d.divisionName === $(this).val());
                        $('#DivisionId').val(selectedOption ? selectedOption.divisionId : '');
                    });
                }
            },
            error: function () {
                $select.append($('<option value=""></option>').text('Error loading divisions'));
            }
        });
    }

    function loadManagers() {
        var $select = $('#ProfitCentreHead');
        var currentHead = '@(Model?.ProfitCentreHead ?? string.Empty)';

        $.ajax({
            url: '@Url.Action("GetManagers", "ResourceCentreMaintenance", new { area = "FPS" })',
            type: 'GET',
            success: function (response) {
                if (response.success && response.data) {
                    $select.find('option:not(:first)').remove();
                    $.each(response.data, function (index, manager) {
                        $select.append($('<option></option>')
                            .attr('value', manager.name)
                            .text(manager.name));
                    });

                    // Set the selected value after all options are appended
                    if (currentHead) {
                        $select.val(currentHead);
                    } else {
                        $select.val('');
                    }
                }
            },
            error: function () {
                // Non-critical — leave the select empty if managers fail to load
            }
        });
    }
</script>


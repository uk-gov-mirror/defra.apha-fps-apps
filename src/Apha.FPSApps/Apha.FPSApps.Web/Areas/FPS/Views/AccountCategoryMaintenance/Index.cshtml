@using Apha.FPSApps.Web.Models.Components.DataGrid
@model Apha.FPSApps.Web.Areas.FPS.Models.AccountCategoryMaintenanceViewModel

@{
    ViewData["Title"] = "Account Category Maintenance";
}

<main id="main-content">
    <div class="container-fluid">
        <!-- Title section -->
        <div class="govuk-grid-row">
            <div class="govuk-grid-column-full">
                <h1 class="govuk-heading-s sup_border-bottom govuk-!-margin-top-2 govuk-!-padding-bottom-2 govuk-!-padding-left-4">Account Category Maintenance</h1>
            </div>
        </div>

        <div class="row">
            <div class="col-lg-12">
                <main class="main-content" style="padding:0;">
                    <div class="container-fluid" style="padding: 0;">
                        <div class="row">
                            <div class="container-fluid" style="padding-left:0px;">
                                <div style="display: flex; flex-direction: row; align-items: flex-start;">
                                    <!-- Side nav -->
                                    @await Html.PartialAsync("_MaintenanceSideNav", "AccountCategoryMaintenance")
                                    <div style="display: flex; flex-direction: column; flex: 1 1 auto; min-width: 0; margin: 0 0px 5px 8px;">
                                        <!-- Filter and Grid section -->
                                        <div class="govuk-grid-row">
                                            <div class="govuk-grid-column-full mt-2">
                                                <div class="" style="border-radius: 5px; justify-content: flex-start; margin-bottom: 10px; padding: 4px;">
                                                    <div class="row">
                                                        <div class="col-lg-7 align-items-center">
                                                            <div class="row">
                                                                <div class="col-lg-12">
                                                                    <fieldset class="govuk-fieldset">
                                                                        <legend class="govuk-fieldset__legend govuk-!-font-weight-bold govuk-!-font-size-16">Show me codes for</legend>
                                                                        <div class="govuk-radios govuk-radios--small govuk-radios--inline">
                                                                            <div class="govuk-radios__item">
                                                                                <input class="govuk-radios__input"
                                                                                       id="filter-rc"
                                                                                       name="filterType"
                                                                                       type="radio"
                                                                                       value="rc"
                                                                                       onchange="filterAccountCategories(this)">
                                                                                <label class="govuk-label govuk-radios__label sup_label_auto_width govuk-!-font-size-16" for="filter-rc">
                                                                                    Resource Centres
                                                                                </label>
                                                                            </div>
                                                                            <div class="govuk-radios__item">
                                                                                <input class="govuk-radios__input"
                                                                                       id="filter-ps"
                                                                                       name="filterType"
                                                                                       type="radio"
                                                                                       value="ps"
                                                                                       onchange="filterAccountCategories(this)">
                                                                                <label class="govuk-label govuk-radios__label sup_label_auto_width govuk-!-font-size-16" for="filter-ps">
                                                                                    Project Specific
                                                                                </label>
                                                                            </div>
                                                                            <div class="govuk-radios__item">
                                                                                <input class="govuk-radios__input"
                                                                                       id="filter-all"
                                                                                       name="filterType"
                                                                                       type="radio"
                                                                                       value="all"
                                                                                       checked
                                                                                       onchange="filterAccountCategories(this)">
                                                                                <label class="govuk-label govuk-radios__label sup_label_auto_width govuk-!-font-size-16" for="filter-all">
                                                                                    All
                                                                                </label>
                                                                            </div>
                                                                        </div>
                                                                    </fieldset>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                                <!-- Grid -->
                                                @if (Model.AccountCategoryGrid != null)
                                                {
                                                    <div id="@($"gridContainer_{Model.AccountCategoryGrid.GridId}")">
                                                        @await Html.PartialAsync("_DataGrid", Model.AccountCategoryGrid)
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </main>
            </div>
        </div>
    </div>
</main>

<!-- Modal for Add/Edit -->
<div id="accountCategoryModal" class="modal" tabindex="-1" role="dialog" aria-hidden="true" , aria-modal="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div id="accountCategoryModalContent"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/ajax-form-validation.js"></script>
    <script src="~/js/fps_js/AccountCategoryMaintenance.js"></script>
}
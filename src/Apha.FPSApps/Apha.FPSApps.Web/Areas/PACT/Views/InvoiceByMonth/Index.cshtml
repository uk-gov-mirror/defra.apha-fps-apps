@using Apha.FPSApps.Web.Models.Components.DataGrid
@model Apha.FPSApps.Web.Areas.PACT.Models.InvoiceByMonthViewModel

@{
    ViewData["Title"] = "Invoices by Month";
}

<div class="govuk-grid-row sup_margin_left_right_0">
    <div class="govuk-grid-column-full sup_border-bottom">
        <h1 class="heading_with_txtbox govuk-heading-s govuk-!-margin-top-2 govuk-!-margin-bottom-2">
            <span class="sup_flex_left_center">Invoices by Month</span>
        </h1>
    </div>
</div>

<div class="govuk-grid-row sup_margin_left_right_0 govuk-!-margin-top-3 sup_margin_bottom_10">
    <div class="govuk-grid-column-full">
        <div id="gridContainer_invoiceByMonthGrid">
            @await Html.PartialAsync("_DataGrid", Model.Grid)
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function toggleSidebar() {
            document.querySelector('.sidenav')?.classList.toggle('collapsed');
        }
    </script>
}

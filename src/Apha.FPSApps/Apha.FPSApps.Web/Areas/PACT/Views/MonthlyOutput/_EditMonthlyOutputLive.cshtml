@model Apha.FPSApps.Web.Areas.PACT.Models.MonthlyOutputLiveItem

@{
    var monthOptions = ViewBag.MonthOptions as IEnumerable<SelectListItem> ?? new List<SelectListItem>();
    var workGroups   = ViewBag.WorkGroups   as IEnumerable<SelectListItem> ?? new List<SelectListItem>();
}

<div class="modal-header flex-space-center">
    <h3 class="modal-title m-0" id="liveModalTitle">Edit Monthly Output</h3>
    <button type="button" class="btn-close btn-red" onclick="$('#modalPopup').removeClass('show')" aria-label="Close">X</button>
</div>

<div class="modal-body modal-body-custom" style="max-height: 500px;">
    <form id="monthlyOutputLiveForm" class="govuk-grid-column-full" novalidate>
        <input type="hidden" asp-for="CompositeKey" />

        <div id="liveForm-db-error" class="govuk-error-summary sup_margin_0" role="alert"
             aria-labelledby="liveForm-db-error-title" hidden>
            <h2 class="govuk-error-summary__title" id="liveForm-db-error-title">There is a problem</h2>
            <div class="govuk-error-summary__body">
                <ul class="govuk-list govuk-error-summary__list"></ul>
            </div>
        </div>

        <fieldset class="govuk-fieldset">
            <legend class="govuk-visually-hidden">Monthly Output Record</legend>

            <div class="govuk-form-group sup_margin_bottom_10" id="fg-live-workgroup">
                <div id="live-modal-workgroup-dropdown-container" class="modal-dropdown-container"></div>
                <input type="hidden" asp-for="WorkGroup" id="LiveWorkGroup" name="WorkGroup" required />
                <span data-valmsg-for="WorkGroup" class="govuk-error-message" style="display:none;"></span>
            </div>

            <div class="govuk-form-group sup_margin_bottom_10" id="fg-live-testcode">
                <label class="govuk-label govuk-!-font-weight-bold" asp-for="TestCode">
                    Test Code <span class="app-required" aria-hidden="true">*</span>
                </label>
                <input class="govuk-input govuk-!-font-size-16" asp-for="TestCode" id="LiveTestCode" disabled aria-label="Test Code" />
            </div>

            <div class="govuk-form-group sup_margin_bottom_10" id="fg-live-buyer">
                <label class="govuk-label govuk-!-font-weight-bold" asp-for="Buyer">
                    Buyer <span class="app-required" aria-hidden="true">*</span>
                </label>
                <input class="govuk-input govuk-!-font-size-16" asp-for="Buyer" id="LiveBuyer" disabled aria-label="Buyer" />
            </div>

            <div class="modal-form-row">
                <div class="govuk-form-group sup_margin_bottom_10 modal-form-col" id="fg-live-period">
                    <label for="LiveMonth" class="govuk-label govuk-!-font-weight-bold">
                        Period <span class="app-required" aria-hidden="true">*</span>
                    </label>
                    <select class="govuk-select govuk-!-font-size-16 sup_width_100" asp-for="Month"
                            asp-items="@monthOptions" id="LiveMonth" name="Month"
                            aria-required="true" required disabled>
                        <option value="">--select--</option>
                    </select>
                    <span data-valmsg-for="Month" class="govuk-error-message" style="display:none;"></span>
                </div>

                <div class="govuk-form-group sup_margin_bottom_10 modal-form-col" id="fg-live-volume">
                    <label for="LiveVolume" class="govuk-label govuk-!-font-weight-bold">
                        Volume <span class="app-required" aria-hidden="true">*</span>
                    </label>
                    <input type="text" class="govuk-input govuk-!-font-size-16 decfmt-input"
                           asp-for="Volume" id="LiveVolume" name="Volume" placeholder="Enter Volume"
                           autocomplete="off" aria-required="true" required/>
                    <span data-valmsg-for="Volume" class="govuk-error-message" style="display:none;"></span>
                </div>
            </div>

        </fieldset>
    </form>
</div>

<div class="modal-footer">
    <button type="button" class="govuk-button govuk-button--secondary sup_margin_0" onclick="$('#modalPopup').removeClass('show')">Cancel</button>
    <button type="button" class="govuk-button sup_margin_0" id="saveLiveOutputBtn" onclick="saveMonthlyOutputLive()">Save</button>
</div>

<script type="application/json" id="live-modal-workgroups-data">
    @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
        workGroups.Where(x => !string.IsNullOrWhiteSpace(x.Value))
                  .Select(x => new { value = x.Value, text = x.Text })))
</script>

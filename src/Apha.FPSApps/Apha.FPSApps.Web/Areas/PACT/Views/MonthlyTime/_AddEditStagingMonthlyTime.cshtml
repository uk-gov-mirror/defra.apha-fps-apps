@model Apha.FPSApps.Web.Areas.PACT.Models.StagingMonthlyTimeItem

@{
    var isEdit = Model.Id != 0;
    var workGroups      = ViewBag.WorkGroups    as IEnumerable<SelectListItem> ?? new List<SelectListItem>();
    var timeCodeOptions = ViewBag.TimeCodeOptions as IEnumerable<SelectListItem> ?? new List<SelectListItem>();
    var projectOptions  = ViewBag.ProjectOptions  as IEnumerable<SelectListItem> ?? new List<SelectListItem>();
    var monthOptions    = ViewBag.MonthOptions    as IEnumerable<SelectListItem> ?? new List<SelectListItem>();
}

@* Embed work-group list as JSON so JS can seed the dropdown without scraping the search filter *@
<script type="application/json" id="staging-modal-workgroups-data">
    @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
        workGroups.Where(x => x.Value != null && x.Value != "")
                  .Select(x => new { value = x.Value, text = x.Text })))
</script>
<script type="application/json" id="staging-modal-timecodes-data">
    @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
        timeCodeOptions.Where(x => !string.IsNullOrWhiteSpace(x.Value))
                       .Select(x => new { value = x.Value, text = x.Text })))
</script>
<script type="application/json" id="staging-modal-projects-data">
    @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
        projectOptions.Where(x => !string.IsNullOrWhiteSpace(x.Value))
                      .Select(x => new { value = x.Value, text = x.Text })))
</script>

<div class="modal-header flex-space-center">
    <h3 class="modal-title m-0" id="stagingModalTitle">@(isEdit ? "Edit Imported Time Record" : "Add Time Record")</h3>
    <button type="button" class="btn-close btn-red" onclick="$('#modalPopup').removeClass('show')" aria-label="Close">X</button>
</div>

<div class="modal-body modal-body-custom" style="max-height: 500px;">
    <form id="stagingMonthlyTimeForm" class="govuk-grid-column-full" novalidate>
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="PactId" id="StagingPactId" />

        <div id="stagingForm-db-error" class="govuk-error-summary sup_margin_0" role="alert"
             aria-labelledby="stagingForm-db-error-title" hidden>
            <h2 class="govuk-error-summary__title" id="stagingForm-db-error-title">There is a problem</h2>
            <div class="govuk-error-summary__body">
                <ul class="govuk-list govuk-error-summary__list"></ul>
            </div>
        </div>

        <fieldset class="govuk-fieldset">
            <legend class="govuk-visually-hidden">Time Record</legend>

            @* <span class="app-mandatory-note sup_padding_top_10" aria-hidden="true">
                <span class="app-required">*</span> Mandatory Fields
            </span> *@

            <div class="govuk-form-group sup_margin_bottom_10" id="fg-staging-workgroup">
                <div id="staging-modal-workgroup-dropdown-container" class="modal-dropdown-container"></div>
                <input type="hidden" asp-for="WorkGroup" id="StagingWorkGroup" name="WorkGroup" required />
                <span data-valmsg-for="WorkGroup" class="govuk-error-message" style="display:none;"></span>
            </div>

            <div class="govuk-form-group sup_margin_bottom_10" id="fg-staging-id">
                <label for="StagingPactStaffId" class="govuk-label govuk-!-font-weight-bold">
                    Staff Pact ID
                </label>
                <input type="text" class="govuk-input govuk-!-font-size-16" id="StagingPactStaffId"
                       asp-for="PactStaffId" placeholder="Select a name to populate"
                       autocomplete="off" aria-describedby="live-modal-id-error" disabled />
            </div>

            <div class="govuk-form-group sup_margin_bottom_10" id="fg-staging-name">
                <label class="govuk-label govuk-!-font-weight-bold" asp-for="Name">
                    Name <span class="app-required" aria-hidden="true">*</span>
                </label>
                <div id="staging-modal-name-dropdown"></div>
                <input type="hidden" asp-for="Name" id="StagingName" name="Name"
                       aria-describedby="staging-modal-name-error" aria-required="true" required />
                <span data-valmsg-for="Name" class="govuk-error-message" style="display:none;"></span>
            </div>

            <div class="govuk-form-group sup_margin_bottom_10" id="fg-staging-timecode">
                <label for="StagingTimeCode" class="govuk-label govuk-!-font-weight-bold">
                    Time Code <span class="app-required" aria-hidden="true">*</span>
                </label>
                <div id="staging-modal-timecode-dropdown" class="modal-dropdown-container"></div>
                <input type="hidden" asp-for="TimeCode" id="StagingTimeCode" name="TimeCode"
                       aria-describedby="staging-modal-timecode-error" aria-required="true" required />
                <span data-valmsg-for="TimeCode" class="govuk-error-message" style="display:none;"></span>
            </div>

            <div class="govuk-form-group sup_margin_bottom_10" id="fg-staging-parentproject">
                <label for="StagingParentProject" class="govuk-label govuk-!-font-weight-bold">
                    Parent Project <span class="app-required" aria-hidden="true">*</span>
                </label>
                <div id="staging-modal-parentproject-dropdown" class="modal-dropdown-container"></div>
                <input type="hidden" asp-for="ParentProject" id="StagingParentProject" name="ParentProject"
                       aria-describedby="staging-modal-parentproject-error" aria-required="true" required />
                <span data-valmsg-for="ParentProject" class="govuk-error-message" style="display:none;"></span>
            </div>

            <div class="modal-form-row">
                <div class="govuk-form-group sup_margin_bottom_10 modal-form-col" id="fg-staging-period">
                    <label for="StagingMonth" class="govuk-label govuk-!-font-weight-bold">
                        Period <span class="app-required" aria-hidden="true">*</span>
                    </label>
                    <select class="govuk-select govuk-!-font-size-16 sup_width_100" asp-for="Month"
                            asp-items="@monthOptions" id="StagingMonth" name="Month"
                            aria-describedby="staging-modal-period-error" aria-required="true" required>
                        <option value="">--select--</option>
                    </select>
                    <span data-valmsg-for="Month" class="govuk-error-message" style="display:none;"></span>
                </div>

                <div class="govuk-form-group sup_margin_bottom_10 modal-form-col" id="fg-staging-hours">
                    <label for="StagingHours" class="govuk-label govuk-!-font-weight-bold">
                        Hours <span class="app-required" aria-hidden="true">*</span>
                    </label>
                    <input type="text" class="govuk-input govuk-!-font-size-16 decfmt-input"
                           asp-for="Hours" id="StagingHours" name="Hours" placeholder="Enter Hours"
                           autocomplete="off" aria-describedby="staging-modal-hours-error" aria-required="true" required />
                    <span asp-validation-for="Hours" class="govuk-error-message"></span>
                </div>
            </div>

        </fieldset>
    </form>
</div>

<div class="modal-footer modal-footer-custom">
    <button type="button" class="govuk-button govuk-button--secondary sup_margin_0"
            aria-label="Cancel" onclick="$('#modalPopup').removeClass('show')">Cancel</button>
    <button type="button" class="govuk-button sup_margin_0"
            aria-label="@(isEdit ? "Update" : "Save")" onclick="saveStagingMonthlyTime()" allow-edit="true">@(isEdit ? "Update" : "Save")</button>
</div>

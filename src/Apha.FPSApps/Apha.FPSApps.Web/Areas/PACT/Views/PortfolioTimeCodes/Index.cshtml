@using Apha.FPSApps.Web.Models.Components.DataGrid
@model Apha.FPSApps.Web.Areas.PACT.Models.PortfolioTimeCodesViewModel

@{
    ViewData["Title"] = "Portfolio Time Codes - PACT";
    var selectedPortfolio = Model.SelectedPortfolio ?? string.Empty;
}

<!-- Page title bar -->
<div class="govuk-grid-row sup_margin_left_right_0">
    <div class="govuk-grid-column-full sup_flex_align_center sup_border-bottom">
        <h1 class="heading_with_txtbox govuk-heading-s sup_margin_bottom_0 govuk-!-margin-bottom-2 sup_whitespace_nowrap">
            Portfolio Time Codes for:           
        </h1>
        <div class="sup_flex_left_center govuk-grid-column-one-third">
            <div id="portfolioMultiDropdown" 
                class="govuk-grid-column-two-thirds sup_p_0"></div>
        </div>
        <div class="govuk-grid-column-one-half sup_text_align_right">
            <a asp-area="PACT" asp-controller="PortfolioMaintenance" asp-action="Index" asp-route-portfolio="@Model.SelectedPortfolio"
               class="govuk-back-link sup_font_weight_700">Back</a>
        </div>
    </div>
</div>

@if (!string.IsNullOrEmpty(selectedPortfolio))
{
    <!-- Test Purchase Requirements Button -->
    <div class="govuk-grid-row sup_margin_left_right_0 govuk-!-margin-top-2">
        <div class="govuk-grid-column-full sup_text_align_right">
            <a asp-area="PACT" 
               asp-controller="PortfolioTimeCodes" 
               asp-action="NavigateToTestPurchaseRequirements" 
               asp-route-parentProject="@selectedPortfolio"
               class="govuk-button sup_margin_0">
                <img src="~/images/list-solid-full_white.svg" alt="" aria-hidden="true" style="width: 16px; vertical-align: middle;" />
                Test Purchase Requirements
            </a>
        </div>
    </div>
}

<!-- Main Content Area -->
<div class="govuk-grid-row sup_flex_row sup_margin_left_right_0 sup_margin_bottom_10">

    @if (!string.IsNullOrEmpty(selectedPortfolio))
    {
        <!-- Side Navigation -->
        @await Html.PartialAsync("_PactProjectSideNav", new Apha.FPSApps.Web.Areas.PACT.Models.PactProjectSideNavModel
        {
            ParentProject = selectedPortfolio
        })
    }

    <!-- Main Grid Container -->
    <div class="govuk-grid-column-full">

        <!-- Project Job Codes Grid -->
        <div class="govuk-grid-row sup_margin_left_right_0">
            <div class="sup_border sup_margin_top_10">
                <div id="@($"gridContainer_{Model.JobCodeGrid.GridId}")">
                    @await Html.PartialAsync("_DataGrid", Model.JobCodeGrid)
                </div>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(selectedPortfolio))
        {
            <!-- Time Code Validity Grid -->
            <div class="govuk-grid-row sup_margin_left_right_0 sup_margin_top_10">
                <div class="sup_border">
                    <div id="@($"gridContainer_{Model.TimeCodeGrid.GridId}")">
                        @await Html.PartialAsync("_DataGrid", Model.TimeCodeGrid)
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/common/multicolumn-dropdown.css" />
}

@section Scripts {
    <script>
        const portfolioOptionsListData = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.PortfolioOptions));
        const selectedPortfolioValue = '@Html.Raw(Model.SelectedPortfolio ?? "")';
    </script>
    <script src="~/js/common/multicolumn-dropdown.component.js"></script>
    <script src="~/js/pact_js/portfolio-timecodes.js"></script>
    <script src="~/js/ajax-form-validation.js"></script>
    <script>
        // Initialize the Portfolio Time Codes module with current values
        initPortfolioTimeCodes(
            '@selectedPortfolio',
            '@Model.JobCodeGrid.GridId',
            '@Model.TimeCodeGrid.GridId'
        );
    </script>
}

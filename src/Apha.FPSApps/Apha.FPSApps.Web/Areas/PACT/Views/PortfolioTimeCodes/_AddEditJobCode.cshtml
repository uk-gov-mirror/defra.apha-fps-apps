@model Apha.FPSApps.Web.Areas.PACT.Models.PortfolioJobCodeViewModel
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    var isEdit = !string.IsNullOrEmpty(Model.JobCodeId);
}

<div class="modal-header flex-space-center">
    <h3 class="govuk-heading-s" style="margin:0;">@(isEdit ? "Edit Job Code" : "Add Job Code")</h3>
    <button type="button" class="btn-close" onclick="$('#modalPopup').removeClass('show')">×</button>
</div>

<div class="modal-body" style="padding:8px 16px 0 16px;">
    <form id="jobCodeForm" class="govuk-grid-column-full">

        <input type="hidden" name="isEdit" value="@isEdit.ToString().ToLower()" />

        <!-- Validation error summary -->
        <div class="govuk-error-summary" role="alert"
             aria-labelledby="error-summary-title" tabindex="-1" style="display:none;">
            <h2 class="govuk-error-summary__title" id="error-summary-title">There is a problem</h2>
            <div class="govuk-error-summary__body">
                <ul class="govuk-list govuk-error-summary__list"></ul>
            </div>
        </div>
        <!-- Project Dropdown at Top -->
        <div class="govuk-form-group sup_margin_bottom_10">
            <label class="govuk-label govuk-!-font-weight-bold" asp-for="ParentProject">Project<span class="sup_color_red">* </span></label>
            <select asp-for="ParentProject" class="govuk-select govuk-!-font-size-16"
                    asp-items="@(ViewBag.Projects as List<SelectListItem>)" required>
                <option value="">--select project--</option>
            </select>
            <span asp-validation-for="ParentProject" class="govuk-error-message"></span>
        </div>

        <!-- Job Code -->
        <div class="govuk-form-group sup_margin_bottom_10">
            <label class="govuk-label govuk-!-font-weight-bold" asp-for="JobCodeId">Job Code<span class="sup_color_red">* </span></label>
            @if (isEdit)
            {
                <input type="hidden" asp-for="JobCodeId" />
                <input class="govuk-input govuk-!-font-size-16" value="@Model.JobCodeId" disabled />
            }
            else
            {
                <input class="govuk-input govuk-!-font-size-16" asp-for="JobCodeId" />
                <span asp-validation-for="JobCodeId" class="govuk-error-message"></span>
            }
        </div>

        <!-- Name / Description -->
        <div class="govuk-form-group sup_margin_bottom_10">
            <label class="govuk-label govuk-!-font-weight-bold" asp-for="JobCodeName">Name<span class="sup_color_red">* </span></label>
            <textarea class="govuk-textarea govuk-!-font-size-16 sup_margin_0"
                      asp-for="JobCodeName" rows="3" required></textarea>
            <span asp-validation-for="JobCodeName" class="govuk-error-message"></span>
        </div>

        <!-- Type -->
        <div class="govuk-form-group sup_margin_bottom_10">
            <label class="govuk-label govuk-!-font-weight-bold" asp-for="Type">Type<span class="sup_color_red">* </span></label>
            <select asp-for="Type" asp-items="ViewBag.Types" class="govuk-select govuk-!-font-size-16" required>
                <option value="">--select type--</option>
            </select>
            <span asp-validation-for="Type" class="govuk-error-message"></span>
        </div>

        <!-- Work Group -->
        <div class="govuk-form-group sup_margin_bottom_10">
            <div id="workGroupMultiDropdown"></div>
            <input type="hidden" asp-for="JobCodeWorkGroup" id="JobCodeWorkGroup" />
            <span asp-validation-for="JobCodeWorkGroup" class="govuk-error-message"></span>
        </div>
    </form>
</div>

<div class="modal-footer" style="display:flex; justify-content:space-between; align-items:center;">
    <button type="button" class="govuk-button govuk-button--secondary sup_margin_0"
            onclick="$('#modalPopup').removeClass('show')">Cancel</button>
    <button type="button" class="govuk-button sup_margin_0" onclick="saveJobCode()" allow-edit="true">
        @(isEdit ? "Update" : "Save")
    </button>
</div>

<script>
    $(document).ready(function () {
        var workGroupData = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.WorkGroupsData ?? new List<object>()));
        var selectedWorkGroup = '@Html.Raw(Model.JobCodeWorkGroup ?? "")';

        initializeJobCodeWorkGroupDropdown({
            workGroupData: workGroupData,
            selectedWorkGroup: selectedWorkGroup
        });
    });
</script>
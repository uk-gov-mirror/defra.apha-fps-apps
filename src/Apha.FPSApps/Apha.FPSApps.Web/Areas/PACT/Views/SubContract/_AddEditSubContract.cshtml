@model Apha.FPSApps.Web.Areas.PACT.Models.SubContractItem

@{
    var isEdit = Model.SubContCounter != 0;
}

<div class="modal-header flex-space-center">
    <h3 class="govuk-heading-s sup_margin_0">@(isEdit ? "Edit SubContract" : "Add SubContract")</h3>
    <button type="button" class="btn-close" onclick="$('#modalPopup').removeClass('show')">×</button>
</div>

<div class="modal-body" style="overflow:hidden; padding:8px 16px 0 16px;">
    <form id="subContractForm" class="govuk-grid-column-full">

        <input type="hidden" name="isEdit" value="@isEdit.ToString().ToLower()" />
        <input type="hidden" asp-for="SubContCounter" />

        <!-- Validation error summary -->
        <div class="govuk-error-summary" role="alert"
             aria-labelledby="error-summary-title" tabindex="-1" style="display:none;">
            <h2 class="govuk-error-summary__title" id="error-summary-title">There is a problem</h2>
            <div class="govuk-error-summary__body">
                <ul class="govuk-list govuk-error-summary__list"></ul>
            </div>
        </div>

        @if (isEdit)
        {
            <div class="govuk-grid-row sup_margin_top_10" id="divSubContCounter" style="display: none;">
                <div class="govuk-grid-column-one-half">
                    <div class="govuk-form-group sup_margin_bottom_10">
                        <label class="govuk-label" asp-for="SubContCounter" style="display: none;">SubContract Counter</label>
                        <div class="govuk-input__wrapper">
                            <input class="govuk-input govuk-!-font-size-16" value="@Model.SubContCounter" readonly disabled />
                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="govuk-grid-row sup_margin_top_10">
            <div class="govuk-grid-column-one-half">
                <div class="govuk-form-group sup_margin_bottom_10">
                    <label class="govuk-label" for="projectMultiDropdown_input">
                        Project:<span class="sup_color_red">*</span>
                    </label>
                    <div id="projectMultiDropdown"></div>
                    <input type="hidden" asp-for="Project" id="Project" required />
                    <span asp-validation-for="Project" class="govuk-error-message"></span>
                </div>
            </div>
            <div class="govuk-grid-column-one-half">
                <div class="govuk-form-group sup_margin_bottom_10">
                    <label class="govuk-label" asp-for="Month">
                        Month:<span class="sup_color_red">*</span>
                    </label>
                    @{
                        var months = ViewBag.Months as IEnumerable<SelectListItem> ?? new List<SelectListItem>();
                    }
                    <select class="govuk-select sup_select_option_width_100 govuk-!-font-size-16"
                            asp-for="Month"
                            asp-items="@months"
                            required>
                        <option value="">-- select month --</option>
                    </select>
                    <span asp-validation-for="Month" class="govuk-error-message"></span>
                </div>
            </div>
        </div>

        <div class="govuk-grid-row">
            <div class="govuk-grid-column-one-half">
                <div class="govuk-form-group sup_margin_bottom_10">
                    <label class="govuk-label" asp-for="AcctCode">Account Code</label>
                    <input type="text" class="govuk-input govuk-!-font-size-16"
                           asp-for="AcctCode" placeholder="Enter account code" />
                </div>
            </div>
            <div class="govuk-grid-column-one-half">
                <div class="govuk-form-group sup_margin_bottom_10">
                    <label class="govuk-label" asp-for="Amount">
                        Amount:<span class="sup_color_red">*</span>
                    </label>
                    <div class="govuk-input__wrapper">
                        <div class="govuk-input__prefix" aria-hidden="true">£</div>
                        <input type="number" class="govuk-input govuk-!-font-size-16"
                               asp-for="Amount" step="0.01" placeholder="e.g., 1000" required />                      
                    </div> 
                    <span data-valmsg-for="Amount" class="govuk-error-message"></span>
                </div>
            </div>
        </div>

        <div class="govuk-grid-row">
            <div class="govuk-grid-column-one-half">
                <div class="govuk-form-group sup_margin_bottom_10">
                    <label class="govuk-label" asp-for="WorkGroup">Work Group</label>
                    <input type="text" class="govuk-input govuk-!-font-size-16"
                           asp-for="WorkGroup" placeholder="Enter work group" />
                </div>
            </div>
            <div class="govuk-grid-column-one-half">
                <div class="govuk-form-group sup_margin_bottom_10">
                    <label class="govuk-label" asp-for="TestJob">Test Job</label>
                    <input type="text" class="govuk-input govuk-!-font-size-16"
                           asp-for="TestJob" placeholder="Enter test job" />
                </div>
            </div>
        </div>

        <div class="govuk-grid-row">
            <div class="govuk-grid-column-one-half">
                <div class="govuk-form-group sup_margin_bottom_10">
                    <label class="govuk-label" asp-for="Supplier">Supplier</label>
                    <input type="text" class="govuk-input govuk-!-font-size-16"
                           asp-for="Supplier" placeholder="Enter supplier" />
                </div>
            </div>
            <div class="govuk-grid-column-one-half">
                <div class="govuk-form-group sup_margin_bottom_10">
                    <label class="govuk-label" asp-for="SupplierNumber">Supplier Number</label>
                    <input type="number" class="govuk-input govuk-!-font-size-16"
                           asp-for="SupplierNumber" placeholder="Enter supplier number" />
                </div>
            </div>
        </div>

        <div class="govuk-form-group sup_margin_bottom_10">
            <label class="govuk-label" asp-for="Description">Description</label>
            <textarea class="govuk-textarea govuk-!-font-size-16 sup_margin_0"
                      asp-for="Description" rows="3"
                      placeholder="Enter subcontract description..."></textarea>
        </div>

    </form>
</div>

<div class="modal-footer sup_flex_space_center">
    <button type="button" class="govuk-button govuk-button--secondary sup_margin_0"
            onclick="$('#modalPopup').removeClass('show')">Cancel</button>
    <button type="button" class="govuk-button sup_margin_0" onclick="saveSubContract()" allow-edit="true">
        @(isEdit ? "Update" : "Save")
    </button>
</div>

<script>
    $(document).ready(function () {
        var projectsData = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.Projects ?? new List<object>()));
        var selectedProject = '@Html.Raw(Model.Project ?? "")';

        initializeSubContractProjectDropdown({
            projectsData: projectsData,
            selectedProject: selectedProject
        });
    });
</script>
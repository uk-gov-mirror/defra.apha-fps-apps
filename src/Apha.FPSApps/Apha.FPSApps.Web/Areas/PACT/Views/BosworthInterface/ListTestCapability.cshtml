@model Apha.FPSApps.Web.Areas.PACT.Models.BosworthInterfaceViewModel

@{
    ViewData["Title"] = "List Test Capabilities";
}
<div class="govuk-grid-row sup_margin_left_right_0">
    <div class="govuk-grid-column-full sup_border-bottom">
        <h1 class="govuk-heading-s sup_margin_top_10 sup_margin_bottom_10"> 
                WorkGroup Test Capability List
            @if (TempData["NavigationSource"]?.ToString() == "BosworthInterface")
            {
                <a asp-area="PACT"
                asp-controller="BosworthInterface"
                asp-action="Index"
                class="govuk-back-link sup_align_right">Back</a>
            }
        </h1>
    </div>
</div>

<div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
        <div id="gridContainer_wgTestCapabilitiesGrid">
            @await Html.PartialAsync("_DataGrid", Model.CapabilitiesGrid)
        </div>
    </div>
</div>

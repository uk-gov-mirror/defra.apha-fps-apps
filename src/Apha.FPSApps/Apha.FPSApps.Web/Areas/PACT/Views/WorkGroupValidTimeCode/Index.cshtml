@model Apha.FPSApps.Web.Areas.PACT.Models.WorkGroupValidTimeCodeViewModel

@{
    ViewData["Title"] = "PACT : Work Group Valid Time Codes";
}

<div class="govuk-grid-column-full sup_border-bottom">
    <h1 class="sup_margin_top_10 sup_padding_bottom_10">
        Time codes valid for WorkGroup 
        <a asp-area="PACT"
        asp-controller="WorkGroupPeople"
        asp-action="Index"
        asp-route-workGroup="@Model.SelectedWorkGroup"
        class="govuk-back-link sup_align_right">Back</a></h1>
</div>
@* Filter Header *@
<div class="govuk-grid-row sup_margin_left_right_0 sup_flex_left_center sup_padding_bottom_10 sup_border-bottom" style="margin-top:10px;">

    @* Work Group dropdown *@
    <div class="govuk-grid-column-one-third">
        <label for="workGroupSelect" class="govuk-label govuk-!-font-weight-bold govuk-!-margin-top-1">Select a Work Group</label>
        <div style="position: relative; z-index: 50;">
            <input type="text" id="workGroupSelect" placeholder="Select Work Group" autocomplete="off"
                   class="govuk-input govuk-!-font-size-16 down-arrow-img" style="width:100%; cursor:pointer;" readonly />
            <div id="workGroupDropdownPanel" style="display:none; position:absolute; top:100%; left:0; width:100%;
                    max-height:260px; overflow-y:auto; background:#fff; border:1px solid #b1b4b6;
                    box-shadow:0 4px 8px rgba(0,0,0,.2); z-index:2000;">
                <input type="text" id="workGroupSearchBox" placeholder="Type to search work group"  aria-label="Search work group"
                       style="width:100%; padding:6px 8px; border:0; border-bottom:1px solid #b1b4b6; outline:none; box-sizing:border-box;" />
                <table style="width:100%; border-collapse:collapse; font-size:14px;">
                    <thead style="background:#f3f2f1; position:sticky; top:0; z-index:10;">
                        <tr>
                            <th style="padding:6px 8px; text-align:left;">Work Group</th>
                            <th style="padding:6px 8px; text-align:left;">Profit Centre</th>
                        </tr>
                    </thead>
                    <tbody id="workGroupDropdownBody">
                        @foreach (var item in Model.WorkGroupOptions)
                        {
                            <tr data-value="@item.WorkGroupName" style="cursor:pointer;">
                                <td style="padding:6px 8px; border-bottom:1px solid #f3f2f1;">@item.WorkGroupName</td>
                                <td style="padding:6px 8px; border-bottom:1px solid #f3f2f1;">@item.ProfitCentre</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>

@* Valid Time Codes Data Grid *@
<div class="govuk-grid-row sup_margin_left_right_0 sup_margin_top_10">
    <div class="govuk-grid-column-full">
        <div id="gridContainer_validTimeCodesGrid">
            @await Html.PartialAsync("_DataGrid", Model.ValidTimeCodesGrid)
        </div>
    </div>
</div>

<div class="govuk-grid-column-full sup_flex_space_between sup_padding_left_8 govuk-!-margin-top-2 sup_margin_bottom_10">
    <div class="sup_flex_center_start govuk-grid-column-two-thirds sup_p_0">
        <label for="selectedProject" class="govuk-label govuk-!-font-weight-bold  sup_margin_right_10">I have selected:</label>
        <input type="text" id="selectedProject" class="govuk-input govuk-!-width-one-third" readonly="" disabled="">
    </div>
    <div class="sup_float_right">
        <button type="button" class="govuk-button sup_p_8 sup_margin_0" id="btnShowProjectAdministraction" aria-label="Show me Project Administration" data-module="govuk-button" disabled>
            Show me Project Administration....
        </button>
    </div>
</div>

<input type="hidden" id="hdnSelectedWorkGroup" value="@Model.SelectedWorkGroup" />

@section Scripts {
    <script src="~/js/pact_js/work-group-valid-time-code.js"></script>
    <script>
        validTimeCodesGridId = '@Model.ValidTimeCodesGrid.GridId';
    </script>
}

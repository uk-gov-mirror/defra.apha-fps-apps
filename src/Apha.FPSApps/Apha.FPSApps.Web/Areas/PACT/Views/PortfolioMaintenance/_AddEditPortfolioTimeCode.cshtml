@model Apha.FPSApps.Web.Areas.PACT.Models.PortfolioTimeCodeViewModel
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    var isEdit = Model.IsEdit;
}

<div class="modal-header flex-space-center">
    <h3 class="govuk-heading-s" style="margin:0;">@(isEdit ? "Edit Work Group" : "Add New Workgroup")</h3>
    <button type="button" class="btn-close" onclick="$('#modalPopup').removeClass('show')">×</button>
</div>

<div class="modal-body" style="overflow:hidden; padding:8px 16px 0 16px;">
    <form id="timeCodeForm" class="govuk-grid-column-full" data-workgroup="@Model.WorkGroup">

        <input type="hidden" name="isEdit" value="@isEdit.ToString().ToLower()" />

        <!-- Validation error summary -->
        <div class="govuk-error-summary" role="alert"
             aria-labelledby="error-summary-title" tabindex="-1" style="display:none;">
            <h2 class="govuk-error-summary__title" id="error-summary-title">
                There is a problem
            </h2>
            <div class="govuk-error-summary__body">
                <ul class="govuk-list govuk-error-summary__list"></ul>
            </div>
        </div>

        <!-- Work Group -->
        <div class="govuk-form-group sup_margin_bottom_10">
            <label class="govuk-label govuk-!-font-weight-bold" asp-for="WorkGroup">
                Work Group <span class="sup_color_red">*</span>
            </label>
            <select class="govuk-select govuk-!-font-size-16" asp-for="WorkGroup" asp-label=" WorkGroup"
                    id="txtmodal-workgrp" style="width:100%;" required
                    asp-items="@(ViewBag.WorkGroups as List<SelectListItem>)"
                    disabled="@(isEdit ? "disabled" : null)">
                <option value="">--Select Work Group--</option>
            </select>
            <span asp-validation-for="WorkGroup" class="govuk-error-message"></span>
        </div>

        <!-- Time Code -->
        <div class="govuk-form-group sup_margin_bottom_10">
            <label class="govuk-label govuk-!-font-weight-bold" asp-for="TimeCode">
                Time Code <span class="sup_color_red">*</span>
            </label>
            @if (isEdit)
            {
                <input class="govuk-input govuk-!-font-size-16" asp-for="TimeCode"
                       id="txtmodal-wg-timecode" aria-label="txtmodal-wg-timecode" placeholder="Time Code" disabled />
            }
            else
            {
                <input class="govuk-input govuk-!-font-size-16" asp-for="TimeCode"
                       id="txtmodal-wg-timecode" placeholder="Time Code" aria-label="txtmodal-wg-timecode" />
            }
            <span asp-validation-for="TimeCode" class="govuk-error-message"></span>
        </div>

        <!-- Project -->
        <div class="govuk-form-group sup_margin_bottom_10">
            <label class="govuk-label govuk-!-font-weight-bold" asp-for="ParentProject">
                Project <span class="sup_color_red">*</span>
            </label>
            <select class="govuk-select govuk-!-font-size-16" asp-for="ParentProject"
                    id="txtmodal-wg-project" style="width:100%;" required
                    asp-items="@(ViewBag.ProjectOptions as List<SelectListItem>)"
                    disabled="@(isEdit ? "disabled" : null)">
                <option value="">-- Select Project --</option>
            </select>
            <span asp-validation-for="ParentProject" class="govuk-error-message"></span>
        </div>

        <!-- Test Code (readonly) -->
        <div class="govuk-form-group sup_margin_bottom_10">
            <label class="govuk-label govuk-!-font-weight-bold" asp-for="TestCode">
                Test Code <span class="sup_color_red">*</span>
            </label>
            <input class="govuk-input govuk-!-font-size-16" asp-for="TestCode"
                   id="txtmodal-wg-testcode" aria-label="txtmodal-wg-testcode"  placeholder="Test Code" disabled />
            <span asp-validation-for="TestCode" class="govuk-error-message"></span>
        </div>

        <!-- Portfolio (readonly) -->
        <div class="govuk-form-group sup_margin_bottom_10">
            <label class="govuk-label govuk-!-font-weight-bold" asp-for="Portfolio">
                Portfolio <span class="sup_color_red">*</span>
            </label>
            <input class="govuk-input govuk-!-font-size-16" asp-for="Portfolio"
                   id="txtmodal-wg-portfolio" placeholder="Portfolio" disabled />
            <span asp-validation-for="Portfolio" class="govuk-error-message"></span>
        </div>

        <!-- Active -->
        <div class="govuk-form-group sup_margin_bottom_10">
            <label class="govuk-label govuk-!-font-weight-bold" asp-for="Active">
                Active
                @if (!isEdit)
                {
                    <span class="sup_color_red">* </span>
                }
            </label>
            <div class="govuk-checkboxes govuk-checkboxes--small sup_margin_0" data-module="govuk-checkboxes">
                <div class="govuk-checkboxes__item">
                    <input class="govuk-checkboxes__input"
                           id="txtmodal-wg-active" asp-for="Active" />
                    <label class="govuk-label govuk-checkboxes__label sup_label_auto_width" asp-for="Active">
                        Yes
                    </label>
                </div>
            </div>
            <span asp-validation-for="Active" class="govuk-error-message"></span>
        </div>

    </form>
</div>

<div class="modal-footer" style="padding:8px 16px;">
    <button type="button" class="govuk-button govuk-button--secondary sup_margin_0"
            onclick="$('#modalPopup').removeClass('show')">
        Cancel
    </button>
    <button type="button" class="govuk-button sup_margin_0"
            onclick="@(isEdit ? "updatePortfolioTimeCode()" : "savePortfolioTimeCode()")">
        @(isEdit ? "Update" : "Save")
    </button>
</div>

@using Apha.FPSApps.Web.Models.Components.DataGrid
@model Apha.FPSApps.Web.Areas.PACT.Models.TestPurchaseRequirementViewModel

@{
    ViewData["Title"] = "Test Purchase Requirements";
}

<div class="govuk-grid-row sup_margin_left_right_0">
    <div class="govuk-grid-column-full">
        <h1 class="heading_with_txtbox govuk-heading-s sup_border-bottom">
            <span class="sup_flex_left_center">
                Test Purchase Requirements for: &nbsp;&nbsp;
                <label class="sup_hidden_label" for="sp-projectcode">project code</label>
                <input type="text" id="sp-projectcode"
                       class="govuk-input govuk-!-font-size-16 govuk-input--width-10"
                       value="@Model.ParentProject"
                       onchange="navigateToProjectCode(this.value)" />
            </span>
            <span>
                @if (Model.NavigationOrigin == "PortfolioTimeCodes")
                {
                    <a class="govuk-back-link"
                       asp-area="PACT"
                       asp-controller="PortfolioTimeCodes"
                       asp-action="Index"
                       asp-route-parentProject="@Model.ParentProject">Back</a>
                }
                else if (Model.NavigationOrigin == "PortfolioMaintenance")
                {
                    <a class="govuk-back-link"
                       asp-area="PACT"
                       asp-controller="PortfolioMaintenance"
                       asp-action="Index"
                    asp-route-portfolio="@Model.ParentProject">Back</a>
                }
                else
                {
                    <a class="govuk-back-link"
                       asp-area="PACT"
                       asp-controller="ProjectMaintenance"
                       asp-action="Details"
                       asp-route-id="@Model.ParentProject">Back</a>
                }
            </span>
        </h1>
    </div>
</div>

<div class="govuk-grid-row sup_flex_row sup_margin_left_right_0 sup_margin_bottom_10">

    @await Html.PartialAsync("_PactProjectSideNav", new Apha.FPSApps.Web.Areas.PACT.Models.PactProjectSideNavModel
    {
        ParentProject = Model.ParentProject
    })

    <div class="govuk-grid-column-full">
        <div class="govuk-grid-row sup_margin_left_right_0 sup_margin_bottom_10">
            <div id="gridContainer_testPurchaseReqGrid">
                @await Html.PartialAsync("_DataGrid", Model.TestPurchaseReqGrid)
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/ajax-form-validation.js"></script>
    <script>
        var testPurchaseReqGridId = '@Model.TestPurchaseReqGrid.GridId';
        var parentProject = '@Uri.EscapeDataString(Model.ParentProject ?? string.Empty)';
        var currentTestCode = '';

        function navigateToProjectCode(code) {
            code = (code || '').trim();
            fpsNavigateTo('/PACT/TestPurchaseRequirement/Index?parentProject=' + encodeURIComponent(code));
        }

        function getGridManager() {
            return window['gridManager_' + testPurchaseReqGridId];
        }

        function toggleSidebar() {
            document.querySelector('.sidenav').classList.toggle('collapsed');
        }

        function getTestPurchaseReqExtraFilters() {
            return { testCode: decodeURIComponent(parentProject) };
        }

        function searchTestPurchaseReq() {
            var search = document.getElementById('testPurchaseSearch');
            currentTestCode = (search ? search.value : '').trim();
            if (currentTestCode) {
                var gm = getGridManager();
                if (gm) gm.reloadGrid({ page: 1 });
            }
        }

        // Wire up the search box inside the grid title area
        document.addEventListener('DOMContentLoaded', function () {
            var searchInput = document.getElementById('testPurchaseSearch');
            if (searchInput) {
                searchInput.addEventListener('keypress', function (e) {
                    if (e.key === 'Enter') {
                        e.preventDefault();
                        searchTestPurchaseReq();
                    }
                });
            }
        });

        // ── CRUD ─────────────────────────────────────────────────────────

        function addTestPurchaseReq() {
            $.get('/PACT/TestPurchaseRequirement/GetTestPurchaseReq',
                { testCode: '', buyer: decodeURIComponent(parentProject), parentProject: decodeURIComponent(parentProject) },
                function (html) {
                    $('#modaPopupBody').html(html);
                    $('#modalPopup').addClass('show');
                });
        }

        function editTestPurchaseReq(btn) {
            var testCode = $(btn).data('testcode') || $(btn).closest('tr').find('td:first').text().trim();
            var buyer = $(btn).data('id');
            $.get('/PACT/TestPurchaseRequirement/GetTestPurchaseReq',
                { testCode: testCode, buyer: buyer, parentProject: decodeURIComponent(parentProject) },
                function (html) {
                    $('#modaPopupBody').html(html);
                    $('#modalPopup').addClass('show');
                });
        }

        function deleteTestPurchaseReq(btn) {
            var testCode = $(btn).data('testcode') || $(btn).closest('tr').find('td:first').text().trim();
            var buyer = $(btn).data('id');
            showGovukConfirm('Delete this test purchase requirement?').then(function (confirmed) {
                if (!confirmed) return;
                $.ajax({
                    url: '/PACT/TestPurchaseRequirement/DeleteTestPurchaseReq',
                    type: 'DELETE',
                    data: { testCode: testCode, buyer: buyer },
                    success: function (response) {
                        if (response.success) {
                            getGridManager()?.reloadGrid({ page: 1 });
                            showAlertMessage('Test purchase requirement deleted successfully.', AlertType.SUCCESS);
                        } else {
                            showAlertMessage('Error: ' + response.message, AlertType.ERROR);
                        }
                    },
                    error: function () { showAlertMessage('An error occurred while deleting.', AlertType.ERROR); }
                });
            });
        }

        function saveTestPurchaseReq() {
            var form = $('#testPurchaseReqForm');

            if (!isFormValid(form)) {
                displayClientValidationErrors(form, '#testPurchaseReqForm');
                return;
            }

            var data = form.serializeObject ? form.serializeObject() : Object.fromEntries(new FormData(form[0]));

            if (typeof data.isEdit === 'string') data.isEdit = data.isEdit === 'true';

            ['NoRequired', 'UnitPrice'].forEach(function (f) {
                if (data[f] === '' || data[f] === undefined) data[f] = null;
            });

            // Validate UnitPrice against PostgreSQL money limits
            if (data.UnitPrice !== null && data.UnitPrice !== undefined) {
                var unitPrice = parseFloat(data.UnitPrice);
                var maxMoney = 92233720368547758.07;

                if (isNaN(unitPrice)) {
        showAlertMessage('The value you enter is not valid for this fields. The entered value is larger than the fieldsize permit.', AlertType.ERROR);
                    return;
                }
                if (unitPrice < 0 || unitPrice > maxMoney) {
                    showAlertMessage('The value you enter is not valid for this fields. The entered value is larger than the fieldsize permit.', AlertType.ERROR);
                    return;
                }

                // Check decimal places
                var decimalPart = unitPrice.toString().split('.')[1];
                if (decimalPart && decimalPart.length > 2) {
                    showAlertMessage('Unit Price must have at most 2 decimal places.', AlertType.INFO);
                    return;
                }

                // Ensure we send a proper decimal, not scientific notation
                data.UnitPrice = unitPrice;
            }

            clearValidationErrors('#testPurchaseReqForm');
            $.ajax({
                url: '/PACT/TestPurchaseRequirement/SaveTestPurchaseReq',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(data),
                success: function (response) {
                    if (response.success) {
                        $('#modalPopup').removeClass('show');
                        showAlertMessage(response.message, AlertType.SUCCESS);
                        getGridManager()?.reloadGrid({ page: 1 });
                    } else {
                        displayServerValidationErrors(response.errors, response.message, '#testPurchaseReqForm');
                    }
                },
                error: function () { showAlertMessage('An error occurred while saving.', AlertType.ERROR); }
            });
        }
    </script>
}

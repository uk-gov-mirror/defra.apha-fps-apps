@model Apha.FPSApps.Web.Areas.PACT.Models.TestPurchaseRequirementItem
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    var isEdit = Model.IsEdit;
    var testorProductOptions = ViewBag.TestorProductOptions as List<SelectListItem> ?? new List<SelectListItem>();
    var buyerOptions = ViewBag.BuyerOptions as List<SelectListItem> ?? new List<SelectListItem>();
}

<div class="modal-header flex-space-center">
    <h3 class="govuk-heading-s" style="margin:0;">@(isEdit ? "Edit Test" : "Add Test")</h3>
    <button type="button" class="btn-close" onclick="$('#modalPopup').removeClass('show')">×</button>
</div>

<div class="modal-body" style="overflow:hidden; padding:8px 8px 0 8px;">
    <form id="testPurchaseReqForm" class="govuk-grid-column-full">

        <input type="hidden" name="isEdit" value="@isEdit.ToString().ToLower()" />
        <input type="hidden" asp-for="ProjectBuyerCode" />
        <input type="hidden" name="Active" value="@(Model.Active ?? 1)" />

        <!-- Validation error summary -->
        <div class="govuk-error-summary" role="alert"
             aria-labelledby="tpr-error-title" tabindex="-1" style="display:none;">
            <h2 class="govuk-error-summary__title" id="tpr-error-title">There is a problem</h2>
            <div class="govuk-error-summary__body">
                <ul class="govuk-list govuk-error-summary__list"></ul>
            </div>
        </div>

        <!-- Buyer -->
        <div class="govuk-form-group sup_margin_bottom_10">
            <label class="govuk-label govuk-!-font-weight-bold" asp-for="Buyer">
                Buyer <span class="sup_color_red">*</span>
            </label>
            @if (isEdit)
            {
                <input type="hidden" asp-for="Buyer" />
                <select class="govuk-select govuk-!-font-size-16" asp-for="Buyer"
                        asp-items="buyerOptions" style="width:100%;" disabled>
                    <option value="">-- Select buyer --</option>
                </select>
            }
            else
            {
                <select class="govuk-select govuk-!-font-size-16" asp-for="Buyer"
                        asp-items="buyerOptions" style="width:100%;" required>
                    <option value="">-- Select buyer --</option>
                </select>
                <span data-valmsg-for="Buyer"
                      class="govuk-error-message field-validation-valid" style="display:none;"></span>
            }
        </div>

        <!-- Test Code -->
        <div class="govuk-form-group sup_margin_bottom_10">
            <label class="govuk-label govuk-!-font-weight-bold" asp-for="TestCode">
                Test Code <span class="sup_color_red">*</span>
            </label>
            @if (isEdit)
            {
                <input type="hidden" asp-for="TestCode" />
                <select class="govuk-select govuk-!-font-size-16" asp-for="TestCode"
                        asp-items="testorProductOptions" style="width:100%;" disabled>
                    <option value="">-- Select test code --</option>
                </select>
            }
            else
            {
                <select class="govuk-select govuk-!-font-size-16" asp-for="TestCode"
                        asp-items="testorProductOptions" style="width:100%;" required>
                    <option value="">-- Select test code --</option>
                </select>
                <span data-valmsg-for="TestCode"
                      class="govuk-error-message field-validation-valid" style="display:none;"></span>
            }
        </div>

        <!-- No Required -->
        <div class="govuk-form-group sup_margin_bottom_10">
            <label class="govuk-label govuk-!-font-weight-bold" asp-for="NoRequired">
                No Required <span class="sup_color_red">*</span>
            </label>
            <input class="govuk-input govuk-!-font-size-16 decfmt-input" asp-for="NoRequired"
                   type="text" placeholder="e.g., 0" required />
            <span data-valmsg-for="NoRequired"
                  class="govuk-error-message field-validation-valid" style="display:none;"></span>
        </div>

        <!-- Unit Price -->
        <div class="govuk-form-group sup_margin_bottom_10">
            <label class="govuk-label govuk-!-font-weight-bold" asp-for="UnitPrice">
                Unit Price <span class="sup_color_red">*</span>
            </label>
            <div class="govuk-input__wrapper">
                <div class="govuk-input__prefix" aria-hidden="true">£</div>
                <input class="govuk-input govuk-!-font-size-16 decfmt-input" asp-for="UnitPrice"
                     type="text" placeholder="e.g., 23.8000" required  />
            </div>     
            <span asp-validation-for="UnitPrice"
                  class="govuk-error-message"></span>
        </div>
    </form>
</div>

<div class="modal-footer" style="display:flex; justify-content:space-between; align-items:center;">
    <button type="button" class="govuk-button govuk-button--secondary sup_margin_0"
            onclick="$('#modalPopup').removeClass('show')">Cancel</button>
    <button type="button" class="govuk-button sup_margin_0" onclick="saveTestPurchaseReq()" allow-edit="true">
        @(isEdit ? "Update" : "Save")
    </button>
</div>
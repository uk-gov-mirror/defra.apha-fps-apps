@model Apha.FPSApps.Web.Areas.PACT.Models.SubContractRmsViewModel

@{
    ViewData["Title"] = "SubContracts (Exceptional Costs) (Batch mode from RMS)";
}

<div class="content-wrapper sup_margin_bottom_10">
    <div class="govuk-grid-row sup_margin_left_right_0">
        <div class="govuk-grid-column-full sup_border-bottom ">
            <h1 class="heading_with_txtbox govuk-heading-s  govuk-!-margin-top-2 govuk-!-margin-bottom-2 ">
                <div class="sup_flex_left_center">
                    Project
                    Cost from RMS for Month...
                    <div class="display-flex">
                        <label class="govuk-label sup_visually_hidden sup_label_width_10" for="dpSelectmonth">Select month</label>
                        <div class="m-0 p-0" style="display: flex;  align-items: center;justify-content: flex-start;">
                            <select class="govuk-select govuk-!-font-size-16" name="dpSelectmonth" id="dpSelectmonth">
                                <option value="">-- select month --</option>
                                @foreach (var month in Model.FilterMonths)
                                {
                                    if (month.Value == Model.Month?.ToString())
                                    {
                                        <option value="@month.Value" selected>@month.Text</option>
                                    }
                                    else
                                    {
                                        <option value="@month.Value">@month.Text</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>
                    <label class="sup_visually_hidden sup_label_width_10" for="txtSelectedMonth">Selected month</label>
                    <input hidden type="text" id="txtSelectedMonth" class="govuk-input govuk-!-font-size-16 sup_text_center govuk-input--width-2"
                           readonly value="@(Model.Month.HasValue ? Model.FilterMonths.FirstOrDefault(m => m.Value == Model.Month.Value.ToString())?.Text ?? string.Empty : string.Empty)" />
                </div>
            </h1>
        </div>
    </div>

    <div class="govuk-grid-row sup_margin_left_right_0 sup_margin_top_10 ">
        <div class="govuk-grid-column-full">
            <div id="gridContainer_@Model.SubContractsGrid.GridId">
                @await Html.PartialAsync("_DataGrid", Model.SubContractsGrid)
            </div>
        </div>
    </div>

    <div class="govuk-grid-column-full">
        <div class="sup_margin_left_right_0 sup_margin_bottom_10 sup_margin_top_10" style="display:flex; align-items:flex-start; gap:10px;">
            <div style="flex:1; min-width:0;">
                <div id="gridContainer_@Model.FailedSubContractsGrid.GridId">
                    @await Html.PartialAsync("_DataGrid", Model.FailedSubContractsGrid)
                </div>
            </div>

            <div style="width:fit-content; flex:0 0 auto;">
                <div style="display:flex; flex-direction:column; gap:10px;">
                    <button class="govuk-button sup_margin_0 sup_gov_blue_bg sup_flex sup_width_140" id="templateExcel" type="button">
                        <img src="~/images/file-export-solid-full.svg" width="16" alt="icon for download template for import excel file format">&nbsp; Template
                    </button>

                    <div class="upload-container sup_width_140">
                        <input type="file" id="csvInput" class="file-input" accept=".xls,.xlsx,.csv" hidden>
                        <label for="csvInput" class="govuk-button sup_margin_0 sup_flex">
                            <img src="~/images/file-import-solid-full.svg" width="16" alt="icon for import excel file">&nbsp; Import
                        </label>
                    </div>

                    <button class="govuk-button govuk-button--secondary sup_gov_blue_bg sup_margin_0 sup_flex sup_width_140" id="exportFailedBtn" type="button" title="Export failed records to Excel">
                        <img src="~/images/file-export-solid-full.svg" width="16" alt="icon for export data into excel file">&nbsp; Excel Export
                    </button>

                    <button class="govuk-button govuk-button--warning sup_margin_0 sup_flex sup_width_140" id="deleteAllFailedBtn" type="button" title="Delete all failed records">
                        <img src="~/images/trash-can-regular-full-white.svg" width="16" alt="Delete all failed records">&nbsp; Delete All
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/ajax-form-validation.js"></script>
    <script>
        var initialRmsMonth = '@(Model.Month?.ToString() ?? "")';
        var rmsSubContractsGridId = '@Model.SubContractsGrid.GridId';
        var rmsFailedSubContractsGridId = '@Model.FailedSubContractsGrid.GridId';
    </script>
    <script src="~/js/pact_js/subcontract-rms.js"></script>
}


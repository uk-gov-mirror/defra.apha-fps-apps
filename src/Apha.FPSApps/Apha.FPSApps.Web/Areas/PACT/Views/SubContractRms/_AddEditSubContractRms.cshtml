@using Microsoft.AspNetCore.Mvc.Rendering
@model Apha.FPSApps.Web.Areas.PACT.Models.SubContractRmsItem

@{
    var isEdit = Model.SubContCounter != 0;
    var projects = ViewBag.Projects as IEnumerable<SelectListItem> ?? new List<SelectListItem>();
    var months = ViewBag.Months as IEnumerable<SelectListItem> ?? new List<SelectListItem>();
}

<div class="modal-header flex-space-center">
    <h3 class="modal-title m-0" id="projectCostModalLabel">@(isEdit ? "Edit Project Cost" : "Add Project Cost")</h3>
    <button type="button" class="btn-close btn-red" onclick="$('#modalPopup').removeClass('show')">X</button>
</div>
<div class="modal-body" style="padding: 8px 16px 0 0px;">
    <form class="govuk-grid-column-full" id="formAddProjectCost">
        <input type="hidden" asp-for="SubContCounter" />

        <div class="govuk-error-summary" role="alert"
             aria-labelledby="error-summary-title" tabindex="-1" style="display:none;">
            <h2 class="govuk-error-summary__title" id="error-summary-title">There is a problem</h2>
            <div class="govuk-error-summary__body">
                <ul class="govuk-list govuk-error-summary__list"></ul>
            </div>
        </div>

        <div class="govuk-grid-row">
            <div class="govuk-grid-column-one-half">
                <div class="govuk-form-group sup_margin_bottom_10">
                    <label for="dpSelectproject" class="govuk-label govuk-!-font-weight-bold">Project:<span class="sup_color_red">*</span></label>
                    <select class="govuk-select govuk-!-font-size-16 sup_select_option_width_100" asp-for="Project" id="dpSelectproject" asp-items="@projects" required>
                        <option value="">--select project--</option>
                    </select>
                    <span asp-validation-for="Project" class="govuk-error-message"></span>
                </div>
            </div>
            <div class="govuk-grid-column-one-half">
                <div class="govuk-form-group sup_margin_bottom_10">
                    <label for="txtmodal-accountcode" class="govuk-label govuk-!-font-weight-bold">Account Code:</label>
                    <input type="text" class="govuk-input govuk-!-font-size-16"
                           id="txtmodal-accountcode" asp-for="AcctCode" placeholder="Enter account code">
                </div>
            </div>
        </div>
        <div class="govuk-grid-row">
            <div class="govuk-grid-column-one-half">
                <div class="govuk-form-group sup_margin_bottom_10">
                    <label for="txtmodal-amount" class="govuk-label govuk-!-font-weight-bold">Amount:<span class="sup_color_red">*</span></label>
                    <div class="govuk-input__wrapper">
                        <div class="govuk-input__prefix" aria-hidden="true">£</div>
                        <input type="text" class="govuk-input govuk-!-font-size-16 decfmt-input"
                               id="txtmodal-amount" asp-for="Amount" placeholder="0.00" required>
                    </div>
                    <span asp-validation-for="Amount" class="govuk-error-message"></span>
                </div>
            </div>
            <div class="govuk-grid-column-one-half">
                <div class="govuk-form-group sup_margin_bottom_10">
                    <label for="txtmodal-month" class="govuk-label govuk-!-font-weight-bold">Month:<span class="sup_color_red">*</span></label>
                    <select class="govuk-select govuk-!-font-size-16" id="txtmodal-month" name="Month" asp-items="@months" required>
                        <option value="">--select month--</option>
                    </select>
                    <span asp-validation-for="Month" class="govuk-error-message"></span>
                </div>
            </div>
        </div>
        <div class="govuk-grid-row">
            <div class="govuk-grid-column-one-half">
                <div class="govuk-form-group sup_margin_bottom_10">
                    <label for="txtmodal-testjob" class="govuk-label govuk-!-font-weight-bold">Test Job:</label>
                    <input type="text" class="govuk-input govuk-!-font-size-16" id="txtmodal-testjob"
                           asp-for="TestJob" placeholder="Enter test job">
                </div>
            </div>
            <div class="govuk-grid-column-one-half">
                <div class="govuk-form-group sup_margin_bottom_10">
                    <label for="txtmodal-description" class="govuk-label govuk-!-font-weight-bold">Description:</label>
                    <input type="text" class="govuk-input govuk-!-font-size-16"
                           id="txtmodal-description" asp-for="Description" placeholder="Enter description">
                </div>
            </div>
        </div>
        <div class="govuk-grid-row">
            <div class="govuk-grid-column-one-half">
                <div class="govuk-form-group sup_margin_bottom_10">
                    <label for="txtmodal-supplier" class="govuk-label govuk-!-font-weight-bold">Supplier:</label>
                    <input type="text" class="govuk-input govuk-!-font-size-16" id="txtmodal-supplier"
                           asp-for="Supplier" placeholder="Enter supplier">
                </div>
            </div>
            <div class="govuk-grid-column-one-half">
                <div class="govuk-form-group sup_margin_bottom_10">
                    <label for="txtmodal-suppliernumber" class="govuk-label govuk-!-font-weight-bold">Supplier Number:</label>
                    <input type="text" class="govuk-input govuk-!-font-size-16 decfmt-input"
                          maxlength="9"   id="txtmodal-suppliernumber" asp-for="SupplierNumber" placeholder="Enter supplier number">
                    <span asp-validation-for="SupplierNumber" class="govuk-error-message" style="display:none"></span>
                </div>
            </div>
        </div>
        <div class="govuk-grid-row">
            <div class="govuk-grid-column-one-half">
                <div class="govuk-form-group sup_margin_bottom_10">
                    <label for="txtmodal-dailyrate" class="govuk-label govuk-!-font-weight-bold">Daily Rate:</label>
                    <div class="govuk-input__wrapper">
                        <div class="govuk-input__prefix" aria-hidden="true">£</div>
                        <input type="text" class="govuk-input govuk-!-font-size-16 decfmt-input"
                               id="txtmodal-dailyrate" asp-for="DailyRate" placeholder="0.00">
                    </div>
                    <span asp-validation-for="DailyRate" class="govuk-error-message" style="display:none"></span>
                </div>
            </div>
            <div class="govuk-grid-column-one-half">
                <div class="govuk-form-group sup_margin_bottom_10">
                    <label for="txtmodal-animaldays" class="govuk-label govuk-!-font-weight-bold">Animal Days:</label>
                    <input type="text" class="govuk-input govuk-!-font-size-16 decfmt-input"
                         maxlength="9"  id="txtmodal-animaldays" asp-for="AnimalDays" placeholder="e.g., 10">
                    <span asp-validation-for="AnimalDays" class="govuk-error-message" style="display:none"></span>
                </div>
            </div>
        </div>
    </form>
</div>
<div class="modal-footer"
     style="display: flex; justify-content: space-between; align-items: center; flex-direction: row;">
    <button class="govuk-button govuk-button--secondary sup_margin_0" aria-label="Cancel"
            onclick="$('#modalPopup').removeClass('show')">Cancel</button>
    <button class="govuk-button sup_margin_0" aria-label="Save" onclick="saveProjectCost()">Save</button>
</div>

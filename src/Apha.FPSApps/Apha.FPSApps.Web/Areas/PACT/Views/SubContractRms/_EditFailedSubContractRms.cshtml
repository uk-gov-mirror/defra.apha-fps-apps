@using Microsoft.AspNetCore.Mvc.Rendering
@model Apha.FPSApps.Web.Areas.PACT.Models.SubContractRmsFailedItem

<div class="modal-header flex-space-center">
    <h3 class="modal-title m-0" id="editFailedSubContractModalLabel">Edit Failed Sub-Contract</h3>
    <button type="button" class="btn-close btn-red" onclick="$('#modalPopup').removeClass('show')">X</button>
</div>
<div class="modal-body" style="padding: 8px 16px 0 0px;">
    <form class="govuk-grid-column-full" id="formEditFailedSubContractRms">
        <input type="hidden" asp-for="Id" />

        <div class="govuk-error-summary" role="alert"
             aria-labelledby="error-summary-title" tabindex="-1" style="display:none;">
            <h2 class="govuk-error-summary__title" id="error-summary-title">There is a problem</h2>
            <div class="govuk-error-summary__body">
                <ul class="govuk-list govuk-error-summary__list"></ul>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.ValidationFailure))
        {
            <div class="govuk-warning-text" style="font-size: 14px;">
                <span class="govuk-warning-text__icon" aria-hidden="true">!</span>
                <div class="govuk-warning-text__text">
                    <strong style="display: block; margin-bottom: 4px;">
                        <span class="govuk-warning-text__assistive">Warning</span>
                        Current Validation Errors:
                    </strong>
                    <div style="font-weight: normal; white-space: pre-wrap; word-wrap: break-word;">@Model.ValidationFailure</div>
                </div>
            </div>
        }

        <div class="govuk-grid-row">
            <div class="govuk-grid-column-one-half">
                <div class="govuk-form-group sup_margin_bottom_10">
                    <label for="txtmodal-project-failed" class="govuk-label govuk-!-font-weight-bold">Project:<span class="sup_color_red">*</span></label>
                    <input type="text" class="govuk-input govuk-!-font-size-16"
                           id="txtmodal-project-failed" asp-for="Project" placeholder="Enter project" required>
                    <span asp-validation-for="Project" class="govuk-error-message"></span>
                </div>
            </div>
            <div class="govuk-grid-column-one-half">
                <div class="govuk-form-group sup_margin_bottom_10">
                    <label for="txtmodal-accountcode-failed" class="govuk-label govuk-!-font-weight-bold">Account Code:</label>
                    <input type="text" class="govuk-input govuk-!-font-size-16"
                           id="txtmodal-accountcode-failed" asp-for="AcctCode" placeholder="Enter account code">
                    <span asp-validation-for="AcctCode" class="govuk-error-message"></span>
                </div>
            </div>
        </div>
        <div class="govuk-grid-row">
            <div class="govuk-grid-column-one-half">
                <div class="govuk-form-group sup_margin_bottom_10">
                    <label for="txtmodal-amount-failed" class="govuk-label govuk-!-font-weight-bold">Amount:<span class="sup_color_red">*</span></label>
                    <div class="govuk-input__wrapper">
                        <div class="govuk-input__prefix" aria-hidden="true">£</div>
                        <input type="text" class="govuk-input govuk-!-font-size-16"
                               id="txtmodal-amount-failed" asp-for="Amount" placeholder="0.00" required>
                    </div>
                    <span asp-validation-for="Amount" class="govuk-error-message"></span>
                </div>
            </div>
            <div class="govuk-grid-column-one-half">
                <div class="govuk-form-group sup_margin_bottom_10">
                    <label for="txtmodal-month-failed" class="govuk-label govuk-!-font-weight-bold">Month:<span class="sup_color_red">*</span></label>
                    <input type="text" class="govuk-input govuk-!-font-size-16"
                           id="txtmodal-month-failed" asp-for="Month" placeholder="Enter month (1-12)" required>
                    <span asp-validation-for="Month" class="govuk-error-message"></span>
                </div>
            </div>
        </div>
        <div class="govuk-grid-row">
            <div class="govuk-grid-column-one-half">
                <div class="govuk-form-group sup_margin_bottom_10">
                    <label for="txtmodal-testjob-failed" class="govuk-label govuk-!-font-weight-bold">Test Job:</label>
                    <input type="text" class="govuk-input govuk-!-font-size-16" id="txtmodal-testjob-failed"
                           asp-for="TestJob" placeholder="Enter test job">
                    <span asp-validation-for="TestJob" class="govuk-error-message"></span>
                </div>
            </div>
            <div class="govuk-grid-column-one-half">
                <div class="govuk-form-group sup_margin_bottom_10">
                    <label for="txtmodal-description-failed" class="govuk-label govuk-!-font-weight-bold">Description:</label>
                    <input type="text" class="govuk-input govuk-!-font-size-16"
                           id="txtmodal-description-failed" asp-for="Description" placeholder="Enter description">
                    <span asp-validation-for="Description" class="govuk-error-message"></span>
                </div>
            </div>
        </div>
        <div class="govuk-grid-row">
            <div class="govuk-grid-column-one-half">
                <div class="govuk-form-group sup_margin_bottom_10">
                    <label for="txtmodal-supplier-failed" class="govuk-label govuk-!-font-weight-bold">Supplier:</label>
                    <input type="text" class="govuk-input govuk-!-font-size-16" id="txtmodal-supplier-failed"
                           asp-for="Supplier" placeholder="Enter supplier">
                    <span asp-validation-for="Supplier" class="govuk-error-message"></span>
                </div>
            </div>
            <div class="govuk-grid-column-one-half">
                <div class="govuk-form-group sup_margin_bottom_10">
                    <label for="txtmodal-suppliernumber-failed" class="govuk-label govuk-!-font-weight-bold">Supplier Number:</label>
                    <input type="text" class="govuk-input govuk-!-font-size-16"
                           id="txtmodal-suppliernumber-failed" asp-for="SupplierNumber" placeholder="Enter supplier number">
                    <span asp-validation-for="SupplierNumber" class="govuk-error-message"></span>
                </div>
            </div>
        </div>
        <div class="govuk-grid-row">
            <div class="govuk-grid-column-one-half">
                <div class="govuk-form-group sup_margin_bottom_10">
                    <label for="txtmodal-dailyrate-failed" class="govuk-label govuk-!-font-weight-bold">Daily Rate:</label>
                    <div class="govuk-input__wrapper">
                        <div class="govuk-input__prefix" aria-hidden="true">£</div>
                        <input type="text" class="govuk-input govuk-!-font-size-16"
                               id="txtmodal-dailyrate-failed" asp-for="DailyRate" placeholder="0.00">
                    </div>
                    <span asp-validation-for="DailyRate" class="govuk-error-message"></span>
                </div>
            </div>
            <div class="govuk-grid-column-one-half">
                <div class="govuk-form-group sup_margin_bottom_10">
                    <label for="txtmodal-animaldays-failed" class="govuk-label govuk-!-font-weight-bold">Animal Days:</label>
                    <input type="text" class="govuk-input govuk-!-font-size-16"
                           id="txtmodal-animaldays-failed" asp-for="AnimalDays" placeholder="Enter animal days">
                    <span asp-validation-for="AnimalDays" class="govuk-error-message"></span>
                </div>
            </div>
        </div>
    </form>
</div>
<div class="modal-footer"
     style="display: flex; justify-content: space-between; align-items: center; flex-direction: row;">
    <button class="govuk-button govuk-button--secondary sup_margin_0" aria-label="Cancel"
            onclick="$('#modalPopup').removeClass('show')">Cancel</button>
    <button class="govuk-button sup_margin_0" aria-label="Save" onclick="saveFailedSubContractRms()">Save</button>
</div>

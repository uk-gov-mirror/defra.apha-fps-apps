@model Apha.FPSApps.Web.Areas.PACT.Models.ProjectSubContractItem

@{
    var isEdit = Model.SubContCounter != 0;
}

<div class="modal-header flex-space-center">
    <h3 class="govuk-heading-s sup_margin_0">@(isEdit ? "Edit Sub-Contract" : "Add Sub-Contract")</h3>
    <button type="button" class="btn-close" onclick="$('#modalPopup').removeClass('show')">×</button>
</div>

<div class="modal-body" style="overflow:hidden; padding:8px 16px 0 16px;">
    <form id="subContractForm" class="govuk-grid-column-full">

        <input type="hidden" name="isEdit" value="@isEdit.ToString().ToLower()" />
        <input type="hidden" asp-for="SubContCounter" />

        <!-- Validation error summary -->
        <div class="govuk-error-summary" role="alert"
             aria-labelledby="error-summary-title" tabindex="-1" style="display:none;">
            <h2 class="govuk-error-summary__title" id="error-summary-title">There is a problem</h2>
            <div class="govuk-error-summary__body">
                <ul class="govuk-list govuk-error-summary__list"></ul>
            </div>
        </div>

        @if (isEdit)
        {
            <div class="govuk-grid-row sup_margin_top_10" id="divSubcontractcounter">
                <div class="govuk-grid-column-one-half">
                    <div class="govuk-form-group sup_margin_bottom_10">
                        <label class="govuk-label sup_font_weight_700" asp-for="SubContCounter">Sub-Contract Counter</label>
                        <div class="govuk-input__wrapper">
                            <input class="govuk-input govuk-!-font-size-16" value="@Model.SubContCounter" readonly disabled />
                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="govuk-grid-row sup_margin_top_10">
            <div class="govuk-grid-column-one-half">
                <div class="govuk-form-group sup_margin_bottom_10">
                    <label class="govuk-label sup_font_weight_700" asp-for="Project">
                        Project<span class="sup_color_red">*</span>
                    </label>
                    <select class="govuk-select sup_select_option_width_100 govuk-!-font-size-16"
                            asp-for="Project"
                            asp-items="@(ViewBag.Projects as IEnumerable<SelectListItem>)"
                            required>
                        <option value="">-- select project --</option>
                    </select>
                    <span asp-validation-for="Project" class="govuk-error-message"></span>
                </div>
            </div>
            <div class="govuk-grid-column-one-half">
                <div class="govuk-form-group sup_margin_bottom_10">
                    <label class="govuk-label sup_font_weight_700" asp-for="Month">
                        Month<span class="sup_color_red">*</span>
                    </label>
                    <select class="govuk-select sup_select_option_width_100 govuk-!-font-size-16"
                            asp-for="Month" required>
                        <option value="">--select month--</option>
                        @for (int i = 1; i <= 12; i++)
                        {
                            <option value="@i">@i</option>
                        }
                    </select>
                    <span asp-validation-for="Month" class="govuk-error-message"></span>
                </div>
            </div>
        </div>

        <div class="govuk-grid-row">
            <div class="govuk-grid-column-one-half">
                <div class="govuk-form-group sup_margin_bottom_10">
                    <label class="govuk-label sup_font_weight_700" asp-for="Amount">
                        Amount<span class="sup_color_red">*</span>
                    </label>
                    <div class="govuk-input__wrapper">
                        <div class="govuk-input__prefix" aria-hidden="true">£</div>
                        <input type="text" class="govuk-input govuk-!-font-size-16 decfmt-input"
                               asp-for="Amount" maxlength="20" placeholder="e.g., 1000" required />                        
                    </div>
                    <span asp-validation-for="Amount" class="govuk-error-message"></span>
                </div>
            </div>
            <div class="govuk-grid-column-one-half">
                <div class="govuk-form-group sup_margin_bottom_10">
                    <div class="acctdropdown" data-acctdropdown>
                        <label class="govuk-label sup_font_weight_700" asp-for="AcctCode">Account Code</label>
                        <input type="text" asp-for="AcctCode"
                               class="govuk-input govuk-!-font-size-16" />                        
                    </div>
                </div>
            </div>
        </div>

        <div class="govuk-grid-row">
            <div class="govuk-grid-column-full">
                <div class="govuk-form-group sup_margin_bottom_10">
                    <label class="govuk-label sup_font_weight_700" asp-for="TestJob">Test</label>
                    <input class="govuk-input govuk-!-font-size-16" asp-for="TestJob"
                           placeholder="Enter test details" />
                </div>
            </div>
        </div>

    </form>
</div>

<div class="modal-footer" style="display:flex; justify-content:space-between; align-items:center; flex-direction:row;">
    <button type="button" class="govuk-button govuk-button--secondary sup_margin_0"
            onclick="$('#modalPopup').removeClass('show')">Cancel</button>
    <button type="button" class="govuk-button sup_margin_0" onclick="saveSubContract()" allow-edit="true">
        @(isEdit ? "Update" : "Save")
    </button>
</div>

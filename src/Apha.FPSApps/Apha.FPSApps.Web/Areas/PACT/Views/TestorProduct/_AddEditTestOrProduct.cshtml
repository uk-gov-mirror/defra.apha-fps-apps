<div class="modal-body" style="padding: 8px 16px 0 0px;">
    <div class="govuk-error-summary" role="alert"
         aria-labelledby="error-summary-title" tabindex="-1" style="display:none;">
        <h2 class="govuk-error-summary__title" id="error-summary-title">
            There is a problem
        </h2>
        <div class="govuk-error-summary__body">
            <ul class="govuk-list govuk-error-summary__list">
            </ul>
        </div>
    </div>

    <form class="govuk-grid-column-full" id="testForm" novalidate>
        <input type="hidden" id="isEdit" value="false" />
        <input type="hidden" id="originalItemCode" value="" />

        <div class="govuk-grid-row">
            <div class="govuk-grid-column-one-half">
                <div class="govuk-form-group sup_margin_bottom_10">
                    <label for="itemCode" class="govuk-label govuk-!-font-weight-bold">Item Code <span class="sup_color_red">*</span></label>
                    <input type="text" class="govuk-input govuk-!-font-size-16" id="itemCode" name="ItemCode" placeholder="Enter item code" required maxlength="20" />
                    <span class="govuk-error-message validation-message" data-valmsg-for="ItemCode" style="display:none;"></span>
                </div>
            </div>
            <div class="govuk-grid-column-one-half">
                <div class="govuk-form-group sup_margin_bottom_10">
                    <label for="testManager" class="govuk-label govuk-!-font-weight-bold">Test Manager</label>
                    <input type="text" class="govuk-input govuk-!-font-size-16" id="testManager" name="TestManager" placeholder="Enter test manager" maxlength="50" />
                </div>
            </div>
        </div>

        <div class="govuk-grid-row">
            <div class="govuk-grid-column-full">
                <div class="govuk-form-group sup_margin_bottom_10">
                    <label for="itemDescription" class="govuk-label govuk-!-font-weight-bold">Item Description</label>
                    <input type="text" class="govuk-input govuk-!-font-size-16" id="itemDescription" name="ItemDescription" placeholder="Enter item description" maxlength="200" />
                </div>
            </div>
        </div>

        <div class="govuk-grid-row">
            <div class="govuk-grid-column-one-half">
                <div class="govuk-form-group sup_margin_bottom_10">
                    <label for="unitPriceVla" class="govuk-label govuk-!-font-weight-bold">Non-Defra Unit Price VLA</label>
                    <div class="govuk-input__wrapper">
                        <div class="govuk-input__prefix" aria-hidden="true">£</div>
                        <input type="number" step="0.01" class="govuk-input govuk-!-font-size-16" id="unitPriceVla" name="UnitPriceVla" placeholder="0.00" />
                    </div>
                </div>
            </div>
            <div class="govuk-grid-column-one-half">
                <div class="govuk-form-group sup_margin_bottom_10">
                    <label for="defraUnitPrice" class="govuk-label govuk-!-font-weight-bold">Defra Unit Price <span class="sup_color_red">*</span></label>
                    <div class="govuk-input__wrapper">
                        <div class="govuk-input__prefix" aria-hidden="true">£</div>
                        <input type="number" step="0.01" class="govuk-input govuk-!-font-size-16" id="defraUnitPrice" name="DefraUnitPrice" placeholder="0.00" value="0.00" required />
                    </div>
                    <span class="govuk-error-message validation-message" data-valmsg-for="DefraUnitPrice" style="display:none;"></span>
                </div>
            </div>
        </div>

        <div class="govuk-grid-row">
            <div class="govuk-grid-column-one-half">
                <div class="govuk-form-group sup_margin_bottom_10">
                    <label for="owner" class="govuk-label govuk-!-font-weight-bold">Owner <span class="sup_color_red">*</span></label>
                    <select class="govuk-select govuk-!-font-size-16 sup_width_100" id="owner" name="Owner" required>
                        <option value="">--select owner--</option>
                    </select>
                    <span class="govuk-error-message validation-message" data-valmsg-for="Owner" style="display:none;"></span>
                </div>
            </div>
            <div class="govuk-grid-column-one-half">
                <div class="govuk-form-group sup_margin_bottom_10">
                    <label for="shortDescription" class="govuk-label govuk-!-font-weight-bold">Short Description</label>
                    <input type="text" class="govuk-input govuk-!-font-size-16" id="shortDescription" name="ShortDescription" placeholder="Enter short description" maxlength="18" />
                </div>
            </div>
        </div>
    </form>
</div>

<div class="modal-footer" style="display: flex; justify-content: space-between; align-items: center; flex-direction: row;">
    <button class="govuk-button govuk-button--secondary sup_margin_0" aria-label="Cancel" data-dismiss="modal" onclick="closeTestModal()">Cancel</button>
    <button class="govuk-button sup_margin_0" aria-label="Save" onclick="saveTestOrProduct()">Save</button>
</div>

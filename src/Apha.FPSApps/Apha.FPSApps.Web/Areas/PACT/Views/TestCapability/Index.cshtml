@using Apha.FPSApps.Web.Models.Components.DataGrid
@model Apha.FPSApps.Web.Areas.PACT.Models.TestCapabilityViewModel

@{
    ViewData["Title"] = "PACT : WorkGroup Test Capability";
}

@* Page Title *@
<div class="govuk-grid-row sup_margin_left_right_0">
    <div class="govuk-grid-column-full sup_border-bottom">
        <h1 class="heading_with_txtbox govuk-heading-s sup_margin_top_10 sup_margin_bottom_10"> 
                WorkGroup Test Capability 
            @if (TempData["NavigationSource"]?.ToString() == "WorkGroupTestCapability")
            {
                <a asp-area="PACT"
                asp-controller="WorkGroupTestCapability"
                asp-action="Index"
                asp-route-workGroup="@Model.SelectedWorkGroup"
                class="govuk-back-link sup_align_right">Back</a>
            }
        </h1>
    </div>
</div>

@* Filter Header: Select by WorkGroup or Test *@
<div class="govuk-grid-row sup_margin_left_right_0 sup_flex_left_center sup_padding_bottom_10 sup_border-bottom" style="margin-top:10px;">

    @* WorkGroup dropdown *@
    <div class="govuk-grid-column-one-third">
        <label for="workGroupPick" class="govuk-label govuk-!-font-weight-bold">Select a Workgroup:</label>
        <div id="workGroupPickMultiDropdown"></div>
        <input type="hidden" id="workGroupPick" />
    </div>

    @* OR separator *@
    <div class="govuk-grid-column-two-third sup_margin_top_20" style="text-align:center;">
        OR
    </div>

    @* Test dropdown *@
    <div class="govuk-grid-column-one-third">
        <label for="mainTestPick" class="govuk-label govuk-!-font-weight-bold">Select a Test:</label>
       <div id="mainTestPickMultiDropdown"></div>
        <input type="hidden" id="mainTestPick" />
    </div>

    @* Portfolio Maintenance button *@
    <div class="govuk-grid-column-one-third sup_p_0_mt_24">
        <div class="govuk-button-group sup_margin_0 sup_float_right">
            <a class="govuk-button sup_margin_0 sup_p_8 sup_flex"
               asp-area="PACT" asp-controller="PortfolioMaintenance" asp-action="Index"
                    id="btnPortfolioMaintenance"
                    data-module="govuk-button" allow-edit="true">
                &nbsp;Portfolio Maintenance
            </a>
        </div>
    </div>

</div>

@* TestCode info row *@
<div class="govuk-grid-row sup_margin_left_right_0 sup_p_8 sup_border-bottom sup_margin_bottom_10">
    <div class="govuk-grid-column-full sup_padding_right_left_10">
        <div class="govuk-grid-column-full sup_flex_center_center_center">
            <label for="divTestcode" class="govuk-label govuk-!-font-weight-bold"> Test Requirement records for Test </label>
            <div class="govuk-grid-column-one-third">
                <input type="text" id="divTestcode" class="govuk-input govuk-!-font-size-16">
            </div>
        </div>
        <div class="govuk-grid-column-one-half wgm-left-split sup_p_0">&nbsp;</div>
        <div class="govuk-grid-column-one-half wgm-right-split sup_p_0 sup_padding_left_10">
            <div class="sup_p_8">
                <p class="govuk-body govuk-!-font-size-16 sup_margin_0">------------Buyer Defaulter------------</p>
            </div>
        </div>
    </div>
</div>
 

@* Two-column grid layout *@
<div class="govuk-grid-row sup_margin_0">

    @* Grid 1: Test Capabilities (left) *@
    <div class="govuk-grid-column-one-half col-5" style="padding-right:8px;">
        <div id="gridContainer_testCapabilityGrid">
            @await Html.PartialAsync("_DataGrid", Model.TestCapabilityGrid)
        </div>
    </div>

    @* Grid 2: Test Requirements (right) *@
    <div class="govuk-grid-column-one-half col-7" style="padding-left:8px;">
        <div id="gridContainer_testReqmtGrid">
            @await Html.PartialAsync("_DataGrid", Model.TestReqmtGrid)
        </div>
    </div>

</div>

@section Styles {
    <link rel="stylesheet" href="~/css/common/multicolumn-dropdown.css" />
}

@section Scripts {
    <script src="~/js/ajax-form-validation.js"></script>
    <script src="~/js/common/multicolumn-dropdown.component.js"></script>
    <script>
        const workGroupOptionsListData = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.WorkGroupOptions));
        const testOptionsListData = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.TestorProductOptions));
        

        // ── State ──────────────────────────────────────────────────────────────
        var currentViewBy = 1;
        var currentFilterValue = null;
        var currentSelectedTestCode = null;
        var workGroupSelectDropdown = null;
        var testSelectDropdown = null;
        var selectedWorkGroup = null;
        var selectedTest = null;


        var testCapabilityGridId = '@Model.TestCapabilityGrid.GridId';
        var testReqmtGridId      = '@Model.TestReqmtGrid.GridId';

        function getCapabilityGridManager() {
            return window['gridManager_' + testCapabilityGridId];
        }

        function getReqmtGridManager() {
            return window['gridManager_' + testReqmtGridId];
        }

        // ── URL Parameter Helper ──────────────────────────────────────────────
        function getUrlParameter(name) {
            name = name.replace(/[\[]/, '\\[').replace(/[\]]/, '\\]');
            var regex = new RegExp('[\\?&]' + name + '=([^&#]*)');
            var results = regex.exec(location.search);
            return results === null ? '' : decodeURIComponent(results[1].replace(/\+/g, ' '));
        }

        // ── Page Initialization ───────────────────────────────────────────────
        $(document).ready(function() {

    initializeWorkGroupMultiColumnDropdown();
    initializeTestMultiColumnDropdown();

    var workgroupParam = getUrlParameter('workgroup');

    if (workgroupParam) {

        if (workGroupSelectDropdown) {
            workGroupSelectDropdown.setValue(workgroupParam);
        }

        currentViewBy = 1;
        currentFilterValue = workgroupParam;
        reloadTestCapabilityGrid(workgroupParam);

    } else {
        selectFirstTestCapabilityRow();
    }

    wireTestReqmtExportButton();
});

        // ── WorkGroup dropdown change ──────────────────────────────────────────
        function onWorkGroupPickChange(value) {
            $('#mainTestPick').val('');

            if (testSelectDropdown) {
                 testSelectDropdown.setValue('');
            }
            currentViewBy = 1;
            currentFilterValue = value || null;
            currentSelectedTestCode = null;
            document.getElementById('divTestcode').value = '';
            reloadTestCapabilityGrid(currentFilterValue);
            clearTestReqmtGrid();
        }

        // ── Test dropdown change ───────────────────────────────────────────────
        function onTestPickChange(value) {
            $('#workGroupPick').val('');
            if (workGroupSelectDropdown) {
                workGroupSelectDropdown.setValue('');
            }
            currentViewBy = 2;
            currentFilterValue = value || null;
            currentSelectedTestCode = null;
            document.getElementById('divTestcode').value = '';
            reloadTestCapabilityGrid(currentFilterValue);
            clearTestReqmtGrid();
        }

        // ── Helper: Select first row in Test Capability grid ──────────────────
        function selectFirstTestCapabilityRow() {
            setTimeout(function() {
                var firstRow = $('#gridContainer_testCapabilityGrid tbody tr[data-id]:first');
                if (firstRow.length > 0) {
                    // Remove selected-row class from all rows
                    $('#gridContainer_testCapabilityGrid tbody tr').removeClass('selected-row');
                    // Add selected-row class to first row (applies light blue background)
                    firstRow.addClass('selected-row');
                    // Trigger the row select function
                    onTestCapabilityRowSelect(firstRow);
                }
            }, 100);
        }

        // ── Grid 1: reload ─────────────────────────────────────────────────────
        function reloadTestCapabilityGrid(filterValue) {
            $.ajax({
                url: '/PACT/TestCapability/LoadTestCapabilityGrid',
                type: 'POST',
                headers: { 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() },
                data: {
                    Page: 1,
                    PageSize: 10,
                    Filter: '{}',
                    viewBy: currentViewBy,
                    filterValue: filterValue || ''
                },
                success: function (html) {
                    $('#gridContainer_testCapabilityGrid').html(html);
                    selectFirstTestCapabilityRow();
                },
                error: function () {
                        showAlertMessage('Failed to load Test Capability grid.', AlertType.ERROR);
                }
            });
        }

        // ── Grid 1 row select → populate divTestcode + reload Grid 2 ───────────
        function onTestCapabilityRowSelect(rowData) {
            currentSelectedTestCode = $(rowData).data('id');
            if (!currentSelectedTestCode) return;
            document.getElementById('divTestcode').value = currentSelectedTestCode;
            reloadTestReqmtGrid(currentSelectedTestCode);
        }

        function wireTestReqmtExportButton() {
            var exportButtonSelector = '#' + testReqmtGridId + '_exportBtn';
            var $exportButton = $(exportButtonSelector);
            if ($exportButton.length === 0) {
                return;
            }

            $exportButton.off('click').on('click', function () {
                var hasRows = $('#tbl_' + testReqmtGridId + ' tbody tr[data-id]').length > 0;
                if (!hasRows) {
                    $(this).removeData('export-url').attr('data-export-url', '');
                    showAlertMessage('Please select a Test Capability record before exporting.', AlertType.INFO);
                    return;
                }

                var exportUrl = $(this).data('export-url');
                if (!exportUrl) {
                    showAlertMessage('Please select a Test Capability record before exporting.', AlertType.INFO);
                    return;
                }

                var reqmtGridManager = getReqmtGridManager();
                var currentExtraFilters = getTestReqmtExtraFilters();
                var params = $.extend(
                    { filter: JSON.stringify(reqmtGridManager ? reqmtGridManager.getFilterModel() : {}) },
                    currentExtraFilters
                );

                var query = Object.keys(params)
                    .map(function (k) { return encodeURIComponent(k) + '=' + encodeURIComponent(params[k]); })
                    .join('&');
                window.fpsNavigateTo(exportUrl + '?' + query);
            });
        }

        // ── Grid 2: reload ─────────────────────────────────────────────────────
        function reloadTestReqmtGrid(testCode) {
            $.ajax({
                url: '/PACT/TestCapability/LoadTestReqmtGrid',
                type: 'POST',
                headers: { 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() },
                data: {
                    Page: 1,
                    PageSize: 10,
                    Filter: '{}',
                    testCode: testCode
                },
                success: function (html) {
                    $('#gridContainer_testReqmtGrid').html(html);
                    wireTestReqmtExportButton();
                },
                error: function () {
                        showAlertMessage('Failed to load Test Reqmt grid', AlertType.ERROR);
                }
            });
        }

        function clearTestReqmtGrid() {
            currentSelectedTestCode = null;
            document.getElementById('divTestcode').value = '';

            var exportButtonSelector = '#' + testReqmtGridId + '_exportBtn';
            $(exportButtonSelector)
                .removeData('export-url')
                .attr('data-export-url', '');

            $('#tbl_' + testReqmtGridId + ' tbody').html(
                '<tr><td colspan="100" class="govuk-table__cell" ' +
                'style="text-align:center;color:#505a5f;font-style:italic;padding:16px;">' +
                'No records found.</td></tr>'
            );
        }

        // ── Grid 1 CRUD ────────────────────────────────────────────────────────
        function addTestCapability() {
            $.get('/PACT/TestCapability/CreateTestCapability', function (html) {
                $('#modaPopupBody').html(html);
                $('#modalPopup').addClass('show');
            });
        }

        function editTestCapability(rowData) {
            var testCode  = encodeURIComponent($(rowData).data('id') || '');
            var workGroup = encodeURIComponent(
                $(rowData).closest('tr').find('[data-property="WorkGroup"]').text().trim());
            $.get('/PACT/TestCapability/EditTestCapability?testCode=' + testCode + '&workGroup=' + workGroup,
                function (html) {
                    $('#modaPopupBody').html(html);
                    $('#modalPopup').addClass('show');
                });
        }

        function saveTestCapability() {
            clearValidationErrors('#modaPopupBody');
            var form = $('#testCapabilityForm');
            if (!isFormValid(form)) {
                displayClientValidationErrors(form, '#modaPopupBody');
                return;
            }
            var isEdit = form.find('[name="isEdit"]').val() === 'true';
            var data = {
                TestCode:      form.find('[name="TestCode"]').val(),
                WorkGroup:     form.find('[name="WorkGroup"]').val(),
                PlanPortfolio: form.find('[name="PlanPortfolio"]').val()
            };
            var url = isEdit
                ? '/PACT/TestCapability/EditTestCapability'
                : '/PACT/TestCapability/CreateTestCapability';
            $.ajax({
                url: url, type: 'POST',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify(data),
                success: function (result) {
                    if (result.success) {
                        $('#modalPopup').removeClass('show');
                        reloadTestCapabilityGrid(currentFilterValue);
                        showAlertMessage(isEdit ? 'Record updated successfully.' : 'Record saved successfully.', AlertType.SUCCESS);
                    } else {
                        displayServerValidationErrors(result.errors, result.message, '#modaPopupBody');
                    }
                },
                error: function () { showAlertMessage('Request failed. Please try again.', AlertType.ERROR); }
            });
        }

        function deleteTestCapability(rowData) {
            var testCode  = encodeURIComponent($(rowData).data('id') || '');
            var workGroup = encodeURIComponent(
                $(rowData).closest('tr').find('[data-property="WorkGroup"]').text().trim());
            showGovukConfirm('Delete this Test Capability record?').then(function (confirmed) {
                if (!confirmed) return;
                $.ajax({
                    url: '/PACT/TestCapability/DeleteTestCapability?testCode=' + testCode + '&workGroup=' + workGroup,
                    type: 'DELETE',
                    headers: { 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() },
                    success: function (result) {
                        if (result.success) {
                            reloadTestCapabilityGrid(currentFilterValue);
                            clearTestReqmtGrid();
                            showAlertMessage('Test Capability record deleted successfully.', AlertType.SUCCESS);
                        } else {
                            showAlertMessage(result.message ? result.message : 'Delete failed.', AlertType.ERROR);
                        }
                    },
                    error: function () { showAlertMessage('An error occurred while deleting.', AlertType.ERROR); }
                });
            });
        }

        // ── Grid 2 CRUD ────────────────────────────────────────────────────────
        function addTestReqmt() {
            var hasRows = $('#tbl_' + testReqmtGridId + ' tbody tr[data-id]').length > 0;
            if (!hasRows || !currentSelectedTestCode) {
                showAlertMessage('Please select a Test Capability record before adding the test requirement', AlertType.INFO);
                return;
            }

            $.get('/PACT/TestCapability/CreateTestReqmt?testCode=' + encodeURIComponent(currentSelectedTestCode),
                function (html) {
                    $('#modaPopupBody').html(html);
                    $('#modalPopup').addClass('show');
                });
        }

        function editTestReqmt(rowData) {
            var testCode = encodeURIComponent(currentSelectedTestCode || '');
            var buyer    = encodeURIComponent($(rowData).data('id') || '');
            $.get('/PACT/TestCapability/EditTestReqmt?testCode=' + testCode + '&buyer=' + buyer,
                function (html) {
                    $('#modaPopupBody').html(html);
                    $('#modalPopup').addClass('show');
                });
        }

        function saveTestReqmt() {
            clearValidationErrors('#modaPopupBody');
            var form = $('#testReqmtForm');
            if (!isFormValid(form)) {
                displayClientValidationErrors(form, '#modaPopupBody');
                return;
            }
            var isEdit        = form.find('[name="isEdit"]').val() === 'true';
            var rawUnitPrice  = form.find('[name="UnitPrice"]').val();
            var rawNoRequired = form.find('[name="NoRequired"]').val();
            var rawActive     = form.find('[name="Active"]').val();
            var data = {
                TestCode:        form.find('[name="TestCode"]').val(),
                Buyer:           form.find('[name="Buyer"]').val(),
                ProjectBuyerCode: form.find('[name="ProjectBuyerCode"]').val(),
                TestBuyerCode:   form.find('[name="TestBuyerCode"]').val(),
                UnitPrice:       rawUnitPrice  !== '' ? parseFloat(rawUnitPrice)  : null,
                NoRequired:      rawNoRequired !== '' ? parseFloat(rawNoRequired) : null,
                Active:          rawActive     !== '' ? parseInt(rawActive, 10)   : null
            };
            var url = isEdit
                ? '/PACT/TestCapability/EditTestReqmt'
                : '/PACT/TestCapability/CreateTestReqmt';
            $.ajax({
                url: url, type: 'POST',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify(data),
                success: function (result) {
                    if (result.success) {
                        $('#modalPopup').removeClass('show');
                        reloadTestReqmtGrid(currentSelectedTestCode);
                        showAlertMessage(isEdit ? 'Record updated successfully.' : 'Record saved successfully.', AlertType.SUCCESS);
                    } else {
                        displayServerValidationErrors(result.errors, result.message, '#modaPopupBody');
                    }
                },
                error: function () { showAlertMessage('Request failed. Please try again.', AlertType.ERROR); }
            });
        }

        function deleteTestReqmt(rowData) {
            var testCode = encodeURIComponent(currentSelectedTestCode || '');
            var buyer    = encodeURIComponent($(rowData).data('id') || '');
            showGovukConfirm('Delete this Test Requirement record?').then(function (confirmed) {
                if (!confirmed) return;
                $.ajax({
                    url: '/PACT/TestCapability/DeleteTestReqmt?testCode=' + testCode + '&buyer=' + buyer,
                    type: 'DELETE',
                    headers: { 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() },
                    success: function (result) {
                        if (result.success) {
                            reloadTestReqmtGrid(currentSelectedTestCode);
                            showAlertMessage('Test Requirement record deleted successfully.', AlertType.SUCCESS);
                        } else {
                            showAlertMessage(result.message ? result.message : 'Delete failed.', AlertType.ERROR);
                        }
                    },
                    error: function () { showAlertMessage('An error occurred while deleting.', AlertType.ERROR); }
                });
            });
        }

        // ── Extra filter methods (passed to gridManager for pagination/sort) ───
        function getTestCapabilityExtraFilters() {
            return {
                viewBy: currentViewBy,
                filterValue: currentFilterValue || ''
            };
        }

        function getTestReqmtExtraFilters() {
            return {
                testCode: currentSelectedTestCode || ''
            };
        }

        function initializeWorkGroupMultiColumnDropdown() {

    workGroupSelectDropdown = new MultiColumnDropdownComponent({
        dropdownId: 'workGroupPickDropdown',
        containerSelector: '#workGroupPickMultiDropdown',
        placeholder: 'Select a Workgroup',
        showSerialNumber: false,
        searchPlaceholder: 'Search by Workgroup',
        labelText: '',
        columns: [
            { field: 'Value', header: 'Workgroup', width: '100px' },
            { field: 'Text', header: 'ProfitCentre', width: '180px' }
        ],
        data: workGroupOptionsListData,
        displayField: 'Value',
        valueField: 'Value',
        clearButtonClearsSelection: true,

        callbacks: {
            onSelect: function (selectedItem) {

                selectedWorkGroup = selectedItem.Value;

                $('#workGroupPick').val(selectedWorkGroup);

                onWorkGroupPickChange(selectedWorkGroup);
            },

            onClear: function () {

                selectedWorkGroup = null;
                $('#workGroupPick').val('');

                onWorkGroupPickChange('');
            }
        }
    });
}

function initializeTestMultiColumnDropdown() {

    testSelectDropdown = new MultiColumnDropdownComponent({
        dropdownId: 'mainTestPickDropdown',
        containerSelector: '#mainTestPickMultiDropdown',
        placeholder: 'Select a Test',
        showSerialNumber: false,
        searchPlaceholder: 'Search by Test',
        labelText: '',
        columns: [
            { field: 'Value', header: 'Test Code', width: '100px' },
            { field: 'Text', header: 'Test Description', width: '180px' }
        ],
        data: testOptionsListData,
        displayField: 'Text',
        valueField: 'Value',
        clearButtonClearsSelection: true,
        showClearButton: true,

        callbacks: {
            onSelect: function (selectedItem) {

                selectedTest = selectedItem.Value;

                $('#mainTestPick').val(selectedTest);

                onTestPickChange(selectedTest);
            },

            onClear: function () {

                selectedTest = null;
                $('#mainTestPick').val('');

                onTestPickChange('');
            }
        }
    });
}

            </script>

            @Html.AntiForgeryToken()
        }

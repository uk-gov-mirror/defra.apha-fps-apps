@model Apha.FPSApps.Web.Areas.PACT.Models.WorkGroupPeopleViewModel

@{
    ViewData["Title"] = "PACT : Work Group People";
}

@* Filter Header *@
<div class="govuk-grid-row sup_margin_left_right_0 sup_flex_left_center sup_padding_bottom_10 sup_border-bottom" style="margin-top:10px;">

    @* Work Group dropdown *@
    <div class="govuk-grid-column-one-half sup_flex_align_center">
        <label for="workGroupSelectDropdown_input" class="govuk-label govuk-!-font-weight-bold">Select a WorkGroup......</label>
        <div id="workGroupSelectMultiDropdown" class="govuk-grid-column-two-thirds sup_p_0"></div>
    </div>

    @* OR separator *@
    <div class="govuk-grid-column-one-sixth" style="text-align:center; padding-top:4px;">
        <label class="govuk-label govuk-!-font-weight-bold">..Or a Person....</label>
    </div>

    @* Person dropdown *@
    <div class="govuk-grid-column-one-third">
        <label for="personSelectDropdown_input" class="govuk-label govuk-!-font-weight-bold sup_visually_hidden">&nbsp;</label>
        <div id="personSelectMultiDropdown" class="govuk-grid-column-full sup_p_0"></div>
    </div>

</div>

@* Main content row: grid (left) + info panels (right) *@
<div class="govuk-grid-row sup_margin_0">

    @* People Grid *@
    <div class="govuk-grid-column-three-quarters sup_margin_top_10">
        <div id="gridContainer_peopleGrid">
            @await Html.PartialAsync("_DataGrid", Model.PeopleGrid)
        </div>
    </div>

    @* Right-hand information panels *@
    <div class="govuk-grid-column-one-quarter sup_margin_top_10">

        @* WorkGroup Information Panel *@
        <div class="sup_border sup_margin_bottom_15 sup_p_8">
            <h3 class="govuk-heading-s sup_margin_0">WorkGroup Information</h3>
            <div class="sup_margin_bottom_10">
                <label for="selectedWorkgroup" class="govuk-label govuk-!-font-weight-bold">I have selected:</label>
                <input type="text" id="selectedWorkgroup" class="govuk-input govuk-!-font-size-16" readonly />
            </div>
            <div class="sup_flex_column">
                <button type="button" class="govuk-button sup_margin_bottom_10 sup_p_8" id="btnShowSummary"
                        data-module="govuk-button" disabled>
                    Show me summarised WorkGroup time
                </button>
                <button type="button" class="govuk-button sup_margin_bottom_10 sup_p_8" id="btnShowTimeRecords"
                        data-module="govuk-button" disabled>
                    Show Time Records
                </button>
                <button type="button" class="govuk-button sup_margin_bottom_10 sup_p_8" id="btnShowTimeCodes"
                        data-module="govuk-button" disabled>
                    Show me valid TimeCodes
                </button>
                <button type="button" class="govuk-button sup_margin_bottom_0 sup_p_8" id="btnShowTestOutputs"
                        data-module="govuk-button" disabled>
                    Show me valid Test Outputs
                </button>
            </div>
        </div>

        @* People Information Panel *@
        <div class="sup_border sup_margin_bottom_10 sup_p_8">
            <h3 class="govuk-heading-s sup_margin_0">People Information</h3>
            <div class="sup_margin_bottom_10">
                <label for="selectedPerson" class="govuk-label govuk-!-font-weight-bold">I have selected:</label>
                <input type="text" id="selectedPerson" class="govuk-input govuk-!-font-size-16" readonly />
            </div>
            <div class="sup_flex_column">
                <button type="button" class="govuk-button sup_margin_0 sup_p_8" id="btnShowTimeByJob"
                        data-module="govuk-button" disabled>
                    Show me Time by JobCode and Month
                </button>
            </div>
        </div>

    </div>

</div>
@section Styles {
    <link rel="stylesheet" href="~/css/common/multicolumn-dropdown.css" />
}
@section Scripts {
    <script>
        const workgroupOptionsListData =   @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.WorkGroupOptions));
        const personOptionsListData =   @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.PersonOptions));
         
    </script>
    <script src="~/js/common/multicolumn-dropdown.component.js"></script>
    <script src="~/js/pact_js/work-group-people.js"></script>
    <script>
        peopleGridId = '@Model.PeopleGrid.GridId';
        preselectedWorkGroup = '@Html.Raw(Model.SelectedWorkGroup ?? "")';
    </script>
}

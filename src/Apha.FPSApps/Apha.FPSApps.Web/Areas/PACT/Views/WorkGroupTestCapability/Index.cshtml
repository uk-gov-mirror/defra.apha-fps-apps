@using Apha.FPSApps.Web.Models.Components.DataGrid
@model Apha.FPSApps.Web.Areas.PACT.Models.WorkGroupTestCapabilityViewModel

@{
    ViewData["Title"] = "PACT : Test Capabilities for WorkGroup";
    var currentYear = Context.Items["SelectedFPSYear"]?.ToString() ?? DateTime.Now.Year.ToString();
}

@* Page Title *@
<div class="govuk-grid-row sup_margin_left_right_0">
    <div class="govuk-grid-column-full sup_border-bottom">
        <h1 class="sup_margin_top_10 sup_padding_bottom_10">
            Test Capabilities for WorkGroup
            <a asp-area="PACT"
               asp-controller="WorkGroupPeople"
               asp-action="Index"
               asp-route-workGroup="@Model.SelectedWorkGroup"
               class="govuk-back-link sup_align_right sup_margin_0">
                Back
            </a>
        </h1>
    </div>
</div>

@* Main Content *@
<div class="govuk-grid-row sup_margin_left_right_0 sup_margin_top_10 sup_margin_bottom_10">

    @* Left Panel - Selection Controls *@
    <div class="sup_flex_column govuk-grid-column-one-quarter sup_padding_right_0">

        @* WorkGroup Selection *@
        <div class="sup_border sup_margin_bottom_15 sup_p_8">
            <div class="sup_margin_bottom_10">
                <label for="workGroupSelect" class="govuk-label govuk-!-font-weight-bold">I have selected:</label>
                <div style="position: relative; z-index: 50;">
                    <input type="text" id="workGroupSelect" placeholder="Select WorkGroup" autocomplete="off"
                           class="govuk-input govuk-!-font-size-16 down-arrow-img" style="width:100%; cursor:pointer;" readonly />
                    <div id="workGroupDropdownPanel" style="display:none; position:absolute; top:100%; left:0; width:100%;
                            max-height:260px; overflow-y:auto; background:#fff; border:1px solid #b1b4b6;
                            box-shadow:0 4px 8px rgba(0,0,0,.2); z-index:2000;">
                        <input type="text" id="workGroupSearchBox" placeholder="Type to search work group"
                               style="width:100%; padding:6px 8px; border:0; border-bottom:1px solid #b1b4b6; outline:none; box-sizing:border-box;" />
                        <table style="width:100%; border-collapse:collapse; font-size:14px;">
                            <thead style="background:#f3f2f1; position:sticky; top:0; z-index:10;">
                                <tr>
                                    <th style="padding:6px 8px; text-align:left;">Work Group</th>
                                    <th style="padding:6px 8px; text-align:left;">Profit Centre</th>
                                </tr>
                            </thead>
                            <tbody id="workGroupDropdownBody">
                                @foreach (var item in Model.WorkGroupOptions)
                                {
                                    <tr data-value="@item.WorkGroupName" style="cursor:pointer;">
                                        <td style="padding:6px 8px; border-bottom:1px solid #f3f2f1;">@item.WorkGroupName</td>
                                        <td style="padding:6px 8px; border-bottom:1px solid #f3f2f1;">@item.ProfitCentre</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="sup_flex_column">
                <button type="button" class="govuk-button sup_margin_bottom_10 sup_p_8" id="btnTestCapability"
                        aria-label="Show Test Capability Maintenance" data-module="govuk-button"
                        onclick="navigateToTestCapability()">
                    Show me Test Capability Maintenance
                </button>
            </div>
        </div>

        @* Portfolio Selection *@
        <div class="sup_border sup_margin_bottom_15 sup_p_8">
            <div class="sup_margin_bottom_10">
                <label for="selectedPortfolio" class="govuk-label govuk-!-font-weight-bold">I have selected:</label>
                <input type="text" id="selectedPortfolio" class="govuk-input govuk-!-font-size-16" disabled />
            </div>
            <div class="sup_flex_column">
                <button type="button" class="govuk-button sup_margin_bottom_10 sup_p_8" id="btnShowProjectAdministration"
                        aria-label="Show Portfolio Details" data-module="govuk-button" disabled
                        onclick="navigateToPortfolioMaintenance()">
                    Show me Project Administration...
                </button>
            </div>
        </div>

    </div>

    @* Right Panel - Grid *@
    <div class="govuk-grid-column-three-quarters sup_p_0">
        <div id="gridContainer_testCapabilitiesWGGrid" class="govuk-grid-column-full">
            @await Html.PartialAsync("_DataGrid", Model.TestCapabilityGrid)
        </div>
    </div>

</div>

@section Scripts {
    <script src="~/js/ajax-form-validation.js"></script>
    <script src="~/js/pact_js/work-group-test-capability.js"></script>
    <script>
        // Initialize the WorkGroup Test Capability module
        $(document).ready(function () {
            WorkGroupTestCapability.initialize('@Model.TestCapabilityGrid.GridId', '@Html.Raw(Model.SelectedWorkGroup)');
        });
    </script>

    @Html.AntiForgeryToken()
}

@using Apha.FPSApps.Web.Models.Components.DataGrid
@model dynamic

<div class="editable-grid-container sup_border">
    <div class="sup_border_bottom_0">
        <h2 class="sup_border-bottom sup_text_color sup_heading_bg_color govuk-heading-s sup_margin_0 sup_align_heading " aria-label="@Model.Title || Datagrid Title">
            <div class="sup_flex_space_between ">
                    @Model.Title
                    <div>
                        @if (Model.AllowExport)
                        {
                            <button type="button" class="govuk-button govuk-button--secondary sup_gov_blue_bg sup_margin_0 sup_p_8"
                                    id="@($"{Model.GridId}_exportBtn")" data-export-url="@Model.ExportUrl" allow-edit ="true">
                                <i class="fa fa-file-excel-o"></i> Excel Export
                            </button>
                        }
                        @if (Model.AllowAdd)
                        {
                            <button type="button" class="govuk-button sup_margin_0 sup_p_8"
                                                  id="@($"{Model.GridId}_addRowBtn")" data-add-function="@Model.AddFunction">
                                <i class="fa fa-plus"></i> Add
                            </button>
                        }
                        @if (Model.AllowBulkCopy)
                        {
                            <button type="button" class="govuk-button sup_margin_0 sup_p_8"
                                                  id="@($"{Model.GridId}_bulkCopyBtn")" data-bulkcopy-function="@Model.BulkCopyFunction">
                                <i class="fa fa-copy"></i> @Model.BulkCopyButtonText
                            </button>
                        }
                        @if (Model.AllowBulkDelete)
                        {
                            <button type="button" class="govuk-button govuk-button--warning sup_margin_0 sup_p_8"
                                                  id="@($"{Model.GridId}_bulkDeleteBtn")" data-bulkdelete-function="@Model.BulkDeleteFunction">
                                <i class="fa fa-trash"></i> Delete All
                            </button>
                        }                    
                    </div>
                </div>
            </h2>
        <div class="grid-toolbar">
            <div class="sup_flex_center_gap_0">
                <!-- Page Size Dropdown START -->
                @*  <select id="@($"{Model.GridId}_pageSize")" class="form-control form-control-sm" style="width: 90px;">
                    @{
                        var sizes = new[] { 5, 10, 20, 50, 100 };
                        int currentSize = Model.Pagination?.PageSize ?? 5;
                    }
                    @foreach (var size in sizes)
                    {
                        <option value="@size" selected="@(size == currentSize ? "selected" : null)">
                            @size / page
                        </option>
                    }
                </select> *@
                <!-- Page Size Dropdown END -->
                @*    <button type="button" class="btn btn-success" id="@($"{Model.GridId}_addRowBtn")">
                    <i class="fa fa-plus"></i> Add
                </button> *@
            </div>
        </div>
    </div>



    <div>
        <div class="grid-scroll-container">
            <table id="@($"tbl_{Model.GridId}")" class="editable-grid-table govuk-table custom-table">
                <thead class="govuk-table__head">
                    @if (Model.ColumnGroups != null && ((IEnumerable<dynamic>)Model.ColumnGroups).Any())
                    {
                        <tr class="govuk-table__row grid-column-group-row">
                            @if (Model.ShowCheckboxColumn)
                            {
                                <th scope="col" class="grid-column-group-cell grid-column-group-cell--empty"></th>
                            }
                            @foreach (var group in Model.ColumnGroups)
                            {
                                if (string.IsNullOrEmpty(Convert.ToString(group.Label)))
                                {
                                    <th scope="col" colspan="@group.Span" class="grid-column-group-cell grid-column-group-cell--empty"></th>
                                }
                                else
                                {
                                    <th scope="col" colspan="@group.Span" class="grid-column-group-cell grid-column-group-cell--labelled">@group.Label</th>
                                }
                            }
                            @if (Model.AllowEdit || Model.AllowDelete || Model.AllowView)
                            {
                                <th scope="col" class="grid-column-group-cell grid-column-group-cell--empty"></th>
                            }
                        </tr>
                    }
                    <tr class="govuk-table__row">
                        @if (Model.ShowCheckboxColumn)
                        {
                            <th scope="col" class="govuk-table__header sup_p_0">

                                <div class="govuk-checkboxes govuk-checkboxes--small sup_margin_0" data-module="govuk-checkboxes">
                                    <div class="govuk-checkboxes__item">
                                    <input type="checkbox" id="@($"{Model.GridId}_selectAll")" class="govuk-checkboxes__input govuk-!-font-size-16" aria-label="Select all rows" />
                                    @*        <input class="govuk-checkboxes__input govuk-!-font-size-16" id="chkfinished" name="chkfinished" type="checkbox" value="finished"> *@
                                    <label class="govuk-label govuk-checkboxes__label sup_label_auto_width sup_p_0 sup_w_h_0" for="@($"{Model.GridId}_selectAll")">
                                        <span class="govuk-visually-hidden">Select all rows</span>
                                    </label>
                                </div>

                                </div>
                            </th>
                        }
                        @foreach (var column in Model.Columns)
                        {
                            if (column.IsVisible)
                            {
                                var isSorted = (Model.Pagination.SortColumn == column.PropertyName);
                                var sortIcon = "";
                                if (isSorted)
                                    sortIcon = Model.Pagination.SortDirection ? "▲" : "▼";
                                <th scope="col" style="width: @column.Width px; cursor:pointer;"
                                            class="sortable-header"
                                            data-column="@column.PropertyName"
                                            data-sortdir="@(!Model.Pagination.SortDirection)">
                                            @column.DisplayName <span class="sort-icon">@sortIcon</span>
                                            <div class="column-resizer"></div>
                                        </th>
                                    }
                                }
                                @if (Model.AllowEdit || Model.AllowDelete || Model.AllowView)
                                {
                                    <th scope="col" class="govuk-table__header">Action</th>
                                }
                    </tr>
                    <!-- Filter Row -->
                    @{
                        bool hasFilterableColumns = Model.Columns != null &&
                            ((IEnumerable<dynamic>)Model.Columns).Any(c => c.IsVisible && c.IsFilterable);
                    }
                    @if (hasFilterableColumns)
                    {
                    <tr class="filter-row govuk-table__row">
                        @if (Model.ShowCheckboxColumn)
                        {
                            <th scope="col" aria-label="Select row checkbox"></th>
                        }
                        @foreach (var column in Model.Columns)
                        {
                            if (column.IsVisible)
                            {
                                    <th scope="col" aria-label="Select row checkbox">
                                    @if (column.IsFilterable)
                                    {
                                        var filterValue = Model.CurrentFilters != null && Model.CurrentFilters.ContainsKey(column.PropertyName)
                                        ? Model.CurrentFilters[column.PropertyName]
                                        : "";

                                        if (column.FilterType == GridColumnType.Dropdown && column.FilterOptions != null)
                                        {
                                            <select id="@($"{Model.GridId}_{column.PropertyName}_filter")" class="grid-filter govuk-input govuk-!-font-size-16" data-filter="@column.PropertyName" aria-label="@($"Filter {column.DisplayName}")">
                                                <option value="">All</option>
                                                @foreach (var option in column.FilterOptions)
                                                {
                                                    <option value="@option.Key" selected="@(option.Key == filterValue ? "selected" : null)">
                                                        @option.Value
                                                    </option>
                                                }
                                            </select>
                                        }
                                        else if (column.FilterType == GridColumnType.Checkbox)
                                        {
                                            <select id="@($"{Model.GridId}_{column.PropertyName}_filter")" class="grid-filter govuk-input govuk-!-font-size-16" data-filter="@column.PropertyName" aria-label="@($"Filter {column.DisplayName}")">
                                                <option value="">All</option>
                                                <option value="true" selected="@(filterValue == "true" ? "selected" : null)">True</option>
                                                <option value="false" selected="@(filterValue == "false" ? "selected" : null)">False</option>
                                            </select>
                                        }
                                        //Add condition for datepicker
                                        else if (column.FilterType == GridColumnType.Date)
                                        {
                                            <input type="date" id="@($"{Model.GridId}_{column.PropertyName}_filter")" class="grid-filter grid-date govuk-input govuk-!-font-size-16" data-filter="@column.PropertyName"
                                                   value="@(!string.IsNullOrWhiteSpace(filterValue) ? Convert.ToDateTime(filterValue).ToString("yyyy-MM-dd") : "")" placeholder="Filter..." aria-label="@($"Filter {column.DisplayName}")" />
                                        }
                                        else
                                        {
                                            <input type="text" id="@($"{Model.GridId}_{column.PropertyName}_filter")" class="grid-filter govuk-input govuk-!-font-size-16" data-filter="@column.PropertyName" value="@filterValue" placeholder="Filter..." aria-label="@($"Filter {column.DisplayName}")" />
                                        }
                                    }
                                    else
                                    {
                                        <span class="govuk-visually-hidden">No filter</span>
                                    }
                                </th>
                                            }
                                        }
                                        @if (Model.AllowEdit || Model.AllowDelete || Model.AllowView)
                                        {
                                            <th scope="col" aria-label="Actions column"></th>
                                        }
                                    </tr>
                    }
                </thead>
                <tbody class="govuk-table__body">
                    @{
                        var rowIndex = 0;
                        string selectFnForRow = string.IsNullOrEmpty((string)Model.RowSelectFunction)
                            ? (string)Model.EditFunction
                            : (string)Model.RowSelectFunction;
                    }
                    @foreach (var row in Model.Data)
                    {
                        <tr data-row-index="@rowIndex"
                            data-id="@GridHelpers.GetPropertyValue(row, Model.KeyProperty)"
                            class="@(Model.AllowRowSelection ? "selectable-row" : null)"
                            data-select-function="@(Model.AllowRowSelection ? selectFnForRow : null)">
                            @if (Model.ShowCheckboxColumn)
                            {
                                <td class="checkbox-cell govuk-table__cell">
                                    @*  <input type="checkbox" name="chk-box-_@rowIndex"
                                           id="@($"chk_{Model.GridId}_{rowIndex}")" class="row-checkbox" /> *@


                                    <div class="govuk-checkboxes govuk-checkboxes--small sup_margin_0" data-module="govuk-checkboxes">
                                        <div class="govuk-checkboxes__item sup_chk_margin">
                                            <input type="checkbox" name="chk-box-_@rowIndex"
                                                   id="@($"chk_{Model.GridId}_{rowIndex}")" class="row-checkbox govuk-checkboxes__input govuk-!-font-size-16" />
                                            <label class="govuk-label govuk-checkboxes__label sup_label_auto_width sup_p_0 sup_w_h_0" for="@($"chk_{Model.GridId}_{rowIndex}")">
                                                <span class="govuk-visually-hidden">Select row @((rowIndex + 1))</span>
                                            </label>
                                        </div>

                                    </div>
                                </td>
                            }
                            @foreach (var column in Model.Columns)
                            {
                                if (column.IsVisible)
                                {
                                    var value = GridHelpers.GetPropertyValue(row, column.PropertyName);
                                    if (column.ColumnType == GridColumnType.Checkbox)
                                    {
                                        <td class="checkbox-cell govuk-table__cell" data-property="@column.PropertyName" data-type="@column.ColumnType" style="text-align:center; vertical-align:middle;">
                                            <div class="govuk-checkboxes govuk-checkboxes--small sup_margin_0" data-module="govuk-checkboxes" style="display:flex; justify-content:center; align-items:center;">
                                                <div class="govuk-checkboxes__item sup_chk_margin" style="pointer-events:none;">
                                                    <input type="checkbox" name="@column.PropertyName"
                                                           id="@($"{Model.GridId}_{column.PropertyName}_{rowIndex}")" class="govuk-checkboxes__input govuk-!-font-size-16 @GridHelpers.GetTypeCssClass(column)"
                                                           @(Convert.ToBoolean(value) ? "checked" : "") />
                                                    <label class="govuk-label govuk-checkboxes__label sup_label_auto_width sup_p_0 sup_w_h_0" for="@($"{Model.GridId}_{column.PropertyName}_{rowIndex}")">
                                                        <span class="govuk-visually-hidden">@column.DisplayName</span>
                                                    </label>
                                                </div>
                                            </div>
                                        </td>
                                    }
                                    else
                                    {
                                        <td data-property="@column.PropertyName" data-type="@column.ColumnType" class="govuk-table__cell">
                                            <span name="@column.PropertyName"
                                                  id="@($"{Model.GridId}_{column.PropertyName}_{rowIndex}")"
                                                  class="@GridHelpers.GetTypeCssClass(column)">@GridHelpers.FormatValue(value, column)</span>
                                        </td>
                                    }
                                }
                            }
                            <!-- Edit / Delete / View Buttons -->
                            @if (Model.AllowEdit || Model.AllowDelete || Model.AllowCopy || Model.AllowView)
                            {
                                <td class="govuk-table__cell">
                                    @if (Model.AllowEdit)
                                    {
                                        <button type="button"
                                                class="btn btn-sm edit-row-btn"
                                                data-id="@GridHelpers.GetPropertyValue(row, Model.KeyProperty)"
                                                data-edit-function="@Model.EditFunction">
                                            <img src="~/images/edit_gridicon.svg" alt="Edit icon" width="20" height="20" title="Edit">
                                        </button>
                                    }
                                    @if (Model.AllowCopy)
                                    {
                                        <button type="button"
                                                class="btn btn-sm copy-row-btn"
                                                data-id="@GridHelpers.GetPropertyValue(row, Model.KeyProperty)"
                                                data-copy-function="@Model.CopyFunction">
                                                <img src="~/images/copy-regular-full.svg" alt="Copy icon" width="20" height="20" title="Copy">
                                        </button>
                                    }
                                    @if (Model.AllowDelete)
                                    {
                                        <button type="button"
                                                class="btn btn-sm delete-row-btn"
                                                data-id="@GridHelpers.GetPropertyValue(row, Model.KeyProperty)"
                                                data-delete-function="@Model.DeleteFunction">
                                            <img src="~/images/delete_gridicon.svg" alt="Delete icon" width="20" height="20" title="Delete">
                                        </button>
                                    }
                                    @if (Model.AllowView)
                                    {
                                        <button type="button"
                                                class="btn btn-sm delete-row-btn"
                                                data-id="@GridHelpers.GetPropertyValue(row, Model.KeyProperty)"
                                                data-delete-function="@Model.ViewFunction" allow-edit="true">
                                            <img src="~/images/view_icon.png" alt="View icon" width="20" height="20" title="View">
                                        </button>
                                    }
                                </td>
                            }
                        </tr>
                        rowIndex++;
                    }
                    @if (Model.Data == null || Model.Data.Count == 0)
                    {
                        <tr>
                            <td colspan="100" class="govuk-table__cell"
                                style="text-align:center; color:#505a5f; font-style:italic; padding:16px;">
                                No records found.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
     @if (Model.ShowPagination)
     {
         <div class="sup_pagination_footer sup_p_0">
             <div class="sup_pagination_wrapper">
                 <div class="sup_margin_top_bottom_5_10 sup_flex_center">
                     <label for="recordsPerPage" class="sup_margin_right_5">Records per page  </label>
                     <select id="@($"{Model.GridId}_pageSize")" class="govuk-select govuk-select--width-2 sup_width_4em govuk-!-font-size-16">
                         @{
                             var sizes = new[] { 5, 10, 20, 50, 100 };
                             int currentSize = Model.Pagination?.PageSize ?? 5;
                         }
                         @foreach (var size in sizes)
                         {
                             <option value="@size" selected="@(size == currentSize ? "selected" : null)">
                                 @size
                             </option>
                         }
                     </select>
                 </div>

                 @await Component.InvokeAsync("Pagination", Model.Pagination)
                     <span class="record-info sup_display_none">
                         Page @Model.Pagination.PageNumber of @Model.Pagination.TotalPages
                         &nbsp;|&nbsp;
                         Showing @((Model.Pagination.PageSize * (Model.Pagination.PageNumber - 1)) + 1)
                         -
                         @(Math.Min(Model.Pagination.PageSize * Model.Pagination.PageNumber, Model.Pagination.TotalRecords))
                         of @Model.Pagination.TotalRecords
                     </span>

             </div>
        </div>
    }
</div>

<script type="text/javascript">
    (function() {
        var gridId = '@Model.GridId';
        var gridContainerSelector = '#gridContainer_' + gridId;
        var bindGridUrl = '@Model.BindGridUrl';

        // Get extra filters once at initialization
        var extraFilters = typeof window['@Model.ExtraFilterMethod'] === "function"
            ? window['@Model.ExtraFilterMethod']()
            : {};

        // Core grid manager - attached to this specific grid
        var gridManager = {
            getFilterModel: function() {
                var filterModel = {};
                $(gridContainerSelector + ' .grid-filter').each(function () {
                    var prop = $(this).data('filter');
                    var val = $(this).val();
                    if (val !== undefined && val !== null && val !== '') {
                        filterModel[prop] = val;
                    }
                });
                return filterModel;
            },

            getAjaxParams: function(customParams) {
                // Refresh extra filters each time to get latest values
                var currentExtraFilters = typeof window['@Model.ExtraFilterMethod'] === "function"
                    ? window['@Model.ExtraFilterMethod']()
                    : {};

                var params = {
                    page: customParams.page || 1,
                    pageSize: customParams.pageSize || $('#' + gridId + '_pageSize').val() || 10,
                    sortBy: customParams.sortBy || '@Model.Pagination.SortColumn',
                    descending: customParams.descending || '@Model.Pagination.SortDirection',
                    filter: JSON.stringify(this.getFilterModel())
                };

                // Merge extra filters
                for (var key in currentExtraFilters) {
                    if (currentExtraFilters.hasOwnProperty(key)) {
                        params[key] = currentExtraFilters[key];
                    }
                }

                return params;
            },

            reloadGrid: function(params) {
                var self = this;
                $.post(bindGridUrl, self.getAjaxParams(params))
                    .done(function (htmlData) {
                        $(gridContainerSelector).html(htmlData);
                        self.applyGridColumnWidths();
                        self.deselectAllCheckboxes();
                        document.dispatchEvent(new CustomEvent('gridReloaded', { detail: { gridId: gridId } }));
                    })
                    .fail(function(xhr, status, error) {
                        console.error('Grid reload failed:', error);
                    });
            },

            deselectAllCheckboxes: function() {
                $('#' + gridId + '_selectAll').prop('checked', false);
                $('#tbl_' + gridId + ' .row-checkbox').prop('checked', false);
            },

            saveGridColumnWidths: function() {
                var widths = {};
                $('#tbl_' + gridId + ' th[data-column]').each(function () {
                    var col = $(this).data('column');
                    if (col) widths[col] = $(this).outerWidth();
                });
                localStorage.setItem(gridId + '_colWidths', JSON.stringify(widths));
            },

            applyGridColumnWidths: function() {
                var widths = {};
                try {
                    widths = JSON.parse(localStorage.getItem(gridId + '_colWidths') || '{}');
                } catch {}
                $('#tbl_' + gridId + ' th[data-column]').each(function () {
                    var col = $(this).data('column');
                    if (col && widths[col]) $(this).css('width', widths[col] + 'px');
                });
            }
        };

        // EXPOSE gridManager to global scope with grid-specific name
        window['gridManager_' + gridId] = gridManager;

        // Initialize grid on document ready
        $(function() {
            // Track changes for saving
            var changedRows = {};

            $(gridContainerSelector).on('change', '.grid-input', function() {
                var $row = $(this).closest('tr');
                var rowIndex = $row.data('row-index');
                var property = $(this).closest('td').data('property');
                var value = $(this).is(':checkbox') ? $(this).is(':checked') : $(this).val();

                if (!changedRows[rowIndex]) {
                    changedRows[rowIndex] = {};
                }
                changedRows[rowIndex][property] = value;
                $row.css('background-color', '#ffffcc');
            });

            window.getChangedRows = function() {
                return changedRows;
            };

            // Sort header click
            $(gridContainerSelector).off('click', '.sortable-header').on('click', '.sortable-header', function (e) {
                if (resizing) {
                    e.stopImmediatePropagation();
                    return;
                }

                gridManager.reloadGrid({
                    page: 1,
                    sortBy: $(this).data('column'),
                    descending: $(this).data('sortdir')
                });
            });

            // Pagination click
            $(gridContainerSelector).off('click', '.pagination a, .pagination span').on('click', '.pagination a, .pagination span', function (e) {
                e.preventDefault();
                if ($(this).hasClass('pagination--disabled') || $(this).attr('aria-disabled') === 'true') return;
                var pageNo = $(this).data('pageno');
                if ($(this).is('[disabled]') || !pageNo || isNaN(pageNo) || pageNo < 1) return;

                gridManager.reloadGrid({ page: pageNo });
            });

            // Page size change
            $('#' + gridId + '_pageSize').on('change', function () {
                gridManager.reloadGrid({
                    page: 1,
                    pageSize: $(this).val()
                });
            });

            // Filter change
            $(gridContainerSelector).off('change', '.grid-filter').on('change', '.grid-filter', function () {
                gridManager.reloadGrid({ page: 1 });
            });

            // Select All checkbox
            $('#' + gridId + '_selectAll').on('change', function() {
                var checked = $(this).is(':checked');
                $('#tbl_' + gridId + ' .row-checkbox').prop('checked', checked);
            });

            // Row checkbox change
            $(gridContainerSelector).off('change', '.row-checkbox').on('change', '.row-checkbox', function() {
                var allChecked = $('.row-checkbox').length === $('.row-checkbox:checked').length;
                $('#' + gridId + '_selectAll').prop('checked', allChecked);
            });

            // Add button click
            $('#' + gridId + '_addRowBtn').on('click', function () {
                var customAddFn = $(this).data('add-function');
                if (customAddFn && typeof window[customAddFn] === 'function') {
                    window[customAddFn](this);
                }
            });

            // Helper: returns { ids: [...], isAll: bool }
            // - If no checkbox column exists, treats every row as selected (isAll = true).
            // - If the select-all checkbox is checked, or every individual checkbox is
            //   checked, isAll = true and all row IDs are returned.
            // - Otherwise only the IDs of checked rows are returned.
            function getSelectedIds() {
                var $checkboxes = $('#tbl_' + gridId + ' .row-checkbox');
                var ids = [];

                if ($checkboxes.length === 0) {
                    $('#tbl_' + gridId + ' tbody tr').each(function () {
                        ids.push($(this).data('id'));
                    });
                    return { ids: ids, isAll: true };
                }

                var $checked = $checkboxes.filter(':checked');
                var isAll = $checkboxes.length === $checked.length;

                if (isAll) {
                    $('#tbl_' + gridId + ' tbody tr').each(function () {
                        ids.push($(this).data('id'));
                    });
                } else {
                    $checked.each(function () {
                        ids.push($(this).closest('tr').data('id'));
                    });
                }
                return { ids: ids, isAll: isAll };
            }

            // Bulk Copy button click
            $('#' + gridId + '_bulkCopyBtn').on('click', function () {
                var fn = $(this).data('bulkcopy-function');
                if (fn && typeof window[fn] === 'function') {
                    window[fn](getSelectedIds());
                }
            });

            // Bulk Delete button click
            $('#' + gridId + '_bulkDeleteBtn').on('click', function () {
                var fn = $(this).data('bulkdelete-function');
                if (fn && typeof window[fn] === 'function') {
                    window[fn](getSelectedIds());
                }
            });

            // Export button click
            $('#' + gridId + '_exportBtn').on('click', function () {
                var exportUrl = $(this).data('export-url');
                if (!exportUrl) return;

                var currentExtraFilters = typeof window['@Model.ExtraFilterMethod'] === 'function'
                    ? window['@Model.ExtraFilterMethod']()
                    : {};

                var params = $.extend(
                    { filter: JSON.stringify(gridManager.getFilterModel()) },
                    currentExtraFilters
                );

                var query = Object.keys(params)
                    .map(function (k) { return encodeURIComponent(k) + '=' + encodeURIComponent(params[k]); })
                    .join('&');

                window.location.href = exportUrl + '?' + query;
            });

            // Edit button click
            $(gridContainerSelector).off('click', '.edit-row-btn').on('click', '.edit-row-btn', function() {
                var customEditFn = $(this).data('edit-function');
                if (customEditFn && typeof window[customEditFn] === 'function') {
                    window[customEditFn](this);
                }
            });

            // Copy button click
            $(gridContainerSelector).off('click', '.copy-row-btn').on('click', '.copy-row-btn', function() {
                var customCopyFn = $(this).data('copy-function');
                if (customCopyFn && typeof window[customCopyFn] === 'function') {
                window[customCopyFn](this);
                }
            });

            // Delete button click
            $(gridContainerSelector).off('click', '.delete-row-btn').on('click', '.delete-row-btn', function() {
                var customDeleteFn = $(this).data('delete-function');
                if (customDeleteFn && typeof window[customDeleteFn] === 'function') {
                    window[customDeleteFn](this);
                }
            });

            // Row selection click
            $(gridContainerSelector).off('click', '.selectable-row').on('click', '.selectable-row', function (e) {
                if ($(e.target).closest('button, a, input').length) return;

                $('#tbl_' + gridId + ' tbody tr').removeClass('selected-row');
                $(this).addClass('selected-row');

                var selectFn = $(this).data('select-function');
                if (selectFn && typeof window[selectFn] === 'function') {
                    window[selectFn](this);
                }
            });

            // Column resizing
            const table = document.getElementById('tbl_' + gridId);
            let pressed = false;
            let startX, startWidth, th;
            let resizing = false;

            if (table) {
                table.querySelectorAll('.column-resizer').forEach(function (resizer) {
                    resizer.addEventListener('mousedown', function (e) {
                        pressed = true;
                        resizing = false;
                        th = resizer.parentElement;
                        startX = e.pageX;
                        startWidth = th.offsetWidth;
                        document.body.style.cursor = 'col-resize';
                        e.preventDefault();
                    });
                });

                document.addEventListener('mousemove', function (e) {
                    if (!pressed) return;
                    const diff = e.pageX - startX;
                    if (Math.abs(diff) > 2) resizing = true;
                    th.style.width = (startWidth + diff) + 'px';
                });

                window.addEventListener('mouseup', function (e) {
                    if (pressed) {
                        pressed = false;
                        setTimeout(() => { resizing = false; }, 100);
                        document.body.style.cursor = '';
                        gridManager.saveGridColumnWidths();
                    }
                });
            }
        });
    })();
</script>